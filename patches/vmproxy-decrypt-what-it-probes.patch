+    /// Choose the right unlocking tool once blkid has said what this is.
+    ///
+    /// The kind of encryption is picked in `new` from the type the host sent,
+    /// and for an image the host sends "auto" — it cannot see inside one. So
+    /// when the probe here turns out to be encrypted, the choice has to be made
+    /// again, or BitLocker would be opened with `cryptsetup open`.
+    fn prepare_for_probed_encryption(&mut self) {
+        match self.fs_type.as_deref() {
+            Some("BitLocker") => {
+                self.mapper_ident_prefix = "btlk";
+                self.cryptsetup_op = "bitlkOpen";
+            }
+            _ => {
+                self.mapper_ident_prefix = "luks";
+                self.cryptsetup_op = "open";
+            }
+        }
+    }
