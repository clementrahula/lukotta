+
+/// The MAC address vmnet handed out for this interface, once one has started.
+///
+/// vmnet assigns the address when the interface is created and afterwards
+/// delivers unicast to that address alone. A guest NIC carrying any other
+/// address still receives broadcast, so ARP is answered and the host learns a
+/// neighbour it can never actually reach: every unicast frame is dropped by
+/// vmnet before it arrives, and the host reports "No route to host" for a
+/// route that plainly exists. Nothing in the guest looks wrong -- its
+/// interface is up, addressed and routed, and its counters show frames coming
+/// in, because broadcast still arrives.
+static VMNET_MAC: OnceLock<[u8; 6]> = OnceLock::new();
+
+/// Record what vmnet assigned, before the VM that must wear it is created.
+pub fn set_vmnet_mac_address(mac: [u8; 6]) {
+    let _ = VMNET_MAC.set(mac);
+}
+
+/// The address to give the guest NIC.
+///
+/// A random one is right for gvproxy, a user-mode stack that answers for
+/// whatever address the guest picks. It is wrong for vmnet, which picked one
+/// already.
+pub fn vm_mac_address() -> [u8; 6] {
+    VMNET_MAC.get().copied().unwrap_or_else(random_mac_address)
+}
+
+/// Read a MAC address in the form vmnet-helper prints, "0a:1b:2c:3d:4e:5f".
+pub fn parse_mac_address(text: &str) -> Option<[u8; 6]> {
+    let mut mac = [0u8; 6];
+    let mut parts = text.trim().split(':');
+    for octet in mac.iter_mut() {
+        *octet = u8::from_str_radix(parts.next()?, 16).ok()?;
+    }
+    if parts.next().is_some() {
+        return None;
+    }
+    Some(mac)
 }
 
