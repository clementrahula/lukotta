diff -ruN -x target -x Cargo.lock a/src/vdi/mod.rs b/src/vdi/mod.rs
--- a/src/vdi/mod.rs	1970-01-01 03:00:00
+++ b/src/vdi/mod.rs	2026-08-22 14:50:51
@@ -0,0 +1,401 @@
+// SPDX-FileCopyrightText: 2026 Clement Rahula <lukotta@rahula.dev>
+// SPDX-License-Identifier: MIT
+//
+// Contributed to imago and licensed under that crate's MIT terms. The
+// GPL-3.0-or-later terms covering the Lukotta distribution, which carries this
+// file as a patch, do not apply to it.
+
+//! VDI implementation.
+//!
+//! VirtualBox's format, read-only. A VDI is a header, a block map and the
+//! blocks. The map holds one 32-bit entry per block of the virtual disk, giving
+//! that block's index in the image. Two values are reserved and mark a block
+//! that was never written and reads as zeroes.
+//!
+//! Nothing here follows a reference to another file, because the format cannot
+//! express one: a VDI's data is always its own. VirtualBox's snapshots are
+//! separate images chained together by the virtual machine's configuration
+//! rather than by anything in the image.
+
+use crate::format::builder::{FormatDriverBuilder, FormatDriverBuilderBase};
+use crate::format::drivers::FormatDriverInstance;
+use crate::format::gate::ImplicitOpenGate;
+use crate::format::{Format, PreallocateMode};
+use crate::io_buffers::IoBuffer;
+use crate::misc_helpers::invalid_data;
+use crate::storage::ext::StorageExt;
+use crate::{ShallowMapping, Storage, StorageOpenOptions};
+use async_trait::async_trait;
+use std::fmt::{self, Display, Formatter};
+use std::path::{Path, PathBuf};
+use std::{cmp, io};
+
+/// The signature that begins the header, after 64 bytes of free text.
+const VDI_SIGNATURE: u32 = 0xbeda_107f;
+/// Where that signature sits.
+const SIGNATURE_OFFSET: u64 = 0x40;
+/// How much of the file the header can occupy, and therefore how much is read
+/// before its length is known.
+const HEADER_READ: usize = 0x200;
+
+/// The block was never written, and reads as zeroes.
+const BLOCK_FREE: u32 = 0xffff_ffff;
+/// The block was discarded, and reads as zeroes.
+const BLOCK_ZERO: u32 = 0xffff_fffe;
+
+/// A block map larger than this exceeds any real disk, and reading it is the
+/// only unbounded allocation this driver performs. 100 million blocks is a
+/// 100 TB disk at the smallest block size in use.
+const MAX_BLOCKS: u32 = 100_000_000;
+
+/// The header's contents, once read and validated.
+#[derive(Debug, Clone)]
+struct VdiHeader {
+    /// Where the block map begins.
+    blocks_offset: u64,
+    /// Where the first block's data begins.
+    data_offset: u64,
+    /// How large the virtual disk is.
+    disk_size: u64,
+    /// How much disk one block holds.
+    block_size: u32,
+    /// Padding written before each block's data, normally none.
+    block_extra: u32,
+    /// How many entries the block map has.
+    blocks: u32,
+}
+
+/// VDI disk image format implementation, read-only.
+#[derive(Debug)]
+pub struct Vdi<S: Storage + 'static> {
+    /// The image file.
+    inner: S,
+
+    /// The header, as read.
+    header: VdiHeader,
+
+    /// The block map, read once when the image is opened.
+    block_map: Vec<u32>,
+}
+
+/// Read a little-endian `u32` at `offset` in `buf`.
+fn le32(buf: &[u8], offset: usize) -> u32 {
+    u32::from_le_bytes(buf[offset..offset + 4].try_into().unwrap())
+}
+
+/// Read a little-endian `u64` at `offset` in `buf`.
+fn le64(buf: &[u8], offset: usize) -> u64 {
+    u64::from_le_bytes(buf[offset..offset + 8].try_into().unwrap())
+}
+
+impl<S: Storage + 'static> Vdi<S> {
+    /// Create a new [`FormatDriverBuilder`] instance for the given image.
+    pub fn builder(image: S) -> VdiOpenBuilder<S> {
+        VdiOpenBuilder::new(image)
+    }
+
+    /// Create a new [`FormatDriverBuilder`] instance for an image under the given path.
+    pub fn builder_path<P: AsRef<Path>>(image_path: P) -> VdiOpenBuilder<S> {
+        VdiOpenBuilder::new_path(image_path)
+    }
+
+    /// Read the header, check it over, and read the block map.
+    async fn do_open(inner: S) -> io::Result<Self> {
+        let file_size = inner.size()?;
+        if file_size < HEADER_READ as u64 {
+            return Err(invalid_data("VDI image too short to hold a header"));
+        }
+
+        let mut buf = IoBuffer::new(HEADER_READ, inner.mem_align())?;
+        inner.read(buf.as_mut(), 0).await?;
+        let buf = buf.as_ref().into_slice();
+
+        if le32(buf, SIGNATURE_OFFSET as usize) != VDI_SIGNATURE {
+            return Err(invalid_data("Not a VDI image"));
+        }
+        // Only version 1 was released. Version 0 laid the header out
+        // differently and is no longer written.
+        let version = le32(buf, 0x44);
+        if version >> 16 != 1 {
+            return Err(invalid_data(format!(
+                "Unsupported VDI version {}.{}",
+                version >> 16,
+                version & 0xffff
+            )));
+        }
+        // 1 is dynamic and 2 is fixed. Both are read the same way, a fixed
+        // image being one whose block map is already filled in.
+        let image_type = le32(buf, 0x4c);
+        if image_type != 1 && image_type != 2 {
+            return Err(io::Error::new(
+                io::ErrorKind::Unsupported,
+                format!("Unsupported VDI image type {image_type}"),
+            ));
+        }
+
+        let header = VdiHeader {
+            blocks_offset: le32(buf, 0x154) as u64,
+            data_offset: le32(buf, 0x158) as u64,
+            disk_size: le64(buf, 0x170),
+            block_size: le32(buf, 0x178),
+            block_extra: le32(buf, 0x17c),
+            blocks: le32(buf, 0x180),
+        };
+
+        // Each of the following values can direct this driver to read the
+        // wrong part of the file, so all are validated before any are used.
+        if header.block_size == 0 || !header.block_size.is_power_of_two() {
+            return Err(invalid_data(format!(
+                "VDI block size {} is not a power of two",
+                header.block_size
+            )));
+        }
+        if header.blocks > MAX_BLOCKS {
+            return Err(invalid_data(format!(
+                "VDI block map has {} entries, which is more than this reads",
+                header.blocks
+            )));
+        }
+        let mapped = (header.blocks as u64)
+            .checked_mul(header.block_size as u64)
+            .ok_or_else(|| invalid_data("VDI block map covers more than any disk could hold"))?;
+        if header.disk_size > mapped {
+            return Err(invalid_data(format!(
+                "VDI says it holds {} bytes but its block map covers only {mapped}",
+                header.disk_size
+            )));
+        }
+        if header.blocks_offset < SIGNATURE_OFFSET || header.data_offset < header.blocks_offset {
+            return Err(invalid_data("VDI header offsets overlap"));
+        }
+
+        let map_bytes = (header.blocks as usize)
+            .checked_mul(4)
+            .ok_or_else(|| invalid_data("VDI block map too large"))?;
+        let mut block_map = vec![0u32; header.blocks as usize];
+        if map_bytes > 0 {
+            if header
+                .blocks_offset
+                .checked_add(map_bytes as u64)
+                .is_none_or(|end| end > file_size)
+            {
+                return Err(invalid_data("VDI block map runs past the end of the file"));
+            }
+            let mut map = IoBuffer::new(map_bytes, inner.mem_align())?;
+            inner.read(map.as_mut(), header.blocks_offset).await?;
+            let map = map.as_ref().into_slice();
+            for (i, entry) in block_map.iter_mut().enumerate() {
+                *entry = le32(map, i * 4);
+            }
+        }
+
+        // A block index past the end of the file would be served as disk
+        // contents, so the map is validated here rather than on every read.
+        let stride = (header.block_size as u64) + (header.block_extra as u64);
+        for &entry in &block_map {
+            if entry == BLOCK_FREE || entry == BLOCK_ZERO {
+                continue;
+            }
+            let start = (entry as u64)
+                .checked_mul(stride)
+                .and_then(|o| o.checked_add(header.data_offset))
+                .and_then(|o| o.checked_add(header.block_extra as u64));
+            match start {
+                Some(start) if start + (header.block_size as u64) <= file_size => (),
+                _ => {
+                    return Err(invalid_data(
+                        "VDI block map points outside the image file",
+                    ))
+                }
+            }
+        }
+
+        Ok(Vdi {
+            inner,
+            header,
+            block_map,
+        })
+    }
+
+    /// Open a VDI image, read-only.
+    pub async fn open_image(inner: S, writable: bool) -> io::Result<Self> {
+        if writable {
+            return Err(io::Error::new(
+                io::ErrorKind::Unsupported,
+                "No VDI write support",
+            ));
+        }
+        Self::do_open(inner).await
+    }
+
+    /// Synchronous wrapper around [`Vdi::open_image()`].
+    #[cfg(feature = "sync-wrappers")]
+    pub fn open_image_sync(inner: S, writable: bool) -> io::Result<Self> {
+        tokio::runtime::Builder::new_current_thread()
+            .build()?
+            .block_on(Self::open_image(inner, writable))
+    }
+}
+
+impl<S: Storage + 'static> Display for Vdi<S> {
+    fn fmt(&self, f: &mut Formatter<'_>) -> fmt::Result {
+        write!(f, "vdi[{}]", self.inner)
+    }
+}
+
+#[async_trait(?Send)]
+impl<S: Storage + 'static> FormatDriverInstance for Vdi<S> {
+    type Storage = S;
+
+    fn format(&self) -> Format {
+        Format::Vdi
+    }
+
+    async unsafe fn probe(storage: &S) -> io::Result<bool>
+    where
+        Self: Sized,
+    {
+        if storage.size()? < HEADER_READ as u64 {
+            return Ok(false);
+        }
+        let mut buf = IoBuffer::new(HEADER_READ, storage.mem_align())?;
+        storage.read(buf.as_mut(), 0).await?;
+        let buf = buf.as_ref().into_slice();
+        Ok(le32(buf, SIGNATURE_OFFSET as usize) == VDI_SIGNATURE)
+    }
+
+    fn size(&self) -> u64 {
+        self.header.disk_size
+    }
+
+    fn collect_storage_dependencies(&self) -> Vec<&S> {
+        vec![&self.inner]
+    }
+
+    fn writable(&self) -> bool {
+        false
+    }
+
+    async fn get_mapping<'a>(
+        &'a self,
+        offset: u64,
+        max_length: u64,
+    ) -> io::Result<(ShallowMapping<'a, S>, u64)> {
+        let remaining = match self.size().checked_sub(offset) {
+            None | Some(0) => return Ok((ShallowMapping::Eof {}, 0)),
+            Some(remaining) => remaining,
+        };
+
+        let block_size = self.header.block_size as u64;
+        let index = (offset / block_size) as usize;
+        let in_block = offset % block_size;
+        // Never longer than the remainder of this block. The next block may
+        // lie elsewhere in the file, or nowhere at all.
+        let length = cmp::min(cmp::min(max_length, remaining), block_size - in_block);
+
+        let Some(&entry) = self.block_map.get(index) else {
+            return Ok((ShallowMapping::Eof {}, 0));
+        };
+        if entry == BLOCK_FREE || entry == BLOCK_ZERO {
+            return Ok((
+                ShallowMapping::Zero {
+                    explicit: entry == BLOCK_ZERO,
+                },
+                length,
+            ));
+        }
+
+        // Checked when the map was read, so this cannot overflow.
+        let stride = block_size + (self.header.block_extra as u64);
+        let start = self.header.data_offset
+            + (entry as u64) * stride
+            + (self.header.block_extra as u64);
+
+        Ok((
+            ShallowMapping::Raw {
+                storage: &self.inner,
+                offset: start + in_block,
+                writable: false,
+            },
+            length,
+        ))
+    }
+
+    async fn ensure_data_mapping<'a>(
+        &'a self,
+        _offset: u64,
+        _length: u64,
+        _overwrite: bool,
+    ) -> io::Result<(&'a S, u64, u64)> {
+        Err(io::Error::other("Image is read-only"))
+    }
+
+    async fn flush(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    async fn sync(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    async unsafe fn invalidate_cache(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    async fn resize_grow(&self, _new_size: u64, _prealloc_mode: PreallocateMode) -> io::Result<()> {
+        Err(io::Error::other("Image is read-only"))
+    }
+
+    async fn resize_shrink(&mut self, _new_size: u64) -> io::Result<()> {
+        Err(io::Error::other("Image is read-only"))
+    }
+}
+
+/// Options builder for opening a VDI image.
+pub struct VdiOpenBuilder<S: Storage + 'static>(FormatDriverBuilderBase<S>);
+
+impl<S: Storage + 'static> FormatDriverBuilder<S> for VdiOpenBuilder<S> {
+    type Format = Vdi<S>;
+    const FORMAT: Format = Format::Vdi;
+
+    fn new(image: S) -> Self {
+        VdiOpenBuilder(FormatDriverBuilderBase::new(image))
+    }
+
+    fn new_path<P: AsRef<Path>>(image_path: P) -> Self {
+        VdiOpenBuilder(FormatDriverBuilderBase::new_path(image_path))
+    }
+
+    fn write(mut self, writable: bool) -> Self {
+        self.0.set_write(writable);
+        self
+    }
+
+    fn storage_open_options(mut self, options: StorageOpenOptions) -> Self {
+        self.0.set_storage_open_options(options);
+        self
+    }
+
+    async fn open<G: ImplicitOpenGate<S>>(self, mut gate: G) -> io::Result<Self::Format> {
+        if self.0.get_writable() {
+            return Err(io::Error::new(
+                io::ErrorKind::Unsupported,
+                "No VDI write support",
+            ));
+        }
+        let file = self.0.open_image(&mut gate).await?;
+        Vdi::open_image(file, false).await
+    }
+
+    fn get_image_path(&self) -> Option<PathBuf> {
+        self.0.get_image_path()
+    }
+
+    fn get_writable(&self) -> bool {
+        self.0.get_writable()
+    }
+
+    fn get_storage_open_options(&self) -> Option<&StorageOpenOptions> {
+        self.0.get_storage_opts()
+    }
+}
diff -ruN -x target -x Cargo.lock a/src/vhd/mod.rs b/src/vhd/mod.rs
--- a/src/vhd/mod.rs	1970-01-01 03:00:00
+++ b/src/vhd/mod.rs	2026-08-22 14:50:51
@@ -0,0 +1,452 @@
+// SPDX-FileCopyrightText: 2026 Clement Rahula <lukotta@rahula.dev>
+// SPDX-License-Identifier: MIT
+//
+// Contributed to imago and licensed under that crate's MIT terms. The
+// GPL-3.0-or-later terms covering the Lukotta distribution, which carries this
+// file as a patch, do not apply to it.
+
+//! VHD implementation.
+//!
+//! Microsoft's first format, read-only, in both forms that hold their own
+//! data:
+//!
+//! - fixed, which is the raw disk followed by a 512-byte footer, and
+//! - dynamic, which stores the disk in blocks listed by an allocation table,
+//!   each preceded by a bitmap sector.
+//!
+//! The third form, differencing, holds only the changes from a parent disk that
+//! it names, and is refused: this driver never opens a second file.
+//!
+//! VHDX shares the name and none of the layout, and is a separate format.
+
+use crate::format::builder::{FormatDriverBuilder, FormatDriverBuilderBase};
+use crate::format::drivers::FormatDriverInstance;
+use crate::format::gate::ImplicitOpenGate;
+use crate::format::{Format, PreallocateMode};
+use crate::io_buffers::IoBuffer;
+use crate::misc_helpers::invalid_data;
+use crate::storage::ext::StorageExt;
+use crate::{ShallowMapping, Storage, StorageOpenOptions};
+use async_trait::async_trait;
+use std::fmt::{self, Display, Formatter};
+use std::path::{Path, PathBuf};
+use std::{cmp, io};
+
+/// The footer's first eight bytes.
+const FOOTER_COOKIE: &[u8; 8] = b"conectix";
+/// The dynamic header's first eight bytes.
+const DYNAMIC_COOKIE: &[u8; 8] = b"cxsparse";
+/// How long the footer is.
+const FOOTER_LENGTH: u64 = 512;
+/// How long the dynamic header is.
+const DYNAMIC_LENGTH: usize = 1024;
+/// The sector size the format is defined in.
+const SECTOR: u64 = 512;
+
+/// The disk is the raw data with the footer after it.
+const TYPE_FIXED: u32 = 2;
+/// The disk is stored in blocks listed by an allocation table.
+const TYPE_DYNAMIC: u32 = 3;
+/// The image holds only the changes from a parent disk that it names.
+const TYPE_DIFFERENCING: u32 = 4;
+
+/// A block that was never written, and reads as zeroes.
+const BAT_UNALLOCATED: u32 = 0xffff_ffff;
+
+/// An allocation table larger than this exceeds any real disk, and reading it
+/// is the only unbounded allocation this driver performs.
+const MAX_BAT_ENTRIES: u32 = 100_000_000;
+
+/// How the image holds its data.
+#[derive(Debug)]
+enum VhdLayout {
+    /// The raw disk, with the footer past the end of it.
+    Fixed,
+    /// Blocks listed by an allocation table.
+    Dynamic {
+        /// How much disk one block holds.
+        block_size: u64,
+        /// How much sits before each block's data: the bitmap, rounded up to a
+        /// whole number of sectors.
+        bitmap_size: u64,
+        /// Where each block's data begins, or `BAT_UNALLOCATED`.
+        bat: Vec<u32>,
+    },
+}
+
+/// VHD disk image format implementation, read-only.
+#[derive(Debug)]
+pub struct Vhd<S: Storage + 'static> {
+    /// The image file.
+    inner: S,
+
+    /// How large the virtual disk is.
+    size: u64,
+
+    /// How the image holds its data.
+    layout: VhdLayout,
+}
+
+/// Read a big-endian `u32` at `offset` in `buf`.
+fn be32(buf: &[u8], offset: usize) -> u32 {
+    u32::from_be_bytes(buf[offset..offset + 4].try_into().unwrap())
+}
+
+/// Read a big-endian `u64` at `offset` in `buf`.
+fn be64(buf: &[u8], offset: usize) -> u64 {
+    u64::from_be_bytes(buf[offset..offset + 8].try_into().unwrap())
+}
+
+impl<S: Storage + 'static> Vhd<S> {
+    /// Create a new [`FormatDriverBuilder`] instance for the given image.
+    pub fn builder(image: S) -> VhdOpenBuilder<S> {
+        VhdOpenBuilder::new(image)
+    }
+
+    /// Create a new [`FormatDriverBuilder`] instance for an image under the given path.
+    pub fn builder_path<P: AsRef<Path>>(image_path: P) -> VhdOpenBuilder<S> {
+        VhdOpenBuilder::new_path(image_path)
+    }
+
+    /// Read the footer, and whatever else the kind of image needs.
+    async fn do_open(inner: S) -> io::Result<Self> {
+        let file_size = inner.size()?;
+        if file_size < FOOTER_LENGTH {
+            return Err(invalid_data("VHD image too short to hold a footer"));
+        }
+
+        let mut buf = IoBuffer::new(FOOTER_LENGTH as usize, inner.mem_align())?;
+        inner.read(buf.as_mut(), file_size - FOOTER_LENGTH).await?;
+        let footer = buf.as_ref().into_slice();
+
+        if &footer[..8] != FOOTER_COOKIE {
+            return Err(invalid_data("Not a VHD image"));
+        }
+        let disk_type = be32(footer, 60);
+        let size = be64(footer, 48);
+        if size == 0 {
+            return Err(invalid_data("VHD says it holds nothing"));
+        }
+
+        let layout = match disk_type {
+            TYPE_FIXED => {
+                if size > file_size - FOOTER_LENGTH {
+                    return Err(invalid_data(
+                        "VHD says it holds more than the file does",
+                    ));
+                }
+                VhdLayout::Fixed
+            }
+            TYPE_DYNAMIC => {
+                Self::read_dynamic(&inner, footer, file_size, size).await?
+            }
+            TYPE_DIFFERENCING => {
+                return Err(io::Error::new(
+                    io::ErrorKind::Unsupported,
+                    "VHD holds only the changes from another disk, which it names",
+                ))
+            }
+            other => {
+                return Err(io::Error::new(
+                    io::ErrorKind::Unsupported,
+                    format!("Unsupported VHD disk type {other}"),
+                ))
+            }
+        };
+
+        Ok(Vhd {
+            inner,
+            size,
+            layout,
+        })
+    }
+
+    /// Read the dynamic disk header and the allocation table after it.
+    async fn read_dynamic(
+        inner: &S,
+        footer: &[u8],
+        file_size: u64,
+        size: u64,
+    ) -> io::Result<VhdLayout> {
+        let header_at = be64(footer, 16);
+        if header_at
+            .checked_add(DYNAMIC_LENGTH as u64)
+            .is_none_or(|end| end > file_size)
+        {
+            return Err(invalid_data("VHD header lies outside the file"));
+        }
+
+        let mut buf = IoBuffer::new(DYNAMIC_LENGTH, inner.mem_align())?;
+        inner.read(buf.as_mut(), header_at).await?;
+        let header = buf.as_ref().into_slice();
+
+        if &header[..8] != DYNAMIC_COOKIE {
+            return Err(invalid_data("VHD header is not where the footer says"));
+        }
+        let table_at = be64(header, 16);
+        let entries = be32(header, 28);
+        let block_size = be32(header, 32) as u64;
+
+        if block_size < SECTOR || !block_size.is_power_of_two() {
+            return Err(invalid_data(format!(
+                "VHD block size {block_size} is not a power of two"
+            )));
+        }
+        if entries > MAX_BAT_ENTRIES {
+            return Err(invalid_data(format!(
+                "VHD allocation table has {entries} entries, which is more than this reads"
+            )));
+        }
+        let covered = (entries as u64)
+            .checked_mul(block_size)
+            .ok_or_else(|| invalid_data("VHD allocation table covers more than any disk could"))?;
+        if size > covered {
+            return Err(invalid_data(format!(
+                "VHD says it holds {size} bytes but its allocation table covers only {covered}"
+            )));
+        }
+
+        let table_bytes = (entries as usize)
+            .checked_mul(4)
+            .ok_or_else(|| invalid_data("VHD allocation table too large"))?;
+        if table_at
+            .checked_add(table_bytes as u64)
+            .is_none_or(|end| end > file_size)
+        {
+            return Err(invalid_data(
+                "VHD allocation table runs past the end of the file",
+            ));
+        }
+
+        // The bitmap says which sectors of a block have been written. It is
+        // rounded up to a whole sector, and sits immediately before the data.
+        let bitmap_size = block_size.div_ceil(SECTOR).div_ceil(8).next_multiple_of(SECTOR);
+
+        let mut bat = vec![0u32; entries as usize];
+        if table_bytes > 0 {
+            let mut table = IoBuffer::new(table_bytes, inner.mem_align())?;
+            inner.read(table.as_mut(), table_at).await?;
+            let table = table.as_ref().into_slice();
+            for (i, entry) in bat.iter_mut().enumerate() {
+                *entry = be32(table, i * 4);
+            }
+        }
+
+        // A block past the end of the file would be served as disk contents,
+        // so the table is validated here rather than on every read.
+        for &entry in &bat {
+            if entry == BAT_UNALLOCATED {
+                continue;
+            }
+            let start = (entry as u64)
+                .checked_mul(SECTOR)
+                .and_then(|o| o.checked_add(bitmap_size));
+            match start {
+                Some(start) if start.checked_add(block_size).is_some_and(|e| e <= file_size) => (),
+                _ => {
+                    return Err(invalid_data(
+                        "VHD allocation table points outside the image file",
+                    ))
+                }
+            }
+        }
+
+        Ok(VhdLayout::Dynamic {
+            block_size,
+            bitmap_size,
+            bat,
+        })
+    }
+
+    /// Open a VHD image, read-only.
+    pub async fn open_image(inner: S, writable: bool) -> io::Result<Self> {
+        if writable {
+            return Err(io::Error::new(
+                io::ErrorKind::Unsupported,
+                "No VHD write support",
+            ));
+        }
+        Self::do_open(inner).await
+    }
+
+    /// Synchronous wrapper around [`Vhd::open_image()`].
+    #[cfg(feature = "sync-wrappers")]
+    pub fn open_image_sync(inner: S, writable: bool) -> io::Result<Self> {
+        tokio::runtime::Builder::new_current_thread()
+            .build()?
+            .block_on(Self::open_image(inner, writable))
+    }
+}
+
+impl<S: Storage + 'static> Display for Vhd<S> {
+    fn fmt(&self, f: &mut Formatter<'_>) -> fmt::Result {
+        write!(f, "vhd[{}]", self.inner)
+    }
+}
+
+#[async_trait(?Send)]
+impl<S: Storage + 'static> FormatDriverInstance for Vhd<S> {
+    type Storage = S;
+
+    fn format(&self) -> Format {
+        Format::Vhd
+    }
+
+    async unsafe fn probe(storage: &S) -> io::Result<bool>
+    where
+        Self: Sized,
+    {
+        let file_size = storage.size()?;
+        if file_size < FOOTER_LENGTH {
+            return Ok(false);
+        }
+        let mut buf = IoBuffer::new(FOOTER_LENGTH as usize, storage.mem_align())?;
+        storage.read(buf.as_mut(), file_size - FOOTER_LENGTH).await?;
+        Ok(&buf.as_ref().into_slice()[..8] == FOOTER_COOKIE)
+    }
+
+    fn size(&self) -> u64 {
+        self.size
+    }
+
+    fn collect_storage_dependencies(&self) -> Vec<&S> {
+        vec![&self.inner]
+    }
+
+    fn writable(&self) -> bool {
+        false
+    }
+
+    async fn get_mapping<'a>(
+        &'a self,
+        offset: u64,
+        max_length: u64,
+    ) -> io::Result<(ShallowMapping<'a, S>, u64)> {
+        let remaining = match self.size.checked_sub(offset) {
+            None | Some(0) => return Ok((ShallowMapping::Eof {}, 0)),
+            Some(remaining) => remaining,
+        };
+        let max_length = cmp::min(max_length, remaining);
+
+        match &self.layout {
+            // The data is the file from its start, the footer lying past the
+            // end of the disk and so never within a mapping.
+            VhdLayout::Fixed => Ok((
+                ShallowMapping::Raw {
+                    storage: &self.inner,
+                    offset,
+                    writable: false,
+                },
+                max_length,
+            )),
+
+            VhdLayout::Dynamic {
+                block_size,
+                bitmap_size,
+                bat,
+            } => {
+                let index = (offset / block_size) as usize;
+                let in_block = offset % block_size;
+                // Never longer than the remainder of this block. The next
+                // block may lie elsewhere in the file, or nowhere at all.
+                let length = cmp::min(max_length, block_size - in_block);
+
+                let Some(&entry) = bat.get(index) else {
+                    return Ok((ShallowMapping::Eof {}, 0));
+                };
+                if entry == BAT_UNALLOCATED {
+                    return Ok((ShallowMapping::Zero { explicit: false }, length));
+                }
+
+                // Checked when the table was read, so this cannot overflow.
+                let start = (entry as u64) * SECTOR + bitmap_size;
+                Ok((
+                    ShallowMapping::Raw {
+                        storage: &self.inner,
+                        offset: start + in_block,
+                        writable: false,
+                    },
+                    length,
+                ))
+            }
+        }
+    }
+
+    async fn ensure_data_mapping<'a>(
+        &'a self,
+        _offset: u64,
+        _length: u64,
+        _overwrite: bool,
+    ) -> io::Result<(&'a S, u64, u64)> {
+        Err(io::Error::other("Image is read-only"))
+    }
+
+    async fn flush(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    async fn sync(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    async unsafe fn invalidate_cache(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    async fn resize_grow(&self, _new_size: u64, _prealloc_mode: PreallocateMode) -> io::Result<()> {
+        Err(io::Error::other("Image is read-only"))
+    }
+
+    async fn resize_shrink(&mut self, _new_size: u64) -> io::Result<()> {
+        Err(io::Error::other("Image is read-only"))
+    }
+}
+
+/// Options builder for opening a VHD image.
+pub struct VhdOpenBuilder<S: Storage + 'static>(FormatDriverBuilderBase<S>);
+
+impl<S: Storage + 'static> FormatDriverBuilder<S> for VhdOpenBuilder<S> {
+    type Format = Vhd<S>;
+    const FORMAT: Format = Format::Vhd;
+
+    fn new(image: S) -> Self {
+        VhdOpenBuilder(FormatDriverBuilderBase::new(image))
+    }
+
+    fn new_path<P: AsRef<Path>>(image_path: P) -> Self {
+        VhdOpenBuilder(FormatDriverBuilderBase::new_path(image_path))
+    }
+
+    fn write(mut self, writable: bool) -> Self {
+        self.0.set_write(writable);
+        self
+    }
+
+    fn storage_open_options(mut self, options: StorageOpenOptions) -> Self {
+        self.0.set_storage_open_options(options);
+        self
+    }
+
+    async fn open<G: ImplicitOpenGate<S>>(self, mut gate: G) -> io::Result<Self::Format> {
+        if self.0.get_writable() {
+            return Err(io::Error::new(
+                io::ErrorKind::Unsupported,
+                "No VHD write support",
+            ));
+        }
+        let file = self.0.open_image(&mut gate).await?;
+        Vhd::open_image(file, false).await
+    }
+
+    fn get_image_path(&self) -> Option<PathBuf> {
+        self.0.get_image_path()
+    }
+
+    fn get_writable(&self) -> bool {
+        self.0.get_writable()
+    }
+
+    fn get_storage_open_options(&self) -> Option<&StorageOpenOptions> {
+        self.0.get_storage_opts()
+    }
+}
diff -ruN -x target -x Cargo.lock a/src/vhdx/mod.rs b/src/vhdx/mod.rs
--- a/src/vhdx/mod.rs	1970-01-01 03:00:00
+++ b/src/vhdx/mod.rs	2026-08-22 14:50:51
@@ -0,0 +1,585 @@
+// SPDX-FileCopyrightText: 2026 Clement Rahula <lukotta@rahula.dev>
+// SPDX-License-Identifier: MIT
+//
+// Contributed to imago and licensed under that crate's MIT terms. The
+// GPL-3.0-or-later terms covering the Lukotta distribution, which carries this
+// file as a patch, do not apply to it.
+
+//! VHDX implementation.
+//!
+//! Microsoft's second format, read-only. Several structures must be located
+//! before the disk can be read:
+//!
+//! - two headers, the live one being whichever carries the higher sequence
+//!   number together with a sound checksum;
+//! - a region table naming where the allocation table and the metadata are;
+//! - a metadata region giving the block size, the disk size and the sector
+//!   size;
+//! - an allocation table with one entry per block, interleaved with entries
+//!   describing sector bitmaps, which only a differencing image uses.
+//!
+//! Two images are refused rather than read. One that names a parent is a
+//! differencing image, and nothing here opens a second file. One whose log is
+//! not empty was not closed cleanly, so its most recent metadata is in that log
+//! rather than in the file itself. Replaying the log requires writing, which a
+//! read-only driver must not do, and disregarding it returns data older than
+//! the disk last held.
+
+use crate::format::builder::{FormatDriverBuilder, FormatDriverBuilderBase};
+use crate::format::drivers::FormatDriverInstance;
+use crate::format::gate::ImplicitOpenGate;
+use crate::format::{Format, PreallocateMode};
+use crate::io_buffers::IoBuffer;
+use crate::misc_helpers::invalid_data;
+use crate::storage::ext::StorageExt;
+use crate::{ShallowMapping, Storage, StorageOpenOptions};
+use async_trait::async_trait;
+use std::fmt::{self, Display, Formatter};
+use std::path::{Path, PathBuf};
+use std::{cmp, io};
+
+/// What the file begins with.
+const FILE_SIGNATURE: &[u8; 8] = b"vhdxfile";
+/// Where the two headers sit, one after the other.
+const HEADER_OFFSETS: [u64; 2] = [0x1_0000, 0x2_0000];
+/// What each header begins with.
+const HEADER_SIGNATURE: &[u8; 4] = b"head";
+/// How long a header is, checksum included.
+const HEADER_LENGTH: usize = 4096;
+/// Where the two region tables sit.
+const REGION_OFFSETS: [u64; 2] = [0x3_0000, 0x4_0000];
+/// What each region table begins with.
+const REGION_SIGNATURE: &[u8; 4] = b"regi";
+/// How long a region table is.
+const REGION_LENGTH: usize = 65536;
+/// What the metadata region begins with.
+const METADATA_SIGNATURE: &[u8; 8] = b"metadata";
+
+/// The region holding the block allocation table.
+const GUID_BAT: [u8; 16] = [
+    0x66, 0x77, 0xC2, 0x2D, 0x23, 0xF6, 0x00, 0x42, 0x9D, 0x64, 0x11, 0x5E, 0x9B, 0xFD, 0x4A, 0x08,
+];
+/// The region holding the metadata table.
+const GUID_METADATA: [u8; 16] = [
+    0x06, 0xA2, 0x7C, 0x8B, 0x90, 0x47, 0x9A, 0x4B, 0xB8, 0xFE, 0x57, 0x5F, 0x05, 0x0F, 0x88, 0x6E,
+];
+/// Block size and whether the image names a parent.
+const GUID_FILE_PARAMETERS: [u8; 16] = [
+    0x37, 0x67, 0xA1, 0xCA, 0x36, 0xFA, 0x43, 0x4D, 0xB3, 0xB6, 0x33, 0xF0, 0xAA, 0x44, 0xE7, 0x6B,
+];
+/// How large the virtual disk is.
+const GUID_VIRTUAL_DISK_SIZE: [u8; 16] = [
+    0x24, 0x42, 0xA5, 0x2F, 0x1B, 0xCD, 0x76, 0x48, 0xB2, 0x11, 0x5D, 0xBE, 0xD8, 0x3B, 0xF4, 0xB8,
+];
+/// The sector size the disk is addressed in.
+const GUID_LOGICAL_SECTOR_SIZE: [u8; 16] = [
+    0x1D, 0xBF, 0x41, 0x81, 0x6F, 0xA9, 0x09, 0x47, 0xBA, 0x47, 0xF2, 0x33, 0xA8, 0xFA, 0xAB, 0x5F,
+];
+
+/// The block was never written, and reads as zeroes.
+const BLOCK_NOT_PRESENT: u64 = 0;
+/// The block holds nothing, and reads as zeroes.
+const BLOCK_UNDEFINED: u64 = 1;
+/// The block was written as zeroes.
+const BLOCK_ZERO: u64 = 2;
+/// The block was discarded, and reads as zeroes.
+const BLOCK_UNMAPPED: u64 = 3;
+/// The whole block is in the file.
+const BLOCK_FULLY_PRESENT: u64 = 6;
+/// Part of the block is in the file and the rest is in a parent, which only a
+/// differencing image has.
+const BLOCK_PARTIALLY_PRESENT: u64 = 7;
+
+/// An allocation table larger than this exceeds any real disk, and reading it is
+/// the only unbounded allocation this driver performs.
+const MAX_BAT_ENTRIES: u64 = 1 << 24;
+
+/// CRC-32C, the checksum VHDX uses for its headers and tables.
+///
+/// Computed a bit at a time, which costs little: it runs over a few tens of
+/// kilobytes, once, when the image is opened.
+fn crc32c(data: &[u8]) -> u32 {
+    let mut crc = 0xFFFF_FFFFu32;
+    for byte in data {
+        crc ^= *byte as u32;
+        for _ in 0..8 {
+            let bit = crc & 1;
+            crc >>= 1;
+            if bit != 0 {
+                crc ^= 0x82F6_3B78; // the Castagnoli polynomial, reversed
+            }
+        }
+    }
+    !crc
+}
+
+/// Whether `block` checksums to the value stored at `at` within it.
+fn checksum_holds(block: &[u8], at: usize) -> bool {
+    let mut copy = block.to_vec();
+    let stored = u32::from_le_bytes(copy[at..at + 4].try_into().unwrap());
+    copy[at..at + 4].fill(0);
+    crc32c(&copy) == stored
+}
+
+/// Read a little-endian `u32` at `offset` in `buf`.
+fn le32(buf: &[u8], offset: usize) -> u32 {
+    u32::from_le_bytes(buf[offset..offset + 4].try_into().unwrap())
+}
+
+/// Read a little-endian `u64` at `offset` in `buf`.
+fn le64(buf: &[u8], offset: usize) -> u64 {
+    u64::from_le_bytes(buf[offset..offset + 8].try_into().unwrap())
+}
+
+/// Where a region of the file begins, and its length.
+#[derive(Debug, Clone, Copy)]
+struct Region {
+    /// Where it begins.
+    offset: u64,
+    /// How long it is.
+    length: u64,
+}
+
+/// VHDX disk image format implementation, read-only.
+#[derive(Debug)]
+pub struct Vhdx<S: Storage + 'static> {
+    /// The image file.
+    inner: S,
+
+    /// How large the virtual disk is.
+    size: u64,
+
+    /// How much disk one block holds.
+    block_size: u64,
+
+    /// How many payload blocks share one sector-bitmap entry in the table.
+    chunk_ratio: u64,
+
+    /// The allocation table, read once when the image is opened.
+    bat: Vec<u64>,
+}
+
+impl<S: Storage + 'static> Vhdx<S> {
+    /// Create a new [`FormatDriverBuilder`] instance for the given image.
+    pub fn builder(image: S) -> VhdxOpenBuilder<S> {
+        VhdxOpenBuilder::new(image)
+    }
+
+    /// Create a new [`FormatDriverBuilder`] instance for an image under the given path.
+    pub fn builder_path<P: AsRef<Path>>(image_path: P) -> VhdxOpenBuilder<S> {
+        VhdxOpenBuilder::new_path(image_path)
+    }
+
+    /// Read one block of the file.
+    async fn read_at(inner: &S, offset: u64, length: usize) -> io::Result<Vec<u8>> {
+        let file_size = inner.size()?;
+        if offset
+            .checked_add(length as u64)
+            .is_none_or(|end| end > file_size)
+        {
+            return Err(invalid_data("VHDX structure lies outside the file"));
+        }
+        let mut buf = IoBuffer::new(length, inner.mem_align())?;
+        inner.read(buf.as_mut(), offset).await?;
+        Ok(buf.as_ref().into_slice().to_vec())
+    }
+
+    /// Find the live header: of those whose checksum holds, the one carrying the
+    /// higher sequence number.
+    async fn read_header(inner: &S) -> io::Result<()> {
+        let mut live: Option<(u64, Vec<u8>)> = None;
+        for at in HEADER_OFFSETS {
+            let Ok(block) = Self::read_at(inner, at, HEADER_LENGTH).await else {
+                continue;
+            };
+            if &block[..4] != HEADER_SIGNATURE || !checksum_holds(&block, 4) {
+                continue;
+            }
+            let sequence = le64(&block, 8);
+            if live.as_ref().is_none_or(|(seen, _)| sequence > *seen) {
+                live = Some((sequence, block));
+            }
+        }
+        let Some((_, header)) = live else {
+            return Err(invalid_data("VHDX has no sound header"));
+        };
+
+        // A log guid of zero means the log holds nothing. Anything else means
+        // the image was not closed cleanly and its newest state is in the log:
+        // replaying it is a write, and skipping it would serve stale data.
+        if header[48..64] != [0u8; 16] {
+            return Err(io::Error::new(
+                io::ErrorKind::Unsupported,
+                "VHDX was not closed cleanly and its log has yet to be replayed",
+            ));
+        }
+        Ok(())
+    }
+
+    /// Read the region table and return where the allocation table and the
+    /// metadata are.
+    async fn read_regions(inner: &S) -> io::Result<(Region, Region)> {
+        let mut sound: Option<Vec<u8>> = None;
+        for at in REGION_OFFSETS {
+            let Ok(block) = Self::read_at(inner, at, REGION_LENGTH).await else {
+                continue;
+            };
+            if &block[..4] == REGION_SIGNATURE && checksum_holds(&block, 4) {
+                sound = Some(block);
+                break;
+            }
+        }
+        let Some(table) = sound else {
+            return Err(invalid_data("VHDX has no sound region table"));
+        };
+
+        let count = le32(&table, 8) as usize;
+        if count > (REGION_LENGTH - 16) / 32 {
+            return Err(invalid_data("VHDX region table claims more entries than fit"));
+        }
+
+        let mut bat = None;
+        let mut metadata = None;
+        for i in 0..count {
+            let at = 16 + i * 32;
+            let guid: [u8; 16] = table[at..at + 16].try_into().unwrap();
+            let region = Region {
+                offset: le64(&table, at + 16),
+                length: le32(&table, at + 24) as u64,
+            };
+            let required = le32(&table, at + 28) & 1 == 1;
+            match guid {
+                GUID_BAT => bat = Some(region),
+                GUID_METADATA => metadata = Some(region),
+                // A region this does not know, which the image says must be
+                // understood to read it at all.
+                _ if required => {
+                    return Err(io::Error::new(
+                        io::ErrorKind::Unsupported,
+                        "VHDX holds a region this does not know and may not skip",
+                    ))
+                }
+                _ => (),
+            }
+        }
+
+        match (bat, metadata) {
+            (Some(bat), Some(metadata)) => Ok((bat, metadata)),
+            _ => Err(invalid_data("VHDX names no allocation table or no metadata")),
+        }
+    }
+
+    /// Read the metadata region: block size, disk size, sector size.
+    async fn read_metadata(inner: &S, region: Region) -> io::Result<(u64, u64, u64)> {
+        let length = cmp::min(region.length, 1 << 20) as usize;
+        let table = Self::read_at(inner, region.offset, length).await?;
+        if &table[..8] != METADATA_SIGNATURE {
+            return Err(invalid_data("VHDX metadata is not where the region says"));
+        }
+
+        let count = u16::from_le_bytes(table[10..12].try_into().unwrap()) as usize;
+        if 32 + count * 32 > length {
+            return Err(invalid_data("VHDX metadata claims more entries than fit"));
+        }
+
+        let mut block_size = None;
+        let mut disk_size = None;
+        let mut sector_size = None;
+        for i in 0..count {
+            let at = 32 + i * 32;
+            let guid: [u8; 16] = table[at..at + 16].try_into().unwrap();
+            let offset = le32(&table, at + 16) as usize;
+            let item_length = le32(&table, at + 20) as usize;
+            if offset.checked_add(item_length).is_none_or(|end| end > length) {
+                return Err(invalid_data("VHDX metadata item lies outside its region"));
+            }
+            match guid {
+                GUID_FILE_PARAMETERS if item_length >= 8 => {
+                    block_size = Some(le32(&table, offset) as u64);
+                    // Bit 1 says the image holds only what changed from a
+                    // parent disk, which it names elsewhere in this region.
+                    if le32(&table, offset + 4) & 2 != 0 {
+                        return Err(io::Error::new(
+                            io::ErrorKind::Unsupported,
+                            "VHDX holds only the changes from another disk, which it names",
+                        ));
+                    }
+                }
+                GUID_VIRTUAL_DISK_SIZE if item_length >= 8 => {
+                    disk_size = Some(le64(&table, offset));
+                }
+                GUID_LOGICAL_SECTOR_SIZE if item_length >= 4 => {
+                    sector_size = Some(le32(&table, offset) as u64);
+                }
+                _ => (),
+            }
+        }
+
+        match (block_size, disk_size, sector_size) {
+            (Some(block), Some(disk), Some(sector)) => Ok((block, disk, sector)),
+            _ => Err(invalid_data("VHDX does not say how large its blocks are")),
+        }
+    }
+
+    /// Read the header, the regions, the metadata and the allocation table.
+    async fn do_open(inner: S) -> io::Result<Self> {
+        let head = Self::read_at(&inner, 0, 8).await?;
+        if head != FILE_SIGNATURE {
+            return Err(invalid_data("Not a VHDX image"));
+        }
+
+        Self::read_header(&inner).await?;
+        let (bat_region, metadata_region) = Self::read_regions(&inner).await?;
+        let (block_size, size, sector_size) = Self::read_metadata(&inner, metadata_region).await?;
+
+        if block_size == 0 || !block_size.is_power_of_two() || block_size < 1 << 20 {
+            return Err(invalid_data(format!(
+                "VHDX block size {block_size} is not one this reads"
+            )));
+        }
+        if sector_size != 512 && sector_size != 4096 {
+            return Err(invalid_data(format!(
+                "VHDX sector size {sector_size} is not one this reads"
+            )));
+        }
+        if size == 0 {
+            return Err(invalid_data("VHDX says it holds nothing"));
+        }
+
+        // Every so many payload blocks the table holds one entry describing a
+        // sector bitmap instead, which only a differencing image uses. They are
+        // counted here so the payload ones can be found.
+        let chunk_ratio = ((1u64 << 23) * sector_size) / block_size;
+        if chunk_ratio == 0 {
+            return Err(invalid_data("VHDX block size does not fit its sector size"));
+        }
+        let blocks = size.div_ceil(block_size);
+        let entries = blocks + (blocks - 1) / chunk_ratio;
+        if entries > MAX_BAT_ENTRIES {
+            return Err(invalid_data(format!(
+                "VHDX allocation table has {entries} entries, which is more than this reads"
+            )));
+        }
+        if entries * 8 > bat_region.length {
+            return Err(invalid_data(
+                "VHDX allocation table is larger than the region holding it",
+            ));
+        }
+
+        let raw = Self::read_at(&inner, bat_region.offset, (entries * 8) as usize).await?;
+        let bat: Vec<u64> = (0..entries as usize).map(|i| le64(&raw, i * 8)).collect();
+
+        // A block pointing past the end of the file would be read as disk
+        // contents, so the table is checked here rather than per read.
+        let file_size = inner.size()?;
+        for entry in &bat {
+            if entry & 7 != BLOCK_FULLY_PRESENT {
+                continue;
+            }
+            let at = entry & !0xF_FFFF;
+            if at
+                .checked_add(block_size)
+                .is_none_or(|end| end > file_size)
+            {
+                return Err(invalid_data(
+                    "VHDX allocation table points outside the image file",
+                ));
+            }
+        }
+
+        Ok(Vhdx {
+            inner,
+            size,
+            block_size,
+            chunk_ratio,
+            bat,
+        })
+    }
+
+    /// Open a VHDX image, read-only.
+    pub async fn open_image(inner: S, writable: bool) -> io::Result<Self> {
+        if writable {
+            return Err(io::Error::new(
+                io::ErrorKind::Unsupported,
+                "No VHDX write support",
+            ));
+        }
+        Self::do_open(inner).await
+    }
+
+    /// Synchronous wrapper around [`Vhdx::open_image()`].
+    #[cfg(feature = "sync-wrappers")]
+    pub fn open_image_sync(inner: S, writable: bool) -> io::Result<Self> {
+        tokio::runtime::Builder::new_current_thread()
+            .build()?
+            .block_on(Self::open_image(inner, writable))
+    }
+}
+
+impl<S: Storage + 'static> Display for Vhdx<S> {
+    fn fmt(&self, f: &mut Formatter<'_>) -> fmt::Result {
+        write!(f, "vhdx[{}]", self.inner)
+    }
+}
+
+#[async_trait(?Send)]
+impl<S: Storage + 'static> FormatDriverInstance for Vhdx<S> {
+    type Storage = S;
+
+    fn format(&self) -> Format {
+        Format::Vhdx
+    }
+
+    async unsafe fn probe(storage: &S) -> io::Result<bool>
+    where
+        Self: Sized,
+    {
+        if storage.size()? < 8 {
+            return Ok(false);
+        }
+        Ok(Self::read_at(storage, 0, 8).await? == FILE_SIGNATURE)
+    }
+
+    fn size(&self) -> u64 {
+        self.size
+    }
+
+    fn collect_storage_dependencies(&self) -> Vec<&S> {
+        vec![&self.inner]
+    }
+
+    fn writable(&self) -> bool {
+        false
+    }
+
+    async fn get_mapping<'a>(
+        &'a self,
+        offset: u64,
+        max_length: u64,
+    ) -> io::Result<(ShallowMapping<'a, S>, u64)> {
+        let remaining = match self.size.checked_sub(offset) {
+            None | Some(0) => return Ok((ShallowMapping::Eof {}, 0)),
+            Some(remaining) => remaining,
+        };
+
+        let block = offset / self.block_size;
+        let in_block = offset % self.block_size;
+        // Never longer than the remainder of this block. The next block may
+        // lie elsewhere in the file, or nowhere at all.
+        let length = cmp::min(
+            cmp::min(max_length, remaining),
+            self.block_size - in_block,
+        );
+
+        // The table holds a sector-bitmap entry after every `chunk_ratio`
+        // payload entries, so the payload ones are not where the block number
+        // alone would put them.
+        let index = block + block / self.chunk_ratio;
+        let Some(&entry) = self.bat.get(index as usize) else {
+            return Ok((ShallowMapping::Eof {}, 0));
+        };
+
+        match entry & 7 {
+            BLOCK_FULLY_PRESENT => Ok((
+                ShallowMapping::Raw {
+                    storage: &self.inner,
+                    offset: (entry & !0xF_FFFF) + in_block,
+                    writable: false,
+                },
+                length,
+            )),
+            BLOCK_ZERO | BLOCK_UNMAPPED => {
+                Ok((ShallowMapping::Zero { explicit: true }, length))
+            }
+            BLOCK_NOT_PRESENT | BLOCK_UNDEFINED => {
+                Ok((ShallowMapping::Zero { explicit: false }, length))
+            }
+            // Only a differencing image has these, and such an image is refused
+            // when opened, so reaching this point means the image contradicts
+            // itself.
+            BLOCK_PARTIALLY_PRESENT => Err(io::Error::new(
+                io::ErrorKind::Unsupported,
+                "VHDX block is only partly present, which needs a parent disk",
+            )),
+            state => Err(invalid_data(format!("Unknown VHDX block state {state}"))),
+        }
+    }
+
+    async fn ensure_data_mapping<'a>(
+        &'a self,
+        _offset: u64,
+        _length: u64,
+        _overwrite: bool,
+    ) -> io::Result<(&'a S, u64, u64)> {
+        Err(io::Error::other("Image is read-only"))
+    }
+
+    async fn flush(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    async fn sync(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    async unsafe fn invalidate_cache(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    async fn resize_grow(&self, _new_size: u64, _prealloc_mode: PreallocateMode) -> io::Result<()> {
+        Err(io::Error::other("Image is read-only"))
+    }
+
+    async fn resize_shrink(&mut self, _new_size: u64) -> io::Result<()> {
+        Err(io::Error::other("Image is read-only"))
+    }
+}
