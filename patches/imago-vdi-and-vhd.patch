+
+#[async_trait(?Send)]
+impl<S: Storage + 'static> FormatDriverInstance for Vhd<S> {
+    type Storage = S;
+
+    fn format(&self) -> Format {
+        Format::Vhd
+    }
+
+    async unsafe fn probe(storage: &S) -> io::Result<bool>
+    where
+        Self: Sized,
+    {
+        let file_size = storage.size()?;
+        if file_size < FOOTER_LENGTH {
+            return Ok(false);
+        }
+        let mut buf = IoBuffer::new(FOOTER_LENGTH as usize, storage.mem_align())?;
+        storage.read(buf.as_mut(), file_size - FOOTER_LENGTH).await?;
+        Ok(&buf.as_ref().into_slice()[..8] == FOOTER_COOKIE)
+    }
+
+    fn size(&self) -> u64 {
+        self.size
+    }
+
+    fn collect_storage_dependencies(&self) -> Vec<&S> {
+        vec![&self.inner]
+    }
+
+    fn writable(&self) -> bool {
+        false
+    }
+
+    async fn get_mapping<'a>(
+        &'a self,
+        offset: u64,
+        max_length: u64,
+    ) -> io::Result<(ShallowMapping<'a, S>, u64)> {
+        let remaining = match self.size.checked_sub(offset) {
+            None | Some(0) => return Ok((ShallowMapping::Eof {}, 0)),
+            Some(remaining) => remaining,
+        };
+        let max_length = cmp::min(max_length, remaining);
+
+        match &self.layout {
+            // The data is the file, from the start, with the footer past the
+            // end of the disk and so never inside a mapping.
+            VhdLayout::Fixed => Ok((
+                ShallowMapping::Raw {
+                    storage: &self.inner,
+                    offset,
+                    writable: false,
+                },
+                max_length,
+            )),
+
+            VhdLayout::Dynamic {
+                block_size,
+                bitmap_size,
+                bat,
+            } => {
+                let index = (offset / block_size) as usize;
+                let in_block = offset % block_size;
+                // Never longer than what is left of this block: the next one
+                // may be elsewhere in the file, or nowhere at all.
+                let length = cmp::min(max_length, block_size - in_block);
+
+                let Some(&entry) = bat.get(index) else {
+                    return Ok((ShallowMapping::Eof {}, 0));
+                };
+                if entry == BAT_UNALLOCATED {
+                    return Ok((ShallowMapping::Zero { explicit: false }, length));
+                }
+
+                // Checked when the table was read, so this cannot overflow.
+                let start = (entry as u64) * SECTOR + bitmap_size;
+                Ok((
+                    ShallowMapping::Raw {
+                        storage: &self.inner,
+                        offset: start + in_block,
+                        writable: false,
+                    },
+                    length,
+                ))
+            }
+        }
+    }
+
+    async fn ensure_data_mapping<'a>(
+        &'a self,
+        _offset: u64,
+        _length: u64,
+        _overwrite: bool,
+    ) -> io::Result<(&'a S, u64, u64)> {
+        Err(io::Error::other("Image is read-only"))
+    }
+
+    async fn flush(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    async fn sync(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    async unsafe fn invalidate_cache(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    async fn resize_grow(&self, _new_size: u64, _prealloc_mode: PreallocateMode) -> io::Result<()> {
+        Err(io::Error::other("Image is read-only"))
+    }
+
+    async fn resize_shrink(&mut self, _new_size: u64) -> io::Result<()> {
+        Err(io::Error::other("Image is read-only"))
+    }
+}
