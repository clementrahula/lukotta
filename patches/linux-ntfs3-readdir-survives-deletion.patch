+/* The entry the walk is at. */
+static struct NTFS_DE **ntfs_dir_at(struct ntfs_fnd *fnd)
+{
+	return fnd->level ? &fnd->de[fnd->level - 1] : &fnd->root_de;
+}
+
+/* From the entry the walk is at down to the first entry of its lowest subnode. */
+static int ntfs_dir_down(struct ntfs_inode *ni, struct ntfs_fnd *fnd)
+{
+	struct NTFS_DE *e = *ntfs_dir_at(fnd);
+
+	while (de_has_vcn_ex(e)) {
+		struct indx_node *node = NULL;
+		int err;
+
+		if (fnd->level >= ARRAY_SIZE(fnd->nodes) ||
+		    le16_to_cpu(e->size) < sizeof(struct NTFS_DE) + sizeof(u64))
 			return -EINVAL;
 
-		ctx->pos = vbo + off;
+		err = indx_read(&ni->dir, ni, de_get_vbn(e), &node);
+		if (err)
+			return err;
 
-		/* Submit the name to the filldir callback. */
-		if (!ntfs_dir_emit(sbi, ni, e, name, ctx)) {
-			/* ctx is full. */
-			return +1;
+		e = hdr_first_de(&node->index->ihdr);
+		if (!e) {
+			put_indx_node(node);
+			return -EINVAL;
 		}
+
+		fnd->nodes[fnd->level] = node;
+		fnd->de[fnd->level] = e;
+		fnd->level += 1;
 	}
+	return 0;
 }
 
 /*
+ * Past the entry the walk is at to the next in name order: the first entry
+ * under the next entry's subnode or, past a node's last entry, the entry that
+ * node hangs from. Returns 1 past the directory's last entry.
+ */
+static int ntfs_dir_next(struct ntfs_inode *ni, const struct INDEX_ROOT *root,
+			 struct ntfs_fnd *fnd)
+{
+	struct NTFS_DE **at = ntfs_dir_at(fnd);
+	const struct INDEX_HDR *hdr;
+
+	if (de_is_last(*at)) {
+		if (!fnd->level)
+			return 1;
+		fnd->level -= 1;
+		put_indx_node(fnd->nodes[fnd->level]);
+		fnd->nodes[fnd->level] = NULL;
+		return 0;
+	}
+
+	hdr = fnd->level ? &fnd->nodes[fnd->level - 1]->index->ihdr :
+			   &root->ihdr;
+	*at = hdr_next_de(hdr, *at);
+	if (!*at)
+		return -EINVAL;
+	return ntfs_dir_down(ni, fnd);
+}
