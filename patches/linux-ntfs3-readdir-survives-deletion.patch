+/* Whether 'attr' is the name in 'dir_ni' that a position was handed out for. */
+static bool ntfs_dir_name_is(struct ntfs_inode *dir_ni,
+			     const struct ATTRIB *attr, u32 hash,
+			     struct cpu_str *uni)
+{
+	const struct ATTR_FILE_NAME *fname;
+
+	if (attr->type != ATTR_NAME)
+		return false;
+
+	fname = resident_data_ex(attr, SIZEOF_ATTRIBUTE_FILENAME);
+	if (!fname || fname->type == FILE_NAME_DOS ||
+	    le32_to_cpu(attr->res.data_size) < fname_full_size(fname) ||
+	    !mi_is_ref(&dir_ni->mi, &fname->home) ||
+	    ntfs_dir_hash(fname->name, fname->name_len) != hash)
+		return false;
+
+	ntfs_dir_copy_name(uni, fname->name, fname->name_len);
+	return true;
+}
+
+/*
+ * ntfs_dir_position_name - The name position 'pos' was handed out for: the
+ * entry's own while it is in the directory, the one it had once it is gone.
+ */
+static bool ntfs_dir_position_name(struct ntfs_inode *dir_ni, u64 pos,
+				   struct cpu_str *uni)
+{
+	struct ntfs_sb_info *sbi = dir_ni->mi.sbi;
+	struct ntfs_index *indx = &dir_ni->dir;
+	u32 rno = lower_32_bits(pos);
+	u32 hash = upper_32_bits(pos) & NTFS_DIR_HASH;
+	struct ntfs_dir_gone *g;
+	struct ATTRIB *attr = NULL;
+	struct mft_inode *mi;
+	struct inode *inode;
+	bool found = false;
+
+	/*
+	 * An inode in memory can hold a name its record on disk has not got
+	 * yet. Without one the record is read as it is and no inode is made:
+	 * a position can outlive its entry, and ntfs_iget5() given a stale
+	 * sequence number marks a live inode bad.
+	 */
+	inode = ilookup(sbi->sb, rno);
+	if (inode) {
+		struct ntfs_inode *ni = ntfs_i(inode);
+		struct ATTR_LIST_ENTRY *le = NULL;
+
+		if (!is_bad_inode(inode)) {
+			ni_lock(ni);
+			while (!found &&
+			       (attr = ni_find_attr(ni, attr, &le, ATTR_NAME,
+						    NULL, 0, NULL, NULL)))
+				found = ntfs_dir_name_is(dir_ni, attr, hash, uni);
+			ni_unlock(ni);
+		}
+		iput(inode);
+	} else if (!mi_get(sbi, rno, &mi)) {
+		if (is_rec_inuse(mi->mrec)) {
+			while (!found && (attr = mi_enum_attr(mi, attr)))
+				found = ntfs_dir_name_is(dir_ni, attr, hash, uni);
+		}
+		mi_put(mi);
+	}
+
+	if (found || !indx->gone.next)
+		return found;
+
+	list_for_each_entry(g, &indx->gone, list) {
+		if (g->rno == rno && g->hash == hash) {
+			ntfs_dir_copy_name(uni, g->name, g->len);
+			return true;
+		}
+	}
+	return false;
+}
