+/*
+ * A position is a byte offset inside an index block, and deleting an entry
+ * moves the ones after it down, so a position handed out before a deletion
+ * can point past entries nobody has seen. Every position therefore carries
+ * the directory's deletion count above the offset, and a stale one starts
+ * the listing again after the dots.
+ */
+#define NTFS_DIR_POS_BITS 40
+#define NTFS_DIR_POS_MASK ((1ULL << NTFS_DIR_POS_BITS) - 1)
+#define NTFS_DIR_TAG_MASK 0x7FFFFFULL
+
+static inline u64 ntfs_dir_tag(const struct ntfs_inode *ni)
+{
+	return READ_ONCE(ni->dir.deletions) & NTFS_DIR_TAG_MASK;
 }
 
+static inline loff_t ntfs_dir_pos(const struct ntfs_inode *ni, u64 pos)
+{
+	return (loff_t)((ntfs_dir_tag(ni) << NTFS_DIR_POS_BITS) |
+			(pos & NTFS_DIR_POS_MASK));
+}
