 /*
- * ntfs_read_hdr - Helper function for ntfs_readdir().
+ * A readdir position names the entry the listing goes on from, by its MFT
+ * record and a hash of its name, and the index is walked in name order, so
+ * creating or removing entries mid-listing skips nothing and repeats nothing.
+ * indx_find_sort() is not used: it reads a subnode into the node it came from.
+ */
+#define NTFS_DIR_NAMED	(1ULL << 62)
+#define NTFS_DIR_END	((loff_t)(NTFS_DIR_NAMED - 1))
+#define NTFS_DIR_HASH	0x3FFFFFFFU
+/* Names kept after they are removed, for positions handed out before. */
+#define NTFS_DIR_GONE_MAX 4096
+
+struct ntfs_dir_gone {
+	struct list_head list;
+	u32 rno;
+	u32 hash;
+	u8 len;
+	__le16 name[];
+};
+
+static u32 ntfs_dir_hash(const __le16 *name, u8 len)
+{
+	return jhash(name, len * sizeof(__le16), 0) & NTFS_DIR_HASH;
+}
+
+static loff_t ntfs_dir_position(const struct NTFS_DE *e,
+				const struct ATTR_FILE_NAME *fname)
+{
+	return NTFS_DIR_NAMED |
+	       ((u64)ntfs_dir_hash(fname->name, fname->name_len) << 32) |
+	       lower_32_bits(ino_get(&e->ref));
+}
