+void ntfs_dir_forget_all(struct ntfs_index *indx)
+{
+	struct ntfs_dir_gone *g, *tmp;
+
+	if (!indx->gone.next)
+		return;
+
+	list_for_each_entry_safe(g, tmp, &indx->gone, list)
+		kfree(g);
+	INIT_LIST_HEAD(&indx->gone);
+	indx->gone_count = 0;
