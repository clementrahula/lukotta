diff -ruN a/anylinuxfs/src/devinfo.rs b/anylinuxfs/src/devinfo.rs
--- a/anylinuxfs/src/devinfo.rs	2026-07-20 19:00:52
+++ b/anylinuxfs/src/devinfo.rs	2026-08-22 10:57:18
@@ -14,6 +14,10 @@
     #[default]
     Raw,
     Qcow2,
+    Vmdk,
+    Vdi,
+    Vhd,
+    Vhdx,
 }
 
 impl DiskFormat {
@@ -22,12 +26,34 @@
         match self {
             DiskFormat::Raw => 0,
             DiskFormat::Qcow2 => 1,
+            DiskFormat::Vmdk => 2,
+            DiskFormat::Vdi => 3,
+            DiskFormat::Vhd => 4,
+            DiskFormat::Vhdx => 5,
         }
     }
 
+    /// Whether the bytes need decoding rather than being read straight
+    /// through: everything but Raw.
+    pub fn is_encoded(self) -> bool {
+        self != DiskFormat::Raw
+    }
+
     pub fn from_path(path: impl AsRef<BStr>) -> Self {
         if path.as_ref().ends_with(b".qcow2") {
             DiskFormat::Qcow2
+        } else if path.as_ref().ends_with(b".vmdk") {
+            DiskFormat::Vmdk
+        } else if path.as_ref().ends_with(b".vhdx") {
+            // Before ".vhd", which is a suffix of it and a different format.
+            DiskFormat::Vhdx
+        } else if path.as_ref().ends_with(b".vdi") {
+            DiskFormat::Vdi
+        } else if path.as_ref().ends_with(b".vhd") {
+            // Both kinds: a fixed VHD is raw with a footer after it, which the
+            // driver reads as such, and a dynamic one is blocks listed by a
+            // table. Neither is read straight through.
+            DiskFormat::Vhd
         } else {
             DiskFormat::Raw
         }
