+/// What a sparse extent's header says, once it has been read and checked.
+#[derive(Debug, Clone, Copy)]
+struct SparseHeader {
+    /// How much disk the extent holds, in sectors.
+    capacity: u64,
+    /// How much disk one grain holds, in sectors.
+    grain_size: u64,
+    /// Where the embedded descriptor begins, in sectors, or 0 for none.
+    descriptor_offset: u64,
+    /// How long that descriptor is, in sectors.
+    descriptor_size: u64,
+    /// How many grains one grain table covers.
+    gtes_per_gt: u32,
+    /// Where the grain directory begins, in sectors.
+    gd_offset: u64,
+}
+
+impl SparseHeader {
+    /// Read a sparse extent header, and refuse anything this does not read.
+    fn parse(head: &[u8]) -> io::Result<Self> {
+        if u32::from_le_bytes(head[..4].try_into().unwrap()) != VMDK4_MAGIC {
+            return Err(invalid_data("Not a sparse VMDK extent"));
+        }
+        let version = u32::from_le_bytes(head[4..8].try_into().unwrap());
+        if !VMDK_VERSION_RANGE.contains(&version) {
+            return Err(invalid_data(format!("Unsupported VMDK version {version}")));
+        }
+
+        let flags = u32::from_le_bytes(head[8..12].try_into().unwrap());
+        // The streamed form stores every grain compressed and behind a marker,
+        // which is a different thing to read and is not read here.
+        if flags & (VMDK_FLAG_COMPRESSED | VMDK_FLAG_MARKERS) != 0 {
+            return Err(io::Error::new(
+                io::ErrorKind::Unsupported,
+                "Unsupported compressed (stream-optimized) VMDK extent",
+            ));
+        }
+
+        let le64 = |at: usize| u64::from_le_bytes(head[at..at + 8].try_into().unwrap());
+        let header = SparseHeader {
+            capacity: le64(12),
+            grain_size: le64(20),
+            descriptor_offset: le64(28),
+            descriptor_size: le64(36),
+            gtes_per_gt: u32::from_le_bytes(head[44..48].try_into().unwrap()),
+            gd_offset: le64(56),
+        };
+
+        // All of this decides where the driver reads, so all of it is checked
+        // before any of it is used.
+        if header.grain_size == 0
+            || !header.grain_size.is_power_of_two()
+            || header.grain_size > 1 << 20
+        {
+            return Err(invalid_data(format!(
+                "VMDK grain size of {} sectors is not one this reads",
+                header.grain_size
+            )));
+        }
+        if header.gtes_per_gt == 0 || !header.gtes_per_gt.is_power_of_two() {
+            return Err(invalid_data(format!(
+                "VMDK grain table of {} entries is not one this reads",
+                header.gtes_per_gt
+            )));
+        }
+        if header.gd_offset == 0 {
+            return Err(invalid_data("VMDK sparse extent has no grain directory"));
+        }
+        Ok(header)
+    }
+
+    /// How much disk one grain table covers, in bytes.
+    fn table_span(&self) -> u64 {
+        self.grain_size * VMDK_SECTOR_SIZE * (self.gtes_per_gt as u64)
+    }
+}
+
+/// A sparse extent: the file, its grain directory, and the grain tables read so
+/// far.
+///
+/// The directory is read once, when the image is opened, because it is small —
+/// one entry per grain table. The tables themselves are read as the disk is,
+/// and the last few are kept: one table covers a long stretch of disk, so
+/// reading an image through touches each of them about once.
+#[derive(Debug)]
+struct SparseExtent<S: Storage + 'static> {
+    /// The file holding the grains.
+    file: Arc<S>,
+    /// What its header said.
+    header: SparseHeader,
+    /// Where each grain table begins, in sectors, or 0 for a table that was
+    /// never written and whose whole span reads as zeroes.
+    directory: Vec<u32>,
+    /// The tables read so far, and the order they were read in.
+    tables: Mutex<(HashMap<usize, Arc<Vec<u32>>>, VecDeque<usize>)>,
+}
+
+impl<S: Storage + 'static> SparseExtent<S> {
+    /// Read the header and the grain directory of an already-opened file.
+    async fn open(file: S) -> io::Result<Self> {
+        let file_size = file.size()?;
+        if file_size < VMDK_SECTOR_SIZE {
+            return Err(invalid_data("VMDK sparse extent too short to hold a header"));
+        }
+        let mut buf = IoBuffer::new(VMDK_SECTOR_SIZE as usize, file.mem_align())?;
+        file.read(buf.as_mut(), 0).await?;
+        let header = SparseHeader::parse(buf.as_ref().into_slice())?;
+
+        let entries = header
+            .capacity
+            .div_ceil(header.grain_size)
+            .div_ceil(header.gtes_per_gt as u64);
+        if entries > MAX_GRAIN_DIRECTORY {
+            return Err(invalid_data(format!(
+                "VMDK grain directory has {entries} entries, which is more than this reads"
+            )));
+        }
+        let bytes = (entries as usize) * 4;
+        let at = header.gd_offset * VMDK_SECTOR_SIZE;
+        if at.checked_add(bytes as u64).is_none_or(|end| end > file_size) {
+            return Err(invalid_data(
+                "VMDK grain directory runs past the end of the file",
+            ));
+        }
+
+        let mut directory = vec![0u32; entries as usize];
+        if bytes > 0 {
+            let mut buf = IoBuffer::new(bytes, file.mem_align())?;
+            file.read(buf.as_mut(), at).await?;
+            let raw = buf.as_ref().into_slice();
+            for (i, entry) in directory.iter_mut().enumerate() {
+                *entry = u32::from_le_bytes(raw[i * 4..i * 4 + 4].try_into().unwrap());
+            }
+        }
+
+        Ok(SparseExtent {
+            file: Arc::new(file),
+            header,
+            directory,
+            tables: Mutex::new((HashMap::new(), VecDeque::new())),
+        })
+    }
+
+    /// Return the grain table at `index`, reading it if it has not been read.
+    async fn table(&self, index: usize) -> io::Result<Arc<Vec<u32>>> {
+        // The lock is never held across a read: it is taken to look, dropped to
+        // read, and taken again to keep what was read.
+        if let Some(table) = self.tables.lock().unwrap().0.get(&index) {
+            return Ok(Arc::clone(table));
+        }
+
+        let sector = self.directory[index] as u64;
+        let bytes = (self.header.gtes_per_gt as usize) * 4;
+        let at = sector * VMDK_SECTOR_SIZE;
+        let file_size = self.file.size()?;
+        if at.checked_add(bytes as u64).is_none_or(|end| end > file_size) {
+            return Err(invalid_data("VMDK grain table lies outside the file"));
+        }
+
+        let mut buf = IoBuffer::new(bytes, self.file.mem_align())?;
+        self.file.read(buf.as_mut(), at).await?;
+        let raw = buf.as_ref().into_slice();
+        let table: Arc<Vec<u32>> = Arc::new(
+            (0..self.header.gtes_per_gt as usize)
+                .map(|i| u32::from_le_bytes(raw[i * 4..i * 4 + 4].try_into().unwrap()))
+                .collect(),
+        );
+
+        let mut kept = self.tables.lock().unwrap();
+        if kept.0.insert(index, Arc::clone(&table)).is_none() {
+            kept.1.push_back(index);
+            while kept.1.len() > GRAIN_TABLE_CACHE {
+                if let Some(oldest) = kept.1.pop_front() {
+                    kept.0.remove(&oldest);
+                }
+            }
+        }
+        Ok(table)
+    }
+
+    /// Where `offset` into this extent is in the file, and for how long.
+    ///
+    /// A grain that was never written, or one written as zeroes, reads as
+    /// zeroes; anything else is a plain stretch of the file.
+    async fn map(&self, offset: u64, max_length: u64) -> io::Result<(Option<u64>, u64)> {
+        let grain_bytes = self.header.grain_size * VMDK_SECTOR_SIZE;
+        let in_grain = offset % grain_bytes;
+        let length = cmp::min(max_length, grain_bytes - in_grain);
+
+        let table_index = (offset / self.header.table_span()) as usize;
+        let Some(&table_at) = self.directory.get(table_index) else {
+            return Ok((None, length));
+        };
+        if table_at == 0 {
+            return Ok((None, length));
+        }
+
+        let table = self.table(table_index).await?;
+        let within = (offset % self.header.table_span()) / grain_bytes;
+        let grain = table[within as usize];
+        if grain == GRAIN_UNALLOCATED || grain == GRAIN_ZERO {
+            return Ok((None, length));
+        }
+
+        let at = (grain as u64)
+            .checked_mul(VMDK_SECTOR_SIZE)
+            .and_then(|at| at.checked_add(in_grain))
+            .ok_or_else(|| invalid_data("VMDK grain offset overflow"))?;
+        let file_size = self.file.size()?;
+        if at.checked_add(length).is_none_or(|end| end > file_size) {
+            return Err(invalid_data("VMDK grain lies outside the file"));
+        }
+        Ok((Some(at), length))
+    }
 }
 
