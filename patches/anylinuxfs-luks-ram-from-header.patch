+    // The floor, which the caller may name when it has read the volume's own
+    // header and knows what the key derivation will actually allocate. Anything
+    // unset, unparseable or zero keeps the constant, so a caller that says
+    // nothing is treated exactly as before.
+    let floor: u32 = std::env::var("ALFS_LUKS_MIN_RAM_MIB")
+        .ok()
+        .and_then(|v| v.trim().parse::<u32>().ok())
+        .filter(|v| *v > 0)
+        .unwrap_or(2560);
+    if config.preferences.krun_ram_size_mib() < floor {
+        config.preferences.user_mut().krun.ram_size_mib = Some(floor);
         println!(
             "Configured RAM size is lower than the minimum required for LUKS decryption, setting to {} MiB",
