     async fn sync(&self) -> io::Result<()> {
+        // A device node takes neither of the two calls below. Measured on
+        // macOS 26, on a device opened for writing:
+        //
+        //     target         fsync   F_FULLFSYNC   DKIOCSYNCHRONIZECACHE
+        //     device node    ok      ENOTTY        ok
+        //     regular file   ok      ok            ENOTTY
+        //
+        // They are exact complements, and `fsync` on a device node is the
+        // trap: it returns success having done nothing, so both branches
+        // below report a flush that never reached the drive. `sync_all` is
+        // no better -- it is F_FULLFSYNC, which the device refuses outright.
+        //
+        // Written 8 MB through a mount with `dd conv=fsync` and killed the
+        // machine: on a real drive the file was not there at all afterwards,
+        // while the same test against an image file kept it byte-identical.
+        // The image is a regular file, where `fsync` is real. That is the
+        // whole of the difference.
         #[cfg(target_os = "macos")]
+        if self.is_device {
+            let rc = while_eintr(|| {
+                // Safe: File descriptor is valid, and the request takes no
+                // argument.
+                unsafe {
+                    libc::ioctl(
+                        self.file.write().unwrap().as_raw_fd(),
+                        DK_SYNCHRONIZE_CACHE,
+                    )
+                }
+            });
+            return match rc {
+                Ok(_) => Ok(()),
+                // A device with no cache to flush says so rather than
+                // failing. Turning that into an I/O error would fail every
+                // barrier and nothing would mount.
+                Err(e) if device_has_no_cache(&e) => Ok(()),
+                Err(e) => Err(e),
+            };
+        }
+        #[cfg(target_os = "macos")]
         if self.relaxed_sync {
             // Safe: File descriptor is valid and there aren't any other arguments.
             while_eintr(|| unsafe { libc::fsync(self.file.write().unwrap().as_raw_fd()) })?;
@@ -444,6 +511,13 @@
