+/// `DKIOCSYNCHRONIZECACHE`: flush the drive's own write cache.
+///
+/// Declared in `<sys/disk.h>` as `_IO('d', 22)`. Spelled as the number it
+/// expands to because there is no macOS disk crate in this tree worth adding
+/// for one constant; the value came out of the header by compiling it, rather
+/// than being worked out by hand.
+#[cfg(target_os = "macos")]
+const DK_SYNCHRONIZE_CACHE: libc::c_ulong = 0x2000_6416;
+
+/// Whether the device is saying it has no cache to flush, rather than that the
+/// flush went wrong.
+///
+/// ENOTTY 25, ENOTSUP 45, EINVAL 22, ENODEV 19, as on Darwin.
+#[cfg(target_os = "macos")]
+fn device_has_no_cache(e: &io::Error) -> bool {
+    matches!(e.raw_os_error(), Some(25) | Some(45) | Some(22) | Some(19))
+        || e.kind() == io::ErrorKind::Unsupported
+}
