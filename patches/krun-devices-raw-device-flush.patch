+
+/// Whether the device is saying it has no sync to give, rather than that the
+/// sync went wrong.
+///
+/// A raw device on macOS answers `fsync(2)` this way. Turning that into a
+/// failed flush would make every barrier an I/O error and nothing would mount;
+/// treating it as satisfied is what the code did before, by never asking.
+///
+/// The numbers rather than `libc`, which this crate does not depend on and
+/// which is not worth adding for four constants: ENOTSUP 45, ENOTTY 25,
+/// EINVAL 22, ENODEV 19, as on Darwin.
+fn device_has_no_sync(e: &io::Error) -> bool {
+    matches!(e.raw_os_error(), Some(45) | Some(25) | Some(22) | Some(19))
+        || e.kind() == io::ErrorKind::Unsupported
+}
