 impl CacheType {
     /// Picks the appropriate cache type based on disk image or device path.
-    /// Special files like `/dev/rdisk*` on macOS do not support flush/sync.
+    ///
+    /// Every path gets Writeback, raw devices included. They used to get
+    /// Unsafe, on the grounds that `/dev/rdisk*` does not support flush/sync.
+    /// That is true of plain `fsync(2)` and it is not a reason to answer the
+    /// guest's flush with a no-op: the guest is told the device has a cache
+    /// barrier either way, so under Unsafe it is told a barrier exists that
+    /// the host has already decided never to honour.
+    ///
+    /// Measured before this change, on a real drive: 8 MB written with
+    /// `dd conv=fsync`, which returns only once the NFS client's COMMIT has
+    /// been answered, then the machine killed. The file was not there at all
+    /// afterwards. An application that fsynced and was told it had succeeded
+    /// had nothing on the disk.
+    ///
+    /// A device that genuinely cannot sync is handled in the FLUSH arm of
+    /// worker.rs rather than by refusing to ask it.
     pub fn auto(_path: &str) -> CacheType {
-        #[cfg(target_os = "macos")]
-        if _path.starts_with("/dev/rdisk") {
-            return CacheType::Unsafe;
-        }
         CacheType::Writeback
     }
 }
