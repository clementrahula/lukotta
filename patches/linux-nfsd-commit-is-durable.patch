+/*
+ * vmproxy exports async only on a kernel that has this: one where a COMMIT
+ * or a rename is on the drive before it is answered, and a write asked to be
+ * stable is written through, whatever the export says.
+ */
+static bool commit_is_durable = true;
+module_param(commit_is_durable, bool, 0444);
+
+/*
+ * Write a filesystem out as syncfs(2) does, then flush the device. A writeback
+ * error is for the caller to check, against a cursor of its own.
+ */
+static int nfsd_sync_fs(struct super_block *sb)
+{
+	int err;
+
+	down_read(&sb->s_umount);
+	err = sync_filesystem(sb);
+	up_read(&sb->s_umount);
+	if (!err && sb->s_bdev)
+		err = blkdev_issue_flush(sb->s_bdev);
+	return err;
+}
