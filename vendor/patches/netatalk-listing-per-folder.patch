 #define SDBUFBRK	2048
+#define SDSLOTS		16
+
+/* One listing per folder. Finder lists several folders in turn while it deletes; a single
+ * listing was re-read between one folder's batches, entries shifted and were skipped. */
+static struct savedir *savedir_for(u_short vid, uint32_t did)
+{
+    static struct savedir slots[SDSLOTS];
+    static unsigned int used[SDSLOTS];
+    static unsigned int now;
+    int i, oldest = 0;
+
+    for (i = 0; i < SDSLOTS; i++) {
+        if (slots[i].sd_buf != NULL && slots[i].sd_did == did && slots[i].sd_vid == vid) {
+            used[i] = ++now;
+            return &slots[i];
+        }
+
+        if (used[i] < used[oldest]) {
+            oldest = i;
+        }
+    }
+
+    if (slots[oldest].sd_buf == NULL) {
+        if ((slots[oldest].sd_buf = (char *)malloc(SDBUFBRK)) == NULL) {
+            return NULL;
+        }
+
+        slots[oldest].sd_buflen = SDBUFBRK;
+    }
+
+    slots[oldest].sd_did = 0;
+    slots[oldest].sd_last = slots[oldest].sd_buf;
+    slots[oldest].sd_sindex = 1;
+    used[oldest] = ++now;
+    return &slots[oldest];
+}
 
