+/*!
+ * @brief Stat the composed name, or the one the client sent.
+ *
+ * mtoupath() composes, because CH_UTF8_MAC is flagged decomposed and the
+ * conversion to the volume charset precomposes. A volume written by a Mac
+ * holds the decomposed form, and the composed name is not there at all.
+ *
+ * On a miss that is not ENOENT, or where nothing was converted, this is
+ * of_stat(). Where the fallback misses too the composed name is restored, so
+ * a create request still makes the name the volume charset asks for.
  */
+static int of_stat_as_stored(const struct vol *vol, struct path *path)
+{
+    char *composed;
+
+    if (of_stat(vol, path) == 0) {
+        return 0;
+    }
+
+    if (path->st_errno != ENOENT || path->u_name == path->m_name) {
+        return -1;
+    }
+
+    composed = path->u_name;
+    path->u_name = path->m_name;
+
+    if (of_stat(vol, path) == 0) {
+        return 0;
+    }
+
+    path->u_name = composed;
+    path->st_errno = ENOENT;
+    return -1;
+}
+
 struct path *cname(struct vol *vol, struct dir *dir, char **cpath)
 {
     static char        path[MAXPATHLEN + 1];
