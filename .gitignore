.DS_Store
.build/
dist/

# The engine the build fetches. Anchored to the root, so a stray vendor tree
# anywhere else shows up in git status instead of hiding. The contents are
# ignored rather than the directory itself, because git cannot re-include a
# file inside an excluded directory — and engine.lock has to be tracked: the
# build scripts read it to know which engine to fetch, so a clone without it
# cannot build at all.
/vendor/*
!/vendor/engine.lock
# The guest's package inventory is tracked for the same reason: the audit
# workflow scans it on a Linux runner that has no vendor tree and no macOS
# build, so an untracked copy would leave it scanning nothing.
!/vendor/guest-sbom.json

# Agent worktrees are checkouts of this repo, not content of it.
.claude/worktrees/
# Written by the preview tool, with this machine's paths in it.
.claude/launch.json

# The Sparkle PUBLIC key is not a secret, and a clone without it builds an app
# that trusts no update at all. Tracked deliberately.

# Built from resources/Localizable.xcstrings at build time.
/resources/*.lproj/

# Audit reports. Written for a piece of work and kept on the machine that ran
# it; the repository holds the fixes rather than the report. Ignored so that a
# sweeping `git add` cannot take one in, which has happened.
/AUDIT.md

# Audits: working documents, and they quote this machine back at you.
audit.md
audit_*/
translation_audit/

# The working note for a night of work. Not part of the repository.
/TONIGHT.md
nfs-stall.md
.claude/
architecture.md
scripts/__pycache__/
.lint.log
.tests.log

# One log per gate row, rewritten on every run of scripts/verify.sh.
# Kept on disk because a failing check's whole output is the evidence; kept
# out of git because it is the output of a run, not a source of one.
.verify-logs/
