<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleDisplayName</key><string>Lukotta</string>
  <key>CFBundleExecutable</key><string>Lukotta</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundleIdentifier</key><string>com.clementrahula.lukotta</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>Lukotta</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>__VERSION__</string>
  <key>CFBundleVersion</key><string>__BUILD__</string>
  <key>LSMinimumSystemVersion</key><string>15.0</string>
  <key>LSArchitecturePriority</key><array><string>arm64</string></array>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSRemovableVolumesUsageDescription</key><string>Lukotta reads the encrypted drive directly in order to unlock it. It only reads the drive you choose, and it never sends anything anywhere.</string>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <key>NSHumanReadableCopyright</key><string>Copyright © 2026 Clement Rahula. Licensed under GPL-3.0-or-later.</string>
  <key>SUFeedURL</key><string>https://lukotta-updates.rahula.dev/appcast.xml</string>
  <key>SUPublicEDKey</key><string>__SPARKLE_PUBLIC_KEY__</string>
  <key>SUEnableInstallerLauncherService</key><false/>
  <!-- Checking is on by default, and there is no first-run question about it.
       Installing is not: replacing the app is the user's call to make, and
       Lukotta may be holding a drive open when the moment arrives. -->
  <key>SUEnableAutomaticChecks</key><true/>
  <key>SUAutomaticallyUpdate</key><false/>
  <!-- Daily. The default is a week, which is a long time to carry a fix. -->
  <key>SUScheduledCheckInterval</key><integer>86400</integer>
  <key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
</dict>
</plist>
