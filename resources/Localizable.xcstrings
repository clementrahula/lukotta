    "No encrypted drives found": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не са намерени шифровани дискове"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyly nalezeny žádné šifrované disky"
          }
        },
