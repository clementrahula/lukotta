    "“%@” is smaller than its footer states, and may be damaged or incomplete.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏“%@” أصغر مما تذكره تذييلته، وقد يكون تالفًا أو ناقصًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ е по-малък, отколкото посочва долният му колонтитул, и може да е повреден или непълен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ je menší, než uvádí jeho patička, a může být poškozený nebo neúplný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” er mindre, end dens egen sidefod angiver, og kan være beskadiget eller ufuldstændig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist kleiner, als seine eigene Fußzeile angibt, und ist möglicherweise beschädigt oder unvollständig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» είναι μικρότερο από όσο δηλώνει το υποσέλιδό του και μπορεί να είναι κατεστραμμένο ή ημιτελές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» es más pequeño de lo que indica su pie de página y puede estar dañado o incompleto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ on väiksem, kui tema enda jalus väidab, ja võib olla rikutud või poolik."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” on pienempi kuin sen oma alatunniste ilmoittaa, ja se voi olla vaurioitunut tai keskeneräinen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas maliit ang “%@” kaysa sa nakasaad sa footer nito, at maaaring sira o hindi kumpleto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est plus petit que ne l’indique son pied de page ; il est peut-être endommagé ou incomplet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏“%@” קטן ממה שכתוב בכותרת התחתונה שלו, ועלול להיות פגום או חלקי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” अपने फ़ुटर में बताए आकार से छोटी है, और क्षतिग्रस्त या अधूरी हो सकती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” je manji nego što navodi njegovo podnožje i možda je oštećen ili nepotpun."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” kisebb, mint amit a saját élőlába megad, ezért sérült vagy hiányos lehet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” lebih kecil daripada yang dinyatakan footer-nya, dan mungkin rusak atau tidak lengkap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» è più piccolo di quanto indichi il suo piè di pagina e potrebbe essere danneggiato o incompleto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はフッタに記された大きさより小さく、破損しているか不完全な可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은(는) 푸터에 적힌 크기보다 작아 손상되었거나 불완전할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ yra mažesnis, nei nurodo jo poraštė, todėl gali būti sugadintas arba nebaigtas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ir mazāks, nekā norāda tā kājene, un var būt bojāts vai nepabeigts."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” lebih kecil daripada yang dinyatakan pengakhirnya, dan mungkin rosak atau tidak lengkap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» er mindre enn sin egen bunntekst oppgir, og kan være skadet eller ufullstendig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ is kleiner dan de eigen voettekst aangeeft en is mogelijk beschadigd of onvolledig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” jest mniejszy, niż podaje jego stopka, i może być uszkodzony lub niekompletny."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» é menor do que o seu rodapé indica e pode estar danificado ou incompleto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” este mai mic decât indică propriul subsol și poate fi deteriorat sau incomplet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» меньше, чем заявляет его завершающая запись, и может быть повреждён или неполон."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« je manjši, kot navaja njegova noga, in je morda poškodovan ali nepopoln."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” është më i vogël se sa deklaron fundfaqja e tij, dhe mund të jetë i dëmtuar ose i paplotë."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” är mindre än vad dess egen sidfot anger och kan vara skadad eller ofullständig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” มีขนาดเล็กกว่าที่ระบุไว้ในส่วนท้ายไฟล์ และอาจเสียหายหรือไม่สมบูรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”, altbilgisinin belirttiğinden küçük; hasarlı veya eksik olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» менший, ніж заявляє його завершальний запис, і може бути пошкодженим або неповним."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” nhỏ hơn kích thước ghi trong phần cuối tệp, và có thể đã hỏng hoặc chưa đầy đủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”比其页脚所述的更小，可能已损坏或不完整。"
          }
        }
      }
    },
