    "No reason was reported. The details below may say more.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не беше посочена причина. Подробностите по-долу може да кажат повече."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyl uveden žádný důvod. Podrobnosti níže mohou říct více."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke oplyst nogen årsag. Oplysningerne nedenfor siger måske mere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde kein Grund gemeldet. Die Details unten sagen möglicherweise mehr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν αναφέρθηκε αιτία. Οι λεπτομέρειες παρακάτω ίσως πουν περισσότερα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha indicado ningún motivo. Los detalles de abajo pueden decir más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Põhjust ei teatatud. Allolevad üksikasjad võivad rohkem öelda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syytä ei ilmoitettu. Alla olevat tiedot voivat kertoa enemmän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune raison n’a été signalée. Les détails ci-dessous en disent peut-être davantage."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije naveden razlog. Pojedinosti u nastavku možda kažu više."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem érkezett indoklás. Az alábbi részletek többet elárulhatnak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato indicato alcun motivo. I dettagli qui sotto potrebbero dire di più."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Priežastis nenurodyta. Toliau pateikta informacija gali pasakyti daugiau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemesls netika norādīts. Tālāk redzamā informācija var pastāstīt vairāk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen årsak ble oppgitt. Detaljene nedenfor sier kanskje mer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen reden gemeld. De details hieronder zeggen mogelijk meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie podano przyczyny. Szczegóły poniżej mogą powiedzieć więcej."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi indicado qualquer motivo. Os detalhes abaixo poderão dizer mais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu a fost raportat niciun motiv. Detaliile de mai jos ar putea spune mai multe."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Razlog ni bil naveden. Spodnje podrobnosti morda povedo več."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen orsak rapporterades. Detaljerna nedan kan säga mer."
          }
        }
      }
    },
