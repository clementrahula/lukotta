    "260 MB of disk: 160 MB for the app, 100 MB for the Linux environment it unpacks on first use": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "260 ميجابايت من القرص: 160 ميجابايت للتطبيق و100 ميجابايت لبيئة Linux التي تُفكّ عند أول استخدام"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB дисково пространство: 160 MB за приложението и 100 MB за средата на Linux, разопакована при първото използване"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB na disku: 160 MB pro aplikaci a 100 MB pro linuxové prostředí rozbalené při prvním použití"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB diskplads: 160 MB til appen og 100 MB til Linux-miljøet, der pakkes ud første gang"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB Speicherplatz: 160 MB für die App, 100 MB für die Linux-Umgebung, die beim ersten Verwenden entpackt wird"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB στον δίσκο: 160 MB για την εφαρμογή και 100 MB για το περιβάλλον Linux που αποσυμπιέζεται στην πρώτη χρήση"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB de disco: 160 MB para la app y 100 MB para el entorno Linux que descomprime la primera vez"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB kettaruumi: 160 MB rakendusele ja 100 MB Linuxi keskkonnale, mis pakitakse lahti esimesel kasutamisel"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "260 Mt levytilaa: 160 Mt ohjelmalle ja 100 Mt Linux-ympäristölle, joka puretaan ensimmäisellä käyttökerralla"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB ng disk: 160 MB para sa app, 100 MB para sa Linux environment na binubuksan sa unang paggamit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "260 Mo d’espace disque : 160 Mo pour l’app, 100 Mo pour l’environnement Linux décompressé à la première utilisation"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏260 מ״ב בדיסק: 160 מ״ב ליישום ו‑100 מ״ב לסביבת Linux שנפרסת בשימוש הראשון"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिस्क पर 260 MB: ऐप के लिए 160 MB और पहली बार उपयोग पर खुलने वाले Linux परिवेश के लिए 100 MB"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB prostora na disku: 160 MB za aplikaciju i 100 MB za Linux okruženje koje se raspakirava pri prvom korištenju"
