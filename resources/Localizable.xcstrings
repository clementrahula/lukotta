    "Virtual machine disks: qcow2, VMDK, VDI, VHD and VHDX, as VMware, VirtualBox, Hyper-V, QEMU and UTM write them": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дискове на виртуални машини: qcow2, VMDK, VDI, VHD и VHDX, както ги записват VMware, VirtualBox, Hyper-V, QEMU и UTM"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Disky virtuálních počítačů: qcow2, VMDK, VDI, VHD a VHDX, jak je zapisují VMware, VirtualBox, Hyper-V, QEMU a UTM"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diske fra virtuelle maskiner: qcow2, VMDK, VDI, VHD og VHDX, sådan som VMware, VirtualBox, Hyper-V, QEMU og UTM skriver dem"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Festplatten virtueller Maschinen: qcow2, VMDK, VDI, VHD und VHDX, so wie VMware, VirtualBox, Hyper-V, QEMU und UTM sie schreiben"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δίσκοι εικονικών μηχανών: qcow2, VMDK, VDI, VHD και VHDX, όπως τους γράφουν τα VMware, VirtualBox, Hyper-V, QEMU και UTM"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Discos de máquinas virtuales: qcow2, VMDK, VDI, VHD y VHDX, tal como los escriben VMware, VirtualBox, Hyper-V, QEMU y UTM"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtuaalmasinate kettad: qcow2, VMDK, VDI, VHD ja VHDX, nagu neid kirjutavad VMware, VirtualBox, Hyper-V, QEMU ja UTM"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtuaalikoneiden levyt: qcow2, VMDK, VDI, VHD ja VHDX sellaisina kuin VMware, VirtualBox, Hyper-V, QEMU ja UTM ne kirjoittavat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disques de machines virtuelles : qcow2, VMDK, VDI, VHD et VHDX, tels que les écrivent VMware, VirtualBox, Hyper-V, QEMU et UTM"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskovi virtualnih strojeva: qcow2, VMDK, VDI, VHD i VHDX, onako kako ih zapisuju VMware, VirtualBox, Hyper-V, QEMU i UTM"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtuális gépek lemezei: qcow2, VMDK, VDI, VHD és VHDX, ahogyan a VMware, a VirtualBox, a Hyper-V, a QEMU és az UTM írja őket"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dischi di macchine virtuali: qcow2, VMDK, VDI, VHD e VHDX, così come li scrivono VMware, VirtualBox, Hyper-V, QEMU e UTM"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualiųjų mašinų diskai: qcow2, VMDK, VDI, VHD ir VHDX, tokie, kokius juos įrašo „VMware“, „VirtualBox“, „Hyper-V“, QEMU ir UTM"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtuālo mašīnu diski: qcow2, VMDK, VDI, VHD un VHDX tādi, kādus tos raksta VMware, VirtualBox, Hyper-V, QEMU un UTM"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disker fra virtuelle maskiner: qcow2, VMDK, VDI, VHD og VHDX, slik VMware, VirtualBox, Hyper-V, QEMU og UTM skriver dem"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schijven van virtuele machines: qcow2, VMDK, VDI, VHD en VHDX, zoals VMware, VirtualBox, Hyper-V, QEMU en UTM ze schrijven"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyski maszyn wirtualnych: qcow2, VMDK, VDI, VHD i VHDX, w postaci zapisywanej przez VMware, VirtualBox, Hyper-V, QEMU i UTM"
