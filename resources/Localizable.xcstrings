        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar para qué sirve cada permiso"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Näita, milleks iga õigus on"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä, mihin kutakin oikeutta tarvitaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher à quoi sert chaque autorisation"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaži čemu služi svako dopuštenje"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyes engedélyek céljának megjelenítése"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra a cosa serve ogni permesso"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodyti, kam skirtas kiekvienas leidimas"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rādīt, kam kalpo katra atļauja"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis hva hver tillatelse brukes til"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon waarvoor elk recht dient"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż, do czego służy każde uprawnienie"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar para que serve cada permissão"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișați la ce servește fiecare permisiune"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaži, čemu je namenjeno posamezno dovoljenje"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa vad varje behörighet används till"
          }
        }
      }
    },
    "Some permissions are still needed": {
      "localizations": {
        "bg": {
          "stringUnit": {
