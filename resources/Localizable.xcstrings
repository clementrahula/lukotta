    "Reading a raw disk and mounting a filesystem are actions only an administrator can do. %@ never sees your password.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة قرص خام وتركيب نظام ملفات إجراءان لا يقوم بهما إلا المسؤول. ولا يرى %@ كلمة سرك أبدًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прякото четене на диск и монтирането на файлова система са действия, които може да извърши само администратор. %@ никога не вижда вашата парола."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přímé čtení disku a připojení souborového systému může provést jen správce. %@ vaše heslo nikdy nevidí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At læse en disk direkte og aktivere et filsystem kan kun en administrator. %@ ser aldrig din adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Festplatte direkt zu lesen und ein Dateisystem zu aktivieren, kann nur ein Administrator. %@ sieht dein Passwort nie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απευθείας ανάγνωση δίσκου και η προσάρτηση συστήματος αρχείων είναι ενέργειες που μόνο διαχειριστής μπορεί να κάνει. Το %@ δεν βλέπει ποτέ το συνθηματικό σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer un disco en bruto y montar un sistema de archivos son acciones que solo puede hacer un administrador. %@ nunca ve tu contraseña."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketta otse lugemine ja failisüsteemi haakimine on toimingud, mida saab teha ainult administraator. %@ ei näe kunagi sinu parooli."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Levyn suora lukeminen ja tiedostojärjestelmän käyttöönotto onnistuvat vain pääkäyttäjältä. %@ ei koskaan näe salasanaasi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pagbasa ng raw na disk at pag-mount ng file system ay mga gawaing administrator lamang ang makagagawa. Hindi kailanman nakikita ng %@ ang iyong password."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire un disque brut et monter un système de fichiers sont des actions réservées à un administrateur. %@ ne voit jamais votre mot de passe."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריאת דיסק גולמי ועגינת מערכת קבצים הן פעולות שרק מנהל יכול לבצע. ‏%@ לעולם אינו רואה את הסיסמה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रॉ डिस्क पढ़ना और फ़ाइल सिस्टम माउंट करना ऐसे काम हैं जो केवल व्यवस्थापक कर सकता है। %@ आपका पासवर्ड कभी नहीं देखता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izravno čitanje diska i montiranje datotečnog sustava radnje su koje može obaviti samo administrator. %@ nikada ne vidi vašu lozinku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy lemez közvetlen olvasása és egy fájlrendszer csatolása csak rendszergazdai művelet. A(z) %@ soha nem látja a jelszavát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca disk mentah dan memasang sistem berkas hanya dapat dilakukan administrator. %@ tidak pernah melihat kata sandi Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggere un disco grezzo e montare un file system sono operazioni riservate a un amministratore. %@ non vede mai la tua password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生のディスクを読むこととファイルシステムをマウントすることは、管理者にしかできません。%@ があなたのパスワードを見ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원시 디스크를 읽고 파일 시스템을 마운트하는 일은 관리자만 할 수 있습니다. %@은(는) 사용자의 암호를 절대 보지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiesioginį disko skaitymą ir failų sistemos prijungimą gali atlikti tik administratorius. %@ niekada nemato jūsų slaptažodžio."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diska tiešu lasīšanu un failu sistēmas montēšanu var veikt tikai administrators. %@ nekad neredz jūsu paroli."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca cakera mentah dan melekapkan sistem fail ialah tindakan yang hanya pentadbir boleh lakukan. %@ tidak pernah melihat kata laluan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å lese en disk direkte og montere et filsystem er noe bare en administrator kan gjøre. %@ ser aldri passordet ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een schijf rechtstreeks lezen en een bestandssysteem activeren kan alleen een beheerder. %@ ziet je wachtwoord nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpośredni odczyt dysku i montowanie systemu plików może wykonać wyłącznie administrator. %@ nigdy nie widzi Twojego hasła."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler um disco diretamente e montar um sistema de ficheiros são ações reservadas a um administrador. O %@ nunca vê a sua palavra-passe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citirea directă a unui disc și montarea unui sistem de fișiere sunt acțiuni pe care le poate face doar un administrator. %@ nu vă vede niciodată parola."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтение необработанного диска и монтирование файловой системы — действия, доступные только администратору. %@ никогда не видит ваш пароль."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neposredno branje diska in priklop datotečnega sistema sta dejanji, ki ju lahko izvede le skrbnik. %@ vašega gesla nikoli ne vidi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Leximi i një disku të papërpunuar dhe montimi i një sistemi skedarësh janë veprime që i bën vetëm një administrator. %@ nuk e sheh kurrë fjalëkalimin tënd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att läsa en disk direkt och montera ett filsystem kan bara en administratör göra. %@ ser aldrig ditt lösenord."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอ่านดิสก์ดิบและการเมานต์ระบบไฟล์เป็นสิ่งที่มีเพียงผู้ดูแลระบบทำได้ %@ ไม่เคยเห็นรหัสผ่านของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ham bir diski okumak ve bir dosya sistemini bağlamak yalnızca yöneticinin yapabileceği işlerdir. %@ parolanızı hiçbir zaman görmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читання необробленого диска та монтування файлової системи — дії, доступні лише адміністратору. %@ ніколи не бачить вашого пароля."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc đĩa thô và gắn kết hệ thống tệp là những việc chỉ quản trị viên mới làm được. %@ không bao giờ nhìn thấy mật khẩu của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取原始磁盘和挂载文件系统只有管理员才能做。%@ 从不会看到你的密码。"
          }
        }
      }
    },
    "Reading a raw disk and mounting a filesystem are actions only an administrator can do. Approve %@ in Login Items to finish.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءة قرص خام وتركيب نظام ملفات إجراءان لا يقوم بهما إلا المسؤول. وافق على %@ في عناصر تسجيل الدخول لإتمام الأمر."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прякото четене на диск и монтирането на файлова система са действия, които може да извърши само администратор. Одобрете %@ в „Login Items“, за да завършите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přímé čtení disku a připojení souborového systému může provést jen správce. Dokončete to schválením aplikace %@ v části „Přihlášení“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At læse en disk direkte og aktivere et filsystem kan kun en administrator. Godkend %@ under “Loginemner” for at afslutte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Festplatte direkt zu lesen und ein Dateisystem zu aktivieren, kann nur ein Administrator. Bestätige %@ unter „Anmeldeobjekte“, um den Vorgang abzuschließen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απευθείας ανάγνωση δίσκου και η προσάρτηση συστήματος αρχείων είναι ενέργειες που μόνο διαχειριστής μπορεί να κάνει. Εγκρίνετε το %@ στα «Στοιχεία εισόδου» για να ολοκληρώσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer un disco en bruto y montar un sistema de archivos son acciones que solo puede hacer un administrador. Autoriza %@ en «Ítems de inicio» para terminar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketta otse lugemine ja failisüsteemi haakimine on toimingud, mida saab teha ainult administraator. Kinnita %@ jaotises „Login Items“, et lõpetada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Levyn suora lukeminen ja tiedostojärjestelmän käyttöönotto onnistuvat vain pääkäyttäjältä. Hyväksy %@ kohdassa ”Kirjautumiskohteet” viimeistelläksesi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pagbasa ng raw na disk at pag-mount ng file system ay mga gawaing administrator lamang ang makagagawa. Aprubahan ang %@ sa Login Items para matapos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire un disque brut et monter un système de fichiers sont des actions réservées à un administrateur. Approuvez %@ dans « Ouverture » pour terminer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריאת דיסק גולמי ועגינת מערכת קבצים הן פעולות שרק מנהל יכול לבצע. אשרו את %@ בפריטי הכניסה כדי לסיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रॉ डिस्क पढ़ना और फ़ाइल सिस्टम माउंट करना ऐसे काम हैं जो केवल व्यवस्थापक कर सकता है। पूरा करने के लिए लॉगिन आइटम में %@ को स्वीकृत करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izravno čitanje diska i montiranje datotečnog sustava radnje su koje može obaviti samo administrator. Odobrite %@ u „Stavke za prijavu” da biste dovršili."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy lemez közvetlen olvasása és egy fájlrendszer csatolása csak rendszergazdai művelet. A befejezéshez hagyja jóvá a(z) %@ programot az „Indítóelemek” alatt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca disk mentah dan memasang sistem berkas hanya dapat dilakukan administrator. Setujui %@ di Item Masuk untuk menyelesaikannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggere un disco grezzo e montare un file system sono operazioni riservate a un amministratore. Approva %@ in «Elementi login» per completare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生のディスクを読むこととファイルシステムをマウントすることは、管理者にしかできません。仕上げに「ログイン項目」で %@ を承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원시 디스크를 읽고 파일 시스템을 마운트하는 일은 관리자만 할 수 있습니다. 마무리하려면 로그인 항목에서 %@을(를) 승인하십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiesioginį disko skaitymą ir failų sistemos prijungimą gali atlikti tik administratorius. Patvirtinkite %@ skiltyje „Login Items“, kad užbaigtumėte."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diska tiešu lasīšanu un failu sistēmas montēšanu var veikt tikai administrators. Apstipriniet %@ sadaļā “Login Items”, lai pabeigtu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca cakera mentah dan melekapkan sistem fail ialah tindakan yang hanya pentadbir boleh lakukan. Luluskan %@ dalam Item Log Masuk untuk menyelesaikannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å lese en disk direkte og montere et filsystem er noe bare en administrator kan gjøre. Godkjenn %@ under «Påloggingsobjekter» for å fullføre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een schijf rechtstreeks lezen en een bestandssysteem activeren kan alleen een beheerder. Keur %@ goed bij ‘Inloggen’ om dit af te ronden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpośredni odczyt dysku i montowanie systemu plików może wykonać wyłącznie administrator. Zatwierdź %@ w sekcji „Logowanie”, aby dokończyć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler um disco diretamente e montar um sistema de ficheiros são ações reservadas a um administrador. Autorize o %@ em «Início de sessão» para concluir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citirea directă a unui disc și montarea unui sistem de fișiere sunt acțiuni pe care le poate face doar un administrator. Aprobați %@ la „Lansare la login” pentru a finaliza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтение необработанного диска и монтирование файловой системы — действия, доступные только администратору. Разрешите %@ в Объекты входа, чтобы завершить."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neposredno branje diska in priklop datotečnega sistema sta dejanji, ki ju lahko izvede le skrbnik. Za dokončanje odobrite %@ v »Elementi prijave«."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Leximi i një disku të papërpunuar dhe montimi i një sistemi skedarësh janë veprime që i bën vetëm një administrator. Mirato %@ te Login Items për ta përfunduar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att läsa en disk direkt och montera ett filsystem kan bara en administratör göra. Godkänn %@ under ”Startobjekt” för att slutföra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอ่านดิสก์ดิบและการเมานต์ระบบไฟล์เป็นสิ่งที่มีเพียงผู้ดูแลระบบทำได้ อนุมัติ %@ ใน รายการเข้าสู่ระบบ เพื่อให้เสร็จสมบูรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ham bir diski okumak ve bir dosya sistemini bağlamak yalnızca yöneticinin yapabileceği işlerdir. Tamamlamak için Giriş Öğeleri içinde %@ uygulamasını onaylayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читання необробленого диска та монтування файлової системи — дії, доступні лише адміністратору. Дозвольте %@ у Об’єкти входу, щоб завершити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc đĩa thô và gắn kết hệ thống tệp là những việc chỉ quản trị viên mới làm được. Hãy chấp thuận %@ trong Mục đăng nhập để hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取原始磁盘和挂载文件系统只有管理员才能做。请在“登录项”中批准 %@ 以完成。"
          }
        }
      }
    },
