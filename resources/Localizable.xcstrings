    "%@ is free software under the GPL, version 3 or later. The mounting is done by anylinuxfs. Complete source for every component is published with each release. The name and the logo are trademarks, and are not covered by that licence.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ е свободен софтуер под лиценза GPL, версия 3 или по-нова. Монтирането се извършва от anylinuxfs. Пълният изходен код на всеки компонент се публикува с всяко издание. Името и логото са търговски марки и не са обхванати от този лиценз."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je svobodný software pod licencí GPL verze 3 nebo novější. Připojování zajišťuje anylinuxfs. Úplný zdrojový kód každé součásti je zveřejňován s každým vydáním. Název a logo jsou ochranné známky a tato licence se na ně nevztahuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er fri software under GPL, version 3 eller nyere. Aktiveringen klares af anylinuxfs. Den fulde kildekode for hver komponent udgives med hver version. Navnet og logoet er varemærker og er ikke omfattet af den licens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist freie Software unter der GPL, Version 3 oder höher. Das Aktivieren übernimmt anylinuxfs. Der vollständige Quelltext jeder Komponente wird mit jeder Version veröffentlicht. Der Name und das Logo sind Marken und fallen nicht unter diese Lizenz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ είναι ελεύθερο λογισμικό υπό την άδεια GPL, έκδοση 3 ή νεότερη. Η προσάρτηση γίνεται από το anylinuxfs. Ο πλήρης πηγαίος κώδικας κάθε στοιχείου δημοσιεύεται με κάθε έκδοση. Το όνομα και το λογότυπο είναι εμπορικά σήματα και δεν καλύπτονται από αυτήν την άδεια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es software libre bajo la GPL, versión 3 o posterior. Del montaje se encarga anylinuxfs. El código fuente completo de cada componente se publica con cada versión. El nombre y el logotipo son marcas registradas y no están cubiertos por esa licencia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on vaba tarkvara GPL-litsentsi versiooni 3 või uuema alusel. Haakimise teeb anylinuxfs. Iga komponendi täielik lähtekood avaldatakse koos iga väljalaskega. Nimi ja logo on kaubamärgid ning need litsents ei hõlma."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on vapaa ohjelmisto GPL-lisenssin version 3 tai uudemman alaisuudessa. Käyttöönotosta huolehtii anylinuxfs. Jokaisen osan täydellinen lähdekoodi julkaistaan jokaisen version mukana. Nimi ja logo ovat tavaramerkkejä, eikä kyseinen lisenssi kata niitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est un logiciel libre sous licence GPL, version 3 ou ultérieure. Le montage est assuré par anylinuxfs. Le code source complet de chaque composant est publié à chaque version. Le nom et le logo sont des marques et ne sont pas couverts par cette licence."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je slobodan softver pod licencom GPL, verzija 3 ili novija. Montiranje obavlja anylinuxfs. Potpuni izvorni kod svake komponente objavljuje se uz svako izdanje. Naziv i logotip zaštitni su znakovi i nisu obuhvaćeni tom licencom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ szabad szoftver a GPL 3-as vagy újabb verziója alatt. A csatolást az anylinuxfs végzi. Minden összetevő teljes forráskódja megjelenik minden kiadással. A név és a logó védjegy, és nem tartozik az említett licenc hatálya alá."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è software libero sotto licenza GPL, versione 3 o successiva. Il montaggio è svolto da anylinuxfs. Il codice sorgente completo di ogni componente viene pubblicato a ogni versione. Il nome e il logo sono marchi e non sono coperti da quella licenza."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yra laisva programinė įranga pagal GPL licenciją, 3 arba naujesnę versiją. Prijungimą atlieka anylinuxfs. Visas kiekvieno komponento pirminis kodas skelbiamas su kiekviena laida. Pavadinimas ir logotipas yra prekių ženklai ir ta licencija jų neapima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ir brīvā programmatūra ar GPL licenci, versiju 3 vai jaunāku. Montēšanu veic anylinuxfs. Katra komponenta pilns pirmkods tiek publicēts ar katru laidienu. Nosaukums un logotips ir preču zīmes, un šī licence uz tiem neattiecas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er fri programvare under GPL, versjon 3 eller nyere. Monteringen gjøres av anylinuxfs. Fullstendig kildekode for hver komponent publiseres med hver utgivelse. Navnet og logoen er varemerker og omfattes ikke av den lisensen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is vrije software onder de GPL, versie 3 of later. Het activeren gebeurt door anylinuxfs. De volledige broncode van elk onderdeel wordt bij elke versie gepubliceerd. De naam en het logo zijn handelsmerken en vallen niet onder die licentie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest wolnym oprogramowaniem na licencji GPL w wersji 3 lub nowszej. Montowaniem zajmuje się anylinuxfs. Pełny kod źródłowy każdego składnika jest publikowany wraz z każdym wydaniem. Nazwa i logo są znakami towarowymi i nie są objęte tą licencją."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ é software livre sob a GPL, versão 3 ou posterior. A montagem é feita pelo anylinuxfs. O código-fonte completo de cada componente é publicado com cada versão. O nome e o logótipo são marcas registadas e não estão abrangidos por essa licença."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ este software liber sub licența GPL, versiunea 3 sau ulterioară. Montarea este realizată de anylinuxfs. Codul sursă complet al fiecărei componente este publicat cu fiecare versiune. Numele și sigla sunt mărci comerciale și nu sunt acoperite de acea licență."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je prosto programje pod licenco GPL, različica 3 ali novejša. Priklop opravi anylinuxfs. Popolna izvorna koda vsake komponente je objavljena z vsako izdajo. Ime in logotip sta blagovni znamki in ju ta licenca ne zajema."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är fri programvara under GPL, version 3 eller senare. Monteringen sköts av anylinuxfs. Fullständig källkod för varje komponent publiceras med varje version. Namnet och logotypen är varumärken och omfattas inte av den licensen."
          }
        }
      }
    },
    "%@ opens BitLocker and Linux drives that macOS cannot read on its own. One setting is needed first.\n\nReading a drive at the raw device level needs Full Disk Access. An administrator password is not enough, and the removable-volumes permission covers files on a drive rather than the raw device. macOS has no way for an app to request this one, so it has to be switched on by hand.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ отваря дискове с BitLocker и Linux, които macOS не може да чете сам. Първо е нужна една настройка.\n\nЧетенето на диск на ниво сурово устройство изисква Full Disk Access. Парола на администратор не е достатъчна, а разрешението за сменяеми носители се отнася за файловете на диск, а не за самото устройство. macOS не дава на приложенията начин да поискат това разрешение, затова се включва ръчно."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ otevírá disky s BitLockerem a Linuxem, které macOS sám přečíst neumí. Nejprve je potřeba jedno nastavení.\n\nČtení disku na úrovni surového zařízení vyžaduje Plný přístup k disku. Heslo správce nestačí a oprávnění pro vyměnitelné svazky se týká souborů na disku, ne surového zařízení. macOS aplikacím nedává možnost si o toto oprávnění říct, takže se zapíná ručně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ åbner BitLocker- og Linux-diske, som macOS ikke selv kan læse. Først kræves én indstilling.\n\nAt læse en disk på råt enhedsniveau kræver Fuld adgang til disk. En administratoradgangskode er ikke nok, og tilladelsen til flytbare enheder dækker filer på en disk frem for den rå enhed. macOS giver ikke programmer nogen måde at bede om denne tilladelse på, så den skal slås til i hånden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ öffnet BitLocker- und Linux-Laufwerke, die macOS von sich aus nicht lesen kann. Dafür ist zuerst eine Einstellung nötig.\n\nEin Laufwerk auf der Ebene des rohen Geräts zu lesen erfordert Festplattenvollzugriff. Ein Administratorpasswort genügt nicht, und die Berechtigung für Wechselmedien gilt für Dateien auf einem Laufwerk statt für das rohe Gerät. macOS bietet Apps keine Möglichkeit, diese Berechtigung anzufordern, also muss sie von Hand eingeschaltet werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ ανοίγει δίσκους BitLocker και Linux που το macOS δεν μπορεί να διαβάσει από μόνο του. Πρώτα χρειάζεται μία ρύθμιση.\n\nΗ ανάγνωση ενός δίσκου σε επίπεδο ωμής συσκευής απαιτεί Πλήρη πρόσβαση στον δίσκο. Το συνθηματικό διαχειριστή δεν αρκεί, και η άδεια για αφαιρούμενους τόμους αφορά αρχεία σε έναν δίσκο και όχι την ίδια τη συσκευή. Το macOS δεν δίνει στις εφαρμογές τρόπο να ζητήσουν αυτή την άδεια, οπότε ενεργοποιείται με το χέρι."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ abre discos con BitLocker y de Linux que macOS no puede leer por sí solo. Antes hace falta un ajuste.\n\nLeer un disco al nivel del dispositivo en bruto requiere Acceso total al disco. Una contraseña de administrador no basta, y el permiso de volúmenes extraíbles cubre los archivos de un disco, no el dispositivo en bruto. macOS no ofrece a las apps ninguna forma de solicitar este permiso, así que hay que activarlo a mano."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ avab BitLockeri ja Linuxi kettaid, mida macOS ise lugeda ei oska. Selleks on kõigepealt vaja üht seadet.\n\nKetta lugemine toorseadme tasandil nõuab Full Disk Access’i. Administraatori paroolist ei piisa ja eemaldatavate andmekandjate luba puudutab ketta faile, mitte toorseadet. macOS ei anna rakendustele võimalust seda luba küsida, seega tuleb see käsitsi sisse lülitada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ avaa BitLocker- ja Linux-levyjä, joita macOS ei osaa itse lukea. Ensin tarvitaan yksi asetus.\n\nLevyn lukeminen raakalaitteen tasolla vaatii Koko levyn käytön. Pääkäyttäjän salasana ei riitä, ja irrotettavien taltioiden käyttöoikeus koskee levyllä olevia tiedostoja eikä raakalaitetta. macOS ei anna ohjelmille mitään tapaa pyytää tätä oikeutta, joten se on kytkettävä päälle käsin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ouvre les disques BitLocker et Linux que macOS ne sait pas lire seul. Un réglage est d’abord nécessaire.\n\nLire un disque au niveau du périphérique brut exige l’Accès complet au disque. Un mot de passe administrateur ne suffit pas, et l’autorisation des volumes amovibles porte sur les fichiers d’un disque, non sur le périphérique brut. macOS n’offre aux apps aucun moyen de demander celle-ci : elle doit être activée à la main."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ otvara BitLocker i Linux diskove koje macOS sam ne može čitati. Prije toga potrebna je jedna postavka.\n\nČitanje diska na razini sirovog uređaja zahtijeva Puni pristup disku. Administratorska lozinka nije dovoljna, a dozvola za uklonjive medije odnosi se na datoteke na disku, a ne na sam uređaj. macOS aplikacijama ne nudi način da je zatraže, pa se uključuje ručno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ olyan BitLocker- és Linux-lemezeket nyit meg, amelyeket a macOS önmagában nem tud olvasni. Ehhez előbb egy beállítás szükséges.\n\nEgy lemez nyers eszközszintű olvasásához Teljes hozzáférés a lemezhez szükséges. A rendszergazdai jelszó nem elég, a cserélhető kötetekre vonatkozó engedély pedig a lemezen lévő fájlokra vonatkozik, nem a nyers eszközre. A macOS nem ad az alkalmazásoknak módot arra, hogy ezt kérjék, ezért kézzel kell bekapcsolni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ apre dischi BitLocker e Linux che macOS da solo non sa leggere. Prima serve un’impostazione.\n\nLeggere un disco a livello di dispositivo grezzo richiede l’Accesso completo al disco. Una password di amministratore non basta, e il permesso per i volumi rimovibili riguarda i file su un disco, non il dispositivo grezzo. macOS non offre alle app alcun modo di richiederlo, quindi va attivato a mano."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ atveria „BitLocker“ ir „Linux“ diskus, kurių „macOS“ pati perskaityti negali. Pirmiausia reikia vieno nustatymo.\n\nSkaityti diską neapdoroto įrenginio lygiu galima tik su Full Disk Access. Administratoriaus slaptažodžio nepakanka, o keičiamųjų laikmenų leidimas apima diske esančius failus, o ne patį įrenginį. „macOS“ nesuteikia programoms būdo šio leidimo paprašyti, todėl jį reikia įjungti ranka."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ atver BitLocker un Linux diskus, kurus macOS pats nespēj nolasīt. Vispirms nepieciešams viens iestatījums.\n\nDiska lasīšanai neapstrādātas ierīces līmenī ir vajadzīga Full Disk Access. Administratora parole nav pietiekama, un noņemamo datu nesēju atļauja attiecas uz diskā esošajiem failiem, nevis uz pašu ierīci. macOS nedod lietotnēm iespēju to pieprasīt, tāpēc tā jāieslēdz ar roku."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ åpner BitLocker- og Linux-disker som macOS ikke kan lese på egen hånd. Først trengs én innstilling.\n\nÅ lese en disk på rått enhetsnivå krever Full disktilgang. Et administratorpassord er ikke nok, og tillatelsen for flyttbare medier gjelder filer på en disk, ikke selve enheten. macOS gir ikke programmer noen måte å be om denne på, så den må slås på for hånd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opent BitLocker- en Linux-schijven die macOS zelf niet kan lezen. Daarvoor is eerst één instelling nodig.\n\nEen schijf op het niveau van het ruwe apparaat lezen vereist Volledige schijftoegang. Een beheerderswachtwoord is niet genoeg, en de toegang tot verwisselbare volumes gaat over bestanden op een schijf, niet over het ruwe apparaat. macOS biedt apps geen manier om hierom te vragen, dus die moet met de hand worden aangezet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ otwiera dyski z BitLockerem i dyski linuksowe, których macOS sam nie potrafi odczytać. Najpierw potrzebne jest jedno ustawienie.\n\nOdczyt dysku na poziomie surowego urządzenia wymaga Pełnego dostępu do dysku. Hasło administratora nie wystarczy, a uprawnienie do nośników wymiennych dotyczy plików na dysku, a nie samego urządzenia. macOS nie daje programom żadnego sposobu, by o nie poprosić, więc trzeba włączyć je ręcznie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ abre discos BitLocker e Linux que o macOS não consegue ler sozinho. Antes disso é preciso uma definição.\n\nLer um disco ao nível do dispositivo em bruto exige Acesso completo ao disco. Uma palavra-passe de administrador não chega, e a autorização para volumes amovíveis abrange os ficheiros de um disco e não o dispositivo em bruto. O macOS não dá às aplicações forma de a pedir, por isso tem de ser ligada à mão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deschide discuri BitLocker și Linux pe care macOS nu le poate citi singur. Mai întâi este nevoie de o setare.\n\nCitirea unui disc la nivelul dispozitivului brut necesită Acces complet la disc. O parolă de administrator nu este suficientă, iar permisiunea pentru volume amovibile se referă la fișierele de pe un disc, nu la dispozitivul brut. macOS nu oferă aplicațiilor nicio cale de a o cere, așa că trebuie activată manual."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ odpira diske BitLocker in Linux, ki jih macOS sam ne zna prebrati. Najprej je potrebna ena nastavitev.\n\nBranje diska na ravni surove naprave zahteva Poln dostop do diska. Skrbniško geslo ne zadošča, dovoljenje za izmenljive nosilce pa se nanaša na datoteke na disku in ne na surovo napravo. macOS programom ne omogoča, da bi zanj zaprosili, zato ga je treba vklopiti ročno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ öppnar BitLocker- och Linux-diskar som macOS inte kan läsa på egen hand. Först krävs en inställning.\n\nAtt läsa en disk på rå enhetsnivå kräver Full skivtillgång. Ett administratörslösenord räcker inte, och behörigheten för flyttbara enheter gäller filer på en disk och inte den råa enheten. macOS ger inte program något sätt att be om den, så den måste slås på för hand."
          }
        }
      }
    },
    "%@ reads this format and does not write it: changing one means writing to its log first, which it does not do. Nothing in the file can change.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ чете този формат, но не пише в него: промяната изисква първо запис в дневника му, което приложението не прави. Нищо във файла не може да се промени."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tento formát čte, ale nezapisuje do něj: změna vyžaduje nejprve zápis do jeho žurnálu, což nedělá. V souboru se nic nezmění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ læser dette format og skriver ikke til det: at ændre et betyder først at skrive til dets log, hvilket programmet ikke gør. Intet i filen kan ændre sig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liest dieses Format und schreibt es nicht: eine Änderung müsste zuerst in sein Log geschrieben werden, was hier nicht geschieht. An der Datei ändert sich nichts."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ διαβάζει αυτή τη μορφή και δεν γράφει σε αυτήν: μια αλλαγή θα έπρεπε πρώτα να γραφτεί στο ημερολόγιό της, κάτι που δεν κάνει. Τίποτα μέσα στο αρχείο δεν αλλάζει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lee este formato y no escribe en él: cambiar uno exige escribir antes en su registro, cosa que no hace. Nada del archivo puede cambiar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ loeb seda vormingut ega kirjuta sinna: muutmiseks tuleks kõigepealt kirjutada selle logisse, mida see ei tee. Failis ei muutu midagi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lukee tätä muotoa eikä kirjoita siihen: muutos pitäisi ensin kirjoittaa sen lokiin, mitä se ei tee. Tiedostossa ei muutu mikään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lit ce format et ne l’écrit pas : le modifier demanderait d’écrire d’abord dans son journal, ce qu’il ne fait pas. Rien dans le fichier ne peut changer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ čita ovaj format, ali u njega ne piše: promjena bi se najprije morala zapisati u njegov dnevnik, što ne radi. U datoteci se ništa ne mijenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ olvassa ezt a formátumot, de nem ír bele: a módosításhoz előbb a naplójába kellene írni, amit nem tesz. A fájlban semmi nem változik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ legge questo formato e non lo scrive: modificarne uno richiede di scrivere prima nel suo log, cosa che non fa. Nel file non cambia nulla."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ šį formatą skaito, bet į jį nerašo: kad jį pakeistų, pirmiausia reikėtų įrašyti į jo žurnalą, o to ji nedaro. Faile niekas nepasikeis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ šo formātu lasa, bet tajā neraksta: lai to mainītu, vispirms būtu jāieraksta tā žurnālā, un to tā nedara. Failā nekas nemainās."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ leser dette formatet og skriver ikke til det: en endring måtte først skrives til loggen, noe programmet ikke gjør. Ingenting i filen kan endres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ leest dit formaat en schrijft er niet naar: iets wijzigen zou eerst naar het logboek geschreven moeten worden, en dat gebeurt hier niet. Er verandert niets in het bestand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ czyta ten format, ale do niego nie zapisuje: zmiana wymagałaby najpierw zapisu do jego dziennika, czego program nie robi. W pliku nic się nie zmieni."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ lê este formato e não o escreve: alterá-lo obrigaria a escrever primeiro no seu registo, o que não faz. Nada no ficheiro se altera."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ citește acest format și nu scrie în el: o modificare ar cere mai întâi o scriere în jurnalul său, lucru pe care nu îl face. Nimic din fișier nu se schimbă."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ta zapis bere in vanj ne piše: sprememba bi morala najprej v njegov dnevnik, česar ne počne. V datoteki se nič ne spremeni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läser det här formatet och skriver inte till det: en ändring skulle först behöva skrivas till dess logg, vilket programmet inte gör. Ingenting i filen kan ändras."
          }
        }
      }
    },
    "%@ starts a small Linux virtual machine, unlocks the drive inside it, and hands the drive back to Finder. macOS cannot read BitLocker or Linux filesystems. Linux can.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ стартира малка виртуална машина с Linux, отключва диска в нея и го предава обратно на Finder. macOS не може да чете файлови системи на BitLocker или Linux. Linux може."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ spustí malý virtuální stroj s Linuxem, odemkne v něm disk a předá jej zpět Finderu. macOS neumí číst souborové systémy BitLocker ani Linuxu. Linux ano."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ starter en lille virtuel Linux-maskine, låser enheden op inde i den og giver enheden tilbage til Finder. macOS kan ikke læse BitLocker- eller Linux-filsystemer. Det kan Linux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ startet eine kleine virtuelle Linux-Maschine, entsperrt das Laufwerk darin und übergibt es zurück an den Finder. macOS kann BitLocker- und Linux-Dateisysteme nicht lesen. Linux schon."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ ξεκινά μια μικρή εικονική μηχανή Linux, ξεκλειδώνει τον δίσκο μέσα σε αυτήν και τον παραδίδει πίσω στο Finder. Το macOS δεν μπορεί να διαβάσει συστήματα αρχείων BitLocker ή Linux. Το Linux μπορεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ arranca una pequeña máquina virtual Linux, desbloquea el disco dentro de ella y se lo entrega al Finder. macOS no puede leer sistemas de archivos BitLocker ni de Linux. Linux sí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ käivitab väikese Linuxi virtuaalmasina, avab ketta selle sees ja annab ketta Finderile tagasi. macOS ei oska lugeda BitLockeri ega Linuxi failisüsteeme. Linux oskab."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ käynnistää pienen Linux-virtuaalikoneen, avaa aseman sen sisällä ja luovuttaa aseman takaisin Finderille. macOS ei osaa lukea BitLocker- eikä Linux-tiedostojärjestelmiä. Linux osaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ démarre une petite machine virtuelle Linux, y déverrouille le disque, puis le transmet au Finder. macOS ne sait pas lire les systèmes de fichiers BitLocker ou Linux. Linux, si."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pokreće mali virtualni Linux stroj, u njemu otključava disk i predaje ga natrag Finderu. macOS ne može čitati BitLocker ni Linux datotečne sustave. Linux može."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ elindít egy kis Linux virtuális gépet, abban feloldja a meghajtót, majd visszaadja a Findernek. A macOS nem tudja olvasni a BitLocker- és Linux-fájlrendszereket. A Linux igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ avvia una piccola macchina virtuale Linux, vi sblocca il disco e lo consegna al Finder. macOS non sa leggere i file system BitLocker o Linux. Linux sì."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ paleidžia nedidelę „Linux“ virtualiąją mašiną, joje atrakina diską ir perduoda diską atgal „Finder“ programai. „macOS“ negali skaityti „BitLocker“ ar „Linux“ failų sistemų. „Linux“ gali."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ palaiž nelielu Linux virtuālo mašīnu, atbloķē disku tajā un nodod disku atpakaļ programmai Finder. macOS nespēj lasīt BitLocker vai Linux failu sistēmas. Linux spēj."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ starter en liten virtuell Linux-maskin, låser opp enheten inne i den og leverer enheten tilbake til Finder. macOS kan ikke lese BitLocker- eller Linux-filsystemer. Linux kan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ start een kleine virtuele Linux-machine, ontgrendelt de schijf daarbinnen en geeft die terug aan de Finder. macOS kan BitLocker- of Linux-bestandssystemen niet lezen. Linux wel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uruchamia małą maszynę wirtualną z Linuksem, odblokowuje w niej dysk i przekazuje go z powrotem Finderowi. macOS nie odczyta systemów plików BitLocker ani Linuksa. Linux tak."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ inicia uma pequena máquina virtual Linux, desbloqueia o disco dentro dela e devolve-o ao Finder. O macOS não consegue ler sistemas de ficheiros BitLocker ou Linux. O Linux consegue."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pornește o mică mașină virtuală Linux, deblochează discul în interiorul ei și îl predă înapoi aplicației Finder. macOS nu poate citi sisteme de fișiere BitLocker sau Linux. Linux poate."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zažene majhen navidezni stroj z Linuxom, v njem odklene pogon in ga preda nazaj Finderju. macOS ne zna brati datotečnih sistemov BitLocker ali Linux. Linux jih zna."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ startar en liten virtuell Linux-maskin, låser upp enheten i den och lämnar tillbaka enheten till Finder. macOS kan inte läsa BitLocker- eller Linux-filsystem. Linux kan."
          }
        }
      }
    },
    "%@ will be moved to the Bin.": {
