    "The passphrase this drive was encrypted with.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عبارة السر التي شُفّر بها هذا المحرّك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Паролата-фраза, с която този диск е шифрован."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístupová fráze, kterou byl tento disk zašifrován."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgangssætningen, som denne enhed blev krypteret med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Passphrase, mit der dieses Laufwerk verschlüsselt wurde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φράση πρόσβασης με την οποία κρυπτογραφήθηκε αυτός ο δίσκος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La frase de contraseña con la que se cifró este disco."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paroolifraas, millega see ketas krüpteeriti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salauslause, jolla tämä asema salattiin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang passphrase na ipinang-encrypt sa drive na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La phrase secrète avec laquelle ce disque a été chiffré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחרוזת הסיסמה שבה הוצפן הכונן הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह पासफ़्रेज़ जिससे यह ड्राइव एन्क्रिप्ट की गई थी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaporka kojom je ovaj disk šifriran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelmondat, amellyel ezt a meghajtót titkosították."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Frasa sandi yang dipakai untuk mengenkripsi drive ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La passphrase con cui è stato cifrato questo disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このドライブの暗号化に使われたパスフレーズ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 드라이브를 암호화할 때 사용한 암호 구문입니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaptafrazė, kuria šis diskas buvo užšifruotas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paroles frāze, ar kuru šis disks tika šifrēts."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Frasa laluan yang digunakan untuk menyulitkan pemacu ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Passordfrasen denne enheten ble kryptert med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wachtwoordzin waarmee deze schijf is versleuteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasło dostępu, którym zaszyfrowano ten dysk."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A frase-passe com que este disco foi encriptado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraza de acces cu care a fost criptat acest disc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Парольная фраза, которой зашифрован этот диск."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geslo, s katerim je bil ta pogon šifriran."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Frazkalimi me të cilin u enkriptua ky disk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösenfrasen som den här enheten krypterades med."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วลีรหัสผ่านที่ใช้เข้ารหัสไดรฟ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sürücünün şifrelendiği parola tümcesi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Парольна фраза, якою зашифровано цей диск."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cụm mật khẩu đã dùng để mã hóa ổ đĩa này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个驱动器加密时所用的密码短语。"
          }
        }
      }
    },
    "The password the drive was locked with, or a 48-digit BitLocker recovery key. Spaces and hyphens in a recovery key are ignored.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة السر التي أُقفل بها المحرّك، أو مفتاح استرداد BitLocker المكوّن من 48 رقمًا. وتُتجاهل المسافات والشرطات في مفتاح الاسترداد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Паролата, с която дискът е заключен, или 48-цифрен ключ за възстановяване на BitLocker. Интервалите и тиретата в ключа се пренебрегват."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Heslo, kterým byl disk zamčen, nebo 48místný obnovovací klíč BitLocker. Mezery a spojovníky v obnovovacím klíči se ignorují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgangskoden, som enheden blev låst med, eller en 48-cifret BitLocker-genoprettelsesnøgle. Mellemrum og bindestreger i en genoprettelsesnøgle ignoreres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort, mit dem das Laufwerk gesperrt wurde, oder ein 48-stelliger BitLocker-Wiederherstellungsschlüssel. Leerzeichen und Bindestriche im Wiederherstellungsschlüssel werden ignoriert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το συνθηματικό με το οποίο κλειδώθηκε ο δίσκος ή ένα 48ψήφιο κλειδί ανάκτησης BitLocker. Τα κενά και οι παύλες στο κλειδί ανάκτησης αγνοούνται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña con la que se bloqueó el disco, o una clave de recuperación de BitLocker de 48 dígitos. Los espacios y guiones de una clave de recuperación se ignoran."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Parool, millega ketas lukustati, või 48-kohaline BitLockeri taastevõti. Taastevõtme tühikuid ja sidekriipse eiratakse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salasana, jolla asema lukittiin, tai 48-numeroinen BitLocker-palautusavain. Palautusavaimen välilyönnit ja väliviivat jätetään huomiotta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang password na ipinangkandado sa drive, o isang 48-digit na BitLocker recovery key. Hindi pinapansin ang mga espasyo at gitling sa isang recovery key."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe avec lequel le disque a été verrouillé, ou une clé de récupération BitLocker à 48 chiffres. Les espaces et les traits d’union d’une clé de récupération sont ignorés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסיסמה שבה ננעל הכונן, או מפתח שחזור של BitLocker בן 48 ספרות. רווחים ומקפים במפתח השחזור אינם נחשבים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह पासवर्ड जिससे ड्राइव लॉक की गई थी, या 48 अंकों की BitLocker रिकवरी कुंजी। रिकवरी कुंजी में स्पेस और हाइफ़न अनदेखे किए जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lozinka kojom je disk zaključan ili 48-znamenkasti BitLocker ključ za oporavak. Razmaci i crtice u ključu za oporavak se zanemaruju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelszó, amellyel a meghajtót zárolták, vagy egy 48 jegyű BitLocker helyreállítási kulcs. A helyreállítási kulcsban lévő szóközöket és kötőjeleket a program figyelmen kívül hagyja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata sandi yang dipakai untuk mengunci drive, atau kunci pemulihan BitLocker 48 digit. Spasi dan tanda hubung pada kunci pemulihan diabaikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La password con cui il disco è stato bloccato, oppure una chiave di recupero BitLocker di 48 cifre. Gli spazi e i trattini nella chiave di recupero vengono ignorati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライブのロックに使われたパスワード、または 48 桁の BitLocker 回復キー。回復キー内のスペースとハイフンは無視されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드라이브를 잠글 때 사용한 암호 또는 48자리 BitLocker 복구 키입니다. 복구 키의 공백과 하이픈은 무시됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaptažodis, kuriuo diskas buvo užrakintas, arba 48 skaitmenų „BitLocker“ atkūrimo raktas. Tarpai ir brūkšneliai atkūrimo rakte nepaisomi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parole, ar kuru disks tika bloķēts, vai 48 ciparu BitLocker atkopšanas atslēga. Atstarpes un defises atkopšanas atslēgā tiek ignorētas."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata laluan yang digunakan untuk mengunci pemacu, atau kunci pemulihan BitLocker 48 digit. Ruang dan sengkang dalam kunci pemulihan diabaikan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Passordet enheten ble låst med, eller en 48-sifret BitLocker-gjenopprettingsnøkkel. Mellomrom og bindestreker i en gjenopprettingsnøkkel ignoreres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wachtwoord waarmee de schijf is vergrendeld, of een BitLocker-herstelsleutel van 48 cijfers. Spaties en streepjes in een herstelsleutel worden genegeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasło, którym zablokowano dysk, albo 48-cyfrowy klucz odzyskiwania BitLocker. Spacje i myślniki w kluczu odzyskiwania są pomijane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A palavra-passe com que o disco foi bloqueado, ou uma chave de recuperação do BitLocker de 48 dígitos. Os espaços e hífenes de uma chave de recuperação são ignorados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola cu care a fost blocat discul sau o cheie de recuperare BitLocker din 48 de cifre. Spațiile și cratimele dintr-o cheie de recuperare sunt ignorate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль, которым заблокирован диск, или 48-значный ключ восстановления BitLocker. Пробелы и дефисы в ключе восстановления не учитываются."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geslo, s katerim je bil pogon zaklenjen, ali 48-mestni obnovitveni ključ BitLocker. Presledki in vezaji v obnovitvenem ključu se prezrejo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjalëkalimi me të cilin u kyç disku, ose një çelës rikuperimi BitLocker me 48 shifra. Hapësirat dhe vizat në një çelës rikuperimi nuk merren parasysh."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösenordet som enheten låstes med, eller en 48-siffrig BitLocker-återställningsnyckel. Mellanslag och bindestreck i en återställningsnyckel ignoreras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสผ่านที่ใช้ล็อกไดรฟ์ หรือคีย์กู้คืน BitLocker 48 หลัก ช่องว่างและขีดกลางในคีย์กู้คืนจะถูกละเว้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürücünün kilitlendiği parola ya da 48 haneli BitLocker kurtarma anahtarı. Kurtarma anahtarındaki boşluklar ve tireler dikkate alınmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль, яким заблоковано диск, або 48-значний ключ відновлення BitLocker. Пробіли та дефіси в ключі відновлення не враховуються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mật khẩu đã dùng để khóa ổ đĩa, hoặc khóa khôi phục BitLocker 48 chữ số. Khoảng trắng và dấu gạch nối trong khóa khôi phục được bỏ qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定该驱动器所用的密码，或 48 位 BitLocker 恢复密钥。恢复密钥中的空格和连字符会被忽略。"
          }
        }
      }
    },
    "The virtualisation engine could not start. A restart usually clears this.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر بدء محرّك الأنظمة الافتراضية. وعادةً ما تحل إعادة التشغيل هذه المشكلة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Двигателят за виртуализация не можа да стартира. Рестартирането обикновено решава това."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualizační jádro se nepodařilo spustit. Obvykle to vyřeší restart."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualiseringsmotoren kunne ikke starte. En genstart løser det som regel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Virtualisierungs-Engine konnte nicht starten. Ein Neustart behebt das meistens."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μηχανή εικονικοποίησης δεν μπόρεσε να ξεκινήσει. Μια επανεκκίνηση συνήθως το λύνει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor de virtualización no ha podido arrancar. Reiniciar suele solucionarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualiseerimismootor ei saanud käivituda. Taaskäivitus lahendab selle tavaliselt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualisointimoottori ei käynnistynyt. Uudelleenkäynnistys yleensä korjaa tämän."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi makapagsimula ang virtualisation engine. Kadalasan ay naaayos ito ng pag-restart."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur de virtualisation n’a pas pu démarrer. Un redémarrage suffit généralement à corriger cela."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנוע הווירטואליזציה לא הצליח לעלות. בדרך כלל הפעלה מחדש פותרת זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्चुअलाइज़ेशन इंजन शुरू नहीं हो सका। आमतौर पर दोबारा चालू करने से यह ठीक हो जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogon za virtualizaciju nije se mogao pokrenuti. Ponovno pokretanje obično to rješava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A virtualizációs motor nem indult el. Ezt általában egy újraindítás megoldja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesin virtualisasi tidak dapat dijalankan. Biasanya menyalakan ulang mengatasinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore di virtualizzazione non è riuscito ad avviarsi. Di solito basta un riavvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想化エンジンを起動できませんでした。ふつうは再起動で解消します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가상화 엔진을 시작하지 못했습니다. 보통 재시동하면 해결됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualizavimo variklis negalėjo pasileisti. Paprastai tai išsprendžia paleidimas iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualizācijas dzinējs nevarēja startēt. Parasti palīdz pārstartēšana."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjin permayaan tidak dapat dimulakan. Biasanya memulakan semula menyelesaikannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualiseringsmotoren kunne ikke starte. En omstart løser vanligvis dette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De virtualisatie-engine kon niet starten. Opnieuw opstarten lost dit meestal op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Silnik wirtualizacji nie mógł się uruchomić. Zwykle pomaga ponowne uruchomienie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor de virtualização não conseguiu arrancar. Reiniciar costuma resolver."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Motorul de virtualizare nu a putut porni. De obicei o repornire rezolvă problema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запустить движок виртуализации. Обычно это устраняется перезагрузкой."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehanizem za virtualizacijo se ni mogel zagnati. Ponovni zagon to običajno odpravi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Motori i virtualizimit nuk u nis dot. Një rinisje zakonisht e zgjidh këtë."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualiseringsmotorn kunde inte starta. En omstart brukar lösa det."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มเอนจินเวอร์ชวลไลเซชันไม่สำเร็จ โดยทั่วไปการเริ่มเครื่องใหม่จะแก้ปัญหานี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanallaştırma motoru başlatılamadı. Bunu genellikle bir yeniden başlatma giderir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося запустити рушій віртуалізації. Зазвичай це усувається перезавантаженням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không khởi động được bộ máy ảo hóa. Khởi động lại máy thường xử lý được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虚拟化引擎无法启动。重新启动通常可以解决。"
          }
        }
      }
    },
    "There is no password to enter.": {
