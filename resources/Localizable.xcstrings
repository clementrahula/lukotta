    },
    "LVM inside LUKS, as Ubuntu, Debian, Mint and Fedora set it up. Several volumes on one drive all unlock together": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM innerhalb von LUKS, wie es Ubuntu, Debian, Mint und Fedora einrichten. Mehrere Volumes auf einem Laufwerk werden gemeinsam entsperrt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM dentro de LUKS, tal como lo configuran Ubuntu, Debian, Mint y Fedora. Varios volúmenes de un mismo disco se desbloquean juntos"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM LUKS-i sees, nagu Ubuntu, Debian, Mint ja Fedora selle seadistavad. Ühe ketta mitu köidet avanevad koos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM LUKSin sisällä, kuten Ubuntu, Debian, Mint ja Fedora sen määrittävät. Saman aseman useat taltiot avautuvat yhdessä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM dans LUKS, tel que le configurent Ubuntu, Debian, Mint et Fedora. Plusieurs volumes sur un même disque se déverrouillent ensemble"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM dentro LUKS, come lo configurano Ubuntu, Debian, Mint e Fedora. Più volumi sullo stesso disco si sbloccano insieme"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM LUKS iekšienē, kā to iestata Ubuntu, Debian, Mint un Fedora. Vairāki sējumi vienā diskā tiek atbloķēti kopā"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM binnen LUKS, zoals Ubuntu, Debian, Mint en Fedora het instellen. Meerdere volumes op één schijf worden samen ontgrendeld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM wewnątrz LUKS, tak jak konfigurują to Ubuntu, Debian, Mint i Fedora. Kilka woluminów na jednym dysku odblokowuje się razem"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM dentro de LUKS, tal como o Ubuntu, o Debian, o Mint e o Fedora o configuram. Vários volumes num mesmo disco são desbloqueados em conjunto"
          }
        }
      }
    },
