    "macOS reads and writes exFAT itself, so this image was opened directly as an ordinary disk.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏macOS يقرأ exFAT ويكتبها بنفسه، لذا فُتحت هذه الصورة مباشرةً كقرص عادي."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS сам чете и записва exFAT, затова този образ беше отворендиректно като обикновен диск."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS čte a zapisuje exFAT sám, proto byl tento obraz otevřen přímo jako běžný disk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS læser og skriver selv exFAT, så dette diskbillede blev åbnet direkte som en almindelig disk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS liest und schreibt exFAT selbst, daher wurde dieses Image direkt als gewöhnliches Laufwerk geöffnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το macOS διαβάζει και γράφει exFAT μόνο του, οπότε αυτό το είδωλο άνοιξε απευθείας ως συνηθισμένος δίσκος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lee y escribe exFAT por sí mismo, así que esta imagen se abrió directamente como un disco normal."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS loeb ja kirjutab exFAT-i ise, seega avati see tõmmis otse tavalise kettana."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lukee ja kirjoittaa exFAT-muotoa itse, joten tämä levytiedosto avattiin suoraan tavallisena asemana."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang exFAT ay binabasa at sinusulatan mismo ng macOS, kaya binuksan ang image na ito nang tuwiran bilang karaniwang disk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lit et écrit l’exFAT lui-même, cette image a donc été ouverte directement comme un disque ordinaire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏macOS קורא וכותב exFAT בעצמו, ולכן התמונה הזו נפתחה ישירות כדיסק רגיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "exFAT को macOS स्वयं पढ़ता और लिखता है, इसलिए यह इमेज सीधे एक साधारण डिस्क की तरह खोली गई।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS sam čita i piše exFAT, pa je ova slika otvorena izravno kao običan disk."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A macOS maga olvassa és írja az exFAT-ot, ezért ez a lemezkép közvetlenül, szokásos lemezként nyílt meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS membaca dan menulis exFAT sendiri, jadi image ini dibuka langsung sebagai disk biasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS legge e scrive exFAT da sé, quindi questa immagine è stata aperta direttamente come un disco ordinario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "exFAT は macOS 自身が読み書きするため、このイメージは通常のディスクとしてそのまま開かれました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "exFAT는 macOS가 직접 읽고 쓰므로, 이 이미지는 일반 디스크로 곧바로 열렸습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„macOS“ pati skaito ir rašo exFAT, todėl šis atvaizdis buvo atvertas tiesiogiai kaip įprastas diskas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pats lasa un raksta exFAT, tāpēc šis attēls tika atvērts tieši kā parasts disks."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS membaca dan menulis exFAT sendiri, jadi imej ini dibuka terus sebagai cakera biasa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS leser og skriver exFAT selv, så dette diskbildet ble åpnet direkte som en vanlig disk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS leest en schrijft exFAT zelf, dus deze schijfkopie is rechtstreeks geopend als een gewone schijf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS sam odczytuje i zapisuje exFAT, więc ten obraz został otwarty bezpośrednio jako zwykły dysk."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS lê e escreve exFAT por si, pelo que esta imagem foi aberta diretamente como um disco comum."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS citește și scrie exFAT singur, așa că această imagine a fost deschisă direct, ca un disc obișnuit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS читает и записывает exFAT сам, поэтому этот образ был открыт напрямую как обычный диск."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS exFAT bere in zapisuje sam, zato je bila ta slika odprta neposredno kot običajen disk."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS e lexon dhe e shkruan vetë exFAT, ndaj ky imazh u hap drejtpërdrejt si disk i zakonshëm."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS läser och skriver exFAT självt, så den här avbilden öppnades direkt som en vanlig disk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS อ่านและเขียน exFAT ได้เอง อิมเมจนี้จึงถูกเปิดตรงเป็นดิสก์ธรรมดา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "exFAT biçimini macOS zaten kendisi okuyup yazar, bu yüzden bu imaj doğrudan sıradan bir disk olarak açıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS читає та записує exFAT сам, тож цей образ було відкрито напряму як звичайний диск."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS tự đọc và ghi exFAT, nên ảnh đĩa này được mở thẳng như một đĩa thông thường."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "exFAT 由 macOS 自己读写，因此这个映像被直接作为普通磁盘打开。"
          }
        }
      }
    },
