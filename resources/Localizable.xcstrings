          }
        }
      }
    },
    "Click + at the bottom of the list, select %@ in Applications, and switch it on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر + في أسفل القائمة، واختر %@ في التطبيقات، ثم شغّله."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Щракнете + в долния край на списъка, изберете %@ в Applications и го включете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na + v dolní části seznamu, vyberte %@ ve složce Aplikace a zapněte jej."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på + nederst i listen, vælg %@ i Programmer, og slå den til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke unten in der Liste auf +, wähle %@ in „Programme“ und schalte es ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κλικ στο + στο κάτω μέρος της λίστας, επιλέξτε το %@ στις Εφαρμογές και ενεργοποιήστε το."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en + al final de la lista, selecciona %@ en Aplicaciones y actívalo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klõpsa loendi allservas +, vali %@ kaustast Rakendused ja lülita see sisse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoita luettelon alareunassa +, valitse %@ Ohjelmat-kansiosta ja kytke se päälle."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-click ang + sa ibaba ng listahan, piliin ang %@ sa Applications, at buksan ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur + en bas de la liste, sélectionnez %@ dans Applications et activez-le."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחצו על + בתחתית הרשימה, בחרו את %@ בתיקיית היישומים והפעילו אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूची के नीचे + पर क्लिक करें, Applications में %@ चुनें और उसे चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknite + na dnu popisa, odaberite %@ u mapi Aplikacije i uključite ga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kattintson a lista alján a + gombra, válassza ki a(z) %@ alkalmazást az Alkalmazások mappában, és kapcsolja be."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik + di bagian bawah daftar, pilih %@ di Applications, lalu nyalakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su + in fondo all’elenco, seleziona %@ in Applicazioni e attivalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストの下部にある + をクリックし、「アプリケーション」から %@ を選んでオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록 아래쪽의 +를 클릭하고 응용 프로그램에서 %@을(를) 선택한 뒤 켜십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sąrašo apačioje spustelėkite +, aplanke „Programos“ pasirinkite „%@“ ir įjunkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noklikšķiniet uz + saraksta apakšā, mapē Programmas atlasiet %@ un ieslēdziet to."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik + di bahagian bawah senarai, pilih %@ dalam Applications, kemudian hidupkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på + nederst i listen, velg %@ i Programmer, og slå den på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik onder in de lijst op +, selecteer %@ in Programma's en zet die aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij + na dole listy, wybierz %@ w Programach i włącz go."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em + no fim da lista, selecione o %@ em Aplicações e ative-o."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți clic pe + în partea de jos a listei, selectați %@ în Aplicații și activați-l."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите + внизу списка, выберите %@ в папке «Программы» и включите его."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknite + na dnu seznama, izberite %@ v mapi Programi in ga vklopite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliko + në fund të listës, zgjidh %@ te Applications dhe aktivizoje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på + längst ned i listan, välj %@ i Program och slå på den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิก + ที่ด้านล่างของรายการ เลือก %@ ใน Applications แล้วเปิดใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listenin altındaki + düğmesine tıklayın, Uygulamalar içinden %@ seçin ve açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть + унизу списку, виберіть %@ у теці «Програми» та увімкніть його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm + ở cuối danh sách, chọn %@ trong Applications rồi bật lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按列表底部的 +，在“应用程序”中选择 %@，然后将其打开。"
          }
        }
      }
    },
    "Come back to this window and click Relaunch.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عد إلى هذه النافذة وانقر إعادة التشغيل."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Върнете се в този прозорец и щракнете Рестартирай."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraťte se do tohoto okna a klepněte na Spustit znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom tilbage til dette vindue, og klik på Start igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komm zu diesem Fenster zurück und klicke auf „Neu starten“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιστρέψτε σε αυτό το παράθυρο και κάντε κλικ στην Επανεκκίνηση."
          }
        },
        "es": {
          "stringUnit": {
