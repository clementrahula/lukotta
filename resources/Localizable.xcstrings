    "Appears only while a drive is unlocked, for ejecting it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر فقط أثناء وجود محرّك مفتوح، لإخراجه."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Появява се само докато диск е отключен, за да бъде изваден."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí se jen tehdy, když je disk odemčený, kvůli jeho vysunutí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises kun, mens en enhed er låst op, så den kan skubbes ud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint nur, solange ein Laufwerk entsperrt ist, zum Auswerfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζεται μόνο όσο ένας δίσκος είναι ξεκλείδωτος, για την εξαγωγή του."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo aparece mientras hay un disco desbloqueado, para expulsarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmub ainult siis, kui ketas on avatud, selle väljutamiseks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näkyy vain, kun asema on avattuna, sen käytöstä poistamista varten."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumalabas lamang habang nakabukas ang isang drive, para i-eject ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’apparaît que lorsqu’un disque est déverrouillé, pour l’éjecter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מופיע רק בזמן שכונן פתוח, כדי להוציא אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल तब दिखता है जब कोई ड्राइव अनलॉक हो, उसे निकालने के लिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojavljuje se samo dok je disk otključan, radi izbacivanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak akkor jelenik meg, ha egy meghajtó fel van oldva, a kiadásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Muncul hanya selama drive terbuka, untuk mengeluarkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appare solo quando un disco è sbloccato, per espellerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライブがロック解除されているあいだだけ、取り出すために表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드라이브가 잠금 해제된 동안에만, 추출할 수 있도록 표시됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodoma tik tada, kai diskas atrakintas, kad jį būtų galima išstumti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parādās tikai tad, kad disks ir atbloķēts, lai to izstumtu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muncul hanya semasa sesebuah pemacu terbuka, untuk mengeluarkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises bare mens en enhet er låst opp, for å mate den ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschijnt alleen zolang een schijf ontgrendeld is, om die te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojawia się tylko wtedy, gdy dysk jest odblokowany, aby go wysunąć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece apenas enquanto houver um disco desbloqueado, para o ejetar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apare doar cât timp un disc este deblocat, pentru a-l ejecta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Появляется только пока диск разблокирован, чтобы его извлечь."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaže se le, dokler je pogon odklenjen, za njegov izmet."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shfaqet vetëm kur një disk është i shkyçur, për ta nxjerrë atë."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visas bara medan en enhet är upplåst, för att mata ut den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรากฏเฉพาะขณะที่มีไดรฟ์ปลดล็อกอยู่ เพื่อใช้ดันออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bir sürücü açıkken, onu çıkarmak için görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З’являється лише поки диск розблоковано, щоб вилучити його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
