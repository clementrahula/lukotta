            "state": "translated",
            "value": "macOS не можа да отвори този файл като дисков образ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS nedokázal tento soubor otevřít jako obraz disku."
          }
        },
        "da": {
