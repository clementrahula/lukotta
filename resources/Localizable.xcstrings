    "Open Privacy & Security → Full Disk Access.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الخصوصية والأمان ← الوصول الكامل إلى القرص."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворете „Privacy & Security“ → „Full Disk Access“."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete „Soukromí a zabezpečení“ → „Plný přístup k disku“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn “Anonymitet & sikkerhed” → “Fuld adgang til disk”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne „Datenschutz & Sicherheit“ → „Festplattenvollzugriff“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε «Απόρρητο και ασφάλεια» → «Πλήρης πρόσβαση στον δίσκο»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre «Privacidad y seguridad» → «Acceso total al disco»."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava „Privacy & Security“ → „Full Disk Access“."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa ”Tietosuoja ja suojaus” → ”Koko levyn käyttö”."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang Privacy & Security → Full Disk Access."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez « Confidentialité et sécurité » → « Accès complet au disque »."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו פרטיות ואבטחה ← גישה מלאה לדיסק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गोपनीयता और सुरक्षा → पूर्ण डिस्क ऐक्सेस खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite „Privatnost i sigurnost” → „Puni pristup disku”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyissa meg az „Adatvédelem és biztonság” → „Teljes hozzáférés a lemezhez” beállítást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Privasi & Keamanan → Akses Disk Penuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri «Privacy e sicurezza» → «Accesso completo al disco»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「プライバシーとセキュリティ」→「フルディスクアクセス」を開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보 보호 및 보안 → 전체 디스크 접근 권한을 여십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atverkite „Privacy & Security“ → „Full Disk Access“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atveriet “Privacy & Security” → “Full Disk Access”."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Privasi & Keselamatan → Akses Cakera Penuh."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne «Personvern og sikkerhet» → «Full disktilgang»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open ‘Privacy en beveiliging’ → ‘Volledige schijftoegang’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz „Prywatność i ochrona” → „Pełny dostęp do dysku”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra «Privacidade e segurança» → «Acesso completo ao disco»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți „Intimitate și securitate” → „Acces complet la disc”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Конфиденциальность и безопасность → Полный доступ к диску."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odprite „Privacy & Security“ → »Full Disk Access«."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Hap Privacy & Security → Full Disk Access."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna ”Integritet och säkerhet” → ”Full skivtillgång”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด ความเป็นส่วนตัวและความปลอดภัย → การเข้าถึงดิสก์เต็มรูปแบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik ve Güvenlik → Tam Disk Erişimi açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Конфіденційність і безпека → Повний доступ до диска."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Quyền riêng tư & Bảo mật → Toàn quyền truy cập đĩa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“隐私与安全性”→“完全磁盘访问权限”。"
          }
        }
      }
    },
