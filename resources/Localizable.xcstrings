    "Removable volumes — requested by macOS the first time a drive is read": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Removable Volumes — macOS го изисква при първото четене на диск"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udskiftelige enheder — macOS beder om den, første gang en enhed læses"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernbare Volumes — von macOS beim ersten Lesen eines Laufwerks angefordert"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
