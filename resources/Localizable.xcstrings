            "state": "translated",
            "value": "Sprawdzanie wszystkich dysków…"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificar todos os discos…"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se verifică toate discurile…"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preverjanje vseh diskov…"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollerar alla diskar…"
          }
        }
      }
    },
    "Choose File → Open Disk Image, or File → Open Drive to see every disk attached to this Mac and what %@ can do with each": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете Файл → Отвори дисков образ или Файл → Отвори диск, за да видите всеки диск, свързан с този Mac, и какво %@ може да направи с него"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte Soubor → Otevřít obraz disku, nebo Soubor → Otevřít disk, kde uvidíte každý disk připojený k tomuto Macu a co s ním %@ zvládne"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg Arkiv → Åbn diskbillede, eller Arkiv → Åbn disk for at se alle diske tilsluttet denne Mac, og hvad %@ kan gøre med hver enkelt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Ablage → Image öffnen“ oder „Ablage → Laufwerk öffnen“, um jedes an diesen Mac angeschlossene Laufwerk zu sehen und was %@ damit tun kann"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε Αρχείο → Άνοιγμα ειδώλου δίσκου ή Αρχείο → Άνοιγμα δίσκου για να δείτε κάθε δίσκο συνδεδεμένο σε αυτόν τον Mac και τι μπορεί να κάνει το %@ με τον καθένα"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Archivo → Abrir imagen de disco, o Archivo → Abrir disco para ver todos los discos conectados a este Mac y qué puede hacer %@ con cada uno"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali Fail → Ava kettatõmmis või Fail → Ava ketas, et näha kõiki selle Maciga ühendatud kettaid ja seda, mida %@ igaühega teha saab"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse Arkisto → Avaa levytiedosto tai Arkisto → Avaa asema nähdäksesi kaikki tähän Maciin liitetyt levyt ja sen, mitä %@ voi kullekin tehdä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Fichier → Ouvrir une image disque, ou Fichier → Ouvrir un disque pour voir chaque disque relié à ce Mac et ce que %@ peut en faire"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite Datoteka → Otvori sliku diska ili Datoteka → Otvori disk kako biste vidjeli svaki disk priključen na ovaj Mac i što %@ može učiniti sa svakim"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza a Fájl → Lemezkép megnyitása vagy a Fájl → Meghajtó megnyitása menüpontot, hogy lássa a Machez csatlakoztatott összes lemezt, és azt, mit tud velük a(z) %@ kezdeni"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli Archivio → Apri immagine disco, oppure Archivio → Apri disco per vedere ogni disco collegato a questo Mac e che cosa %@ può farne"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirinkite Failas → Atverti disko atvaizdį arba Failas → Atverti diską, kad pamatytumėte kiekvieną prie šio „Mac“ prijungtą diską ir tai, ką %@ gali su kiekvienu padaryti"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvēlieties Fails → Atvērt diska attēlu vai Fails → Atvērt disku, lai redzētu katru šim Mac pievienoto disku un to, ko %@ ar katru var izdarīt"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg Arkiv → Åpne diskbilde, eller Arkiv → Åpne disk for å se hver disk som er koblet til denne Macen, og hva %@ kan gjøre med hver av dem"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies Archief → Open schijfkopie, of Archief → Open schijf om elke schijf te zien die op deze Mac is aangesloten en wat %@ met elke schijf kan doen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz Plik → Otwórz obraz dysku albo Plik → Otwórz dysk, aby zobaczyć każdy dysk podłączony do tego Maca i to, co %@ może z nim zrobić"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha Ficheiro → Abrir imagem de disco, ou Ficheiro → Abrir disco para ver todos os discos ligados a este Mac e o que o %@ pode fazer com cada um"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți Fișier → Deschide imagine de disc sau Fișier → Deschide disc pentru a vedea fiecare disc conectat la acest Mac și ce poate face %@ cu fiecare"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite Datoteka → Odpri sliko diska ali Datoteka → Odpri disk, da vidite vsak disk, priključen na ta Mac, in kaj lahko %@ z vsakim naredi"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj Arkiv → Öppna skivavbild, eller Arkiv → Öppna disk för att se varje disk som är ansluten till den här datorn och vad %@ kan göra med var och en"
          }
        }
      }
    },
    "Choose a disk image or container file to open.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете дисков образ или контейнерен файл за отваряне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte obraz disku nebo kontejnerový soubor k otevření."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et diskbillede eller en containerfil, der skal åbnes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Image oder eine Containerdatei zum Öffnen aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε είδωλο δίσκου ή αρχείο κοντέινερ για άνοιγμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una imagen de disco o un archivo contenedor para abrir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali avamiseks kettatõmmis või konteinerfail."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse avattava levytiedosto tai säilötiedosto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une image disque ou un fichier conteneur à ouvrir."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite sliku diska ili datoteku spremnika za otvaranje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon megnyitandó lemezképet vagy tárolófájlt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un’immagine disco o un file contenitore da aprire."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasirinkite atvertiną disko atvaizdį arba konteinerio failą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvēlieties atveramo diska attēlu vai konteinera failu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et diskbilde eller en beholderfil som skal åpnes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een schijfkopie of containerbestand om te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz obraz dysku lub plik kontenera do otwarcia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma imagem de disco ou um ficheiro de contentor para abrir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți o imagine de disc sau un fișier container pentru deschidere."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite sliko diska ali datoteko vsebnika za odprtje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en skivavbild eller containerfil som ska öppnas."
          }
        }
      }
    },
    "Click + and add %@, then switch it on.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Щракнете върху „+“, добавете %@ и го включете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikněte na „+“, přidejte %@ a zapněte přepínač."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på “+”, tilføj %@, og slå den til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf „+“, füge %@ hinzu und aktiviere den Schalter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κλικ στο «+», προσθέστε το %@ και ενεργοποιήστε το."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en «+», añade %@ y actívalo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klõpsa „+“, lisa %@ ja lülita see sisse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoita ”+”, lisää %@ ja ota se käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur « + », ajoutez %@, puis activez l’option."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknite „+”, dodajte %@ i uključite ga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kattintson a „+” gombra, adja hozzá a(z) %@ programot, majd kapcsolja be."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su «+», aggiungi %@ e attivalo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustelėkite „+“, pridėkite %@ ir įjunkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noklikšķiniet uz “+”, pievienojiet %@ un ieslēdziet to."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på «+», legg til %@ og slå den på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op ‘+’, voeg %@ toe en schakel het in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij „+”, dodaj %@ i włącz przełącznik."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em «+», adicione o %@ e ative-o."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți clic pe „+”, adăugați %@ și activați-l."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknite »+«, dodajte %@ in ga vklopite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på ”+”, lägg till %@ och slå på det."
          }
        }
      }
    },
