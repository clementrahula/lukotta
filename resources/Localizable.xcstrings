    "Removable volumes: requested by macOS the first time a drive is read": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وحدات التخزين القابلة للإزالة: يطلبها macOS عند أول قراءة لمحرّك"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сменяеми носители: macOS го иска при първото четене на диск"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyměnitelné svazky: macOS si o ně řekne, když se disk čte poprvé"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytbare enheder: macOS beder om den, første gang en disk læses"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselmedien: macOS fragt danach, wenn ein Laufwerk zum ersten Mal gelesen wird"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαιρούμενοι τόμοι: το macOS τη ζητά την πρώτη φορά που διαβάζεται ένας δίσκος"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volúmenes extraíbles: macOS lo pide la primera vez que se lee un disco"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eemaldatavad andmekandjad: macOS küsib seda, kui ketast esimest korda loetakse"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Irrotettavat taltiot: macOS pyytää sitä, kun levy luetaan ensimmäisen kerran"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga removable volume: hinihiling ng macOS sa unang pagbasa ng isang drive"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumes amovibles : demandé par macOS la première fois qu’un disque est lu"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אמצעי אחסון נשלפים: ‏macOS מבקש זאת בפעם הראשונה שכונן נקרא"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाने योग्य वॉल्यूम: ड्राइव पहली बार पढ़े जाने पर macOS माँगता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklonjivi mediji: macOS to traži kad se disk čita prvi put"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Cserélhető kötetek: a macOS akkor kéri, amikor először olvas egy lemezt"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume lepasan: diminta macOS saat sebuah drive pertama kali dibaca"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumi rimovibili: macOS lo chiede la prima volta che legge un disco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リムーバブルボリューム：ドライブを最初に読むときに macOS が要求します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동식 볼륨: 드라이브를 처음 읽을 때 macOS가 요청합니다"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Keičiamosios laikmenos: „macOS“ to paprašo, kai diskas skaitomas pirmą kartą"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noņemamie datu nesēji: macOS to pieprasa, kad disks tiek lasīts pirmo reizi"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Volum boleh tanggal: diminta oleh macOS pada kali pertama sesebuah pemacu dibaca"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyttbare medier: macOS ber om den første gang en disk leses"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwisselbare volumes: macOS vraagt erom zodra een schijf voor het eerst wordt gelezen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nośniki wymienne: macOS prosi o to przy pierwszym odczycie dysku"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumes amovíveis: pedido pelo macOS na primeira vez que um disco é lido"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume amovibile: macOS îl cere prima dată când citește un disc"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Съёмные тома: запрашивается macOS при первом чтении диска"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmenljivi nosilci: macOS to zahteva, ko se disk prvič bere"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume të lëvizshme: kërkohet nga macOS herën e parë që lexohet një disk"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyttbara enheter: macOS ber om den första gången en disk läses"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โวลุ่มแบบถอดได้: macOS จะขอสิทธิ์นี้ครั้งแรกที่อ่านไดรฟ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkarılabilir birimler: bir sürücü ilk kez okunduğunda macOS tarafından istenir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знімні томи: запитується macOS під час першого читання диска"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đĩa tháo lắp được: macOS xin quyền này ở lần đầu đọc một ổ đĩa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可移除宗卷：首次读取驱动器时由 macOS 申请"
          }
        }
      }
    },
