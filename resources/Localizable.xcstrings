    "Click + and add %@, then switch it on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf „+“, füge %@ hinzu und aktiviere den Schalter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en «+», añade %@ y actívalo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klõpsa „+“, lisa %@ ja lülita see sisse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoita ”+”, lisää %@ ja ota se käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur « + », ajoutez %@, puis activez l’option."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su «+», aggiungi %@ e attivalo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noklikšķiniet uz “+”, pievienojiet %@ un ieslēdziet to."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op ‘+’, voeg %@ toe en schakel het in."
          }
        },
        "pl": {
