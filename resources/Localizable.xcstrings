    "Administrator password — asked for once when the background helper is set up, then not again. %@ never sees it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Administratorpasswort — wird einmal beim Einrichten des Hintergrund-Helfers abgefragt, danach nicht mehr. %@ sieht es nie"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraseña de administrador: se pide una sola vez al configurar el asistente en segundo plano y nunca más. %@ no la ve nunca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mot de passe administrateur — demandé une seule fois lors de la configuration de l’assistant en arrière-plan, puis plus jamais. %@ ne le voit jamais"
          }
        },
        "it": {
          "stringUnit": {
