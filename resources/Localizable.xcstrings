    "“%@” needs “%@”, which is not beside it. An image of this kind is a set of files, and all of them are required.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج “%@” إلى “%@”، وهو ليس بجانبه. الصورة من هذا النوع مجموعة ملفات، وكلها مطلوبة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ се нуждае от „%2$@“, който не е до него. Образ от този вид е набор от файлове и всички те са задължителни."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ potřebuje „%2$@“, který vedle něj není. Obraz tohoto druhu je sada souborů a vyžadovány jsou všechny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” har brug for “%2$@”, som ikke ligger ved siden af den. Et diskbillede af denne slags er et sæt filer, og de kræves alle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ benötigt „%2$@“, das nicht daneben liegt. Ein Image dieser Art besteht aus mehreren Dateien, und alle davon sind erforderlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%1$@» χρειάζεται το «%2$@», το οποίο δεν βρίσκεται δίπλα του. Ένα είδωλο αυτού του είδους είναι σύνολο αρχείων και απαιτούνται όλα τους."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» necesita «%2$@», que no está junto a él. Una imagen de este tipo es un conjunto de archivos, y todos ellos son necesarios."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ vajab faili „%2$@“, mida tema kõrval ei ole. Sellist liiki tõmmis on failide kogum ja vaja on neid kõiki."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” tarvitsee tiedoston ”%2$@”, jota ei ole sen vieressä. Tämänkaltainen levytiedosto on joukko tiedostoja, ja niitä tarvitaan kaikki."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng “%@” ang “%@”, na wala sa tabi nito. Ang ganitong uri ng image ay isang pangkat ng mga file, at kailangan silang lahat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » a besoin de « %2$@ », qui ne se trouve pas à côté. Une image de ce type est un ensemble de fichiers, et tous sont requis."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏“%@” זקוק ל‑“%@”, שאינו לצידו. תמונה מסוג זה היא אוסף קבצים, וכולם נדרשים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” को “%@” चाहिए, जो उसके पास नहीं है। इस तरह की इमेज फ़ाइलों का समूह होती है, और उन सभी की ज़रूरत होती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” treba „%2$@”, koja nije pored nje. Slika ove vrste skup je datoteka i potrebne su sve."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%1$@” fájlhoz szükséges a(z) „%2$@”, amely nincs mellette. Az ilyen lemezkép fájlok együttese, és mindegyikre szükség van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” memerlukan “%@”, yang tidak ada di sebelahnya. Image semacam ini adalah sekumpulan berkas, dan semuanya diperlukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» richiede «%2$@», che non si trova accanto a esso. Un’immagine di questo tipo è un insieme di file, e servono tutti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」には隣にない「%@」が必要です。この種のイメージはファイルの集合で、そのすべてが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”에는 옆에 없는 “%@”이(가) 필요합니다. 이런 종류의 이미지는 파일의 묶음이며 그 전부가 필요합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ reikia failo „%2$@“, kurio šalia nėra. Tokio tipo atvaizdis yra failų rinkinys ir reikalingi visi jie."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ir nepieciešams “%2$@”, kas neatrodas tam blakus. Šāda veida attēls ir failu kopa, un nepieciešami ir visi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” memerlukan “%@”, yang tiada di sebelahnya. Imej jenis ini ialah satu set fail, dan kesemuanya diperlukan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» trenger «%2$@», som ikke ligger ved siden av den. Et diskbilde av dette slaget er et sett med filer, og alle kreves."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’ heeft ‘%2$@’ nodig, dat er niet naast staat. Een schijfkopie van dit type bestaat uit een reeks bestanden, die allemaal vereist zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” wymaga pliku „%2$@”, którego nie ma obok. Obraz tego rodzaju to zestaw plików i wymagane są wszystkie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» necessita de «%2$@», que não se encontra ao seu lado. Uma imagem deste tipo é um conjunto de ficheiros, sendo todos necessários."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” are nevoie de „%2$@”, care nu se află lângă el. O imagine de acest tip este un set de fișiere, iar toate sunt necesare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» требует «%@», которого нет рядом. Образ такого рода — это набор файлов, и нужны все они."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%1$@« potrebuje »%2$@«, ki ni ob njej. Slika te vrste je nabor datotek in potrebne so vse."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ka nevojë për “%@”, i cili nuk ndodhet pranë tij. Një imazh i këtij lloji është një grup skedarësh, dhe të gjithë janë të nevojshëm."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” behöver ”%2$@”, som inte ligger bredvid den. En skivavbild av det här slaget är en uppsättning filer, och alla krävs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ต้องใช้ “%@” ซึ่งไม่ได้อยู่ข้างกัน อิมเมจแบบนี้เป็นชุดของไฟล์ และต้องมีครบทุกไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” için yanında bulunmayan “%@” gerekli. Bu türden bir imaj bir dosya kümesidir ve hepsi gereklidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» потребує «%@», якого немає поруч. Образ такого роду — це набір файлів, і потрібні всі вони."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” cần “%@”, nhưng tệp đó không nằm cạnh nó. Ảnh đĩa loại này là một bộ tệp, và cần tất cả chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”需要“%@”，而后者并不在它旁边。这类映像是一组文件，缺一不可。"
          }
        }
