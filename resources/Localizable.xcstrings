    "If it is already in the list, switch it on instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن كان موجودًا في القائمة أصلًا، فشغّله فحسب."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ако вече е в списъка, просто го включете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud už v seznamu je, stačí jej zapnout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis den allerede står på listen, skal du bare slå den til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steht es schon in der Liste, schalte es einfach ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν βρίσκεται ήδη στη λίστα, απλώς ενεργοποιήστε το."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ya está en la lista, basta con activarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui see on juba loendis, lülita see lihtsalt sisse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos se on jo luettelossa, kytke se vain päälle."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung nasa listahan na ito, buksan na lamang ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’il figure déjà dans la liste, il suffit de l’activer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם הוא כבר ברשימה, פשוט הפעילו אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि वह पहले से सूची में है, तो बस उसे चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako je već na popisu, samo ga uključite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha már szerepel a listán, csak kapcsolja be."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika sudah ada di daftar, cukup nyalakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se è già nell’elenco, basta attivarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにリストにある場合は、オンにするだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 목록에 있다면 켜기만 하면 됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jei jau yra sąraše, tiesiog jį įjunkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja tā jau ir sarakstā, vienkārši ieslēdziet to."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ia sudah ada dalam senarai, hidupkannya sahaja."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Står det allerede i listen, er det bare å slå det på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat die er al in, zet die dan gewoon aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli jest już na liście, po prostu go włącz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se já estiver na lista, basta ativá-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă se află deja în listă, doar activați-l."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если он уже в списке, просто включите его."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če je že na seznamu, ga samo vklopite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nëse është tashmë në listë, thjesht aktivizoje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Finns det redan i listan räcker det att slå på det."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้ามีอยู่ในรายการแล้ว ให้เปิดใช้งานได้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten listedeyse yalnızca açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо він уже у списку, просто увімкніть його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu nó đã có trong danh sách, chỉ cần bật lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果它已在列表中，直接打开即可。"
          }
        }
      }
    },
    "Images that name another file: a VMware snapshot chain, a differencing VHD, a VHDX with a parent, or a qcow2 with a backing file. %@ opens no image that decides which other files get read": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصور التي تسمّي ملفًا آخر: سلسلة لقطات VMware، أو VHD فارقي، أو VHDX له أصل، أو qcow2 له ملف مساند. لا يفتح %@ أي صورة تقرر بنفسها أي ملفات أخرى ستُقرأ"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Образи, които сочат към друг файл: верига от снимки на VMware, диференциращ VHD, VHDX с родител или qcow2 с базов файл. %@ не отваря образ, който определя кои други файлове да бъдат прочетени"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazy odkazující na jiný soubor: řetěz snímků VMware, rozdílový VHD, VHDX s rodičem nebo qcow2 se základním souborem. %@ neotevírá obraz, který určuje, které další soubory se přečtou"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskbilleder, der henviser til en anden fil: en VMware-snapshotkæde, en differencing-VHD, en VHDX med en forælder eller en qcow2 med en backing-fil. %@ åbner ikke diskbilleder, der bestemmer, hvilke andre filer der læses"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Images, die eine andere Datei benennen: eine VMware-Snapshot-Kette, eine differenzierende VHD, eine VHDX mit übergeordnetem Image oder eine qcow2 mit Backing-Datei. %@ öffnet kein Image, das bestimmt, welche anderen Dateien gelesen werden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είδωλα που παραπέμπουν σε άλλο αρχείο: αλυσίδα στιγμιοτύπων VMware, διαφορικό VHD, VHDX με γονικό είδωλο ή qcow2 με αρχείο υποστήριξης. Το %@ δεν ανοίγει είδωλο που καθορίζει ποια άλλα αρχεία θα διαβαστούν"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imágenes que nombran otro archivo: una cadena de instantáneas de VMware, un VHD diferencial, un VHDX con imagen principal o un qcow2 con archivo base. %@ no abre imágenes que decidan qué otros archivos se leen"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõmmised, mis nimetavad teist faili: VMware'i tõmmiseahel, vahetõmmisega VHD, vanemtõmmisega VHDX või tugifailiga qcow2. %@ ei ava tõmmist, mis otsustab, milliseid teisi faile loetakse"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Levytiedostot, jotka nimeävät toisen tiedoston: VMwaren tilannevedosketju, differencing-VHD, VHDX jolla on ylätaso tai qcow2 jolla on taustatiedosto. %@ ei avaa levytiedostoa, joka määrää mitä muita tiedostoja luetaan"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga image na nagpapangalan ng ibang file: isang chain ng snapshot ng VMware, isang differencing VHD, isang VHDX na may magulang, o isang qcow2 na may backing file. Hindi nagbubukas ang %@ ng anumang image na siyang nagpapasya kung anong ibang file ang babasahin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images qui désignent un autre fichier : une chaîne d’instantanés VMware, un VHD différentiel, un VHDX avec parent ou un qcow2 avec fichier de base. %@ n’ouvre aucune image qui décide quels autres fichiers sont lus"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונות המפנות לקובץ אחר: שרשרת תצלומי מצב של VMware, ‏VHD הפרשי, ‏VHDX עם הורה, או qcow2 עם קובץ גיבוי. ‏%@ אינו פותח תמונה שמחליטה בעצמה אילו קבצים נוספים ייקראו"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसी इमेज जो किसी और फ़ाइल का नाम लेती हैं: VMware स्नैपशॉट शृंखला, डिफ़रेंसिंग VHD, पैरेंट वाला VHDX, या बैकिंग फ़ाइल वाला qcow2। %@ ऐसी कोई इमेज नहीं खोलता जो यह तय करे कि और कौन-सी फ़ाइलें पढ़ी जाएँगी"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slike koje imenuju drugu datoteku: lanac VMware snimaka, diferencijalni VHD, VHDX s roditeljem ili qcow2 s pozadinskom datotekom. %@ ne otvara sliku koja određuje koje se druge datoteke čitaju"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Más fájlt megnevező lemezképek: VMware-pillanatképlánc, különbségi VHD, szülővel rendelkező VHDX vagy háttérfájlt használó qcow2. A(z) %@ nem nyit meg olyan lemezképet, amely eldönti, mely más fájlok olvashatók"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Image yang menyebut berkas lain: rantai snapshot VMware, VHD diferensial, VHDX dengan induk, atau qcow2 dengan berkas pendukung. %@ tidak membuka image yang menentukan sendiri berkas lain mana yang ikut dibaca"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immagini che nominano un altro file: una catena di snapshot VMware, un VHD differenziale, un VHDX con un’immagine padre o un qcow2 con file di base. %@ non apre immagini che decidono quali altri file vengono letti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のファイルを指すイメージ：VMware のスナップショットチェーン、差分 VHD、親を持つ VHDX、バッキングファイルを持つ qcow2 など。%@ は、ほかにどのファイルを読むかを自分で決めるイメージを開きません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 파일을 가리키는 이미지: VMware 스냅샷 체인, 차등 VHD, 상위가 있는 VHDX, 백킹 파일이 있는 qcow2 등. %@은(는) 어떤 파일을 더 읽을지 스스로 정하는 이미지는 열지 않습니다"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atvaizdžiai, nurodantys kitą failą: „VMware“ momentinių kopijų grandinė, diferencinis VHD, VHDX su pirminiu atvaizdžiu arba qcow2 su pagrindiniu failu. %@ neatveria atvaizdžio, kuris nusprendžia, kurie kiti failai bus skaitomi"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Attēli, kas nosauc citu failu: VMware momentuzņēmumu ķēde, diferencējošs VHD, VHDX ar vecākattēlu vai qcow2 ar pamatfailu. %@ neatver attēlu, kas nosaka, kuri citi faili tiek lasīti"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imej yang menamakan fail lain: rantaian syot kilat VMware, VHD pembezaan, VHDX dengan induk, atau qcow2 dengan fail sandaran. %@ tidak membuka imej yang menentukan sendiri fail lain mana yang turut dibaca"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskbilder som navngir en annen fil: en VMware-øyeblikksbildekjede, en differencing-VHD, en VHDX med et overordnet bilde eller en qcow2 med en backing-fil. %@ åpner ingen diskbilder som bestemmer hvilke andre filer som leses"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schijfkopieën die een ander bestand noemen: een VMware-momentopnamereeks, een differencing-VHD, een VHDX met een bovenliggende schijfkopie of een qcow2 met een backing-bestand. %@ opent geen schijfkopie die bepaalt welke andere bestanden worden gelezen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazy wskazujące inny plik: łańcuch migawek VMware, różnicowy VHD, VHDX z obrazem nadrzędnym albo qcow2 z plikiem bazowym. %@ nie otwiera obrazu, który decyduje, jakie inne pliki zostaną odczytane"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagens que nomeiam outro ficheiro: uma cadeia de instantâneos VMware, um VHD diferencial, um VHDX com imagem-mãe ou um qcow2 com ficheiro de base. O %@ não abre imagens que determinem que outros ficheiros são lidos"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagini care numesc alt fișier: un lanț de instantanee VMware, un VHD diferențial, un VHDX cu imagine părinte sau un qcow2 cu fișier de bază. %@ nu deschide imagini care stabilesc ce alte fișiere sunt citite"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Образы, называющие другой файл: цепочка снимков VMware, разностный VHD, VHDX с родителем или qcow2 с базовым файлом. %@ не открывает образы, которые сами решают, какие ещё файлы будут прочитаны"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slike, ki imenujejo drugo datoteko: veriga posnetkov VMware, razlikovalni VHD, VHDX z nadrejeno sliko ali qcow2 s podporno datoteko. %@ ne odpira slik, ki določajo, katere druge datoteke se berejo"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Imazhe që emërtojnë një skedar tjetër: një zinxhir fotografish VMware, një VHD diferencues, një VHDX me prind, ose një qcow2 me skedar mbështetës. %@ nuk hap asnjë imazh që vendos se cilët skedarë të tjerë lexohen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbilder som namnger en annan fil: en VMware-ögonblicksbildkedja, en differencing-VHD, en VHDX med en överordnad avbild eller en qcow2 med en backing-fil. %@ öppnar inga avbilder som avgör vilka andra filer som läses"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อิมเมจที่อ้างถึงไฟล์อื่น: สายสแนปช็อตของ VMware, VHD แบบส่วนต่าง, VHDX ที่มีอิมเมจแม่ หรือ qcow2 ที่มีไฟล์รองรับ %@ จะไม่เปิดอิมเมจใดที่กำหนดเองว่าจะให้อ่านไฟล์อื่นใดบ้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir dosyayı adlandıran imajlar: bir VMware anlık görüntü zinciri, farksal bir VHD, üst imajı olan bir VHDX veya destek dosyası olan bir qcow2. %@, hangi başka dosyaların okunacağına kendisi karar veren hiçbir imajı açmaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Образи, що називають інший файл: ланцюжок знімків VMware, різницевий VHD, VHDX із батьківським образом або qcow2 з базовим файлом. %@ не відкриває образів, які самі вирішують, які ще файли буде прочитано"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh đĩa trỏ tới tệp khác: chuỗi ảnh chụp VMware, VHD sai biệt, VHDX có ảnh cha, hoặc qcow2 có tệp nền. %@ không mở ảnh đĩa nào tự quyết định những tệp nào khác sẽ được đọc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指向另一个文件的映像：VMware 快照链、差异 VHD、带父映像的 VHDX，或带后备文件的 qcow2。%@ 不会打开任何自行决定还要读取哪些文件的映像"
          }
        }
      }
    },
