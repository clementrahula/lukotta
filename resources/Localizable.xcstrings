        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向这种映像格式写入尚未经过验证"
          }
        }
      }
    },
    "You can read and write files on it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك قراءة الملفات عليه والكتابة إليه."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете да четете и записвате файлове на него."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete na něm číst a zapisovat soubory."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan læse og skrive arkiver på den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst Dateien darauf lesen und schreiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να διαβάζετε και να γράφετε αρχεία σε αυτόν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes leer y escribir archivos en él."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa saad sellele faile lugeda ja kirjutada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit lukea ja kirjoittaa siihen tiedostoja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Makakabasa at makakasulat ka ng mga file dito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez y lire et y écrire des fichiers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לקרוא ולכתוב בו קבצים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप उस पर फ़ाइलें पढ़ और लिख सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na njemu možete čitati i zapisivati datoteke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvashat és írhat rajta fájlokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat membaca dan menulis berkas padanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi leggere e scrivere file al suo interno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そこでファイルの読み書きができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거기에서 파일을 읽고 쓸 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jame galite skaityti ir rašyti failus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūs varat tajā lasīt un rakstīt failus."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh membaca dan menulis fail padanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan lese og skrive filer på den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt er bestanden op lezen en schrijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz na nim odczytywać i zapisywać pliki."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ler e escrever ficheiros nele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți citi și scrie fișiere pe el."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На нём можно читать и записывать файлы."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na njem lahko berete in zapisujete datoteke."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mund të lexosh dhe të shkruash skedarë në të."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan läsa och skriva filer på den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอ่านและเขียนไฟล์บนไดรฟ์นี้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzerinde dosyaları okuyabilir ve yazabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На ньому можна читати й записувати файли."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể đọc và ghi tệp trên nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在它上面读写文件。"
          }
        }
      }
    },
    "You can read files on it. It was opened read-only, so nothing can be written to it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك قراءة الملفات عليه. وقد فُتح للقراءة فقط، فلا يمكن كتابة شيء عليه."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете да четете файловете на него. Беше отворен само за четене, така че нищо не може да бъде записано."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete číst soubory na tomto disku. Byl otevřen jen ke čtení, takže na něj nelze nic zapsat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan læse filer på den. Den blev åbnet kun til læsning, så der kan ikke skrives noget til den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst Dateien darauf lesen. Es wurde nur lesend geöffnet, sodass nichts darauf geschrieben werden kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να διαβάσετε τα αρχεία του. Άνοιξε μόνο για ανάγνωση, οπότε δεν μπορεί να γραφτεί τίποτα σε αυτό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes leer los archivos que contiene. Se abrió en solo lectura, así que no se puede escribir nada en él."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saad selle faile lugeda. See avati ainult lugemiseks, seega sinna kirjutada ei saa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit lukea sen tiedostoja. Se avattiin vain luettavaksi, joten siihen ei voi kirjoittaa mitään."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Makakabasa ka ng mga file dito. Binuksan ito nang read-only, kaya walang maisusulat dito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez lire les fichiers qu’il contient. Il a été ouvert en lecture seule, rien ne peut donc y être écrit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לקרוא בו קבצים. הוא נפתח לקריאה בלבד, ולכן אי אפשר לכתוב אליו דבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप उस पर फ़ाइलें पढ़ सकते हैं। वह केवल पढ़ने के लिए खोली गई थी, इसलिए उस पर कुछ लिखा नहीं जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete čitati datoteke na njemu. Otvoren je samo za čitanje, pa se na njega ništa ne može zapisati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvashatja a rajta lévő fájlokat. Csak olvasásra nyílt meg, így semmi nem írható rá."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat membaca berkas padanya. Ia dibuka baca-saja, jadi tidak ada yang dapat ditulis padanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi leggere i file che contiene. È stato aperto in sola lettura, quindi non vi si può scrivere nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そこでファイルを読めます。読み出し専用で開いたため、何も書き込めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거기에서 파일을 읽을 수 있습니다. 읽기 전용으로 열렸으므로 아무것도 기록할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Galite skaityti jame esančius failus. Jis atvertas tik skaitymui, todėl į jį nieko įrašyti negalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varat lasīt tajā esošos failus. Tas tika atvērts tikai lasīšanai, tāpēc tajā neko nevar ierakstīt."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh membaca fail padanya. Ia dibuka baca-sahaja, jadi tiada apa-apa boleh ditulis padanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan lese filene på den. Den ble åpnet kun for lesing, så ingenting kan skrives til den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt de bestanden erop lezen. De schijf is alleen-lezen geopend, dus er kan niets naar worden geschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz czytać znajdujące się na nim pliki. Został otwarty tylko do odczytu, więc nic nie da się na nim zapisać."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ler os ficheiros que contém. Foi aberto apenas para leitura, pelo que nada lhe pode ser escrito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți citi fișierele de pe el. A fost deschis doar pentru citire, așa că nu se poate scrie nimic pe el."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На нём можно читать файлы. Он открыт только для чтения, поэтому записать на него ничего нельзя."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteke na njem lahko berete. Odprt je bil samo za branje, zato nanj ni mogoče ničesar zapisati."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mund të lexosh skedarë në të. U hap si vetëm-lexim, ndaj asgjë nuk mund të shkruhet në të."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan läsa filerna på den. Den öppnades skrivskyddad, så ingenting kan skrivas till den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอ่านไฟล์บนไดรฟ์นี้ได้ ไดรฟ์ถูกเปิดแบบอ่านอย่างเดียว จึงเขียนอะไรลงไปไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üzerinde dosyaları okuyabilirsiniz. Salt okunur açıldı, bu yüzden üzerine hiçbir şey yazılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На ньому можна читати файли. Його відкрито лише для читання, тож записати на нього нічого не можна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể đọc tệp trên nó. Nó được mở ở chế độ chỉ đọc, nên không ghi được gì lên đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在它上面读取文件。它以只读方式打开，因此无法向其写入任何内容。"
          }
        }
      }
    },
    "You can still check whenever you like.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وبإمكانك التحقق متى شئت."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пак можете да проверявате, когато пожелаете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhledávat můžete i nadále kdykoli sami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan stadig selv søge, når du vil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst weiterhin jederzeit selbst suchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε πάντα να ελέγχετε όποτε θέλετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes buscarlas manualmente cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa saad ikka ise kontrollida, millal soovid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit silti tarkistaa milloin haluat."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaari ka pa ring magsuri anumang oras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez toujours vérifier quand vous le souhaitez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אפשר לבדוק מתי שתרצו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जब चाहें तब भी जाँच सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "I dalje možete provjeriti kad god želite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármikor kereshet frissítést saját maga is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda tetap dapat memeriksanya kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi comunque cercarli quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでも自分で確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제든 직접 확인할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis tiek galite tikrinti kada panorėję."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūs joprojām varat meklēt, kad vien vēlaties."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda masih boleh menyemak bila-bila masa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fortsatt søke selv når du vil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt nog steeds zelf zoeken wanneer je wilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadal możesz sprawdzać samodzielnie, kiedy zechcesz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode continuar a procurar quando quiser."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți căuta oricând și singur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы всё равно можете проверить в любой момент."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Še vedno lahko preverite, kadar želite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mund të kontrollosh sërish kurdo që të duash."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fortfarande söka själv när du vill."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังตรวจสอบเองเมื่อไหร่ก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yine de istediğiniz zaman denetleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви все одно можете перевірити будь-коли."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn vẫn có thể kiểm tra bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你仍然可以随时检查。"
          }
        }
      }
    },
    "Your drives are set to open again after a restart, but Full Disk Access is no longer granted. A macOS update, a move or a reinstall can remove it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محرّكاتك معدّة لتُفتح من جديد بعد إعادة التشغيل، لكن الوصول الكامل إلى القرص لم يعد ممنوحًا. وقد يزيله تحديث لـ macOS أو نقل التطبيق أو إعادة تثبيته."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дисковете ви са настроени да се отварят отново след рестарт, но пълният достъп до диска вече не е разрешен. Актуализация на macOS, преместване или преинсталиране могат да го премахнат."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Disky se mají po restartu znovu otevřít, ale plný přístup k disku už není udělen. Aktualizace macOS, přesunutí nebo přeinstalace ho mohou odebrat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine diske er indstillet til at åbne igen efter en genstart, men fuld adgang til disk er ikke længere givet. En macOS-opdatering, en flytning eller en geninstallation kan fjerne den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Laufwerke sollen nach einem Neustart wieder geöffnet werden, doch der Festplattenvollzugriff ist nicht mehr erteilt. Ein macOS-Update, ein Verschieben oder eine Neuinstallation kann ihn entfernen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι δίσκοι σας έχουν οριστεί να ανοίγουν ξανά μετά την επανεκκίνηση, αλλά η πλήρης πρόσβαση στον δίσκο δεν παρέχεται πλέον. Μια ενημέρωση του macOS, μια μετακίνηση ή μια επανεγκατάσταση μπορεί να την αφαιρέσει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus discos están configurados para abrirse de nuevo tras reiniciar, pero el acceso total al disco ya no está concedido. Una actualización de macOS, un traslado o una reinstalación pueden retirarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Su kettad on seatud pärast taaskäivitust uuesti avanema, kuid täielikku kettaligipääsu enam antud ei ole. macOS-i uuendus, teisaldamine või uuesti paigaldamine võib selle eemaldada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Levysi on asetettu avautumaan uudelleen käynnistyksen jälkeen, mutta täyttä levyoikeutta ei ole enää myönnetty. macOS-päivitys, siirto tai uudelleenasennus voi poistaa sen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakatakda ang iyong mga drive na bumukas muli pagkatapos mag-restart, ngunit hindi na ipinagkakaloob ang Full Disk Access. Maaari itong maalis ng isang update ng macOS, ng paglipat, o ng muling pag-install."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos disques doivent se rouvrir après un redémarrage, mais l’accès complet au disque n’est plus accordé. Une mise à jour de macOS, un déplacement ou une réinstallation peuvent le retirer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכוננים שלך מוגדרים להיפתח שוב לאחר הפעלה מחדש, אך הגישה המלאה לדיסק כבר אינה מוענקת. עדכון של macOS, העברה או התקנה מחדש עלולים להסיר אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी ड्राइव पुनः चालू करने के बाद फिर से खुलने के लिए सेट हैं, लेकिन पूर्ण डिस्क ऐक्सेस अब नहीं दिया गया है। macOS का अपडेट, ऐप का स्थान बदलना या दोबारा इंस्टॉल करना इसे हटा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskovi su postavljeni da se nakon pokretanja ponovno otvore, ali puni pristup disku više nije odobren. Ažuriranje macOS-a, premještanje ili ponovna instalacija mogu ga ukloniti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lemezek úgy vannak beállítva, hogy újraindítás után ismét megnyíljanak, de a teljes lemezhozzáférés már nincs megadva. Egy macOS-frissítés, áthelyezés vagy újratelepítés elveheti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive Anda diatur untuk terbuka lagi setelah dinyalakan ulang, tetapi Akses Disk Penuh tidak lagi diberikan. Pembaruan macOS, pemindahan, atau pemasangan ulang dapat menghapusnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dischi sono impostati per riaprirsi dopo un riavvio, ma l’accesso completo al disco non è più concesso. Un aggiornamento di macOS, uno spostamento o una reinstallazione possono revocarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライブは再起動後にもう一度開くよう設定されていますが、「フルディスクアクセス」がすでに付与されていません。macOS のアップデート、移動、再インストールで外れることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드라이브가 재시동 후 다시 열리도록 설정되어 있지만 전체 디스크 접근 권한이 더 이상 부여되어 있지 않습니다. macOS 업데이트, 앱 이동, 재설치가 이를 없앨 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskai nustatyti atsiverti iš naujo po paleidimo, tačiau visa prieiga prie disko nebesuteikta. „macOS“ naujinys, perkėlimas ar įdiegimas iš naujo gali ją panaikinti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diski ir iestatīti atvērties no jauna pēc restartēšanas, taču pilna piekļuve diskam vairs nav piešķirta. macOS atjauninājums, pārvietošana vai pārinstalēšana to var atņemt."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemacu anda ditetapkan untuk dibuka semula selepas dimulakan semula, tetapi Akses Cakera Penuh tidak lagi diberikan. Kemas kini macOS, pemindahan atau pemasangan semula boleh menghapuskannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskene er satt til å åpnes igjen etter omstart, men full disktilgang er ikke lenger gitt. En macOS-oppdatering, en flytting eller en ominstallering kan fjerne den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je schijven zijn ingesteld om na een herstart opnieuw te openen, maar volledige schijftoegang is niet meer verleend. Een macOS-update, een verplaatsing of een herinstallatie kan die wegnemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyski mają być otwierane ponownie po restarcie, ale pełny dostęp do dysku nie jest już przyznany. Aktualizacja macOS, przeniesienie lub ponowna instalacja mogą go odebrać."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus discos estão definidos para abrir novamente após reiniciar, mas o acesso total ao disco já não está concedido. Uma atualização do macOS, uma mudança de localização ou uma reinstalação podem retirá-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Discurile sunt configurate să se deschidă din nou după repornire, dar accesul complet la disc nu mai este acordat. O actualizare macOS, o mutare sau o reinstalare îl pot retrage."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши диски настроены открываться снова после перезагрузки, но Полный доступ к диску больше не предоставлен. Обновление macOS, перемещение или переустановка могут его снять."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Diski so nastavljeni, da se po ponovnem zagonu znova odprejo, vendar poln dostop do diska ni več odobren. Posodobitev macOS, premik ali ponovna namestitev ga lahko odvzame."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Disqet e tua janë vendosur të hapen sërish pas një rinisjeje, por Full Disk Access nuk është më i dhënë. Një përditësim i macOS, një zhvendosje ose një riinstalim mund ta heqin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina diskar är inställda att öppnas igen efter en omstart, men full diskåtkomst är inte längre beviljad. En macOS-uppdatering, en flytt eller en ominstallation kan ta bort den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไดรฟ์ของคุณถูกตั้งให้เปิดอีกครั้งหลังเริ่มเครื่องใหม่ แต่ การเข้าถึงดิสก์เต็มรูปแบบ ไม่ได้ถูกให้ไว้แล้ว การอัปเดต macOS การย้ายแอป หรือการติดตั้งใหม่ อาจทำให้สิทธิ์นี้หายไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürücüleriniz yeniden başlatmadan sonra yine açılacak biçimde ayarlı, ancak Tam Disk Erişimi artık verilmiş değil. Bir macOS güncellemesi, taşıma ya da yeniden kurulum bunu kaldırabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші диски налаштовано відкриватися знову після перезавантаження, але Повний доступ до диска більше не надано. Оновлення macOS, переміщення або перевстановлення можуть його зняти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ổ đĩa của bạn được đặt để mở lại sau khi khởi động, nhưng Toàn quyền truy cập đĩa không còn được cấp. Một bản cập nhật macOS, việc di chuyển hay cài lại đều có thể gỡ bỏ nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的驱动器已设为重新启动后再次打开，但“完全磁盘访问权限”已不再授予。macOS 更新、移动位置或重新安装都可能取消它。"
          }
        }
      }
    },
