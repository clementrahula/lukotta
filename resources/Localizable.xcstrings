        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumi rimovibili: richiesto da macOS la prima volta che si legge un disco"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Removable Volumes — „macOS“ jo paprašo pirmą kartą skaitant diską"
