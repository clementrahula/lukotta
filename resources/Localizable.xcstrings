    "A drive that refuses to be written to is opened read-only rather than left closed, and says so": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Диск, който отказва да бъде записван, се отваря само за четене, вместо да остане затворен, и го отбелязва"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk, který odmítá zápis, se otevře jen ke čtení, místo aby zůstal zavřený, a řekne to"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et drev, der nægter at blive skrevet til, åbnes kun til læsning i stedet for at forblive lukket, og siger det"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Laufwerk, das sich nicht beschreiben lässt, wird nur lesend geöffnet statt geschlossen zu bleiben, und sagt das"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας δίσκος που αρνείται να γραφτεί ανοίγει μόνο για ανάγνωση αντί να μείνει κλειστός, και το δηλώνει"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un disco que no admite escritura se abre en solo lectura en lugar de quedarse cerrado, y lo indica"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketas, millele kirjutada ei saa, avatakse ainult lugemiseks, mitte ei jäeta avamata, ja ütleb seda"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Levy, johon ei voi kirjoittaa, avataan vain luettavaksi sen sijaan että se jäisi avaamatta, ja kertoo siitä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un disque qui refuse l’écriture est ouvert en lecture seule plutôt que laissé fermé, et le signale"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk na koji se ne može pisati otvara se samo za čitanje umjesto da ostane zatvoren, i to kaže"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az a lemez, amelyre nem lehet írni, csak olvasásra nyílik meg ahelyett, hogy zárva maradna, és ezt jelzi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un disco che rifiuta la scrittura viene aperto in sola lettura anziché restare chiuso, e lo dice"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskas, į kurį įrašyti nepavyksta, atveriamas tik skaitymui, o ne paliekamas neatvertas, ir tai pasako"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Disks, kurā nevar rakstīt, tiek atvērts tikai lasīšanai, nevis atstāts neatvērts, un to pasaka"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En disk som ikke lar seg skrive til, åpnes kun for lesing i stedet for å bli stående lukket, og sier fra om det"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een schijf waarnaar niet geschreven kan worden, wordt alleen-lezen geopend in plaats van dicht te blijven, en meldt dat"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dysk, na którym nie da się zapisywać, zostaje otwarty tylko do odczytu, zamiast pozostać zamknięty, i mówi o tym"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um disco que recusa a escrita é aberto apenas para leitura em vez de ficar fechado, e diz que o foi"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un disc pe care nu se poate scrie este deschis doar pentru citire în loc să rămână închis, și spune asta"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk, na katerega ni mogoče pisati, se odpre samo za branje, namesto da bi ostal zaprt, in to pove"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En disk som inte går att skriva till öppnas skrivskyddad i stället för att lämnas stängd, och säger det"
          }
        }
      }
    },
