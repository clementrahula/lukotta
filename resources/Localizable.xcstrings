    "Click + and add %@, then switch it on.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Щракнете върху „+“, добавете %@ и го включете."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på “+”, tilføj %@, og slå den til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf „+“, füge %@ hinzu und aktiviere den Schalter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κλικ στο «+», προσθέστε το %@ και ενεργοποιήστε το."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en «+», añade %@ y actívalo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Klõpsa „+“, lisa %@ ja lülita see sisse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoita ”+”, lisää %@ ja ota se käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur « + », ajoutez %@, puis activez l’option."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su «+», aggiungi %@ e attivalo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustelėkite „+“, pridėkite %@ ir įjunkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Noklikšķiniet uz “+”, pievienojiet %@ un ieslēdziet to."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op ‘+’, voeg %@ toe en schakel het in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij „+”, dodaj %@ i włącz przełącznik."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em «+», adicione o %@ e ative-o."
          }
        },
        "sv": {
