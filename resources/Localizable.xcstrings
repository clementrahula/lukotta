    "Open Privacy & Security → Full Disk Access.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворете „Privacy & Security“ → „Full Disk Access“."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete „Soukromí a zabezpečení“ → „Plný přístup k disku“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn “Anonymitet & sikkerhed” → “Fuld adgang til disk”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne „Datenschutz & Sicherheit“ → „Festplattenvollzugriff“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε «Απόρρητο και ασφάλεια» → «Πλήρης πρόσβαση στον δίσκο»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre «Privacidad y seguridad» → «Acceso total al disco»."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava „Privacy & Security“ → „Full Disk Access“."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa ”Tietosuoja ja suojaus” → ”Koko levyn käyttö”."
          }
        },
