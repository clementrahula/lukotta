    "Switch on Full Disk Access for %@ in the window that just opened. Without it a drive cannot be read, at login or at any other time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل الوصول الكامل إلى القرص لـ %@ في النافذة التي فُتحت للتو. من دونه لا يمكن قراءة أي محرّك، لا عند تسجيل الدخول ولا في أي وقت آخر."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включете Full Disk Access за %@ в прозореца, който току-що се отвори. Без него диск не може да бъде прочетен, нито при влизане, нито по друго време."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V okně, které se právě otevřelo, zapněte pro %@ Plný přístup k disku. Bez něj disk nelze přečíst, ani při přihlášení, ani jindy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Fuld adgang til disk til for %@ i vinduet, der lige åbnede. Uden den kan en disk ikke læses, hverken ved login eller på andre tidspunkter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte im gerade geöffneten Fenster den Festplattenvollzugriff für %@ ein. Ohne ihn lässt sich kein Laufwerk lesen, weder beim Anmelden noch sonst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε την Πλήρη πρόσβαση στον δίσκο για το %@ στο παράθυρο που μόλις άνοιξε. Χωρίς αυτήν δεν διαβάζεται κανένας δίσκος, ούτε κατά τη σύνδεση ούτε άλλη στιγμή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el Acceso total al disco para %@ en la ventana que acaba de abrirse. Sin él no se puede leer ningún disco, ni al iniciar sesión ni en ningún otro momento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita äsja avanenud aknas rakendusele %@ sisse Full Disk Access. Ilma selleta ei saa ketast lugeda, ei sisselogimisel ega muul ajal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kytke juuri avautuneessa ikkunassa ohjelmalle %@ päälle Koko levyn käyttö. Ilman sitä levyä ei voi lukea, ei kirjautuessa eikä muulloin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang Full Disk Access para sa %@ sa bintanang kabubukas lamang. Kung wala ito, hindi mababasa ang isang drive, sa pag-log in man o anumang oras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l’Accès complet au disque pour %@ dans la fenêtre qui vient de s’ouvrir. Sans lui, aucun disque ne peut être lu, à l’ouverture de session comme à tout autre moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעילו גישה מלאה לדיסק עבור %@ בחלון שנפתח זה עתה. בלעדיה אי אפשר לקרוא כונן, לא בכניסה למערכת ולא בשום זמן אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी खुली विंडो में %@ के लिए पूर्ण डिस्क ऐक्सेस चालू करें। इसके बिना कोई ड्राइव नहीं पढ़ी जा सकती, न लॉग इन पर और न किसी और समय।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U prozoru koji se upravo otvorio uključite Puni pristup disku za %@. Bez toga disk se ne može čitati, ni pri prijavi ni bilo kada drugo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A most megnyílt ablakban kapcsolja be a Teljes hozzáférés a lemezhez beállítást a(z) %@ számára. Enélkül egyetlen lemez sem olvasható, sem bejelentkezéskor, sem máskor."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan Akses Disk Penuh untuk %@ pada jendela yang baru saja terbuka. Tanpa itu sebuah drive tidak dapat dibaca, baik saat masuk maupun kapan pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva l’Accesso completo al disco per %@ nella finestra appena aperta. Senza, nessun disco può essere letto, né all’accesso né in altri momenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いたウインドウで %@ の「フルディスクアクセス」をオンにしてください。これがないと、ログイン時もそれ以外のときも、ドライブを読めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 열린 창에서 %@에 대해 전체 디스크 접근 권한을 켜십시오. 이 권한이 없으면 로그인할 때든 다른 때든 드라이브를 읽을 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ką tik atsivėrusiame lange įjunkite %@ Full Disk Access. Be jo disko perskaityti nepavyks nei prisijungiant, nei bet kada kitada."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tikko atvērtajā logā ieslēdziet %@ Full Disk Access. Bez tās disku nevar nolasīt ne pieteikšanās brīdī, ne citreiz."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Akses Cakera Penuh untuk %@ dalam tetingkap yang baru terbuka. Tanpanya sesebuah pemacu tidak dapat dibaca, sama ada semasa log masuk atau pada bila-bila masa lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Full disktilgang for %@ i vinduet som nettopp åpnet. Uten den kan ingen disk leses, verken ved pålogging eller ellers."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet Volledige schijftoegang aan voor %@ in het venster dat zojuist is geopend. Zonder die toegang kan geen schijf worden gelezen, niet bij het inloggen en niet daarbuiten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W oknie, które właśnie się otworzyło, włącz Pełny dostęp do dysku dla programu %@. Bez tego żaden dysk nie zostanie odczytany, ani przy logowaniu, ani kiedy indziej."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Na janela que acabou de abrir, ative o Acesso completo ao disco para o %@. Sem ele, nenhum disco pode ser lido, nem ao iniciar sessão nem noutra altura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În fereastra care tocmai s-a deschis, activați Acces complet la disc pentru %@. Fără el, niciun disc nu poate fi citit, nici la conectare, nici altcândva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Полный доступ к диску для %@ в только что открывшемся окне. Без него диск нельзя прочитать — ни при входе в систему, ни в любой другой момент."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V oknu, ki se je pravkar odprlo, vklopite Full Disk Access za %@. Brez tega diska ni mogoče brati, ne ob prijavi ne kdaj drugič."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivizo Full Disk Access për %@ në dritaren që sapo u hap. Pa të, një disk nuk mund të lexohet, as gjatë hyrjes as në ndonjë çast tjetër."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Full skivtillgång för %@ i fönstret som just öppnades. Utan den kan ingen disk läsas, varken vid inloggning eller annars."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด การเข้าถึงดิสก์เต็มรูปแบบ ให้ %@ ในหน้าต่างที่เพิ่งเปิดขึ้น หากไม่มีสิทธิ์นี้ จะอ่านไดรฟ์ไม่ได้ ไม่ว่าตอนล็อกอินหรือเวลาใดก็ตาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Az önce açılan pencerede %@ için Tam Disk Erişimi iznini açın. Bu izin olmadan bir sürücü ne oturum açılışında ne de başka bir anda okunabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть Повний доступ до диска для %@ у щойно відкритому вікні. Без нього диск не можна прочитати — ані під час входу, ані будь-коли інше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy bật Toàn quyền truy cập đĩa cho %@ trong cửa sổ vừa mở. Không có nó thì không đọc được ổ đĩa, dù khi đăng nhập hay bất cứ lúc nào khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在刚打开的窗口中为 %@ 开启“完全磁盘访问权限”。没有它，无论是登录时还是其他任何时候，都无法读取驱动器。"
          }
        }
      }
    },
