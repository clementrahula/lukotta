          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam Disk Erişimi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повний доступ до диска"
          }
        },
        "vi": {
          "stringUnit": {
