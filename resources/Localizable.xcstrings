    "Drives sealed to a TPM rather than a password, including Ubuntu's newer hardware-backed encryption": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محرّكات مختومة بشريحة TPM بدل كلمة سر، بما فيها التشفير العتادي الأحدث في Ubuntu"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дискове, обвързани с TPM вместо с парола, включително по-новото хардуерно шифроване на Ubuntu"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Disky vázané na TPM místo na heslo, včetně novějšího hardwarového šifrování v Ubuntu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheder bundet til en TPM i stedet for en adgangskode, herunder Ubuntus nyere hardwarekryptering"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufwerke, die an ein TPM statt an ein Passwort gebunden sind, einschließlich der neueren hardwaregestützten Verschlüsselung von Ubuntu"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δίσκοι δεμένοι με TPM αντί για συνθηματικό, όπως η νεότερη κρυπτογράφηση υλικού του Ubuntu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Discos sellados a un TPM en vez de a una contraseña, incluido el cifrado por hardware más reciente de Ubuntu"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kettad, mis on seotud TPM-iga parooli asemel, sealhulgas Ubuntu uuem riistvarapõhine krüpteering"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asemat, jotka on sidottu TPM-piiriin salasanan sijaan, mukaan lukien Ubuntun uudempi laitepohjainen salaus"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga drive na nakatali sa TPM sa halip na sa password, kasama ang mas bagong hardware-based na pag-encrypt ng Ubuntu"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les disques scellés à un TPM plutôt qu’à un mot de passe, y compris le chiffrement matériel plus récent d’Ubuntu"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כוננים החתומים ל‑TPM במקום לסיסמה, כולל ההצפנה החדשה מבוססת החומרה של Ubuntu"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासवर्ड के बजाय TPM से बंधी ड्राइव, जिसमें Ubuntu का नया हार्डवेयर-आधारित एन्क्रिप्शन भी शामिल है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskovi vezani uz TPM umjesto uz lozinku, uključujući noviju hardversku enkripciju u Ubuntuu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Meghajtók, amelyeket jelszó helyett TPM-hez kötöttek, beleértve az Ubuntu újabb hardveres titkosítását"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive yang disegel ke TPM alih-alih kata sandi, termasuk enkripsi berbasis perangkat keras Ubuntu yang lebih baru"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dischi legati a un TPM anziché a una password, compresa la più recente cifratura basata su hardware di Ubuntu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードではなく TPM に結び付けられたドライブ（Ubuntu の新しいハードウェアベースの暗号化を含む）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호 대신 TPM에 묶인 드라이브. Ubuntu의 최신 하드웨어 기반 암호화를 포함합니다"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskai, susieti su TPM, o ne su slaptažodžiu, įskaitant naujesnį „Ubuntu“ aparatinį šifravimą"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diski, kas piesaistīti TPM, nevis parolei, tostarp Ubuntu jaunākā aparatūras šifrēšana"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemacu yang dimeterai kepada TPM dan bukan kata laluan, termasuk penyulitan berasaskan perkakasan Ubuntu yang lebih baharu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheter bundet til en TPM i stedet for et passord, inkludert Ubuntus nyere maskinvarekryptering"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schijven die aan een TPM zijn gekoppeld in plaats van aan een wachtwoord, waaronder de nieuwere hardwareversleuteling van Ubuntu"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyski powiązane z modułem TPM zamiast z hasłem, w tym nowsze szyfrowanie sprzętowe w Ubuntu"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Discos selados a um TPM em vez de a uma palavra-passe, incluindo a encriptação por hardware mais recente do Ubuntu"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Discuri legate de un TPM în loc de o parolă, inclusiv criptarea hardware mai nouă din Ubuntu"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диски, привязанные к TPM вместо пароля, включая новое аппаратное шифрование Ubuntu"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogoni, vezani na TPM namesto na geslo, vključno z novejšim strojnim šifriranjem v Ubuntuju"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Disqe të vulosur me TPM në vend të një fjalëkalimi, përfshirë enkriptimin më të ri harduerik të Ubuntu-t"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheter bundna till en TPM i stället för ett lösenord, inklusive Ubuntus nyare hårdvarukryptering"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไดรฟ์ที่ผูกกับ TPM แทนรหัสผ่าน รวมถึงการเข้ารหัสด้วยฮาร์ดแวร์รุ่นใหม่ของ Ubuntu"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola yerine TPM'ye bağlanmış sürücüler, Ubuntu'nun yeni donanım destekli şifrelemesi dahil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диски, прив’язані до TPM замість пароля, зокрема нове апаратне шифрування Ubuntu"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đĩa gắn với TPM thay vì mật khẩu, gồm cả mã hóa dựa trên phần cứng mới hơn của Ubuntu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 TPM 而非密码封装的驱动器，包括 Ubuntu 较新的硬件加密"
          }
        }
      }
    },
