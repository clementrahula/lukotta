    "Enter the drive's passphrase.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die Passphrase des Laufwerks ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la frase de contraseña del disco."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisesta ketta paroolifraas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita aseman salauslause."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez la phrase secrète du disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la passphrase del disco."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ievadiet diska paroles frāzi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de wachtwoordzin van de schijf in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz hasło dostępu do dysku."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza a frase-passe do disco."
          }
        }
      }
    },
    "Enter the drive's password, or its 48-digit recovery key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib das Passwort des Laufwerks ein oder seinen 48-stelligen Wiederherstellungsschlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la contraseña del disco o su clave de recuperación de 48 dígitos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisesta ketta parool või selle 48-kohaline taastevõti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita aseman salasana tai sen 48-numeroinen palautusavain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le mot de passe du disque ou sa clé de récupération à 48 chiffres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la password del disco o la sua chiave di recupero di 48 cifre."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ievadiet diska paroli vai tā 48 ciparu atkopšanas atslēgu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer het wachtwoord van de schijf in, of de herstelsleutel van 48 cijfers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz hasło dysku albo jego 48-cyfrowy klucz odzyskiwania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza a palavra-passe do disco ou a respetiva chave de recuperação de 48 dígitos."
          }
        }
      }
    },
    "Everything else was removed. %@ itself could not be moved to the Bin — %@ — so drag it there yourself to finish.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles Übrige wurde entfernt. %@ selbst konnte nicht in den Papierkorb bewegt werden — %@ — bewege es zum Abschluss selbst dorthin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo demás se ha eliminado. %@ en sí no se ha podido mover a la papelera (%@), así que arrástralo tú para terminar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik muu eemaldati. Rakendust %@ ennast ei õnnestunud prügikasti teisaldada (%@) — lohista see ise sinna, et lõpetada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki muu poistettiin. Itse ohjelmaa %@ ei saatu siirrettyä roskakoriin (%@) — vedä se sinne itse viimeistelläksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le reste a été supprimé. %@ lui-même n’a pas pu être placé dans la corbeille — %@ — faites-le glisser vous-même pour terminer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto il resto è stato rimosso. %@ stesso non è stato spostato nel Cestino (%@): trascinalo tu per completare."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Viss pārējais tika noņemts. Pašu %@ neizdevās pārvietot uz atkritni (%@) — velciet to turp pats, lai pabeigtu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al het overige is verwijderd. %@ zelf kon niet naar de prullenmand worden verplaatst (%@) — sleep het er zelf naartoe om af te ronden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko inne zostało usunięte. Samego programu %@ nie udało się przenieść do Kosza (%@) — przeciągnij go tam sam, aby dokończyć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o resto foi removido. O próprio %@ não pôde ser movido para o lixo (%@) — arraste-o para lá para concluir."
          }
