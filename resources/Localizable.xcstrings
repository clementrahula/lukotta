        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สภาพแวดล้อม Linux จะถูกลบ ทำให้ว่างขึ้นราว %lld MB"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux ortamı silinecek ve yaklaşık %lld MB boşalacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
