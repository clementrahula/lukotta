    "260 MB of disk: 160 MB for the app, 100 MB for the Linux environment it unpacks on first use": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB дисково пространство: 160 MB за приложението и 100 MB за средата на Linux, разопакована при първото използване"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB na disku: 160 MB pro aplikaci a 100 MB pro linuxové prostředí rozbalené při prvním použití"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB diskplads: 160 MB til appen og 100 MB til Linux-miljøet, der pakkes ud første gang"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB Speicherplatz: 160 MB für die App, 100 MB für die Linux-Umgebung, die beim ersten Verwenden entpackt wird"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB στον δίσκο: 160 MB για την εφαρμογή και 100 MB για το περιβάλλον Linux που αποσυμπιέζεται στην πρώτη χρήση"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB de disco: 160 MB para la app y 100 MB para el entorno Linux que descomprime la primera vez"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB kettaruumi: 160 MB rakendusele ja 100 MB Linuxi keskkonnale, mis pakitakse lahti esimesel kasutamisel"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "260 Mt levytilaa: 160 Mt ohjelmalle ja 100 Mt Linux-ympäristölle, joka puretaan ensimmäisellä käyttökerralla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "260 Mo d’espace disque : 160 Mo pour l’app, 100 Mo pour l’environnement Linux décompressé à la première utilisation"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB prostora na disku: 160 MB za aplikaciju i 100 MB za Linux okruženje koje se raspakirava pri prvom korištenju"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB lemezterület: 160 MB az alkalmazásnak és 100 MB a Linux-környezetnek, amelyet az első használatkor csomagol ki"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB di disco: 160 MB per l’app e 100 MB per l’ambiente Linux estratto al primo utilizzo"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB disko vietos: 160 MB programai ir 100 MB „Linux“ aplinkai, kuri išpakuojama pirmą kartą naudojant"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB diska vietas: 160 MB lietotnei un 100 MB Linux videi, ko tā izpako pirmajā lietošanas reizē"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB diskplass: 160 MB til appen og 100 MB til Linux-miljøet som pakkes ut første gang"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB schijfruimte: 160 MB voor de app en 100 MB voor de Linux-omgeving die bij het eerste gebruik wordt uitgepakt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB miejsca na dysku: 160 MB na aplikację i 100 MB na środowisko Linuksa rozpakowywane przy pierwszym użyciu"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB de disco: 160 MB para a app e 100 MB para o ambiente Linux descompactado na primeira utilização"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB pe disc: 160 MB pentru aplicație și 100 MB pentru mediul Linux dezarhivat la prima utilizare"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB prostora na disku: 160 MB za aplikacijo in 100 MB za okolje Linux, ki se razpakira ob prvi uporabi"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "260 MB diskutrymme: 160 MB för appen och 100 MB för Linux-miljön som packas upp vid första användningen"
          }
        }
      }
    },
    "30 to 80 MB of RAM per unlocked drive": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "От 30 до 80 MB оперативна памет за всеки отключен диск"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "30 až 80 MB paměti na každý odemčený disk"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "30 til 80 MB hukommelse pr. oplåst enhed"
          }
        },
        "de": {
          "stringUnit": {
