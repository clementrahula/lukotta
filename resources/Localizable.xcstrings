    "LUKS volumes whose header is stored separately from the drive": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وحدات تخزين LUKS التي تُحفظ ترويستها بمعزل عن المحرّك"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS томове, чиято заглавка се съхранява отделно от диска"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svazky LUKS, jejichž hlavička je uložena odděleně od disku"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS-enheder, hvis header er arkiveret adskilt fra disken"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS-Volumes, deren Header getrennt vom Laufwerk gespeichert ist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τόμοι LUKS των οποίων η κεφαλίδα αποθηκεύεται χωριστά από τον δίσκο"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volúmenes LUKS cuya cabecera se guarda aparte del disco"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS-köited, mille päis on salvestatud kettast eraldi"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS-taltiot, joiden otsake on tallennettu erilleen asemasta"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga LUKS volume na hiwalay sa drive nakatago ang header"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les volumes LUKS dont l’en-tête est stocké séparément du disque"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אמצעי אחסון LUKS שכותרתם נשמרת בנפרד מהכונן"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसे LUKS वॉल्यूम जिनका हेडर ड्राइव से अलग रखा गया है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS jedinice čije je zaglavlje pohranjeno odvojeno od diska"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS-kötetek, amelyek fejléce a meghajtótól külön van tárolva"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume LUKS yang header-nya disimpan terpisah dari drive"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumi LUKS il cui header è conservato separatamente dal disco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘッダがドライブとは別に保存されている LUKS ボリューム"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헤더가 드라이브와 따로 저장된 LUKS 볼륨"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS tomai, kurių antraštė saugoma atskirai nuo disko"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS sējumi, kuru galvene tiek glabāta atsevišķi no diska"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Volum LUKS yang pengepalanya disimpan berasingan daripada pemacu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS-volumer der hodet er lagret atskilt fra enheten"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS-volumes waarvan de header los van de schijf is opgeslagen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Woluminy LUKS, których nagłówek jest przechowywany osobno od dysku"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumes LUKS cujo cabeçalho é guardado separadamente do disco"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume LUKS al căror antet este stocat separat de disc"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тома LUKS, заголовок которых хранится отдельно от диска"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosilci LUKS, katerih glava je shranjena ločeno od pogona"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume LUKS, koka e të cilëve ruhet veçmas nga disku"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS-volymer vars huvud lagras separat från enheten"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โวลุ่ม LUKS ที่เก็บส่วนหัวแยกจากตัวไดรฟ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlığı sürücüden ayrı saklanan LUKS birimleri"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Томи LUKS, заголовок яких зберігається окремо від диска"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ LUKS có phần đầu lưu tách rời khỏi ổ đĩa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件头与驱动器分开存放的 LUKS 宗卷"
          }
        }
      }
    },
    "LVM inside LUKS, as Ubuntu, Debian, Mint and Fedora set it up. Several volumes on one drive all unlock together": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM داخل LUKS، كما تعدّه Ubuntu وDebian وMint وFedora. تُفتح عدة وحدات تخزين على محرّك واحد معًا"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM вътре в LUKS, както го настройват Ubuntu, Debian, Mint и Fedora. Няколко тома на един диск се отключват заедно"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM uvnitř LUKS, jak jej nastavují Ubuntu, Debian, Mint a Fedora. Několik svazků na jednom disku se odemkne společně"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM inde i LUKS, som Ubuntu, Debian, Mint og Fedora sætter det op. Flere enheder på samme disk låses op sammen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM innerhalb von LUKS, wie es Ubuntu, Debian, Mint und Fedora einrichten. Mehrere Volumes auf einem Laufwerk werden gemeinsam entsperrt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM μέσα σε LUKS, όπως το ρυθμίζουν τα Ubuntu, Debian, Mint και Fedora. Πολλοί τόμοι σε έναν δίσκο ξεκλειδώνουν μαζί"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM dentro de LUKS, tal como lo configuran Ubuntu, Debian, Mint y Fedora. Varios volúmenes de un mismo disco se desbloquean juntos"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM LUKS-i sees, nagu Ubuntu, Debian, Mint ja Fedora selle seadistavad. Ühe ketta mitu köidet avanevad koos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM LUKSin sisällä, kuten Ubuntu, Debian, Mint ja Fedora sen määrittävät. Saman aseman useat taltiot avautuvat yhdessä"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM sa loob ng LUKS, gaya ng pagkakaayos ng Ubuntu, Debian, Mint at Fedora. Sabay-sabay na bumubukas ang ilang volume sa isang drive"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM dans LUKS, tel que le configurent Ubuntu, Debian, Mint et Fedora. Plusieurs volumes sur un même disque se déverrouillent ensemble"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏LVM בתוך LUKS, כפי ש‑Ubuntu, ‏Debian, ‏Mint ו‑Fedora מגדירות זאת. כמה אמצעי אחסון בכונן אחד נפתחים יחד"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS के भीतर LVM, जैसा Ubuntu, Debian, Mint और Fedora सेट करते हैं। एक ड्राइव पर कई वॉल्यूम एक साथ अनलॉक होते हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM unutar LUKS-a, kako ga postavljaju Ubuntu, Debian, Mint i Fedora. Više jedinica na jednom disku otključava se zajedno"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM a LUKS-on belül, ahogy azt az Ubuntu, a Debian, a Mint és a Fedora beállítja. Egy meghajtó több kötete együtt oldódik fel"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM di dalam LUKS, seperti yang disiapkan Ubuntu, Debian, Mint, dan Fedora. Beberapa volume pada satu drive terbuka bersama-sama"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM dentro LUKS, come lo configurano Ubuntu, Debian, Mint e Fedora. Più volumi sullo stesso disco si sbloccano insieme"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubuntu、Debian、Mint、Fedora が構成するかたちの、LUKS の中の LVM。1 台のドライブ上の複数のボリュームがまとめてロック解除されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubuntu, Debian, Mint, Fedora가 구성하는 방식의 LUKS 안의 LVM. 한 드라이브의 여러 볼륨이 함께 잠금 해제됩니다"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM LUKS viduje, kaip jį nustato „Ubuntu“, „Debian“, „Mint“ ir „Fedora“. Keli tomai viename diske atrakinami kartu"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM LUKS iekšienē, kā to iestata Ubuntu, Debian, Mint un Fedora. Vairāki sējumi vienā diskā tiek atbloķēti kopā"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM di dalam LUKS, seperti yang disediakan Ubuntu, Debian, Mint dan Fedora. Beberapa volum pada satu pemacu dibuka serentak"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM inni LUKS, slik Ubuntu, Debian, Mint og Fedora setter det opp. Flere volumer på samme enhet låses opp sammen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM binnen LUKS, zoals Ubuntu, Debian, Mint en Fedora het instellen. Meerdere volumes op één schijf worden samen ontgrendeld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM wewnątrz LUKS, tak jak konfigurują to Ubuntu, Debian, Mint i Fedora. Kilka woluminów na jednym dysku odblokowuje się razem"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM dentro de LUKS, tal como o Ubuntu, o Debian, o Mint e o Fedora o configuram. Vários volumes num mesmo disco são desbloqueados em conjunto"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM în interiorul LUKS, așa cum îl configurează Ubuntu, Debian, Mint și Fedora. Mai multe volume de pe același disc se deblochează împreună"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM внутри LUKS, как это настраивают Ubuntu, Debian, Mint и Fedora. Несколько томов на одном диске разблокируются вместе"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM znotraj LUKS, kot ga nastavijo Ubuntu, Debian, Mint in Fedora. Več nosilcev na enem pogonu se odklene skupaj"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM brenda LUKS, ashtu si e vendosin Ubuntu, Debian, Mint dhe Fedora. Disa volume në një disk shkyçen të gjitha bashkë"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM inuti LUKS, så som Ubuntu, Debian, Mint och Fedora ställer in det. Flera volymer på samma enhet låses upp tillsammans"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM ภายใน LUKS อย่างที่ Ubuntu, Debian, Mint และ Fedora ตั้งค่าไว้ หลายโวลุ่มบนไดรฟ์เดียวจะปลดล็อกพร้อมกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubuntu, Debian, Mint ve Fedora'nın kurduğu biçimde LUKS içinde LVM. Bir sürücüdeki birkaç birim birlikte açılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM усередині LUKS, як це налаштовують Ubuntu, Debian, Mint і Fedora. Кілька томів на одному диску розблоковуються разом"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM bên trong LUKS, theo cách Ubuntu, Debian, Mint và Fedora thiết lập. Nhiều ổ trên cùng một đĩa được mở khóa cùng lúc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS 内的 LVM，也就是 Ubuntu、Debian、Mint 和 Fedora 的安装方式。同一驱动器上的多个宗卷会一起解锁"
          }
        }
      }
    },
