    "Show what each permission is for": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажи за какво служи всяко разрешение"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit, k čemu každé oprávnění slouží"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis, hvad hver tilladelse bruges til"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigen, wofür jede Berechtigung dient"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση του σκοπού κάθε άδειας"
