    "They stay in Finder after %@ quits. Eject them there whenever you are finished.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى في الباحث بعد إنهاء %@. أخرجها هناك متى انتهيت."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Те остават във Finder, след като %@ приключи. Извадете ги оттам, когато сте готови."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstanou ve Finderu i po ukončení aplikace %@. Až budete hotovi, vysuňte je odtud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De bliver i Finder, efter at %@ er sluttet. Skub dem ud derfra, når du er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie bleiben nach dem Beenden von %@ im Finder. Wirf sie dort aus, wenn du fertig bist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παραμένουν στο Finder αφού τερματιστεί το %@. Κάντε εξαγωγή από εκεί όταν τελειώσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanecen en el Finder después de salir de %@. Expúlsalos allí cuando termines."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Nad jäävad Finderisse pärast seda, kui %@ väljub. Väljuta nad sealt, kui oled lõpetanud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne jäävät Finderiin sen jälkeen, kun %@ lopetetaan. Poista ne sieltä käytöstä, kun olet valmis."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nananatili sila sa Finder pagkatapos umalis ang %@. I-eject sila roon kapag tapos ka na."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils restent dans le Finder après la fermeture de %@. Éjectez-les depuis le Finder lorsque vous avez terminé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הם נשארים ב‑Finder לאחר ש‑%@ יוצא. הוציאו אותם שם בכל עת שתסיימו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के बंद होने के बाद भी वे Finder में रहती हैं। काम पूरा होने पर उन्हें वहीं निकालें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostaju u Finderu nakon što %@ završi. Izbacite ih ondje kad završite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Finderben maradnak, miután a(z) %@ kilép. Ha végzett, onnan adja ki őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya tetap ada di Finder setelah %@ keluar. Keluarkan di sana bila Anda sudah selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restano nel Finder dopo la chiusura di %@. Espellili da lì quando hai finito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の終了後もそれらは Finder に残ります。終わったらそこで取り出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 종료된 뒤에도 Finder에 남습니다. 끝나면 그곳에서 추출하십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jie lieka „Finder“ programoje, kai %@ baigia darbą. Išstumkite juos ten, kai baigsite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tie paliek programmā Finder pēc tam, kad %@ ir aizvērta. Izstumiet tos tur, kad esat pabeidzis."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya kekal dalam Finder selepas %@ keluar. Keluarkannya di sana apabila anda selesai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De blir værende i Finder etter at %@ avsluttes. Mat dem ut derfra når du er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze blijven in de Finder staan nadat %@ is gestopt. Verwijder ze daar wanneer je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostają w Finderze po zakończeniu programu %@. Wysuń je stamtąd, gdy skończysz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanecem no Finder depois de o %@ sair. Ejete-os aí quando terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rămân în Finder după ce %@ se închide. Ejectați-le de acolo când terminați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они остаются в Finder после выхода из %@. Извлеките их там, когда закончите."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostanejo v Finderju, potem ko se %@ konča. Izvrzite jih tam, ko končate."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ata qëndrojnë në Finder pasi %@ të dalë. Nxirri atje kur të mbarosh."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De finns kvar i Finder efter att %@ avslutats. Mata ut dem där när du är klar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทั้งหมดยังอยู่ใน Finder หลังจาก %@ ปิดไปแล้ว ดันออกที่นั่นเมื่อคุณใช้เสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ çıktıktan sonra Finder'da kalırlar. İşiniz bittiğinde orada çıkarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вони залишаються у Finder після виходу з %@. Вилучіть їх там, коли завершите."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng vẫn ở trong Finder sau khi %@ thoát. Hãy tháo chúng ở đó khi bạn xong việc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 退出后它们仍留在“访达”中。用完后在那里推出即可。"
          }
        }
      }
    },
