    "Appears only while a drive is unlocked, for ejecting it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint nur, solange ein Laufwerk entsperrt ist, zum Auswerfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo aparece mientras hay un disco desbloqueado, para expulsarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmub ainult siis, kui ketas on avatud, selle väljutamiseks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näkyy vain, kun asema on avattuna, sen käytöstä poistamista varten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’apparaît que lorsqu’un disque est déverrouillé, pour l’éjecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appare solo quando un disco è sbloccato, per espellerlo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parādās tikai tad, kad disks ir atbloķēts, lai to izstumtu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschijnt alleen zolang een schijf ontgrendeld is, om die te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojawia się tylko wtedy, gdy dysk jest odblokowany, aby go wysunąć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece apenas enquanto houver um disco desbloqueado, para o ejetar."
          }
        }
      }
    },
