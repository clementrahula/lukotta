    "LUKS volumes whose header is stored separately from the drive": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS томове, чиято заглавка се съхранява отделно от диска"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS-enheder, hvis header er arkiveret adskilt fra disken"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS-Volumes, deren Header getrennt vom Laufwerk gespeichert ist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τόμοι LUKS των οποίων η κεφαλίδα αποθηκεύεται χωριστά από τον δίσκο"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volúmenes LUKS cuya cabecera se guarda aparte del disco"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS-köited, mille päis on salvestatud kettast eraldi"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS-taltiot, joiden otsake on tallennettu erilleen asemasta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les volumes LUKS dont l’en-tête est stocké séparément du disque"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumi LUKS il cui header è conservato separatamente dal disco"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS tomai, kurių antraštė saugoma atskirai nuo disko"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS sējumi, kuru galvene tiek glabāta atsevišķi no diska"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS-volumes waarvan de header los van de schijf is opgeslagen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Woluminy LUKS, których nagłówek jest przechowywany osobno od dysku"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumes LUKS cujo cabeçalho é guardado separadamente do disco"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS-volymer vars huvud lagras separat från enheten"
          }
        }
      }
    },
    "LVM inside LUKS, as Ubuntu, Debian, Mint and Fedora set it up. Several volumes on one drive all unlock together": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM вътре в LUKS, както го настройват Ubuntu, Debian, Mint и Fedora. Няколко тома на един диск се отключват заедно"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM inde i LUKS, som Ubuntu, Debian, Mint og Fedora sætter det op. Flere enheder på samme disk låses op sammen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM innerhalb von LUKS, wie es Ubuntu, Debian, Mint und Fedora einrichten. Mehrere Volumes auf einem Laufwerk werden gemeinsam entsperrt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM μέσα σε LUKS, όπως το ρυθμίζουν τα Ubuntu, Debian, Mint και Fedora. Πολλοί τόμοι σε έναν δίσκο ξεκλειδώνουν μαζί"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM dentro de LUKS, tal como lo configuran Ubuntu, Debian, Mint y Fedora. Varios volúmenes de un mismo disco se desbloquean juntos"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM LUKS-i sees, nagu Ubuntu, Debian, Mint ja Fedora selle seadistavad. Ühe ketta mitu köidet avanevad koos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM LUKSin sisällä, kuten Ubuntu, Debian, Mint ja Fedora sen määrittävät. Saman aseman useat taltiot avautuvat yhdessä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM dans LUKS, tel que le configurent Ubuntu, Debian, Mint et Fedora. Plusieurs volumes sur un même disque se déverrouillent ensemble"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM dentro LUKS, come lo configurano Ubuntu, Debian, Mint e Fedora. Più volumi sullo stesso disco si sbloccano insieme"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM LUKS viduje, kaip jį nustato „Ubuntu“, „Debian“, „Mint“ ir „Fedora“. Keli tomai viename diske atrakinami kartu"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM LUKS iekšienē, kā to iestata Ubuntu, Debian, Mint un Fedora. Vairāki sējumi vienā diskā tiek atbloķēti kopā"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM binnen LUKS, zoals Ubuntu, Debian, Mint en Fedora het instellen. Meerdere volumes op één schijf worden samen ontgrendeld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM wewnątrz LUKS, tak jak konfigurują to Ubuntu, Debian, Mint i Fedora. Kilka woluminów na jednym dysku odblokowuje się razem"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM dentro de LUKS, tal como o Ubuntu, o Debian, o Mint e o Fedora o configuram. Vários volumes num mesmo disco são desbloqueados em conjunto"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "LVM inuti LUKS, så som Ubuntu, Debian, Mint och Fedora ställer in det. Flera volymer på samma enhet låses upp tillsammans"
          }
        }
      }
    },
