    "About ten drives can stay unlocked at once": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Около десет диска могат да останат отключени едновременно"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odemčených současně může zůstat asi deset disků"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Omkring ti enheder kan være låst op samtidig"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa zehn Laufwerke können gleichzeitig entsperrt bleiben"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περίπου δέκα δίσκοι μπορούν να μείνουν ξεκλείδωτοι ταυτόχρονα"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede haber unos diez discos desbloqueados a la vez"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Umbes kümme ketast võib korraga avatuks jääda"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Noin kymmenen asemaa voi olla avattuna yhtä aikaa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une dizaine de disques peuvent rester déverrouillés en même temps"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otključano istodobno može ostati oko deset diskova"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Körülbelül tíz meghajtó maradhat egyszerre feloldva"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa dieci dischi possono restare sbloccati contemporaneamente"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apie dešimt diskų gali likti atrakinti vienu metu"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptuveni desmit diski var vienlaikus palikt atbloķēti"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Omtrent ti enheter kan være låst opp samtidig"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeveer tien schijven kunnen tegelijk ontgrendeld blijven"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Około dziesięciu dysków może być odblokowanych jednocześnie"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de dez discos podem permanecer desbloqueados em simultâneo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproximativ zece discuri pot rămâne deblocate simultan"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hkrati lahko ostane odklenjenih približno deset pogonov"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungefär tio enheter kan vara upplåsta samtidigt"
          }
        }
      }
