    "Reading a raw disk and mounting a filesystem are actions only an administrator can do.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прякото четене на диск и монтирането на файлова система са действия, които може да извърши само администратор."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přímé čtení disku a připojení souborového systému může provést jen správce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At læse en disk direkte og aktivere et filsystem kan kun en administrator."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Festplatte direkt zu lesen und ein Dateisystem zu aktivieren, kann nur ein Administrator."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απευθείας ανάγνωση δίσκου και η προσάρτηση συστήματος αρχείων είναι ενέργειες που μόνο διαχειριστής μπορεί να κάνει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer un disco en bruto y montar un sistema de archivos son acciones que solo puede hacer un administrador."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketta otse lugemine ja failisüsteemi haakimine on toimingud, mida saab teha ainult administraator."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Levyn suora lukeminen ja tiedostojärjestelmän käyttöönotto onnistuvat vain pääkäyttäjältä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire un disque brut et monter un système de fichiers sont des actions réservées à un administrateur."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izravno čitanje diska i montiranje datotečnog sustava radnje su koje može obaviti samo administrator."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy lemez közvetlen olvasása és egy fájlrendszer csatolása csak rendszergazdai művelet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggere un disco grezzo e montare un file system sono operazioni riservate a un amministratore."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiesioginį disko skaitymą ir failų sistemos prijungimą gali atlikti tik administratorius."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diska tiešu lasīšanu un failu sistēmas montēšanu var veikt tikai administrators."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å lese en disk direkte og montere et filsystem er noe bare en administrator kan gjøre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een schijf rechtstreeks lezen en een bestandssysteem activeren kan alleen een beheerder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpośredni odczyt dysku i montowanie systemu plików może wykonać wyłącznie administrator."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler um disco diretamente e montar um sistema de ficheiros são ações reservadas a um administrador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Citirea directă a unui disc și montarea unui sistem de fișiere sunt acțiuni pe care le poate face doar un administrator."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neposredno branje diska in priklop datotečnega sistema sta dejanji, ki ju lahko izvede le skrbnik."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att läsa en disk direkt och montera ett filsystem kan bara en administratör göra."
          }
        }
      }
    },
    "Reading a raw disk and mounting a filesystem are actions only an administrator can do. %@ never sees your password.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прякото четене на диск и монтирането на файлова система са действия, които може да извърши само администратор. %@ никога не вижда вашата парола."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přímé čtení disku a připojení souborového systému může provést jen správce. %@ vaše heslo nikdy nevidí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At læse en disk direkte og aktivere et filsystem kan kun en administrator. %@ ser aldrig din adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Festplatte direkt zu lesen und ein Dateisystem zu aktivieren, kann nur ein Administrator. %@ sieht dein Passwort nie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απευθείας ανάγνωση δίσκου και η προσάρτηση συστήματος αρχείων είναι ενέργειες που μόνο διαχειριστής μπορεί να κάνει. Το %@ δεν βλέπει ποτέ το συνθηματικό σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer un disco en bruto y montar un sistema de archivos son acciones que solo puede hacer un administrador. %@ nunca ve tu contraseña."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketta otse lugemine ja failisüsteemi haakimine on toimingud, mida saab teha ainult administraator. %@ ei näe kunagi sinu parooli."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Levyn suora lukeminen ja tiedostojärjestelmän käyttöönotto onnistuvat vain pääkäyttäjältä. %@ ei koskaan näe salasanaasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire un disque brut et monter un système de fichiers sont des actions réservées à un administrateur. %@ ne voit jamais votre mot de passe."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izravno čitanje diska i montiranje datotečnog sustava radnje su koje može obaviti samo administrator. %@ nikada ne vidi vašu lozinku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy lemez közvetlen olvasása és egy fájlrendszer csatolása csak rendszergazdai művelet. A(z) %@ soha nem látja a jelszavát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggere un disco grezzo e montare un file system sono operazioni riservate a un amministratore. %@ non vede mai la tua password."
