    "macOS wrote %@. It is not sent anywhere automatically. Attach it to your message if you can.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS записа %@. Той не се изпраща никъде автоматично. Прикачете го към съобщението си, ако можете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
