    "Appears only while a drive is unlocked, for ejecting it.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Появява се само докато диск е отключен, за да бъде изваден."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises kun, mens en enhed er låst op, så den kan skubbes ud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint nur, solange ein Laufwerk entsperrt ist, zum Auswerfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζεται μόνο όσο ένας δίσκος είναι ξεκλείδωτος, για την εξαγωγή του."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo aparece mientras hay un disco desbloqueado, para expulsarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmub ainult siis, kui ketas on avatud, selle väljutamiseks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näkyy vain, kun asema on avattuna, sen käytöstä poistamista varten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’apparaît que lorsqu’un disque est déverrouillé, pour l’éjecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appare solo quando un disco è sbloccato, per espellerlo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodoma tik tada, kai diskas atrakintas, kad jį būtų galima išstumti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parādās tikai tad, kad disks ir atbloķēts, lai to izstumtu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschijnt alleen zolang een schijf ontgrendeld is, om die te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojawia się tylko wtedy, gdy dysk jest odblokowany, aby go wysunąć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece apenas enquanto houver um disco desbloqueado, para o ejetar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visas bara medan en enhet är upplåst, för att mata ut den."
          }
        }
      }
    },
