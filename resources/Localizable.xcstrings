          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šajā versijā nav iekļauts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet aanwezig in deze versie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak w tej wersji."
          }
        },
        "pt-PT": {
