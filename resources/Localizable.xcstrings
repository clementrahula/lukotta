    "The Linux environment is unpacked once, on first use.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفكّ بيئة Linux مرة واحدة، عند أول استخدام."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Средата на Linux се разопакова веднъж, при първото използване."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Linuxové prostředí se rozbalí jednou, při prvním použití."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux-miljøet pakkes ud én gang, første gang det bruges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Linux-Umgebung wird einmalig beim ersten Verwenden entpackt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το περιβάλλον Linux αποσυμπιέζεται μία φορά, κατά την πρώτη χρήση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno Linux se descomprime una sola vez, la primera vez que se usa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Linuxi keskkond pakitakse lahti ühe korra, esimesel kasutamisel."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux-ympäristö puretaan kerran, ensimmäisellä käyttökerralla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Linux environment ay binubuksan nang isang beses, sa unang paggamit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’environnement Linux n’est décompressé qu’une seule fois, à la première utilisation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סביבת Linux נפרסת פעם אחת, בשימוש הראשון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux परिवेश एक बार, पहली बार उपयोग पर खुलता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux okruženje raspakirava se jednom, pri prvom korištenju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Linux-környezet egyszer, az első használatkor kerül kicsomagolásra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingkungan Linux dibongkar sekali saja, saat pertama kali dipakai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ambiente Linux viene estratto una sola volta, al primo utilizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 環境は初回使用時に一度だけ展開されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 환경은 처음 사용할 때 한 번만 풀립니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Linux“ aplinka išpakuojama vieną kartą, pirmojo naudojimo metu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux vide tiek izpakota vienu reizi, pirmajā lietošanas reizē."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Persekitaran Linux dibuka sekali sahaja, pada penggunaan pertama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux-miljøet pakkes ut én gang, første gang det brukes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Linux-omgeving wordt eenmalig uitgepakt, bij het eerste gebruik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Środowisko Linuksa jest rozpakowywane raz, przy pierwszym użyciu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente Linux é descompactado uma única vez, na primeira utilização."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediul Linux este dezarhivat o singură dată, la prima utilizare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Среда Linux распаковывается один раз, при первом запуске."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okolje Linux se razpakira enkrat, ob prvi uporabi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjedisi Linux shpaketohet një herë, në përdorimin e parë."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux-miljön packas upp en gång, vid första användningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สภาพแวดล้อม Linux จะแตกออกครั้งเดียว เมื่อใช้ครั้งแรก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux ortamı bir kez, ilk kullanımda açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Середовище Linux розпаковується один раз, під час першого запуску."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Môi trường Linux được giải nén một lần, ở lần dùng đầu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 环境只在首次使用时解压一次。"
          }
        }
      }
    },
    "The Linux environment will be deleted, freeing about %lld MB.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف بيئة Linux، فتتحرر نحو %lld ميجابايت."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Средата на Linux ще бъде изтрита, освобождавайки около %lld MB."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Linuxové prostředí bude smazáno a uvolní se asi %lld MB."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux-miljøet slettes, hvilket frigør omkring %lld MB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Linux-Umgebung wird gelöscht und gibt etwa %lld MB frei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το περιβάλλον Linux θα διαγραφεί, ελευθερώνοντας περίπου %lld MB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará el entorno Linux, liberando unos %lld MB."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Linuxi keskkond kustutatakse, vabastades umbes %lld MB."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux-ympäristö poistetaan, mikä vapauttaa noin %lld Mt."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buburahin ang Linux environment, na magpapalaya ng mga %lld MB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’environnement Linux sera supprimé, libérant environ %lld Mo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סביבת Linux תימחק, ויתפנו כ‑%lld מ״ב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux परिवेश हटा दिया जाएगा, जिससे लगभग %lld MB खाली होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux okruženje bit će izbrisano i oslobodit će oko %lld MB."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Linux-környezet törlődik, ezzel körülbelül %lld MB szabadul fel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingkungan Linux akan dihapus, membebaskan sekitar %lld MB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ambiente Linux verrà eliminato, liberando circa %lld MB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 環境が削除され、約 %lld MB が空きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 환경이 삭제되어 약 %lldMB가 확보됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Linux“ aplinka bus ištrinta, atlaisvinant apie %lld MB."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux vide tiks izdzēsta, atbrīvojot aptuveni %lld MB."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
