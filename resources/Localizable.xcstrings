    "Why it appears as a network drive": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Защо се появява като мрежов диск"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvorfor den vises som en netværksenhed"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum es als Netzlaufwerk erscheint"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γιατί εμφανίζεται ως δίσκος δικτύου"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por qué aparece como un disco de red"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Miks see ilmub võrgukettana"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miksi se näkyy verkkoasemana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi il apparaît comme un disque réseau"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché appare come disco di rete"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodėl jis rodomas kaip tinklo diskas"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kāpēc tas parādās kā tīkla disks"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarom het als netwerkschijf verschijnt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlaczego pojawia się jako dysk sieciowy"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque aparece como um disco de rede"
          }
        },
        "sv": {
