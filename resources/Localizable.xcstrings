        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen årsak ble oppgitt. Detaljene nedenfor sier kanskje mer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen reden gemeld. De details hieronder zeggen mogelijk meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie podano przyczyny. Szczegóły poniżej mogą powiedzieć więcej."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi indicado qualquer motivo. Os detalhes abaixo poderão dizer mais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu a fost raportat niciun motiv. Detaliile de mai jos ar putea spune mai multe."
          }
        },
        "ru": {
