    "“%@” had stopped responding and was disconnected. You can open it again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف “%@” عن الاستجابة وفُصل. يمكنك فتحه من جديد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ спря да отговаря и беше изключен. Можете да го отворите отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ přestal odpovídat a byl odpojen. Můžete jej otevřít znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” svarede ikke længere og blev frakoblet. Du kan åbne den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ hat nicht mehr reagiert und wurde getrennt. Du kannst es erneut öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» σταμάτησε να αποκρίνεται και αποσυνδέθηκε. Μπορείτε να το ανοίξετε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» había dejado de responder y se desconectó. Puedes volver a abrirlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ei vastanud enam ja ühendati lahti. Sa saad selle uuesti avada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” lakkasi vastaamasta ja irrotettiin. Voit avata sen uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Huminto sa pagtugon ang “%@” at nadiskonekta. Maaari mo itong buksan muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne répondait plus et a été déconnecté. Vous pouvez l’ouvrir à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏“%@” הפסיק להגיב ונותק. אפשר לפתוח אותו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ने जवाब देना बंद कर दिया और वह कट गई। आप उसे दोबारा खोल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” je prestao odgovarati i odspojen je. Možete ga ponovno otvoriti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nem válaszolt, ezért le lett választva. Újra megnyithatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” berhenti merespons dan diputus. Anda dapat membukanya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» non rispondeva più ed è stato scollegato. Puoi aprirlo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」が応答しなくなり、切断されました。もう一度開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”이(가) 응답을 멈추고 연결이 끊겼습니다. 다시 열 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ nustojo atsakyti ir buvo atjungtas. Galite jį atverti dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” pārstāja atbildēt un tika atvienots. Jūs varat to atvērt vēlreiz."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” telah berhenti bertindak balas dan diputuskan. Anda boleh membukanya semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» sluttet å svare og ble koblet fra. Du kan åpne den igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ reageerde niet meer en is losgekoppeld. Je kunt die opnieuw openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” przestał odpowiadać i został odłączony. Możesz otworzyć go ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» deixou de responder e foi desligado. Pode abri-lo novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nu mai răspundea și a fost deconectat. Îl puteți deschide din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» перестал отвечать и был отключён. Вы можете открыть его снова."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« se ni več odzival in je bil odklopljen. Lahko ga znova odprete."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” kishte pushuar së përgjigjuri dhe u shkëput. Mund ta hapësh sërish."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” slutade svara och kopplades bort. Du kan öppna den igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” หยุดตอบสนองและถูกตัดการเชื่อมต่อ คุณเปิดมันใหม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” yanıt vermeyi bıraktı ve bağlantısı kesildi. Yeniden açabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» перестав відповідати й був від’єднаний. Ви можете відкрити його знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” đã ngừng phản hồi và bị ngắt. Bạn có thể mở lại nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已停止响应并被断开。你可以再次打开它。"
          }
        }
      }
    },
    "“%@” holds an encrypted volume, and this build’s drive engine cannot open encryption inside an image. Opening the drive it was made from would work.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي “%@” على وحدة تخزين مشفّرة، ولا يستطيع محرّك الأقراص في هذه النسخة فتح التشفير داخل صورة. وفتح المحرّك الذي صُنعت منه سينجح."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ съдържа шифрован том, а дисковото ядро на този билд не може да отваря шифроване вътре в образ. Отварянето на диска, от който е направен, би свършило работа."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ obsahuje šifrovaný svazek a diskové jádro tohoto sestavení neumí otevřít šifrování uvnitř obrazu. Otevření disku, ze kterého vznikl, by fungovalo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” indeholder et krypteret arkiv, og diskmotoren i denne udgave kan ikke åbne kryptering inde i et diskbillede. At åbne den disk, det er lavet af, ville virke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ enthält ein verschlüsseltes Volume, und die Laufwerks-Engine dieses Builds kann Verschlüsselung innerhalb eines Images nicht öffnen. Das Laufwerk zu öffnen, aus dem es erstellt wurde, würde gehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%1$@» περιέχει κρυπτογραφημένο τόμο, και ο μηχανισμός δίσκων αυτής της έκδοσης δεν ανοίγει κρυπτογράφηση μέσα σε είδωλο. Το άνοιγμα του δίσκου από τον οποίο δημιουργήθηκε θα λειτουργούσε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» contiene un volumen cifrado, y el motor de discos de esta compilación no puede abrir el cifrado dentro de una imagen. Abrir el disco del que se creó sí funcionaría."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ sisaldab krüptitud köidet ja selle koostu kettamootor ei ava krüptimist tõmmise sees. Ketta avamine, millest see tehti, töötaks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” sisältää salatun taltion, eikä tämän koosteen levymoottori avaa salausta levytiedoston sisällä. Sen aseman avaaminen, josta se on tehty, toimisi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May naka-encrypt na volume sa “%@”, at hindi mabuksan ng drive engine ng build na ito ang encryption sa loob ng isang image. Gagana kung bubuksan ang drive na pinagmulan nito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » contient un volume chiffré, et le moteur de disque de cette version n’ouvre pas le chiffrement à l’intérieur d’une image. Ouvrir le disque dont elle provient fonctionnerait."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏“%@” מכיל אמצעי אחסון מוצפן, ומנוע הכוננים בגרסה זו אינו יכול לפתוח הצפנה בתוך תמונה. פתיחת הכונן שממנו נוצרה תעבוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” में एन्क्रिप्टेड वॉल्यूम है, और इस बिल्ड का ड्राइव इंजन इमेज के भीतर एन्क्रिप्शन नहीं खोल सकता। जिस ड्राइव से यह बनी थी उसे खोलने पर काम बनेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” sadrži šifrirani svezak, a diskovni pogon ove verzije ne može otvoriti šifriranje unutar slike. Otvaranje diska iz kojeg je nastala bi uspjelo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%1$@” titkosított kötetet tartalmaz, és ennek a összeállításnak a lemezmotorja nem tud lemezképen belüli titkosítást megnyitni. Annak a meghajtónak a megnyitása, amelyből készült, működne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” berisi volume terenkripsi, dan mesin drive pada build ini tidak dapat membuka enkripsi di dalam sebuah image. Membuka drive asalnya akan berhasil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» contiene un volume cifrato, e il motore dei dischi di questa build non apre la cifratura all’interno di un’immagine. Aprire il disco da cui è stata creata funzionerebbe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」には暗号化されたボリュームが含まれていますが、このビルドのドライブエンジンはイメージ内の暗号化を開けません。元になったドライブを開けば動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”에는 암호화된 볼륨이 들어 있지만, 이 빌드의 드라이브 엔진은 이미지 안의 암호화를 열지 못합니다. 이것이 만들어진 드라이브를 열면 됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ turi šifruotą tomą, o šios laidos diskų variklis negali atverti šifravimo atvaizdžio viduje. Pavyktų atverti diską, iš kurio jis sukurtas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” satur šifrētu sējumu, un šī būvējuma disku dzinis nespēj atvērt šifrējumu attēla iekšienē. Atvērt disku, no kura tas izveidots, izdotos."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” mengandungi volum bersulit, dan enjin pemacu binaan ini tidak dapat membuka penyulitan di dalam sesebuah imej. Membuka pemacu asalnya akan berhasil."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» inneholder et kryptert volum, og diskmotoren i denne utgaven kan ikke åpne kryptering inne i et diskbilde. Å åpne disken det ble laget av, ville fungere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’ bevat een versleuteld volume, en de schijfengine van deze build kan versleuteling binnen een schijfkopie niet openen. De schijf openen waarvan die is gemaakt, zou wel werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” zawiera zaszyfrowany wolumin, a silnik dysków w tej kompilacji nie otwiera szyfrowania wewnątrz obrazu. Otwarcie dysku, z którego powstał, zadziałałoby."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» contém um volume cifrado, e o motor de discos desta compilação não abre cifra dentro de uma imagem. Abrir o disco a partir do qual foi criada resultaria."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” conține un volum criptat, iar motorul de discuri al acestei versiuni nu poate deschide criptarea din interiorul unei imagini. Deschiderea discului din care a fost creată ar funcționa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» содержит зашифрованный том, а движок дисков этой сборки не открывает шифрование внутри образа. Открытие диска, с которого он сделан, сработало бы."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%1$@« vsebuje šifriran nosilec, pogon diskov te različice pa ne zna odpreti šifriranja znotraj slike. Odpiranje diska, iz katerega je nastala, bi delovalo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” përmban një volum të enkriptuar, dhe motori i disqeve i këtij ndërtimi nuk hap dot enkriptim brenda një imazhi. Hapja e diskut nga i cili u krijua do të funksiononte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” innehåller en krypterad volym, och diskmotorn i den här versionen kan inte öppna kryptering inuti en skivavbild. Att öppna disken den skapades från skulle fungera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” มีโวลุ่มที่เข้ารหัสอยู่ภายใน และเอนจินไดรฟ์ของบิลด์นี้เปิดการเข้ารหัสภายในอิมเมจไม่ได้ การเปิดไดรฟ์ต้นทางที่สร้างมันขึ้นมาจะใช้ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” şifreli bir birim içeriyor ve bu derlemenin sürücü motoru bir imajın içindeki şifrelemeyi açamıyor. Onun oluşturulduğu sürücüyü açmak işe yarar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» містить зашифрований том, а рушій дисків цієї збірки не відкриває шифрування всередині образу. Відкриття диска, з якого його зроблено, спрацювало б."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” chứa một ổ được mã hóa, và bộ máy ổ đĩa của bản dựng này không mở được mã hóa bên trong một ảnh đĩa. Mở ổ đĩa gốc của nó thì được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”内含一个加密宗卷，而此构建的驱动引擎无法打开映像内部的加密。打开它所源自的驱动器则可以。"
          }
        }
      }
    },
    "“%@” holds only the changes from another disk, and names the disk it changes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي “%@” على التغييرات عن قرص آخر فقط، ويسمّي القرص الذي يغيّره."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ съдържа само промените спрямо друг диск и посочва диска, който променя."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ obsahuje jen změny oproti jinému disku a pojmenovává disk, který mění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” indeholder kun ændringerne fra en anden disk og navngiver den disk, den ændrer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ enthält nur die Änderungen gegenüber einem anderen Laufwerk und benennt das Laufwerk, das es ändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» περιέχει μόνο τις αλλαγές από άλλον δίσκο, και ονομάζει τον δίσκο που αλλάζει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» contiene solo los cambios respecto a otro disco, y nombra el disco que modifica."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ sisaldab ainult teise ketta muudatusi ja nimetab ketast, mida see muudab."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” sisältää vain muutokset toiseen levyyn nähden ja nimeää levyn, jota se muuttaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naglalaman lamang ang “%@” ng mga pagbabago mula sa ibang disk, at pinapangalanan nito ang disk na binabago nito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne contient que les modifications apportées à un autre disque, et nomme le disque qu’il modifie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏“%@” מכיל רק את השינויים מדיסק אחר, ומציין את הדיסק שהוא משנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” में केवल किसी और डिस्क से हुए बदलाव हैं, और वह उस डिस्क का नाम लेती है जिसे वह बदलती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” sadrži samo promjene u odnosu na drugi disk i imenuje disk koji mijenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” csak egy másik lemezhez képest történt változásokat tartalmazza, és megnevezi azt a lemezt, amelyet módosít."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” hanya berisi perubahan dari disk lain, dan menyebut disk yang diubahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» contiene solo le modifiche rispetto a un altro disco, e nomina il disco che modifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」には別のディスクからの変更分だけが入っており、変更対象のディスクを指しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”에는 다른 디스크로부터의 변경분만 들어 있으며, 변경 대상 디스크를 가리킵니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ turi tik pakeitimus, palyginti su kitu disku, ir nurodo diską, kurį keičia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” satur tikai izmaiņas attiecībā pret citu disku un nosauc disku, ko tas maina."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” hanya mengandungi perubahan daripada cakera lain, dan menamakan cakera yang diubahnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» inneholder bare endringene fra en annen disk, og navngir disken den endrer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ bevat alleen de wijzigingen ten opzichte van een andere schijf, en noemt de schijf die het wijzigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” zawiera tylko zmiany względem innego dysku i wskazuje dysk, który zmienia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» contém apenas as alterações face a outro disco, e nomeia o disco que altera."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” conține doar modificările față de alt disc și numește discul pe care îl modifică."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» содержит только изменения относительно другого диска и называет тот диск, который изменяет."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« vsebuje le spremembe glede na drug disk in imenuje disk, ki ga spreminja."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” përmban vetëm ndryshimet nga një disk tjetër, dhe e emërton diskun që ndryshon."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” innehåller bara ändringarna från en annan disk, och namnger disken den ändrar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” มีเพียงส่วนที่เปลี่ยนไปจากดิสก์อื่น และระบุชื่อดิสก์ที่มันเปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” yalnızca başka bir diskteki değişiklikleri içerir ve değiştirdiği diski adlandırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» містить лише зміни щодо іншого диска й називає той диск, який змінює."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” chỉ chứa những thay đổi so với một đĩa khác, và nêu tên đĩa mà nó thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”只包含相对于另一个磁盘的更改，并指明了它所更改的磁盘。"
          }
        }
      }
    },
    "“%@” is a VDI, and this build’s drive engine has no VDI driver. A raw image or a qcow2 would open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏“%@” من نوع VDI، ولا يملك محرّك الأقراص في هذه النسخة مشغّل VDI. صورة خام أو qcow2 ستُفتح."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ е VDI, а дисковото ядро на този билд няма драйвер за VDI. Суров образ или qcow2 би се отворил."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ je VDI a diskové jádro tohoto sestavení nemá ovladač VDI. Surový obraz nebo qcow2 by se otevřel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” er en VDI, og diskmotoren i denne udgave har ingen VDI-driver. Et råt diskbillede eller en qcow2 ville kunne åbnes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist ein VDI, und die Laufwerks-Engine dieses Builds hat keinen VDI-Treiber. Ein Rohimage oder ein qcow2 ließe sich öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» είναι VDI, και ο μηχανισμός δίσκων αυτής της έκδοσης δεν έχει οδηγό VDI. Ένα ωμό είδωλο ή ένα qcow2 θα άνοιγε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» es un VDI, y el motor de discos de esta compilación no tiene controlador VDI. Una imagen en bruto o un qcow2 sí se abrirían."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ on VDI ja selle koostu kettamootoril ei ole VDI draiverit. Toortõmmis või qcow2 avaneks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” on VDI, eikä tämän koosteen levymoottorissa ole VDI-ajuria. Raakatiedosto tai qcow2 aukeaisi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang “%@” ay isang VDI, at walang VDI driver ang drive engine ng build na ito. Bubukas ang isang raw na image o isang qcow2."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est un VDI, et le moteur de disque de cette version n’a pas de pilote VDI. Une image brute ou un qcow2 s’ouvrirait."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏“%@” הוא VDI, ולמנוע הכוננים בגרסה זו אין מנהל התקן ל‑VDI. תמונה גולמית או qcow2 כן ייפתחו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” एक VDI है, और इस बिल्ड के ड्राइव इंजन में VDI ड्राइवर नहीं है। कोई रॉ इमेज या qcow2 खुल जाती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” je VDI, a diskovni pogon ove verzije nema VDI upravljački program. Sirova slika ili qcow2 bi se otvorili."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” egy VDI, és ennek az összeállításnak a lemezmotorjában nincs VDI-illesztőprogram. Egy nyers lemezkép vagy egy qcow2 megnyílna."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” adalah VDI, dan mesin drive pada build ini tidak memiliki driver VDI. Image mentah atau qcow2 akan terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» è un VDI, e il motore dei dischi di questa build non ha un driver VDI. Un’immagine grezza o un qcow2 si aprirebbero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は VDI ですが、このビルドのドライブエンジンには VDI ドライバがありません。raw イメージか qcow2 なら開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은(는) VDI이지만 이 빌드의 드라이브 엔진에는 VDI 드라이버가 없습니다. 원시 이미지나 qcow2라면 열립니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ yra VDI, o šios laidos diskų variklis neturi VDI tvarkyklės. Pavyktų atverti neapdorotą atvaizdį arba qcow2."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ir VDI, un šī būvējuma disku dzinim nav VDI draivera. Neapstrādāts attēls vai qcow2 atvērtos."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ialah VDI, dan enjin pemacu binaan ini tiada pemacu VDI. Imej mentah atau qcow2 akan terbuka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» er en VDI, og diskmotoren i denne utgaven har ingen VDI-driver. Et rått diskbilde eller en qcow2 ville åpnet seg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ is een VDI, en de schijfengine van deze build heeft geen VDI-stuurprogramma. Een ruwe schijfkopie of een qcow2 zou wel opengaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” to VDI, a silnik dysków w tej kompilacji nie ma sterownika VDI. Surowy obraz lub qcow2 dałoby się otworzyć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» é um VDI, e o motor de discos desta compilação não tem controlador VDI. Uma imagem em bruto ou um qcow2 abririam."
          }
        },
        "ro": {
          "stringUnit": {
