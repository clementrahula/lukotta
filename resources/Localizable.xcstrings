          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddelanden om tredjepartsprogram"
          }
        }
      }
    },
    "This drive holds several volumes inside it, and %@ could not work out which ones. Reporting this would help.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този диск съдържа няколко тома и %@ не успя да определи кои. Съобщаването за това би помогнало."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enhed indeholder flere enheder, og %@ kunne ikke finde ud af hvilke. Det vil hjælpe at rapportere det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Laufwerk enthält mehrere Volumes, und %@ konnte nicht ermitteln, welche. Eine Meldung darüber würde helfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο δίσκος περιέχει πολλούς τόμους και το %@ δεν μπόρεσε να διακρίνει ποιους. Μια αναφορά θα βοηθούσε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este disco contiene varios volúmenes y %@ no ha podido determinar cuáles. Informar de ello sería útil."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See ketas sisaldab mitut köidet ja %@ ei suutnud tuvastada, milliseid. Sellest teatamine aitaks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä asema sisältää useita taltioita, eikä %@ pystynyt selvittämään mitkä. Tästä ilmoittaminen auttaisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce disque contient plusieurs volumes, et %@ n’a pas pu déterminer lesquels. Le signaler serait utile."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo disco contiene più volumi e %@ non è riuscito a capire quali. Segnalarlo sarebbe utile."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiame diske yra keli tomai, o %@ nepavyko nustatyti, kurie. Pranešimas apie tai padėtų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis disks satur vairākus sējumus, un %@ nespēja noskaidrot, kurus. Ziņošana par to palīdzētu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze schijf bevat meerdere volumes en %@ kon niet bepalen welke. Dit melden zou helpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten dysk zawiera kilka woluminów, a %@ nie zdołał ustalić, które. Zgłoszenie tego byłoby pomocne."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este disco contém vários volumes e o %@ não conseguiu determinar quais. Comunicar isto ajudaria."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten innehåller flera volymer och %@ kunde inte avgöra vilka. Att rapportera det skulle hjälpa."
          }
        }
      }
    },
    "This is a macOS privacy setting, not a change to your Mac. You can switch it off again at any time, and nothing is installed.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това е настройка за поверителност на macOS, а не промяна на вашия Mac. Можете да я изключите по всяко време и нищо не се инсталира."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er en anonymitetsindstilling i macOS, ikke en ændring af din Mac. Du kan slå den fra igen når som helst, og der installeres ikke noget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist eine Datenschutzeinstellung von macOS, keine Änderung an deinem Mac. Du kannst sie jederzeit wieder deaktivieren, und es wird nichts installiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόκειται για ρύθμιση απορρήτου του macOS, όχι για αλλαγή στο Mac σας. Μπορείτε να την απενεργοποιήσετε όποτε θέλετε και δεν εγκαθίσταται τίποτα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un ajuste de privacidad de macOS, no un cambio en tu Mac. Puedes desactivarlo cuando quieras y no se instala nada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See on macOS-i privaatsusseade, mitte muudatus sinu Macis. Sa võid selle igal ajal uuesti välja lülitada ja midagi ei paigaldata."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on macOS:n tietosuoja-asetus, ei muutos Maciisi. Voit poistaa sen käytöstä milloin tahansa, eikä mitään asenneta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s’agit d’un réglage de confidentialité de macOS, pas d’une modification de votre Mac. Vous pouvez le désactiver à tout moment, et rien n’est installé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un’impostazione di privacy di macOS, non una modifica al tuo Mac. Puoi disattivarla quando vuoi e non viene installato nulla."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai „macOS“ privatumo nuostata, o ne jūsų „Mac“ pakeitimas. Galite ją bet kada vėl išjungti, ir niekas nediegiama."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis ir macOS privātuma iestatījums, nevis izmaiņas jūsu Mac datorā. Jūs to jebkurā brīdī varat atkal izslēgt, un nekas netiek instalēts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een privacy-instelling van macOS, geen wijziging aan je Mac. Je kunt die op elk moment weer uitschakelen, en er wordt niets geïnstalleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ustawienie prywatności systemu macOS, a nie zmiana w Twoim Macu. Możesz je wyłączyć w dowolnej chwili, a nic nie jest instalowane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma definição de privacidade do macOS, não uma alteração ao seu Mac. Pode desativá-la quando quiser, e nada é instalado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är en integritetsinställning i macOS, inte en ändring av din Mac. Du kan slå av den igen när som helst, och ingenting installeras."
          }
        }
      }
    },
