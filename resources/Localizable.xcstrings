    "Once the background helper is set up, updating will leave unlocked drives alone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد إعداد المساعد في الخلفية، لن يمسّ التحديث المحرّكات المفتوحة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "След като фоновият помощник бъде настроен, актуализирането няма да засяга отключените дискове."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakmile je pomocník na pozadí nastaven, aktualizace se odemčených disků nedotkne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når baggrundshjælperen er sat op, rører opdateringer ikke ved oplåste enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald der Hintergrund-Helfer eingerichtet ist, lässt ein Update entsperrte Laufwerke unberührt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόλις ρυθμιστεί ο βοηθός παρασκηνίου, η ενημέρωση δεν θα πειράζει τους ξεκλείδωτους δίσκους."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez configurado el asistente en segundo plano, actualizar no afectará a los discos desbloqueados."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui taustaabiline on seadistatud, ei puuduta uuendamine avatud kettaid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun taustaohjelma on otettu käyttöön, päivittäminen ei koske avattuihin asemiin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag naisaayos na ang background helper, hindi na gagalawin ng pag-update ang mga nakabukas na drive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois l’assistant en arrière-plan configuré, une mise à jour laissera les disques déverrouillés tranquilles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר שעוזר הרקע מוגדר, עדכון לא ייגע בכוננים פתוחים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पृष्ठभूमि सहायक सेट होने के बाद अपडेट अनलॉक ड्राइव को नहीं छेड़ता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad je pomoćnik u pozadini postavljen, ažuriranje neće dirati otključane diskove."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha a háttérsegéd be van állítva, a frissítés nem nyúl a feloldott meghajtókhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah pembantu latar belakang disiapkan, pembaruan tidak akan mengganggu drive yang terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta configurato l’helper in background, l’aggiornamento lascerà stare i dischi sbloccati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドヘルパーを設定すると、アップデートはロック解除中のドライブに触れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 도우미를 설정하면 업데이트가 잠금 해제된 드라이브를 건드리지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kai foninis pagalbininkas nustatytas, naujinimas nepalies atrakintų diskų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad fona palīgs ir iestatīts, atjaunināšana neaiztiks atbloķētos diskus."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah pembantu latar belakang disediakan, kemas kini tidak akan mengganggu pemacu yang terbuka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når bakgrunnshjelperen er satt opp, lar oppdateringer opplåste enheter være i fred."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra de achtergrondhelper is ingesteld, laat bijwerken ontgrendelde schijven met rust."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po skonfigurowaniu pomocnika działającego w tle uaktualnianie nie będzie ruszać odblokowanych dysków."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim que o assistente em segundo plano estiver configurado, atualizar não mexerá nos discos desbloqueados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După configurarea asistentului din fundal, actualizarea nu va atinge discurile deblocate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После настройки фонового помощника обновление не будет трогать разблокированные диски."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko je pomočnik v ozadju nastavljen, posodabljanje odklenjenih pogonov ne bo prizadelo."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasi të vendoset ndihmësi në sfond, përditësimi nuk i prek disqet e shkyçur."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När bakgrundshjälpen är konfigurerad lämnar uppdateringar upplåsta enheter i fred."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อตั้งค่าตัวช่วยเบื้องหลังแล้ว การอัปเดตจะไม่ไปยุ่งกับไดรฟ์ที่ปลดล็อกอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka plan yardımcısı kurulduktan sonra güncelleme, açık sürücülere dokunmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після налаштування фонового помічника оновлення не чіпатиме розблокованих дисків."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi trình trợ giúp nền được thiết lập, việc cập nhật sẽ không đụng đến các ổ đang mở khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置好后台助手后，更新不会影响已解锁的驱动器。"
          }
        }
      }
    },
