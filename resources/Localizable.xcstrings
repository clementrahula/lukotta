    "Setting up the Linux environment": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux-Umgebung wird eingerichtet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration de l’environnement Linux"
          }
        }
      }
    },
    "Show": {
