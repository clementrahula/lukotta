    "%@ does not yet support writing to this file format.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يدعم %@ الكتابة إلى صيغة الملف هذه بعد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ все още не поддържа запис в този файлов формат."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zatím zápis do tohoto formátu souboru nepodporuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ understøtter endnu ikke skrivning til dette filformat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ unterstützt das Schreiben in dieses Dateiformat noch nicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ δεν υποστηρίζει ακόμη την εγγραφή σε αυτή τη μορφή αρχείου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ todavía no admite la escritura en este formato de archivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei toeta veel sellesse failivormingusse kirjutamist."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei vielä tue kirjoittamista tähän tiedostomuotoon."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa sinusuportahan ng %@ ang pagsulat sa format na ito ng file."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne prend pas encore en charge l’écriture dans ce format de fichier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ עדיין אינו תומך בכתיבה לפורמט קובץ זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अभी इस फ़ाइल फ़ॉर्मैट में लिखना समर्थित नहीं करता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ još ne podržava pisanje u ovaj format datoteke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ még nem támogatja az ebbe a fájlformátumba írást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ belum mendukung penulisan ke format berkas ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non supporta ancora la scrittura in questo formato di file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はこのファイル形式への書き込みにまだ対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 아직 이 파일 형식에 쓰기를 지원하지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ dar nepalaiko rašymo į šį failo formatą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vēl neatbalsta rakstīšanu šajā faila formātā."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ belum menyokong penulisan ke format fail ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ støtter ennå ikke skriving til dette filformatet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ondersteunt schrijven naar dit bestandsformaat nog niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie obsługuje jeszcze zapisu w tym formacie pliku."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ ainda não suporta a escrita neste formato de ficheiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nu acceptă încă scrierea în acest format de fișier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ пока не поддерживает запись в этот формат файла."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pisanja v to vrsto datoteke še ne podpira."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ende nuk mbështet shkrimin në këtë format skedari."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stöder ännu inte skrivning till det här filformatet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ยังไม่รองรับการเขียนลงรูปแบบไฟล์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu dosya biçimine yazmayı henüz desteklemiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ поки не підтримує запис у цей формат файлу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chưa hỗ trợ ghi vào định dạng tệp này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 尚不支持写入这种文件格式。"
          }
        }
      }
    },
