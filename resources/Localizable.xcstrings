    "BitLocker drives, unlocked with the volume password or a 48-digit recovery key": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дискове с BitLocker, отключени с паролата на тома или 48-цифрен ключ за възстановяване"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Disky BitLocker, odemčené heslem svazku nebo 48místným obnovovacím klíčem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "BitLocker-enheder, låst op med enhedens adgangskode eller en 48-cifret genoprettelsesnøgle"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BitLocker-Laufwerke, entsperrt mit dem Volume-Passwort oder einem 48-stelligen Wiederherstellungsschlüssel"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δίσκοι BitLocker, ξεκλειδωμένοι με το συνθηματικό του τόμου ή ένα 48ψήφιο κλειδί ανάκτησης"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Discos BitLocker, desbloqueados con la contraseña del volumen o una clave de recuperación de 48 dígitos"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "BitLockeri kettad, avatuna köite parooli või 48-kohalise taastevõtmega"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "BitLocker-asemat, avattuna taltion salasanalla tai 48-numeroisella palautusavaimella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les disques BitLocker, déverrouillés avec le mot de passe du volume ou une clé de récupération à 48 chiffres"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "BitLocker diskovi, otključani lozinkom jedinice ili 48-znamenkastim ključem za oporavak"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "BitLocker-meghajtók, a kötet jelszavával vagy 48 jegyű helyreállítási kulccsal feloldva"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dischi BitLocker, sbloccati con la password del volume o una chiave di recupero di 48 cifre"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„BitLocker“ diskai, atrakinami tomo slaptažodžiu arba 48 skaitmenų atkūrimo raktu"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "BitLocker diski, atbloķēti ar sējuma paroli vai 48 ciparu atkopšanas atslēgu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "BitLocker-enheter, låst opp med volumets passord eller en 48-sifret gjenopprettingsnøkkel"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "BitLocker-schijven, ontgrendeld met het wachtwoord van het volume of een herstelsleutel van 48 cijfers"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyski BitLocker, odblokowywane hasłem woluminu albo 48-cyfrowym kluczem odzyskiwania"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Discos BitLocker, desbloqueados com a palavra-passe do volume ou uma chave de recuperação de 48 dígitos"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Discuri BitLocker, deblocate cu parola volumului sau cu o cheie de recuperare din 48 de cifre"
          }
        },
        "sl": {
