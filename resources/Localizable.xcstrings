    "Updating does not eject your drives. Anything unlocked stays unlocked and keeps working.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يخرج التحديث محرّكاتك. فكل ما هو مفتوح يبقى مفتوحًا ويواصل العمل."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Актуализирането не изважда вашите дискове. Всичко отключено остава отключено и продължава да работи."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizace vaše disky nevysune. Vše odemčené zůstane odemčené a funguje dál."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En opdatering skubber ikke dine enheder ud. Alt, der er låst op, forbliver låst op og fungerer videre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Update wirft deine Laufwerke nicht aus. Alles Entsperrte bleibt entsperrt und funktioniert weiter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ενημέρωση δεν κάνει εξαγωγή των δίσκων σας. Ό,τι είναι ξεκλείδωτο παραμένει ξεκλείδωτο και συνεχίζει να λειτουργεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizar no expulsa tus discos. Todo lo que esté desbloqueado sigue desbloqueado y funcionando."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Uuendamine ei väljuta sinu kettaid. Kõik avatu jääb avatuks ja töötab edasi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivittäminen ei poista asemiasi käytöstä. Kaikki avattu pysyy avattuna ja toimii edelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ini-eject ng pag-update ang iyong mga drive. Ang anumang nakabukas ay mananatiling bukas at patuloy na gumagana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mise à jour n’éjecte pas vos disques. Tout ce qui est déverrouillé le reste et continue de fonctionner."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדכון אינו מוציא את הכוננים שלך. כל מה שפתוח נשאר פתוח וממשיך לעבוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपडेट करने से आपकी ड्राइव नहीं निकलतीं। जो अनलॉक है वह अनलॉक ही रहता है और काम करता रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažuriranje ne izbacuje vaše diskove. Sve što je otključano ostaje otključano i nastavlja raditi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A frissítés nem adja ki a meghajtóit. Ami fel van oldva, az feloldva marad és tovább működik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memperbarui tidak mengeluarkan drive Anda. Apa pun yang terbuka tetap terbuka dan terus bekerja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aggiornamento non espelle i tuoi dischi. Ciò che è sbloccato resta sbloccato e continua a funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートしてもドライブは取り出されません。ロック解除中のものはそのままで、動作し続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트해도 드라이브는 추출되지 않습니다. 잠금 해제된 것은 그대로 유지되며 계속 작동합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Naujinimas neišstumia jūsų diskų. Viskas, kas atrakinta, lieka atrakinta ir veikia toliau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atjaunināšana neizstumj jūsu diskus. Viss atbloķētais paliek atbloķēts un turpina darboties."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengemas kini tidak mengeluarkan pemacu anda. Apa-apa yang terbuka kekal terbuka dan terus berfungsi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En oppdatering mater ikke ut enhetene dine. Alt som er låst opp, forblir låst opp og fungerer videre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijwerken verwijdert je schijven niet. Alles wat ontgrendeld is, blijft ontgrendeld en blijft werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uaktualnianie nie wysuwa Twoich dysków. Wszystko, co odblokowane, pozostaje odblokowane i działa dalej."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizar não ejeta os seus discos. Tudo o que estiver desbloqueado assim permanece e continua a funcionar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizarea nu vă ejectează discurile. Tot ce este deblocat rămâne deblocat și continuă să funcționeze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновление не извлекает ваши диски. Всё разблокированное остаётся разблокированным и продолжает работать."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Posodabljanje ne izvrže vaših pogonov. Vse, kar je odklenjeno, ostane odklenjeno in deluje naprej."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përditësimi nuk i nxjerr disqet. Çdo gjë e shkyçur mbetet e shkyçur dhe vazhdon të punojë."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En uppdatering matar inte ut dina enheter. Allt som är upplåst förblir upplåst och fungerar vidare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอัปเดตไม่ได้ดันไดรฟ์ของคุณออก สิ่งที่ปลดล็อกอยู่จะยังปลดล็อกและทำงานต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncelleme sürücülerinizi çıkarmaz. Açık olan her şey açık kalır ve çalışmayı sürdürür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлення не вилучає ваших дисків. Усе розблоковане залишається розблокованим і працює далі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc cập nhật không tháo các ổ đĩa của bạn. Mọi thứ đang mở khóa vẫn mở khóa và tiếp tục hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新不会推出你的驱动器。已解锁的一切仍保持解锁并继续工作。"
          }
        }
      }
    },
    "Using the key saved in your Keychain": {
      "localizations": {
        "ar": {
