            "value": "«%1$@» não é uma imagem de disco que o %2$@ consiga ler."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” nu este o imagine de disc pe care %2$@ o poate citi."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%1$@« ni slika diska, ki bi jo %2$@ znal prebrati."
