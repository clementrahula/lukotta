    "Was refused. In Files and Folders, switch on Removable Volumes for %@, then come back.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رُفض. في الملفات والمجلدات، شغّل وحدات التخزين القابلة للإزالة لـ %@، ثم عد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Беше отказано. В „Files & Folders“ включете „Removable Volumes“ за %@ и се върнете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bylo odmítnuto. V části „Soubory a složky“ zapněte „Výměnné svazky“ pro %@ a vraťte se sem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Blev afvist. Slå “Udskiftelige enheder” til for %@ under “Arkiver & mapper”, og kom tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wurde abgelehnt. Aktiviere unter „Dateien & Ordner“ die Option „Entfernbare Volumes“ für %@ und komm dann zurück."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απορρίφθηκε. Στα «Αρχεία και φάκελοι» ενεργοποιήστε τους «Αφαιρούμενοι τόμοι» για το %@ και επιστρέψτε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha denegado. En «Archivos y carpetas», activa «Volúmenes extraíbles» para %@ y vuelve aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Keelduti. Lülita jaotises „Files & Folders“ rakenduse %@ jaoks sisse „Removable Volumes“ ja tule tagasi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Evättiin. Ota kohdassa ”Tiedostot ja kansiot” käyttöön ”Siirrettävät taltiot” ohjelmalle %@ ja palaa tänne."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinanggihan. Sa Files and Folders, buksan ang Removable Volumes para sa %@, pagkatapos ay bumalik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A été refusée. Dans « Fichiers et dossiers », activez « Volumes amovibles » pour %@, puis revenez ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדחתה. בקבצים ותיקיות, הפעילו אמצעי אחסון נשלפים עבור %@ ואז חזרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अस्वीकार कर दिया गया। फ़ाइलें और फ़ोल्डर में %@ के लिए हटाने योग्य वॉल्यूम चालू करें, फिर लौटें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbijeno je. U „Datoteke i mape” uključite „Uklonjive jedinice” za %@ pa se vratite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elutasítva. A „Fájlok és mappák” alatt kapcsolja be a „Cserélhető kötetek” beállítást a(z) %@ programhoz, majd térjen vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditolak. Di File dan Folder, nyalakan Volume Lepasan untuk %@, lalu kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato rifiutato. In «File e cartelle» attiva «Volumi rimovibili» per %@, poi torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否されました。「ファイルとフォルダ」で %@ の「リムーバブルボリューム」をオンにしてから、戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거부되었습니다. 파일 및 폴더에서 %@에 대해 이동식 볼륨을 켠 뒤 돌아오십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Buvo atmesta. Skiltyje „Files & Folders“ įjunkite „Removable Volumes“ programai %@ ir grįžkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tika atteikta. Sadaļā “Files & Folders” ieslēdziet “Removable Volumes” programmai %@ un atgriezieties."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Telah ditolak. Dalam Fail dan Folder, hidupkan Volum Boleh Tanggal untuk %@, kemudian kembali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ble avvist. Slå på «Uttakbare volumer» for %@ under «Filer og mapper», og kom tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is geweigerd. Schakel bij ‘Bestanden en mappen’ de optie ‘Verwijderbare volumes’ in voor %@ en kom terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostało odrzucone. W sekcji „Pliki i foldery” włącz „Woluminy wymienne” dla programu %@ i wróć tutaj."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi recusada. Em «Ficheiros e pastas», ative «Volumes amovíveis» para o %@ e volte aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "A fost refuzată. La „Fișiere și dosare”, activați „Volume amovibile” pentru %@, apoi reveniți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Было отклонено. В разделе Файлы и папки включите Съемные тома для %@ и вернитесь."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilo je zavrnjeno. V „Files and Folders“ vklopite „Removable Volumes“ za %@ in se vrnite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "U refuzua. Te Files and Folders, aktivizo Removable Volumes për %@, pastaj kthehu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekades. Slå på ”Borttagbara volymer” för %@ under ”Filer och mappar” och kom tillbaka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถูกปฏิเสธ ใน ไฟล์และโฟลเดอร์ ให้เปิด โวลุ่มที่ถอดได้ สำหรับ %@ แล้วกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reddedildi. Dosyalar ve Klasörler içinde %@ için Çıkarılabilir Birimler seçeneğini açın, sonra geri dönün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Було відхилено. У розділі Файли та папки увімкніть Знімні томи для %@ і поверніться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã bị từ chối. Trong Tệp và thư mục, hãy bật Ổ đĩa tháo lắp được cho %@ rồi quay lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已被拒绝。请在“文件与文件夹”中为 %@ 开启“可移除宗卷”，然后返回。"
          }
        }
      }
    },
