    "macOS already has this drive mounted. Eject it in Finder and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏macOS يركّب هذا المحرّك بالفعل. أخرجه في الباحث ثم حاول مرة أخرى."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS вече е монтирала този диск. Извадете го във Finder и опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS má tento disk již připojen. Vysuňte jej ve Finderu a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS har allerede aktiveret denne enhed. Skub den ud i Finder, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
