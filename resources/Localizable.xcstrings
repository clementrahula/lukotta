        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Finns inte i den här versionen."
          }
        }
      }
    },
    "Nothing is installed. The engine ships inside the app, nothing leaves your Mac, and a drive is only written to when you write to it.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нищо не се инсталира. Двигателят е вътре в приложението, нищо не напуска вашия Mac и на диска се записва само когато вие записвате на него."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der installeres ikke noget. Motoren følger med appen, intet forlader din Mac, og der skrives kun til en enhed, når du selv skriver til den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nichts installiert. Die Engine steckt in der App, nichts verlässt deinen Mac, und auf ein Laufwerk wird nur geschrieben, wenn du darauf schreibst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν εγκαθίσταται τίποτα. Η μηχανή περιέχεται στην εφαρμογή, τίποτα δεν φεύγει από το Mac σας, και σε έναν δίσκο γράφεται μόνο ό,τι γράφετε εσείς."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se instala nada. El motor viene dentro de la app, nada sale de tu Mac y solo se escribe en un disco cuando tú escribes en él."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Midagi ei paigaldata. Mootor on rakenduse sees, miski ei lahku sinu Macist ja kettale kirjutatakse ainult siis, kui sa ise sellele kirjutad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei asenneta. Moottori sisältyy ohjelmaan, mikään ei poistu Macistasi, ja asemalle kirjoitetaan vain silloin, kun itse kirjoitat sille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est installé. Le moteur est intégré à l’app, rien ne quitte votre Mac, et un disque n’est écrit que lorsque vous y écrivez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene installato nulla. Il motore è incluso nell’app, nulla lascia il tuo Mac e su un disco si scrive solo quando ci scrivi tu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekas nediegiama. Variklis yra programos viduje, niekas neišeina iš jūsų „Mac“, o į diską rašoma tik tada, kai patys į jį rašote."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekas netiek instalēts. Dzinējs ir iekļauts lietotnē, nekas neatstāj jūsu Mac datoru, un diskā tiek rakstīts tikai tad, kad jūs pats tajā rakstāt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets geïnstalleerd. De engine zit in de app, er verlaat niets je Mac, en er wordt alleen naar een schijf geschreven wanneer jij dat doet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest instalowane. Silnik jest zawarty w aplikacji, nic nie opuszcza Twojego Maca, a na dysk zapisywane jest tylko to, co sam zapiszesz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é instalado. O motor vem dentro da app, nada sai do seu Mac, e só se escreve num disco quando é o utilizador a escrever."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting installeras. Motorn följer med appen, ingenting lämnar din Mac, och det skrivs bara till en enhet när du själv skriver till den."
          }
        }
      }
    },
    "Once the background helper is set up, updating will leave unlocked drives alone.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "След като фоновият помощник бъде настроен, актуализирането няма да засяга отключените дискове."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når baggrundshjælperen er sat op, rører opdateringer ikke ved oplåste enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald der Hintergrund-Helfer eingerichtet ist, lässt ein Update entsperrte Laufwerke unberührt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόλις ρυθμιστεί ο βοηθός παρασκηνίου, η ενημέρωση δεν θα πειράζει τους ξεκλείδωτους δίσκους."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez configurado el asistente en segundo plano, actualizar no afectará a los discos desbloqueados."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui taustaabiline on seadistatud, ei puuduta uuendamine avatud kettaid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun taustaohjelma on otettu käyttöön, päivittäminen ei koske avattuihin asemiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois l’assistant en arrière-plan configuré, une mise à jour laissera les disques déverrouillés tranquilles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta configurato l’helper in background, l’aggiornamento lascerà stare i dischi sbloccati."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kai foninis pagalbininkas nustatytas, naujinimas nepalies atrakintų diskų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad fona palīgs ir iestatīts, atjaunināšana neaiztiks atbloķētos diskus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra de achtergrondhelper is ingesteld, laat bijwerken ontgrendelde schijven met rust."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po skonfigurowaniu pomocnika działającego w tle uaktualnianie nie będzie ruszać odblokowanych dysków."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim que o assistente em segundo plano estiver configurado, atualizar não mexerá nos discos desbloqueados."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När bakgrundshjälpen är konfigurerad lämnar uppdateringar upplåsta enheter i fred."
          }
        }
      }
    },
