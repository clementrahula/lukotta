    "%@ is free software under the GPL, version 3 or later. The mounting is done by anylinuxfs. Complete source for every component is published with each release. The name and the logo are trademarks, and are not covered by that licence.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ برنامج حر بموجب رخصة GPL الإصدار 3 أو ما بعده. يتولى anylinuxfs عملية التركيب. تُنشر الشيفرة المصدرية الكاملة لكل مكوّن مع كل إصدار. الاسم والشعار علامتان تجاريتان ولا تشملهما تلك الرخصة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ е свободен софтуер под лиценза GPL, версия 3 или по-нова. Монтирането се извършва от anylinuxfs. Пълният изходен код на всеки компонент се публикува с всяко издание. Името и логото са търговски марки и не са обхванати от този лиценз."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je svobodný software pod licencí GPL verze 3 nebo novější. Připojování zajišťuje anylinuxfs. Úplný zdrojový kód každé součásti je zveřejňován s každým vydáním. Název a logo jsou ochranné známky a tato licence se na ně nevztahuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er fri software under GPL, version 3 eller nyere. Aktiveringen klares af anylinuxfs. Den fulde kildekode for hver komponent udgives med hver version. Navnet og logoet er varemærker og er ikke omfattet af den licens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist freie Software unter der GPL, Version 3 oder höher. Das Aktivieren übernimmt anylinuxfs. Der vollständige Quelltext jeder Komponente wird mit jeder Version veröffentlicht. Der Name und das Logo sind Marken und fallen nicht unter diese Lizenz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ είναι ελεύθερο λογισμικό υπό την άδεια GPL, έκδοση 3 ή νεότερη. Η προσάρτηση γίνεται από το anylinuxfs. Ο πλήρης πηγαίος κώδικας κάθε στοιχείου δημοσιεύεται με κάθε έκδοση. Το όνομα και το λογότυπο είναι εμπορικά σήματα και δεν καλύπτονται από αυτήν την άδεια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es software libre bajo la GPL, versión 3 o posterior. Del montaje se encarga anylinuxfs. El código fuente completo de cada componente se publica con cada versión. El nombre y el logotipo son marcas registradas y no están cubiertos por esa licencia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on vaba tarkvara GPL-litsentsi versiooni 3 või uuema alusel. Haakimise teeb anylinuxfs. Iga komponendi täielik lähtekood avaldatakse koos iga väljalaskega. Nimi ja logo on kaubamärgid ning need litsents ei hõlma."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on vapaa ohjelmisto GPL-lisenssin version 3 tai uudemman alaisuudessa. Käyttöönotosta huolehtii anylinuxfs. Jokaisen osan täydellinen lähdekoodi julkaistaan jokaisen version mukana. Nimi ja logo ovat tavaramerkkejä, eikä kyseinen lisenssi kata niitä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang %@ ay malayang software sa ilalim ng GPL bersyon 3 o mas bago. Ang pag-mount ay ginagawa ng anylinuxfs. Ang buong source code ng bawat bahagi ay inilalathala kasabay ng bawat paglabas. Ang pangalan at logo ay mga trademark at hindi saklaw ng lisensyang iyon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est un logiciel libre sous licence GPL, version 3 ou ultérieure. Le montage est assuré par anylinuxfs. Le code source complet de chaque composant est publié à chaque version. Le nom et le logo sont des marques et ne sont pas couverts par cette licence."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ הוא תוכנה חופשית תחת רישיון GPL גרסה 3 או מאוחרת יותר. העגינה מתבצעת על ידי anylinuxfs. קוד המקור המלא של כל רכיב מתפרסם עם כל גרסה. השם והלוגו הם סימני מסחר ואינם מכוסים ברישיון זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ GPL संस्करण 3 या उसके बाद के अंतर्गत मुक्त सॉफ़्टवेयर है। माउंट करने का काम anylinuxfs करता है। हर घटक का पूरा स्रोत कोड प्रत्येक रिलीज़ के साथ प्रकाशित होता है। नाम और लोगो ट्रेडमार्क हैं और उस लाइसेंस के अंतर्गत नहीं आते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je slobodan softver pod licencom GPL, verzija 3 ili novija. Montiranje obavlja anylinuxfs. Potpuni izvorni kod svake komponente objavljuje se uz svako izdanje. Naziv i logotip zaštitni su znakovi i nisu obuhvaćeni tom licencom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ szabad szoftver a GPL 3-as vagy újabb verziója alatt. A csatolást az anylinuxfs végzi. Minden összetevő teljes forráskódja megjelenik minden kiadással. A név és a logó védjegy, és nem tartozik az említett licenc hatálya alá."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adalah perangkat lunak bebas di bawah GPL versi 3 atau yang lebih baru. Pemasangan dikerjakan oleh anylinuxfs. Kode sumber lengkap untuk setiap komponen diterbitkan bersama setiap rilis. Nama dan logo adalah merek dagang dan tidak tercakup dalam lisensi tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è software libero sotto licenza GPL, versione 3 o successiva. Il montaggio è svolto da anylinuxfs. Il codice sorgente completo di ogni componente viene pubblicato a ogni versione. Il nome e il logo sono marchi e non sono coperti da quella licenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は GPL バージョン 3 以降のフリーソフトウェアです。マウントは anylinuxfs が行います。すべての構成要素の完全なソースコードは、リリースごとに公開されます。名称とロゴは商標であり、このライセンスの対象ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) GPL 버전 3 이상에 따른 자유 소프트웨어입니다. 마운트는 anylinuxfs가 수행합니다. 모든 구성 요소의 전체 소스 코드는 릴리스마다 공개됩니다. 이름과 로고는 상표이며 해당 라이선스의 적용을 받지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yra laisva programinė įranga pagal GPL licenciją, 3 arba naujesnę versiją. Prijungimą atlieka anylinuxfs. Visas kiekvieno komponento pirminis kodas skelbiamas su kiekviena laida. Pavadinimas ir logotipas yra prekių ženklai ir ta licencija jų neapima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ir brīvā programmatūra ar GPL licenci, versiju 3 vai jaunāku. Montēšanu veic anylinuxfs. Katra komponenta pilns pirmkods tiek publicēts ar katru laidienu. Nosaukums un logotips ir preču zīmes, un šī licence uz tiem neattiecas."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ialah perisian bebas di bawah GPL versi 3 atau lebih baharu. Pelekapan dilakukan oleh anylinuxfs. Kod sumber lengkap bagi setiap komponen diterbitkan bersama setiap keluaran. Nama dan logo ialah tanda dagangan dan tidak dilindungi lesen itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er fri programvare under GPL, versjon 3 eller nyere. Monteringen gjøres av anylinuxfs. Fullstendig kildekode for hver komponent publiseres med hver utgivelse. Navnet og logoen er varemerker og omfattes ikke av den lisensen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is vrije software onder de GPL, versie 3 of later. Het activeren gebeurt door anylinuxfs. De volledige broncode van elk onderdeel wordt bij elke versie gepubliceerd. De naam en het logo zijn handelsmerken en vallen niet onder die licentie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest wolnym oprogramowaniem na licencji GPL w wersji 3 lub nowszej. Montowaniem zajmuje się anylinuxfs. Pełny kod źródłowy każdego składnika jest publikowany wraz z każdym wydaniem. Nazwa i logo są znakami towarowymi i nie są objęte tą licencją."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ é software livre sob a GPL, versão 3 ou posterior. A montagem é feita pelo anylinuxfs. O código-fonte completo de cada componente é publicado com cada versão. O nome e o logótipo são marcas registadas e não estão abrangidos por essa licença."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ este software liber sub licența GPL, versiunea 3 sau ulterioară. Montarea este realizată de anylinuxfs. Codul sursă complet al fiecărei componente este publicat cu fiecare versiune. Numele și sigla sunt mărci comerciale și nu sunt acoperite de acea licență."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — свободное программное обеспечение под лицензией GPL версии 3 или новее. Монтирование выполняет anylinuxfs. Полный исходный код каждого компонента публикуется с каждым выпуском. Название и логотип являются товарными знаками и этой лицензией не покрываются."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je prosto programje pod licenco GPL, različica 3 ali novejša. Priklop opravi anylinuxfs. Popolna izvorna koda vsake komponente je objavljena z vsako izdajo. Ime in logotip sta blagovni znamki in ju ta licenca ne zajema."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ është software i lirë sipas GPL, versioni 3 ose më i vonshëm. Montimi kryhet nga anylinuxfs. Burimi i plotë për çdo komponent publikohet me çdo hedhje në qarkullim. Emri dhe logoja janë marka tregtare dhe nuk mbulohen nga ajo licencë."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är fri programvara under GPL, version 3 eller senare. Monteringen sköts av anylinuxfs. Fullständig källkod för varje komponent publiceras med varje version. Namnet och logotypen är varumärken och omfattas inte av den licensen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ เป็นซอฟต์แวร์เสรีภายใต้ GPL รุ่น 3 หรือใหม่กว่า การเมานต์ทำโดย anylinuxfs ซอร์สโค้ดฉบับสมบูรณ์ของทุกส่วนประกอบเผยแพร่พร้อมกับทุกรุ่นที่ปล่อยออกมา ชื่อและโลโก้เป็นเครื่องหมายการค้าและไม่อยู่ภายใต้สัญญาอนุญาตนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, GPL sürüm 3 veya sonrası kapsamında özgür yazılımdır. Bağlama işini anylinuxfs yapar. Her bileşenin tam kaynak kodu her sürümle birlikte yayımlanır. Ad ve logo ticari markadır ve bu lisans kapsamında değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — вільне програмне забезпечення за ліцензією GPL версії 3 або новішої. Монтування виконує anylinuxfs. Повний вихідний код кожного компонента публікується з кожним випуском. Назва та логотип є торговельними марками й цією ліцензією не охоплюються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ là phần mềm tự do theo GPL phiên bản 3 hoặc mới hơn. Việc gắn kết do anylinuxfs thực hiện. Mã nguồn đầy đủ của mọi thành phần được công bố cùng mỗi bản phát hành. Tên gọi và biểu trưng là nhãn hiệu và không thuộc phạm vi giấy phép đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是遵循 GPL 第 3 版或更新版本的自由软件。挂载由 anylinuxfs 完成。每个组件的完整源代码都随每次发布一同公布。名称与标志为商标，不在该许可证的涵盖范围内。"
          }
        }
      }
    },
