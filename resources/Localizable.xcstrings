        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” är inte en skivavbild som %2$@ kan läsa."
          }
        }
      }
    },
    "“%@” is part of a chain of snapshots, which %@ cannot open. Open the disk it was made from.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ е част от верига от снимки, която %2$@ не може да отвори. Отворете диска, от който е направен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ je součástí řetězu snímků, který %2$@ neumí otevřít. Otevřete disk, ze kterého vznikl."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” er en del af en kæde af snapshots, som %2$@ ikke kan åbne. Åbn den disk, den er lavet af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ gehört zu einer Kette von Snapshots, die %2$@ nicht öffnen kann. Öffne das Laufwerk, aus dem es erstellt wurde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%1$@» ανήκει σε αλυσίδα στιγμιοτύπων, την οποία το %2$@ δεν μπορεί να ανοίξει. Ανοίξτε τον δίσκο από τον οποίο δημιουργήθηκε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» forma parte de una cadena de instantáneas que %2$@ no puede abrir. Abre el disco del que se creó."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ kuulub hetktõmmiste ahelasse, mida %2$@ avada ei suuda. Ava ketas, millest see tehti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” kuuluu tilannevedosten ketjuun, jota %2$@ ei voi avata. Avaa asema, josta se on tehty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » fait partie d’une chaîne d’instantanés que %2$@ ne sait pas ouvrir. Ouvrez le disque dont il provient."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” dio je lanca snimaka koji %2$@ ne može otvoriti. Otvorite disk iz kojeg je nastao."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%1$@” pillanatképek láncának része, amelyet a(z) %2$@ nem tud megnyitni. Nyissa meg azt a meghajtót, amelyből készült."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» fa parte di una catena di snapshot che %2$@ non sa aprire. Apri il disco da cui è stato creato."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ yra momentinių kopijų grandinės dalis, kurios %2$@ atverti negali. Atverkite diską, iš kurio jis sukurtas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” ir daļa no momentuzņēmumu ķēdes, ko %2$@ nespēj atvērt. Atveriet disku, no kura tas izveidots."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» er del av en kjede med øyeblikksbilder som %2$@ ikke kan åpne. Åpne disken den ble laget av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’ maakt deel uit van een reeks momentopnamen die %2$@ niet kan openen. Open de schijf waarvan die is gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” jest częścią łańcucha migawek, którego %2$@ nie potrafi otworzyć. Otwórz dysk, z którego powstał."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» faz parte de uma cadeia de instantâneos que o %2$@ não consegue abrir. Abra o disco a partir do qual foi criado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” face parte dintr-un lanț de instantanee pe care %2$@ nu îl poate deschide. Deschideți discul din care a fost creat."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%1$@« je del verige posnetkov, ki je %2$@ ne zna odpreti. Odprite pogon, iz katerega je nastal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” ingår i en kedja av ögonblicksbilder som %2$@ inte kan öppna. Öppna disken den skapades från."
          }
        }
      }
    },
    "“%@” is smaller than its footer states, and may be damaged or incomplete.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ е по-малък, отколкото посочва долният му колонтитул, и може да е повреден или непълен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ je menší, než uvádí jeho patička, a může být poškozený nebo neúplný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” er mindre, end dens egen sidefod angiver, og kan være beskadiget eller ufuldstændig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist kleiner, als seine eigene Fußzeile angibt, und ist möglicherweise beschädigt oder unvollständig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» είναι μικρότερο από όσο δηλώνει το υποσέλιδό του και μπορεί να είναι κατεστραμμένο ή ημιτελές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» es más pequeño de lo que indica su pie de página y puede estar dañado o incompleto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ on väiksem, kui tema enda jalus väidab, ja võib olla rikutud või poolik."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” on pienempi kuin sen oma alatunniste ilmoittaa, ja se voi olla vaurioitunut tai keskeneräinen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est plus petit que ne l’indique son pied de page ; il est peut-être endommagé ou incomplet."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” je manji nego što navodi njegovo podnožje i možda je oštećen ili nepotpun."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” kisebb, mint amit a saját élőlába megad, ezért sérült vagy hiányos lehet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» è più piccolo di quanto indichi il suo piè di pagina e potrebbe essere danneggiato o incompleto."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ yra mažesnis, nei nurodo jo poraštė, todėl gali būti sugadintas arba nebaigtas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ir mazāks, nekā norāda tā kājene, un var būt bojāts vai nepabeigts."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» er mindre enn sin egen bunntekst oppgir, og kan være skadet eller ufullstendig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ is kleiner dan de eigen voettekst aangeeft en is mogelijk beschadigd of onvolledig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” jest mniejszy, niż podaje jego stopka, i może być uszkodzony lub niekompletny."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» é menor do que o seu rodapé indica e pode estar danificado ou incompleto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” este mai mic decât indică propriul subsol și poate fi deteriorat sau incomplet."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« je manjši, kot navaja njegova noga, in je morda poškodovan ali nepopoln."
          }
