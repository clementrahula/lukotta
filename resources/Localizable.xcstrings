            "value": "การเขียนลงรูปแบบอิมเมจนี้ยังไม่ได้ผ่านการทดสอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu imaj biçimine yazmak denenmemiştir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис у цей формат образу не перевірено"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc ghi vào định dạng ảnh đĩa này chưa được kiểm chứng"
