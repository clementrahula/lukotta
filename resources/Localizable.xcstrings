    "This usually takes under a minute.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Обикновено отнема под минута."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obvykle to trvá méně než minutu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det tager som regel under et minut."
          }
        },
        "de": {
