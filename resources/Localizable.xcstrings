        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ตั้งค่าตัวช่วยเบื้องหลัง %@ จึงถือไดรฟ์เหล่านั้นให้เปิดอยู่ด้วยตัวเอง การออกตอนนี้จะตัดการเชื่อมต่อ และสิ่งที่กำลังเขียนอยู่จะไม่เสร็จ\n\nเมื่อตั้งค่าตัวช่วยแล้ว ไดรฟ์จะเปิดค้างอยู่ได้เอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka plan yardımcısı kurulu değil, bu yüzden onları açık tutan %@ uygulamasının kendisi. Şimdi çıkmak bağlantılarını keser ve hâlâ yazılmakta olan şeyler tamamlanmaz.\n\nYardımcı kurulduktan sonra sürücüler kendi başlarına açık kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоновий помічник не налаштовано, тож %@ утримує їх відкритими сам. Вихід зараз від’єднає їх, і все, що ще записується, не завершиться.\n\nПісля налаштування помічника диски залишаються відкритими самі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình trợ giúp nền chưa được thiết lập, nên chính %@ đang giữ chúng mở. Thoát lúc này sẽ ngắt chúng, và những gì đang được ghi sẽ không hoàn tất.\n\nSau khi trình trợ giúp được thiết lập, các ổ đĩa tự giữ trạng thái mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台助手尚未设置，因此是 %@ 自己在保持它们打开。此时退出会断开它们，正在写入的内容也无法完成。\n\n设置好助手后，驱动器会自行保持打开。"
          }
        }
      }
    },
    "The background helper will be unregistered.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُلغى تسجيل المساعد في الخلفية."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрацията на фоновия помощник ще бъде отменена."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrace pomocníka na pozadí bude zrušena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baggrundshjælperens registrering fjernes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Registrierung des Hintergrund-Helfers wird aufgehoben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η καταχώριση του βοηθού παρασκηνίου θα ακυρωθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se anulará el registro del asistente en segundo plano."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustaabilise registreering tühistatakse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustaohjelman rekisteröinti perutaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Aalisin ang pagkakarehistro ng background helper."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistant en arrière-plan sera désenregistré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רישום עוזר הרקע יבוטל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पृष्ठभूमि सहायक का पंजीकरण रद्द कर दिया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Registracija pomoćnika u pozadini bit će poništena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A háttérsegéd regisztrációja megszűnik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendaftaran pembantu latar belakang akan dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’helper in background verrà deregistrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドヘルパーの登録が解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 도우미의 등록이 해제됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foninio pagalbininko registracija bus atšaukta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fona palīga reģistrācija tiks atcelta."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendaftaran pembantu latar belakang akan dibatalkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrunnshjelperens registrering fjernes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De registratie van de achtergrondhelper wordt ongedaan gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejestracja pomocnika działającego w tle zostanie cofnięta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O registo do assistente em segundo plano será anulado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrarea asistentului din fundal va fi anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрация фонового помощника будет отменена."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registracija pomočnika v ozadju bo preklicana."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ndihmësi në sfond do të çregjistrohet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrundshjälpens registrering tas bort."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงทะเบียนตัวช่วยเบื้องหลังจะถูกยกเลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka plan yardımcısının kaydı silinecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Реєстрацію фонового помічника буде скасовано."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trình trợ giúp nền sẽ được hủy đăng ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台助手的注册将被取消。"
          }
        }
      }
    },
    "The drive appears in the Finder sidebar under Locations.\nEject it in Finder before unplugging it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر المحرّك في الشريط الجانبي للباحث ضمن المواقع.\nأخرجه في الباحث قبل فصله."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дискът се появява в страничната лента на Finder в раздела „Locations“.\nИзвадете го във Finder, преди да го изключите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk se zobrazí v postranním panelu Finderu v části „Místa“.\nNež jej odpojíte, vysuňte jej ve Finderu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheden vises i Finders indholdsoversigt under “Placeringer”.\nSkub den ud i Finder, før du frakobler den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laufwerk erscheint in der Finder-Seitenleiste unter „Orte“.\nWirf es im Finder aus, bevor du es abziehst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο δίσκος εμφανίζεται στην πλαϊνή στήλη του Finder, στην ενότητα «Τοποθεσίες».\nΚάντε εξαγωγή στο Finder πριν τον αποσυνδέσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco aparece en la barra lateral del Finder, en «Ubicaciones».\nExpúlsalo en el Finder antes de desconectarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketas ilmub Finderi külgribale jaotisse „Locations“.\nVäljuta see Finderis, enne kui selle lahti ühendad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asema näkyy Finderin sivupalkissa kohdassa ”Sijainnit”.\nPoista se käytöstä Finderissa ennen irrottamista."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumalabas ang drive sa sidebar ng Finder sa ilalim ng Locations.\nI-eject ito sa Finder bago hugutin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque apparaît dans la barre latérale du Finder, sous « Emplacements ».\nÉjectez-le dans le Finder avant de le débrancher."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכונן מופיע בסרגל הצד של Finder תחת מיקומים.\nהוציאו אותו ב‑Finder לפני הניתוק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ड्राइव Finder के साइडबार में Locations के नीचे दिखती है।\nनिकालने से पहले उसे Finder में इजेक्ट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk se pojavljuje u rubnom stupcu Findera pod „Lokacije”.\nIzbacite ga u Finderu prije odspajanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A meghajtó a Finder oldalsávján, a „Helyek” alatt jelenik meg.\nLeválasztás előtt adja ki a Finderben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive muncul di bilah samping Finder di bawah Locations.\nKeluarkan di Finder sebelum mencabutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco appare nella barra laterale del Finder, sotto «Posizioni».\nEspellilo nel Finder prima di scollegarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライブは Finder のサイドバーの「場所」に表示されます。\n取り外す前に Finder で取り出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드라이브는 Finder 사이드바의 위치 아래에 나타납니다.\n분리하기 전에 Finder에서 추출하십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskas rodomas „Finder“ šoninėje juostoje skiltyje „Locations“.\nIšstumkite jį „Finder“ programoje prieš atjungdami."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Disks parādās programmas Finder sānjoslā sadaļā “Locations”.\nIzstumiet to programmā Finder, pirms to atvienojat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemacu muncul dalam bar sisi Finder di bawah Locations.\nKeluarkannya dalam Finder sebelum mencabutnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten vises i sidepanelet i Finder under «Plasseringer».\nMat den ut i Finder før du kobler den fra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schijf verschijnt in de navigatiekolom van de Finder onder ‘Locaties’.\nVerwijder die in de Finder voordat je de schijf loskoppelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dysk pojawia się na pasku bocznym Findera w sekcji „Miejsca”.\nWysuń go w Finderze, zanim go odłączysz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco aparece na barra lateral do Finder, em «Locais».\nEjete-o no Finder antes de o desligar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Discul apare în bara laterală Finder, la „Amplasamente”.\nEjectați-l în Finder înainte de a-l deconecta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диск появляется в боковом меню Finder в разделе «Размещения».\nИзвлеките его в Finder, прежде чем отключать."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogon se prikaže v stranski vrstici Finderja pod »Lokacije«.\nPreden ga odklopite, ga izvrzite v Finderju."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Disku shfaqet në shiritin anësor të Finder-it te Locations.\nNxirre në Finder para se ta shkëputësh."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten visas i Finders sidofält under ”Platser”.\nMata ut den i Finder innan du kopplar bort den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไดรฟ์จะปรากฏในแถบข้างของ Finder ใต้หัวข้อ Locations\nดันออกใน Finder ก่อนถอดสาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürücü, Finder kenar çubuğunda Konumlar altında görünür.\nÇıkarmadan önce Finder'da çıkarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диск з’являється в бічній панелі Finder у розділі «Розташування».\nВилучіть його у Finder, перш ніж від’єднувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đĩa xuất hiện ở thanh bên của Finder, dưới mục Locations.\nHãy tháo nó trong Finder trước khi rút ra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该驱动器会出现在“访达”边栏的“位置”下。\n拔下之前请在“访达”中推出它。"
          }
        }
      }
    },
    "The drive did not finish ejecting. It may still be in use, so try again or eject it in Finder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل إخراج المحرّك. قد يكون لا يزال قيد الاستخدام، فحاول مرة أخرى أو أخرجه في الباحث."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дискът не завърши изваждането. Може още да се използва, затова опитайте отново или го извадете във Finder."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk se nepodařilo vysunout celý. Možná se ještě používá, zkuste to znovu nebo ho vysuňte ve Finderu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disken blev ikke skubbet helt ud. Den er måske stadig i brug, så prøv igen, eller skub den ud i Finder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laufwerk wurde nicht fertig ausgeworfen. Vielleicht ist es noch in Gebrauch: versuch es erneut oder wirf es im Finder aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο δίσκος δεν ολοκλήρωσε την εξαγωγή. Μπορεί να χρησιμοποιείται ακόμη, οπότε δοκιμάστε ξανά ή κάντε εξαγωγή από το Finder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco no terminó de expulsarse. Puede que siga en uso: inténtalo de nuevo o expúlsalo en el Finder."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketas ei väljunud lõpuni. Ehk on see veel kasutusel: proovige uuesti või väljutage see Finderis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Levyn poistaminen ei mennyt loppuun. Se voi olla yhä käytössä, joten yritä uudelleen tai poista se Finderissa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi natapos ang pag-eject ng drive. Maaaring ginagamit pa ito, kaya subukan muli o i-eject ito sa Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque n’a pas fini d’être éjecté. Il est peut-être encore utilisé : réessayez ou éjectez-le dans le Finder."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכונן לא סיים להיפלט. ייתכן שהוא עדיין בשימוש, אז נסו שוב או הוציאו אותו ב‑Finder."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ड्राइव निकालने का काम पूरा नहीं हुआ। शायद वह अब भी उपयोग में है; फिर से कोशिश करें या उसे Finder में निकालें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk nije dovršio izbacivanje. Možda je još u upotrebi, pa pokušajte ponovno ili ga izbacite u Finderu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lemez kiadása nem fejeződött be. Lehet, hogy még használatban van: próbálja újra, vagy adja ki a Finderben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive belum selesai dikeluarkan. Mungkin masih dipakai, jadi coba lagi atau keluarkan di Finder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco non ha finito di essere espulso. Potrebbe essere ancora in uso: riprova oppure espellilo dal Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライブの取り出しが完了しませんでした。まだ使用中の可能性があります。もう一度試すか、Finder で取り出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드라이브 추출을 마치지 못했습니다. 아직 사용 중일 수 있으니 다시 시도하거나 Finder에서 추출하십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskas nebaigė išsistumti. Gali būti, kad jis dar naudojamas: bandykite dar kartą arba išstumkite jį per „Finder“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Disks netika izstumts līdz galam. Iespējams, tas vēl tiek lietots: mēģiniet vēlreiz vai izstumiet to programmā Finder."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemacu belum selesai dikeluarkan. Ia mungkin masih digunakan, jadi cuba lagi atau keluarkannya dalam Finder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disken ble ikke matet helt ut. Den er kanskje fortsatt i bruk, så prøv igjen eller mat den ut i Finder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schijf is niet volledig verwijderd. Mogelijk is die nog in gebruik: probeer het opnieuw of verwijder die in de Finder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dysk nie został wysunięty do końca. Może być jeszcze w użyciu, więc spróbuj ponownie albo wysuń go w Finderze."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco não terminou de ser ejetado. Pode ainda estar em uso, por isso tente de novo ou ejete-o no Finder."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Discul nu a terminat de ejectat. Poate fi încă în uz, așa că încercați din nou sau ejectați-l în Finder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диск не завершил извлечение. Возможно, он ещё используется — попробуйте снова или извлеките его в Finder."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk se ni do konca izvrgel. Morda je še v uporabi, zato poskusite znova ali ga izvrzite v Finderju."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Disku nuk e përfundoi nxjerrjen. Mund të jetë ende në përdorim, ndaj provo sërish ose nxirre në Finder."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Disken matades inte ut helt. Den kanske fortfarande används, så försök igen eller mata ut den i Finder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดันไดรฟ์ออกไม่สำเร็จ อาจยังมีการใช้งานอยู่ ลองใหม่อีกครั้งหรือดันออกใน Finder"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürücü çıkarma işlemini tamamlamadı. Hâlâ kullanılıyor olabilir; yeniden deneyin ya da Finder'da çıkarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диск не завершив вилучення. Можливо, він ще використовується — спробуйте знову або вилучіть його у Finder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đĩa chưa tháo xong. Có thể nó vẫn đang được dùng, hãy thử lại hoặc tháo trong Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "驱动器未能完成推出。它可能仍在使用中，请重试或在“访达”中推出。"
          }
        }
      }
    },
    "The drive is busy. Close anything using it, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحرّك مشغول. أغلق كل ما يستخدمه، ثم حاول مرة أخرى."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дискът е зает. Затворете всичко, което го използва, и опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk je používán. Zavřete vše, co jej používá, a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheden er optaget. Luk alt, der bruger den, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laufwerk ist belegt. Schließe alles, was es verwendet, und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο δίσκος είναι απασχολημένος. Κλείστε ό,τι τον χρησιμοποιεί και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco está ocupado. Cierra todo lo que lo esté usando y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketas on hõivatud. Sulge kõik, mis seda kasutab, ja proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asema on varattu. Sulje kaikki sitä käyttävä ja yritä uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Abala ang drive. Isara ang anumang gumagamit nito, pagkatapos ay subukan muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque est occupé. Fermez tout ce qui l’utilise, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכונן תפוס. סגרו כל דבר שמשתמש בו ונסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ड्राइव व्यस्त है। जो कुछ उसका उपयोग कर रहा है उसे बंद करें, फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk je zauzet. Zatvorite sve što ga koristi, pa pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A meghajtó foglalt. Zárjon be mindent, ami használja, majd próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive sedang sibuk. Tutup apa pun yang memakainya, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco è occupato. Chiudi tutto ciò che lo sta usando, quindi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライブが使用中です。使っているものを閉じてから、もう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드라이브가 사용 중입니다. 사용 중인 항목을 닫고 다시 시도하십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskas užimtas. Uždarykite viską, kas jį naudoja, ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Disks ir aizņemts. Aizveriet visu, kas to izmanto, un mēģiniet vēlreiz."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemacu sedang sibuk. Tutup apa-apa yang menggunakannya, kemudian cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten er opptatt. Lukk alt som bruker den, og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schijf is bezig. Sluit alles wat die gebruikt en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dysk jest zajęty. Zamknij wszystko, co go używa, i spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco está ocupado. Feche tudo o que o esteja a usar e tente de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Discul este ocupat. Închideți tot ce îl folosește, apoi reîncercați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диск занят. Закройте всё, что его использует, и попробуйте снова."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogon je zaseden. Zaprite vse, kar ga uporablja, nato poskusite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Disku është i zënë. Mbyll çdo gjë që e përdor, pastaj provo sërish."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten är upptagen. Stäng allt som använder den och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไดรฟ์กำลังถูกใช้งาน ปิดสิ่งที่ใช้งานอยู่แล้วลองใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürücü meşgul. Onu kullanan her şeyi kapatın ve yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диск зайнятий. Закрийте все, що його використовує, і спробуйте знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đĩa đang bận. Hãy đóng những gì đang dùng nó rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "驱动器正忙。请关闭正在使用它的程序，然后重试。"
          }
        }
      }
    },
    "The drive is handed to Finder over a local network connection, so it appears under Locations with a network icon. It reads, writes and ejects like any other drive. macOS offers no way to present it as a local disk.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُسلَّم المحرّك إلى الباحث عبر اتصال شبكة محلي، لذا يظهر ضمن المواقع بأيقونة شبكة. ويُقرأ ويُكتب ويُخرج كأي محرّك آخر. ولا يتيح macOS أي طريقة لعرضه كقرص محلي."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дискът се предава на Finder през локална мрежова връзка, затова се появява в „Locations“ с мрежова икона. Чете се, записва се и се изважда като всеки друг диск. macOS не предлага начин да бъде показан като локален диск."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk je Finderu předán přes místní síťové připojení, proto se zobrazuje v části „Místa“ se síťovou ikonou. Čte se z něj, zapisuje se na něj a vysouvá se jako kterýkoli jiný disk. macOS nenabízí způsob, jak jej zobrazit jako místní disk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheden gives videre til Finder via en lokal netværksforbindelse og vises derfor under “Placeringer” med et netværkssymbol. Den læses, skrives og skubbes ud som enhver anden enhed. macOS giver ingen mulighed for at vise den som en lokal disk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laufwerk wird dem Finder über eine lokale Netzwerkverbindung übergeben und erscheint deshalb unter „Orte“ mit einem Netzwerksymbol. Es liest, schreibt und wird ausgeworfen wie jedes andere Laufwerk. macOS bietet keine Möglichkeit, es als lokales Volume darzustellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο δίσκος παραδίδεται στο Finder μέσω τοπικής σύνδεσης δικτύου, γι’ αυτό εμφανίζεται στις «Τοποθεσίες» με εικονίδιο δικτύου. Διαβάζεται, γράφεται και εξάγεται όπως κάθε άλλος δίσκος. Το macOS δεν προσφέρει τρόπο να παρουσιαστεί ως τοπικός δίσκος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco se entrega al Finder mediante una conexión de red local, por lo que aparece en «Ubicaciones» con un icono de red. Se lee, se escribe y se expulsa como cualquier otro disco. macOS no ofrece ninguna forma de presentarlo como un disco local."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketas antakse Finderile üle kohtvõrguühenduse kaudu, seega ilmub see jaotisse „Locations“ võrguikooniga. Seda loetakse, sellele kirjutatakse ja see väljutatakse nagu iga teine ketas. macOS ei võimalda seda kohaliku kettana esitada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asema välitetään Finderille paikallisen verkkoyhteyden kautta, joten se näkyy kohdassa ”Sijainnit” verkkokuvakkeella. Sitä luetaan, siihen kirjoitetaan ja se poistetaan käytöstä kuten mikä tahansa muu asema. macOS ei tarjoa tapaa esittää sitä paikallisena levynä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibinibigay ang drive sa Finder sa pamamagitan ng lokal na koneksyon sa network, kaya lumalabas ito sa ilalim ng Locations na may icon ng network. Nababasa, nasusulatan at na-e-eject ito gaya ng ibang drive. Walang inaalok ang macOS na paraan para ipakita ito bilang lokal na disk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque est transmis au Finder via une connexion réseau locale : il apparaît donc sous « Emplacements » avec une icône de réseau. Il se lit, s’écrit et s’éjecte comme n’importe quel autre disque. macOS n’offre aucun moyen de le présenter comme un disque local."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכונן נמסר ל‑Finder דרך חיבור רשת מקומי, ולכן הוא מופיע תחת מיקומים עם סמל רשת. אפשר לקרוא, לכתוב ולהוציא אותו כמו כל כונן אחר. ל‑macOS אין דרך להציג אותו כדיסק מקומי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ड्राइव को स्थानीय नेटवर्क कनेक्शन से Finder को सौंपा जाता है, इसलिए वह Locations के नीचे नेटवर्क आइकन के साथ दिखती है। वह किसी भी और ड्राइव की तरह पढ़ी, लिखी और निकाली जाती है। macOS उसे स्थानीय डिस्क की तरह दिखाने का कोई रास्ता नहीं देता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk se Finderu predaje putem lokalne mrežne veze, pa se prikazuje pod „Lokacije” s mrežnom ikonom. Čita se, zapisuje i izbacuje kao i svaki drugi disk. macOS ne nudi način da ga prikaže kao lokalni disk."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A meghajtót a program helyi hálózati kapcsolaton adja át a Findernek, ezért a „Helyek” alatt, hálózati ikonnal jelenik meg. Ugyanúgy olvasható, írható és kiadható, mint bármely más meghajtó. A macOS nem kínál módot arra, hogy helyi lemezként jelenjen meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive diserahkan ke Finder lewat sambungan jaringan lokal, jadi muncul di bawah Locations dengan ikon jaringan. Ia dapat dibaca, ditulis, dan dikeluarkan seperti drive lain. macOS tidak menyediakan cara menampilkannya sebagai disk lokal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco viene consegnato al Finder tramite una connessione di rete locale, quindi appare sotto «Posizioni» con un’icona di rete. Si legge, si scrive e si espelle come qualsiasi altro disco. macOS non offre alcun modo di presentarlo come disco locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライブはローカルのネットワーク接続で Finder に引き渡されるため、「場所」にネットワークアイコン付きで表示されます。ほかのドライブと同じように読み書きと取り出しができます。macOS には、これをローカルディスクとして見せる方法がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드라이브는 로컬 네트워크 연결을 통해 Finder에 넘겨지므로 위치 아래에 네트워크 아이콘과 함께 나타납니다. 다른 드라이브와 똑같이 읽고 쓰고 추출할 수 있습니다. macOS는 이를 로컬 디스크로 표시할 방법을 제공하지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskas perduodamas „Finder“ programai vietinio tinklo ryšiu, todėl rodomas skiltyje „Locations“ su tinklo piktograma. Jis skaitomas, į jį rašoma ir jis išstumiamas kaip bet kuris kitas diskas. „macOS“ nesiūlo būdo pateikti jį kaip vietinį diską."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Disks tiek nodots programmai Finder pa lokālā tīkla savienojumu, tāpēc tas parādās sadaļā “Locations” ar tīkla ikonu. To lasa, tajā raksta un izstumj tāpat kā jebkuru citu disku. macOS nepiedāvā veidu, kā to parādīt kā lokālu disku."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemacu diserahkan kepada Finder melalui sambungan rangkaian setempat, jadi ia muncul di bawah Locations dengan ikon rangkaian. Ia dibaca, ditulis dan dikeluarkan seperti mana-mana pemacu lain. macOS tidak menyediakan cara untuk memaparkannya sebagai cakera setempat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten overleveres til Finder via en lokal nettverkstilkobling, og vises derfor under «Plasseringer» med et nettverkssymbol. Den leses, skrives og mates ut som enhver annen enhet. macOS gir ingen mulighet til å vise den som en lokal disk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schijf wordt via een lokale netwerkverbinding aan de Finder doorgegeven en verschijnt daarom onder ‘Locaties’ met een netwerksymbool. Je leest, schrijft en verwijdert die net als elke andere schijf. macOS biedt geen manier om die als lokale schijf te tonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dysk jest przekazywany Finderowi przez lokalne połączenie sieciowe, dlatego pojawia się w sekcji „Miejsca” z ikoną sieci. Odczytuje się go, zapisuje i wysuwa jak każdy inny dysk. macOS nie daje możliwości pokazania go jako dysku lokalnego."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco é entregue ao Finder através de uma ligação de rede local, pelo que aparece em «Locais» com um ícone de rede. Lê-se, escreve-se e ejeta-se como qualquer outro disco. O macOS não oferece forma de o apresentar como um disco local."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Discul este predat aplicației Finder printr-o conexiune de rețea locală, așa că apare la „Amplasamente” cu o pictogramă de rețea. Se citește, se scrie și se ejectează ca orice alt disc. macOS nu oferă nicio modalitate de a-l prezenta ca disc local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диск передаётся в Finder через локальное сетевое соединение, поэтому он появляется в разделе «Размещения» со значком сети. Он читается, записывается и извлекается как любой другой диск. macOS не даёт способа представить его локальным."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogon se Finderju preda prek lokalne omrežne povezave, zato se prikaže pod »Lokacije« z omrežno ikono. Bere se, zapisuje in izvrže kot vsak drug pogon. macOS ne ponuja načina, da bi ga prikazal kot lokalni disk."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Disku i dorëzohet Finder-it përmes një lidhjeje rrjeti vendore, ndaj shfaqet te Locations me një ikonë rrjeti. Lexon, shkruan dhe nxirret si çdo disk tjetër. macOS nuk ofron asnjë mënyrë për ta paraqitur si disk vendor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten lämnas över till Finder via en lokal nätverksanslutning och visas därför under ”Platser” med en nätverkssymbol. Den läses, skrivs och matas ut som vilken annan enhet som helst. macOS erbjuder inget sätt att visa den som en lokal disk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไดรฟ์ถูกส่งให้ Finder ผ่านการเชื่อมต่อเครือข่ายภายในเครื่อง จึงปรากฏใต้หัวข้อ Locations พร้อมไอคอนเครือข่าย อ่าน เขียน และดันออกได้เหมือนไดรฟ์อื่น macOS ไม่มีวิธีให้แสดงมันเป็นดิสก์ภายในเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürücü, Finder'a yerel bir ağ bağlantısı üzerinden devredilir; bu yüzden Konumlar altında ağ simgesiyle görünür. Diğer sürücüler gibi okunur, yazılır ve çıkarılır. macOS onu yerel bir disk olarak gösterme imkânı sunmuyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диск передається у Finder через локальне мережеве з’єднання, тож він з’являється в розділі «Розташування» зі значком мережі. Він читається, записується та вилучається, як будь-який інший диск. macOS не дає способу подати його як локальний."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đĩa được giao cho Finder qua một kết nối mạng cục bộ, nên nó xuất hiện dưới mục Locations với biểu tượng mạng. Nó đọc, ghi và tháo như mọi ổ đĩa khác. macOS không có cách nào để trình bày nó như một đĩa cục bộ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "驱动器通过本地网络连接交给“访达”，因此会出现在“位置”下并带有网络图标。它像其他驱动器一样可读、可写、可推出。macOS 没有提供把它显示为本地磁盘的方式。"
          }
        }
      }
    },
    "The drive stays in Finder after %@ quits. Eject it there whenever you are finished.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى المحرّك في الباحث بعد إنهاء %@. أخرجه هناك متى انتهيت."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дискът остава във Finder, след като %@ приключи. Извадете го оттам, когато сте готови."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk zůstane ve Finderu i po ukončení aplikace %@. Až budete hotovi, vysuňte jej odtud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheden bliver i Finder, efter at %@ er sluttet. Skub den ud derfra, når du er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laufwerk bleibt nach dem Beenden von %@ im Finder. Wirf es dort aus, wenn du fertig bist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο δίσκος παραμένει στο Finder αφού τερματιστεί το %@. Κάντε εξαγωγή από εκεί όταν τελειώσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco permanece en el Finder después de salir de %@. Expúlsalo allí cuando termines."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketas jääb Finderisse pärast seda, kui %@ väljub. Väljuta see sealt, kui oled lõpetanud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asema jää Finderiin sen jälkeen, kun %@ lopetetaan. Poista se sieltä käytöstä, kun olet valmis."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nananatili ang drive sa Finder pagkatapos umalis ang %@. I-eject ito roon kapag tapos ka na."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque reste dans le Finder après la fermeture de %@. Éjectez-le depuis le Finder lorsque vous avez terminé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכונן נשאר ב‑Finder לאחר ש‑%@ יוצא. הוציאו אותו שם בכל עת שתסיימו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के बंद होने के बाद भी ड्राइव Finder में रहती है। काम पूरा होने पर उसे वहीं निकालें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk ostaje u Finderu nakon što %@ završi. Izbacite ga ondje kad završite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A meghajtó a Finderben marad, miután a(z) %@ kilép. Ha végzett, onnan adja ki."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive tetap ada di Finder setelah %@ keluar. Keluarkan di sana bila Anda sudah selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco resta nel Finder dopo la chiusura di %@. Espellilo da lì quando hai finito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の終了後もドライブは Finder に残ります。終わったらそこで取り出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 종료된 뒤에도 드라이브는 Finder에 남습니다. 끝나면 그곳에서 추출하십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskas lieka „Finder“ programoje, kai %@ baigia darbą. Išstumkite jį ten, kai baigsite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Disks paliek programmā Finder pēc tam, kad %@ ir aizvērta. Izstumiet to tur, kad esat pabeidzis."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemacu kekal dalam Finder selepas %@ keluar. Keluarkannya di sana apabila anda selesai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten blir værende i Finder etter at %@ avsluttes. Mat den ut derfra når du er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schijf blijft in de Finder staan nadat %@ is gestopt. Verwijder die daar wanneer je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dysk pozostaje w Finderze po zakończeniu programu %@. Wysuń go stamtąd, gdy skończysz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco permanece no Finder depois de o %@ sair. Ejete-o aí quando terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Discul rămâne în Finder după ce %@ se închide. Ejectați-l de acolo când terminați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диск остаётся в Finder после выхода из %@. Извлеките его там, когда закончите."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogon ostane v Finderju, potem ko se %@ konča. Izvrzite ga tam, ko končate."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Disku qëndron në Finder pasi %@ të dalë. Nxirre atje kur të mbarosh."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten finns kvar i Finder efter att %@ avslutats. Mata ut den där när du är klar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไดรฟ์ยังอยู่ใน Finder หลังจาก %@ ปิดไปแล้ว ดันออกที่นั่นเมื่อคุณใช้เสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürücü, %@ çıktıktan sonra Finder'da kalır. İşiniz bittiğinde orada çıkarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диск залишається у Finder після виходу з %@. Вилучіть його там, коли завершите."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đĩa vẫn ở trong Finder sau khi %@ thoát. Hãy tháo nó ở đó khi bạn xong việc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 退出后驱动器仍留在“访达”中。用完后在那里推出即可。"
          }
        }
      }
    },
    "The drive was not opened": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُفتح المحرّك"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дискът не беше отворен"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk nebyl otevřen"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheden blev ikke åbnet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laufwerk wurde nicht geöffnet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο δίσκος δεν άνοιξε"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco no se abrió"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketast ei avatud"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asemaa ei avattu"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi nabuksan ang drive"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque n’a pas été ouvert"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכונן לא נפתח"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ड्राइव नहीं खुली"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk nije otvoren"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A meghajtó nem nyílt meg"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive tidak terbuka"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco non è stato aperto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライブを開けませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드라이브를 열지 못했습니다"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskas nebuvo atvertas"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Disks netika atvērts"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemacu tidak dibuka"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten ble ikke åpnet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schijf is niet geopend"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dysk nie został otwarty"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco não foi aberto"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Discul nu a fost deschis"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диск не был открыт"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogon ni bil odprt"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Disku nuk u hap"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten öppnades inte"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดไดรฟ์ไม่สำเร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürücü açılmadı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диск не було відкрито"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đĩa không mở được"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "驱动器未打开"
          }
        }
      }
    },
