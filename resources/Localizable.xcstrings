            "state": "translated",
            "value": "LUKS-taltiot, joiden otsake on tallennettu erilleen asemasta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les volumes LUKS dont l’en-tête est stocké séparément du disque"
          }
        },
        "it": {
