          }
        }
      }
    },
    "Lets %@ read the encrypted data itself.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволява на %@ сама да чете шифрованите данни."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožní aplikaci %@ číst šifrovaná data přímo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lader %@ selv læse de krypterede data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht %@, die verschlüsselten Daten selbst zu lesen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέπει στο %@ να διαβάζει το ίδιο τα κρυπτογραφημένα δεδομένα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que %@ lea los datos cifrados directamente."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võimaldab rakendusel %@ krüpteeritud andmeid ise lugeda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Antaa ohjelman %@ lukea salatut tiedot itse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à %@ de lire lui-même les données chiffrées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućuje aplikaciji %@ da sama čita šifrirane podatke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehetővé teszi, hogy a(z) %@ maga olvassa a titkosított adatokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente a %@ di leggere direttamente i dati cifrati."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leidžia %@ pačiai skaityti užšifruotus duomenis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ļauj programmai %@ pašai lasīt šifrētos datus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lar %@ lese de krypterte dataene selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee leest %@ de versleutelde gegevens zelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala programowi %@ odczytywać same zaszyfrowane dane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite ao %@ ler diretamente os dados encriptados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite aplicației %@ să citească ea însăși datele criptate."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogoča, da %@ sam bere šifrirane podatke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låter %@ läsa den krypterade datan själv."
          }
        }
      }
    },
    "Lets %@ read the encrypted data itself. macOS blocks this without it, even for administrators, and it cannot be requested: it has to be switched on by hand.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволява на %@ да чете самите шифровани данни. Без него macOS блокира това дори за администратори и не може да бъде поискано: включва се ръчно."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožňuje aplikaci %@ číst samotná zašifrovaná data. Bez toho to macOS blokuje i správcům a nelze si o to říct: zapíná se ručně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lader %@ læse de krypterede data direkte. Uden den blokerer macOS det, selv for administratorer, og der kan ikke bedes om den: den skal slås til i hånden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht %@, die verschlüsselten Daten selbst zu lesen. Ohne diesen Zugriff blockiert macOS das selbst für Administratoren, und anfordern lässt er sich nicht: er muss von Hand eingeschaltet werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέπει στο %@ να διαβάζει το ίδιο τα κρυπτογραφημένα δεδομένα. Χωρίς αυτήν το macOS το εμποδίζει ακόμη και για διαχειριστές, και δεν μπορεί να ζητηθεί: ενεργοποιείται με το χέρι."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a %@ leer los datos cifrados directamente. Sin esto macOS lo bloquea, incluso para administradores, y no se puede solicitar: hay que activarlo a mano."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lubab rakendusel %@ lugeda krüptitud andmeid endid. Ilma selleta blokeerib macOS selle isegi administraatoritele ja seda ei saa küsida: see tuleb käsitsi sisse lülitada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Antaa ohjelman %@ lukea salatut tiedot itse. Ilman sitä macOS estää tämän jopa pääkäyttäjiltä, eikä sitä voi pyytää: se on kytkettävä päälle käsin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à %@ de lire lui-même les données chiffrées. Sans cela, macOS l’interdit, même aux administrateurs, et cela ne peut pas être demandé : il faut l’activer à la main."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućuje aplikaciji %@ da sama čita šifrirane podatke. Bez toga macOS to blokira i administratorima, a zatražiti se ne može: uključuje se ručno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehetővé teszi a(z) %@ számára, hogy maga olvassa a titkosított adatokat. Enélkül a macOS ezt még a rendszergazdáknak is tiltja, és nem lehet kérni: kézzel kell bekapcsolni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente a %@ di leggere direttamente i dati cifrati. Senza, macOS lo impedisce anche agli amministratori, e non si può richiedere: va attivato a mano."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leidžia %@ pačiai skaityti užšifruotus duomenis. Be to „macOS“ tai draudžia net administratoriams, ir to paprašyti negalima: reikia įjungti ranka."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ļauj %@ pašai lasīt šifrētos datus. Bez tās macOS to liedz pat administratoriem, un to nevar pieprasīt: tā jāieslēdz ar roku."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lar %@ lese de krypterte dataene selv. Uten den blokkerer macOS dette, også for administratorer, og den kan ikke bes om: den må slås på for hånd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat %@ de versleutelde gegevens zelf lezen. Zonder deze toegang blokkeert macOS dat, ook voor beheerders, en erom vragen kan niet: die moet met de hand worden aangezet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala programowi %@ czytać same zaszyfrowane dane. Bez tego macOS blokuje to nawet administratorom i nie da się o to poprosić: trzeba włączyć to ręcznie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite ao %@ ler os próprios dados encriptados. Sem isso, o macOS bloqueia-o mesmo para administradores, e não pode ser pedido: tem de ser ligado à mão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite aplicației %@ să citească ea însăși datele criptate. Fără acest acces, macOS îl blochează chiar și pentru administratori și nu poate fi cerut: trebuie activat manual."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Programu %@ omogoča, da sam bere šifrirane podatke. Brez tega macOS to prepreči tudi skrbnikom, zaprositi zanj pa ni mogoče: vklopiti ga je treba ročno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låter %@ läsa den krypterade datan själv. Utan den blockerar macOS detta, även för administratörer, och den går inte att be om: den måste slås på för hand."
          }
        }
      }
    },
    "Lets %@ see the drives you plug in.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволява на %@ да вижда свързаните дискове."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožní aplikaci %@ vidět připojované disky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lader %@ se de enheder, du tilslutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht %@, angeschlossene Laufwerke zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέπει στο %@ να βλέπει τους δίσκους που συνδέετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que %@ vea los discos que conectas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võimaldab rakendusel %@ näha ühendatud kettaid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Antaa ohjelman %@ nähdä liittämäsi asemat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à %@ de voir les disques que vous branchez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućuje aplikaciji %@ da vidi diskove koje spajate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehetővé teszi, hogy a(z) %@ lássa a csatlakoztatott meghajtókat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consente a %@ di vedere i dischi che colleghi."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leidžia %@ matyti prijungiamus diskus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ļauj programmai %@ redzēt pievienotos diskus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lar %@ se enhetene du kobler til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee ziet %@ de schijven die je aansluit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala programowi %@ widzieć podłączane dyski."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite ao %@ ver os discos que liga."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite aplicației %@ să vadă discurile pe care le conectați."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogoča, da %@ vidi pogone, ki jih priključite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låter %@ se enheterna du ansluter."
          }
        }
      }
    },
