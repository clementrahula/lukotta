    "LUKS volumes whose header is stored separately from the drive": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS-Volumes, deren Header getrennt vom Laufwerk gespeichert ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volúmenes LUKS cuya cabecera se guarda aparte del disco"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "LUKS-köited, mille päis on salvestatud kettast eraldi"
          }
        },
        "fi": {
