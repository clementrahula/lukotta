          "stringUnit": {
            "state": "translated",
            "value": "Laukiama jūsų patvirtinimo"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaida jūsu apstiprinājumu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på godkjenningen din"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachten op je goedkeuring"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwanie na Twoją zgodę"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A aguardar a sua autorização"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se așteaptă aprobarea dvs."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Čakanje na vašo odobritev"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntar på ditt godkännande"
          }
        }
      }
    },
    "Was refused. In Files and Folders, switch on Removable Volumes for %@, then come back.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Беше отказано. В „Files & Folders“ включете „Removable Volumes“ за %@ и се върнете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bylo odmítnuto. V části „Soubory a složky“ zapněte „Výměnné svazky“ pro %@ a vraťte se sem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Blev afvist. Slå “Udskiftelige enheder” til for %@ under “Arkiver & mapper”, og kom tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wurde abgelehnt. Aktiviere unter „Dateien & Ordner“ die Option „Entfernbare Volumes“ für %@ und komm dann zurück."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απορρίφθηκε. Στα «Αρχεία και φάκελοι» ενεργοποιήστε τους «Αφαιρούμενοι τόμοι» για το %@ και επιστρέψτε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha denegado. En «Archivos y carpetas», activa «Volúmenes extraíbles» para %@ y vuelve aquí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Keelduti. Lülita jaotises „Files & Folders“ rakenduse %@ jaoks sisse „Removable Volumes“ ja tule tagasi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Evättiin. Ota kohdassa ”Tiedostot ja kansiot” käyttöön ”Siirrettävät taltiot” ohjelmalle %@ ja palaa tänne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A été refusée. Dans « Fichiers et dossiers », activez « Volumes amovibles » pour %@, puis revenez ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbijeno je. U „Datoteke i mape” uključite „Uklonjive jedinice” za %@ pa se vratite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elutasítva. A „Fájlok és mappák” alatt kapcsolja be a „Cserélhető kötetek” beállítást a(z) %@ programhoz, majd térjen vissza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato rifiutato. In «File e cartelle» attiva «Volumi rimovibili» per %@, poi torna qui."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Buvo atmesta. Skiltyje „Files & Folders“ įjunkite „Removable Volumes“ programai %@ ir grįžkite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tika atteikta. Sadaļā “Files & Folders” ieslēdziet “Removable Volumes” programmai %@ un atgriezieties."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ble avvist. Slå på «Uttakbare volumer» for %@ under «Filer og mapper», og kom tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Is geweigerd. Schakel bij ‘Bestanden en mappen’ de optie ‘Verwijderbare volumes’ in voor %@ en kom terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostało odrzucone. W sekcji „Pliki i foldery” włącz „Woluminy wymienne” dla programu %@ i wróć tutaj."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi recusada. Em «Ficheiros e pastas», ative «Volumes amovíveis» para o %@ e volte aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "A fost refuzată. La „Fișiere și dosare”, activați „Volume amovibile” pentru %@, apoi reveniți."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilo je zavrnjeno. V »Datoteke in mape« vklopite »Snemljivi nosilci« za %@ in se vrnite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekades. Slå på ”Borttagbara volymer” för %@ under ”Filer och mappar” och kom tillbaka."
          }
        }
      }
    },
