    "Eject it in Finder when you are finished.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Извадете го от Finder, когато приключите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až budete hotovi, vysuňte jej ve Finderu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skub den ud i Finder, når du er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirf es im Finder aus, wenn du fertig bist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε εξαγωγή από το Finder όταν τελειώσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Expúlsalo en el Finder cuando termines."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui oled valmis, väljasta see Finderis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista se Finderissa, kun olet valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éjectez-le dans le Finder lorsque vous avez terminé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbacite ga u Finderu kada završite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha végzett, adja ki a Finderben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Espellilo nel Finder quando hai finito."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Baigę išstumkite jį per „Finder“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad esat pabeidzis, izgrūdiet to programmā Finder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Løs den ut i Finder når du er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werp die uit in de Finder als je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zakończeniu wysuń go w Finderze."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejete-o no Finder quando terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scoateți-l în Finder când ați terminat."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko končate, ga izvrzite v Finderju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mata ut den i Finder när du är klar."
          }
        }
      }
