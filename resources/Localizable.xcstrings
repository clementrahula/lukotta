    "This takes a moment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستغرق هذا لحظة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това отнема момент."
          }
        },
        "cs": {
          "stringUnit": {
