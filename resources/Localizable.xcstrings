        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault dan imej cakera bersulit, yang dibuka sendiri oleh macOS"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault og krypterte diskbilder, som macOS åpner selv"
