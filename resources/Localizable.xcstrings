          "stringUnit": {
            "state": "translated",
            "value": "“%@” nevarēja nolasīt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» kunne ikke leses."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ kon niet worden gelezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać „%@”."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler «%@»."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nu a putut fi citit."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« ni bilo mogoče prebrati."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” kunde inte läsas."
          }
        }
      }
    },
    "“%@” had stopped responding and was disconnected. You can open it again.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ спря да отговаря и беше изключен. Можете да го отворите отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ přestal odpovídat a byl odpojen. Můžete jej otevřít znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” svarede ikke længere og blev frakoblet. Du kan åbne den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ hat nicht mehr reagiert und wurde getrennt. Du kannst es erneut öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» σταμάτησε να αποκρίνεται και αποσυνδέθηκε. Μπορείτε να το ανοίξετε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» había dejado de responder y se desconectó. Puedes volver a abrirlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ei vastanud enam ja ühendati lahti. Sa saad selle uuesti avada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” lakkasi vastaamasta ja irrotettiin. Voit avata sen uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne répondait plus et a été déconnecté. Vous pouvez l’ouvrir à nouveau."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” je prestao odgovarati i odspojen je. Možete ga ponovno otvoriti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nem válaszolt, ezért le lett választva. Újra megnyithatja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» non rispondeva più ed è stato scollegato. Puoi aprirlo di nuovo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ nustojo atsakyti ir buvo atjungtas. Galite jį atverti dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” pārstāja atbildēt un tika atvienots. Jūs varat to atvērt vēlreiz."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» sluttet å svare og ble koblet fra. Du kan åpne den igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ reageerde niet meer en is losgekoppeld. Je kunt die opnieuw openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” przestał odpowiadać i został odłączony. Możesz otworzyć go ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» deixou de responder e foi desligado. Pode abri-lo novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nu mai răspundea și a fost deconectat. Îl puteți deschide din nou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« se ni več odzival in je bil odklopljen. Lahko ga znova odprete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” slutade svara och kopplades bort. Du kan öppna den igen."
          }
        }
      }
    },
    "“%@” holds an encrypted volume, which this build of the drive engine cannot open inside a disk image. Opening the drive it was made from would work.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ съдържа шифрован том, който тази версия на двигателя не може да отвори в дисков образ. Отворете диска, от който е направен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ obsahuje šifrovaný svazek, který tato verze enginu neumí otevřít uvnitř obrazu disku. Otevřete disk, ze kterého vznikl."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” indeholder en krypteret enhed, som denne udgave af drevmotoren ikke kan åbne inde i et diskbillede. Åbn den disk, den er lavet af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ enthält ein verschlüsseltes Volume, das diese Version des Laufwerk-Moduls in einem Image nicht öffnen kann. Öffne das Laufwerk, aus dem es erstellt wurde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» περιέχει κρυπτογραφημένο τόμο τον οποίο αυτή η έκδοση της μηχανής δεν μπορεί να ανοίξει μέσα σε είδωλο δίσκου. Ανοίξτε τον δίσκο από τον οποίο δημιουργήθηκε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» contiene un volumen cifrado que esta versión del motor no puede abrir dentro de una imagen de disco. Abre el disco del que se creó."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ sisaldab krüptitud köidet, mida see mootori versioon kettatõmmise sees avada ei suuda. Ava ketas, millest see tehti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” sisältää salatun taltion, jota tämä moottorin versio ei osaa avata levytiedoston sisällä. Avaa asema, josta se on tehty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » contient un volume chiffré que cette version du moteur ne sait pas ouvrir dans une image disque. Ouvrez le disque dont il provient."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” sadrži šifriranu jedinicu koju ova verzija pogona ne može otvoriti unutar slike diska. Otvorite disk iz kojeg je nastala."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” titkosított kötetet tartalmaz, amelyet a motor ezen változata nem tud lemezképen belül megnyitni. Nyissa meg azt a meghajtót, amelyből készült."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» contiene un volume cifrato che questa versione del motore non sa aprire dentro un’immagine disco. Apri il disco da cui è stato creato."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ turi šifruotą tomą, kurio ši variklio versija negali atverti disko atvaizdyje. Atverkite diską, iš kurio jis sukurtas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” satur šifrētu sējumu, ko šī dzinēja versija nespēj atvērt diska attēlā. Atveriet disku, no kura tas izveidots."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» inneholder en kryptert enhet som denne versjonen av motoren ikke kan åpne inne i et diskbilde. Åpne disken den ble laget av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ bevat een versleuteld volume dat deze versie van de schijfmodule niet in een schijfkopie kan openen. Open de schijf waarvan die is gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” zawiera zaszyfrowany wolumin, którego ta wersja silnika nie potrafi otworzyć wewnątrz obrazu dysku. Otwórz dysk, z którego powstał."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» contém um volume encriptado que esta versão do motor não consegue abrir dentro de uma imagem de disco. Abra o disco a partir do qual foi criado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” conține un volum criptat pe care această versiune a motorului nu îl poate deschide într-o imagine de disc. Deschideți discul din care a fost creat."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« vsebuje šifriran nosilec, ki ga ta različica pogona ne zna odpreti znotraj slike diska. Odprite pogon, iz katerega je nastal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” innehåller en krypterad volym som den här versionen av motorn inte kan öppna inuti en skivavbild. Öppna disken den skapades från."
          }
        }
      }
    },
    "“%@” holds only the changes from another disk, which it names. %@ does not open images that name other files.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ съдържа само промените спрямо друг диск, който назовава. %2$@ не отваря образи, които сочат към други файлове."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ obsahuje jen změny oproti jinému disku, který pojmenovává. %2$@ neotevírá obrazy odkazující na jiné soubory."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” indeholder kun ændringerne fra en anden disk, som den henviser til. %2$@ åbner ikke diskbilleder, der henviser til andre filer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ enthält nur die Änderungen gegenüber einer anderen Festplatte, die sie benennt. %2$@ öffnet keine Images, die andere Dateien benennen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%1$@» περιέχει μόνο τις αλλαγές από άλλον δίσκο, τον οποίο κατονομάζει. Το %2$@ δεν ανοίγει είδωλα που παραπέμπουν σε άλλα αρχεία."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» solo contiene los cambios respecto a otro disco, al que nombra. %2$@ no abre imágenes que nombren otros archivos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ sisaldab ainult muudatusi teise ketta suhtes, mille see nimetab. %2$@ ei ava tõmmiseid, mis nimetavad teisi faile."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” sisältää vain muutokset toiseen levyyn nähden, jonka se nimeää. %2$@ ei avaa levytiedostoja, jotka nimeävät muita tiedostoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » ne contient que les modifications par rapport à un autre disque, qu’il désigne. %2$@ n’ouvre pas les images qui désignent d’autres fichiers."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” sadrži samo promjene u odnosu na drugi disk, koji imenuje. %2$@ ne otvara slike koje imenuju druge datoteke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%1$@” csak egy másik lemezhez képest történt változásokat tartalmazza, amelyet meg is nevez. A(z) %2$@ nem nyit meg olyan lemezképeket, amelyek más fájlokat neveznek meg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» contiene solo le modifiche rispetto a un altro disco, che nomina. %2$@ non apre immagini che nominano altri file."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ turi tik pakeitimus, palyginti su kitu disku, kurį nurodo. %2$@ neatveria atvaizdžių, nurodančių kitus failus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” satur tikai izmaiņas attiecībā pret citu disku, ko tas nosauc. %2$@ neatver attēlus, kas nosauc citus failus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» inneholder bare endringene fra en annen disk, som den navngir. %2$@ åpner ikke diskbilder som navngir andre filer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’ bevat alleen de wijzigingen ten opzichte van een andere schijf, die erin genoemd wordt. %2$@ opent geen schijfkopieën die andere bestanden noemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” zawiera tylko zmiany względem innego dysku, który wskazuje. %2$@ nie otwiera obrazów wskazujących inne pliki."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» contém apenas as alterações em relação a outro disco, que nomeia. O %2$@ não abre imagens que nomeiem outros ficheiros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” conține doar modificările față de un alt disc, pe care îl numește. %2$@ nu deschide imagini care numesc alte fișiere."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%1$@« vsebuje samo spremembe glede na drug disk, ki ga imenuje. %2$@ ne odpira slik, ki imenujejo druge datoteke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%1$@” innehåller bara ändringarna från en annan disk, som den namnger. %2$@ öppnar inte avbilder som namnger andra filer."
          }
        }
      }
    },
    "“%@” is a VDI, which this build of the drive engine cannot open. A raw image or a qcow2 would work.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ е VDI, който тази версия на двигателя не може да отвори. Биха работили суров образ или qcow2."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ je VDI, který tato verze enginu neumí otevřít. Fungoval by surový obraz nebo qcow2."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” er en VDI, som denne udgave af drevmotoren ikke kan åbne. Et råt image eller en qcow2 ville virke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist eine VDI, die diese Version des Laufwerk-Moduls nicht öffnen kann. Ein Rohimage oder eine qcow2-Datei würden funktionieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» είναι VDI, το οποίο αυτή η έκδοση της μηχανής δεν μπορεί να ανοίξει. Θα λειτουργούσε ένα ακατέργαστο είδωλο ή ένα qcow2."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» es un VDI, que esta versión del motor no puede abrir. Funcionaría una imagen sin formato o un qcow2."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ on VDI, mida see mootori versioon avada ei suuda. Toimiks töötlemata tõmmis või qcow2."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” on VDI, jota tämä moottorin versio ei osaa avata. Raakalevykuva tai qcow2 toimisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est un VDI, que cette version du moteur ne sait pas ouvrir. Une image brute ou un qcow2 fonctionneraient."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” je VDI, koji ova verzija pogona ne može otvoriti. Uspjeli bi sirova slika ili qcow2."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” egy VDI, amelyet a motor ezen változata nem tud megnyitni. Egy nyers kép vagy egy qcow2 működne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» è un VDI, che questa versione del motore non sa aprire. Funzionerebbero un’immagine grezza o un qcow2."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ yra VDI, kurio ši variklio versija atverti negali. Tiktų neapdorotas atvaizdis arba qcow2."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ir VDI, ko šī dzinēja versija nespēj atvērt. Derētu neapstrādāts attēls vai qcow2."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» er en VDI, som denne versjonen av motoren ikke kan åpne. Et råbilde eller en qcow2 ville fungere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ is een VDI, die deze versie van de schijfmodule niet kan openen. Een onbewerkte schijfkopie of een qcow2 zou wel werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” to VDI, którego ta wersja silnika nie potrafi otworzyć. Zadziałałby surowy obraz albo qcow2."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» é um VDI, que esta versão do motor não consegue abrir. Uma imagem em bruto ou um qcow2 resultariam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” este un VDI, pe care această versiune a motorului nu îl poate deschide. Ar funcționa o imagine brută sau un qcow2."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« je VDI, ki ga ta različica pogona ne zna odpreti. Delovala bi surova slika ali qcow2."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” är en VDI, som den här versionen av motorn inte kan öppna. En råavbild eller en qcow2 skulle fungera."
          }
        }
      }
    },
    "“%@” is a VHDX, which this build of the drive engine cannot open. A VHD, a raw image or a qcow2 would work.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ е VHDX, който тази версия на двигателя не може да отвори. Биха работили VHD, суров образ или qcow2."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ je VHDX, který tato verze enginu neumí otevřít. Fungoval by VHD, surový obraz nebo qcow2."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” er en VHDX, som denne udgave af drevmotoren ikke kan åbne. En VHD, et råt image eller en qcow2 ville virke."
          }
        },
        "de": {
          "stringUnit": {
