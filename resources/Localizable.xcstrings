    "This drive holds %lld volumes and not all of them could be opened.": {
      "localizations": {
        "bg": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Този диск съдържа %lld том и той не можа да бъде отворен."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Този диск съдържа %lld тома и не всички можаха да бъдат отворени."
                }
              }
            }
          }
        },
        "cs": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tento disk obsahuje %lld svazky a ne všechny se podařilo otevřít."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tento disk obsahuje %lld svazku a ne všechny se podařilo otevřít."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tento disk obsahuje %lld svazek a nepodařilo se jej otevřít."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tento disk obsahuje %lld svazků a ne všechny se podařilo otevřít."
                }
              }
            }
          }
        },
        "da": {
          "variations": {
