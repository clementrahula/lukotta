    "Nothing was written to it. A failed unlock cannot damage the data it holds.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Върху него не е записано нищо. Неуспешно отключване не може да повреди данните на диска."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic se na něj nezapsalo. Neúspěšné odemknutí nemůže poškodit data, která jsou na něm."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke skrevet noget til den. En mislykket oplåsning kan ikke skade de data, den indeholder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nichts darauf geschrieben. Ein fehlgeschlagenes Entsperren kann den Daten darauf nichts anhaben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν γράφτηκε τίποτα σε αυτόν. Ένα ξεκλείδωμα που απέτυχε δεν μπορεί να βλάψει τα δεδομένα που έχει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se escribió nada en él. Un desbloqueo fallido no puede dañar los datos que contiene."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinna ei kirjutatud midagi. Ebaõnnestunud avamine ei saa kettal olevaid andmeid kahjustada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sille ei kirjoitettu mitään. Epäonnistunut avaaminen ei voi vahingoittaa sen sisältämiä tietoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’y a été écrit. Un déverrouillage qui échoue ne peut pas endommager les données qu’il contient."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na njega nije ništa zapisano. Neuspjelo otključavanje ne može oštetiti podatke koje sadrži."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi nem íródott rá. A sikertelen feloldás nem tehet kárt a rajta lévő adatokban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non vi è stato scritto nulla. Uno sblocco fallito non può danneggiare i dati che contiene."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Į jį nieko neįrašyta. Nepavykęs atrakinimas negali sugadinti jame esančių duomenų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tajā nekas netika ierakstīts. Neizdevusies atbloķēšana nevar sabojāt tajā esošos datus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting ble skrevet til den. En mislykket opplåsing kan ikke skade dataene den inneholder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niets naar geschreven. Een mislukte ontgrendeling kan de gegevens erop niet beschadigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic na nim nie zapisano. Nieudane odblokowanie nie może uszkodzić danych, które się na nim znajdują."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não lhe foi escrito nada. Um desbloqueio falhado não pode danificar os dados que contém."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a scris nimic pe el. O deblocare eșuată nu poate deteriora datele pe care le conține."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nanj ni bilo nič zapisano. Neuspelo odklepanje ne more poškodovati podatkov na njem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting skrevs till den. En misslyckad upplåsning kan inte skada de data den innehåller."
          }
        }
      }
    },
