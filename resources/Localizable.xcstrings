            "value": "Trečiųjų šalių pranešimai"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trešo pušu paziņojumi"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kennisgevingen van derden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informacje o oprogramowaniu innych firm"
          }
        },
        "pt-PT": {
          "stringUnit": {
