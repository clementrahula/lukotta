    "FileVault and encrypted disk images, which macOS opens itself": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault и шифровани дискови образи, които macOS отваря сам"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault a šifrované obrazy disků, které macOS otevírá sám"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault og krypterede diskbilleder, som macOS selv åbner"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault und verschlüsselte Images, die macOS selbst öffnet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το FileVault και τα κρυπτογραφημένα είδωλα δίσκων, που τα ανοίγει το ίδιο το macOS"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault y las imágenes de disco cifradas, que macOS abre por sí mismo"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault ja krüptitud kettatõmmised, mille macOS ise avab"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault ja salatut levytiedostot, jotka macOS avaa itse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault et les images disque chiffrées, que macOS ouvre lui-même"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault i šifrirane slike diskova, koje macOS otvara sam"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A FileVault és a titkosított lemezképek, amelyeket a macOS maga nyit meg"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault e le immagini disco cifrate, che macOS apre da sé"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„FileVault“ ir šifruoti diskų atvaizdžiai, kuriuos „macOS“ atveria pati"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault un šifrētie disku attēli, ko macOS atver pats"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault og krypterte diskbilder, som macOS åpner selv"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault en versleutelde schijfkopieën, die macOS zelf opent"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault i zaszyfrowane obrazy dysków, które macOS otwiera sam"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O FileVault e as imagens de disco encriptadas, que o macOS abre por si"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault și imaginile de disc criptate, pe care macOS le deschide singur"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault in šifrirane slike diskov, ki jih macOS odpre sam"
          }
        },
        "sv": {
