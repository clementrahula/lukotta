    "A drive that refuses to be written to is opened read-only rather than left closed, and says so": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحرّك الذي يرفض الكتابة يُفتح للقراءة فقط بدل تركه مغلقًا، ويُذكر ذلك"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Диск, който отказва да бъде записван, се отваря само за четене, вместо да остане затворен, и го отбелязва"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk, který odmítá zápis, se otevře jen ke čtení, místo aby zůstal zavřený, a řekne to"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et drev, der nægter at blive skrevet til, åbnes kun til læsning i stedet for at forblive lukket, og siger det"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Laufwerk, das sich nicht beschreiben lässt, wird nur lesend geöffnet statt geschlossen zu bleiben, und sagt das"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας δίσκος που αρνείται να γραφτεί ανοίγει μόνο για ανάγνωση αντί να μείνει κλειστός, και το δηλώνει"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un disco que no admite escritura se abre en solo lectura en lugar de quedarse cerrado, y lo indica"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketas, millele kirjutada ei saa, avatakse ainult lugemiseks, mitte ei jäeta avamata, ja ütleb seda"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Levy, johon ei voi kirjoittaa, avataan vain luettavaksi sen sijaan että se jäisi avaamatta, ja kertoo siitä"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang drive na ayaw pasulatan ay binubuksan nang read-only sa halip na iwang sarado, at sinasabi ito"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un disque qui refuse l’écriture est ouvert en lecture seule plutôt que laissé fermé, et le signale"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כונן שמסרב לכתיבה נפתח לקריאה בלבד במקום להישאר סגור, וזה נאמר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो ड्राइव लिखने से इनकार करती है वह बंद छोड़ने के बजाय केवल पढ़ने के लिए खोली जाती है, और यह बता दिया जाता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk na koji se ne može pisati otvara se samo za čitanje umjesto da ostane zatvoren, i to kaže"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az a lemez, amelyre nem lehet írni, csak olvasásra nyílik meg ahelyett, hogy zárva maradna, és ezt jelzi"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive yang menolak ditulisi akan dibuka baca-saja alih-alih dibiarkan tertutup, dan hal itu disampaikan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un disco che rifiuta la scrittura viene aperto in sola lettura anziché restare chiuso, e lo dice"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込みを受け付けないドライブは、開けないままにせず読み出し専用で開き、その旨を伝えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰기를 거부하는 드라이브는 닫아 두는 대신 읽기 전용으로 열리며, 그 사실을 알려 줍니다"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskas, į kurį įrašyti nepavyksta, atveriamas tik skaitymui, o ne paliekamas neatvertas, ir tai pasako"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Disks, kurā nevar rakstīt, tiek atvērts tikai lasīšanai, nevis atstāts neatvērts, un to pasaka"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemacu yang enggan ditulis akan dibuka baca-sahaja dan bukannya dibiarkan tertutup, dan ia dinyatakan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En disk som ikke lar seg skrive til, åpnes kun for lesing i stedet for å bli stående lukket, og sier fra om det"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een schijf waarnaar niet geschreven kan worden, wordt alleen-lezen geopend in plaats van dicht te blijven, en meldt dat"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dysk, na którym nie da się zapisywać, zostaje otwarty tylko do odczytu, zamiast pozostać zamknięty, i mówi o tym"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um disco que recusa a escrita é aberto apenas para leitura em vez de ficar fechado, e diz que o foi"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un disc pe care nu se poate scrie este deschis doar pentru citire în loc să rămână închis, și spune asta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диск, который отказывается принимать запись, открывается только для чтения, а не остаётся закрытым, и сообщает об этом"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk, na katerega ni mogoče pisati, se odpre samo za branje, namesto da bi ostal zaprt, in to pove"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një disk që nuk pranon të shkruhet hapet si vetëm-lexim në vend që të lihet i mbyllur, dhe e thotë këtë"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En disk som inte går att skriva till öppnas skrivskyddad i stället för att lämnas stängd, och säger det"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไดรฟ์ที่ไม่ยอมให้เขียนจะถูกเปิดแบบอ่านอย่างเดียวแทนที่จะปล่อยให้ปิดอยู่ และจะแจ้งให้ทราบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazmayı kabul etmeyen bir sürücü kapalı bırakılmak yerine salt okunur açılır ve bunu söyler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диск, який не приймає запис, відкривається лише для читання, а не залишається закритим, і повідомляє про це"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đĩa từ chối ghi sẽ được mở ở chế độ chỉ đọc thay vì bỏ mặc đóng, và điều đó được nói rõ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝写入的驱动器会以只读方式打开，而不是干脆打不开，并会说明这一点"
          }
        }
      }
    },
