    "macOS already has this drive mounted. Eject it in Finder and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat dieses Laufwerk bereits aktiviert. Wirf es im Finder aus und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ya tiene este disco montado. Expúlsalo en el Finder y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a déjà monté ce disque. Éjectez-le dans le Finder, puis réessayez."
          }
        }
      }
    },
    "macOS blocked access to the drive. %@ needs Full Disk Access before it can read an encrypted disk.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat den Zugriff auf das Laufwerk blockiert. %@ benötigt Festplattenvollzugriff, um eine verschlüsselte Festplatte lesen zu können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha bloqueado el acceso al disco. %@ necesita Acceso total al disco para poder leer un disco cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a bloqué l’accès au disque. %@ a besoin de l’accès complet au disque pour pouvoir lire un disque chiffré."
          }
        }
      }
    },
    "macOS wrote %@. It is not sent anywhere automatically — attach it to your message if you can.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat %@ geschrieben. Er wird nirgendwohin automatisch gesendet — hänge ihn deiner Nachricht an, wenn du kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha escrito %@. No se envía a ningún sitio automáticamente: adjúntalo a tu mensaje si puedes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a écrit %@. Il n’est envoyé nulle part automatiquement — joignez-le à votre message si vous le pouvez."
          }
        }
      }
    },
