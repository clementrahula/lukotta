    "Allow %@ in the window that just opened, so macOS lets it open at login.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ %@ في النافذة التي فُتحت للتو، ليسمح macOS بفتحه عند تسجيل الدخول."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешете %@ в прозореца, който току-що се отвори, за да позволи macOS отварянето при влизане."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V okně, které se právě otevřelo, povolte %@, aby ji macOS spouštěl při přihlášení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad %@ i vinduet, der lige åbnede, så macOS lader programmet åbne ved login."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube %@ im gerade geöffneten Fenster, damit macOS die App beim Anmelden öffnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε το %@ στο παράθυρο που μόλις άνοιξε, ώστε το macOS να το ανοίγει κατά τη σύνδεση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite %@ en la ventana que acaba de abrirse para que macOS lo abra al iniciar sesión."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Luba %@ äsja avanenud aknas, et macOS avaks selle sisselogimisel."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli %@ juuri avautuneessa ikkunassa, jotta macOS avaa sen kirjautuessa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Payagan ang %@ sa bintanang kabubukas lamang, para payagan ng macOS na bumukas ito sa pag-log in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez %@ dans la fenêtre qui vient de s’ouvrir, pour que macOS l’ouvre à l’ouverture de session."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אשרו את %@ בחלון שנפתח זה עתה, כדי ש‑macOS יאפשר לו להיפתח בכניסה למערכת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी खुली विंडो में %@ को अनुमति दें, ताकि macOS उसे लॉग इन पर खुलने दे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite %@ u prozoru koji se upravo otvorio kako bi ga macOS pokretao pri prijavi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezze a(z) %@ alkalmazást a most megnyílt ablakban, hogy a macOS bejelentkezéskor elindítsa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan %@ pada jendela yang baru saja terbuka, agar macOS membiarkannya terbuka saat masuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti %@ nella finestra appena aperta, così macOS la aprirà all’accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いたウインドウで %@ を許可してください。macOS がログイン時の起動を許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 열린 창에서 %@을(를) 허용하면 macOS가 로그인 시 실행을 허용합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ką tik atsivėrusiame lange leiskite %@, kad „macOS“ ją atvertų prisijungiant."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tikko atvērtajā logā atļaujiet %@, lai macOS to atvērtu pieteikšanās brīdī."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan %@ dalam tetingkap yang baru terbuka, supaya macOS membenarkannya dibuka semasa log masuk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat %@ i vinduet som nettopp åpnet, så macOS åpner den ved pålogging."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta %@ toe in het venster dat zojuist is geopend, zodat macOS de app bij het inloggen opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól programowi %@ w oknie, które właśnie się otworzyło, aby macOS uruchamiał go przy logowaniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o %@ na janela que acabou de abrir, para que o macOS o abra ao iniciar sessão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți %@ în fereastra care tocmai s-a deschis, pentru ca macOS să îl deschidă la conectare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите %@ в только что открывшемся окне, чтобы macOS позволил запускать его при входе."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V oknu, ki se je pravkar odprlo, dovolite %@, da ga macOS odpre ob prijavi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Lejo %@ në dritaren që sapo u hap, që macOS ta lejojë të hapet gjatë hyrjes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt %@ i fönstret som just öppnades, så att macOS öppnar det vid inloggning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาต %@ ในหน้าต่างที่เพิ่งเปิดขึ้น เพื่อให้ macOS ยอมให้เปิดตอนล็อกอิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Az önce açılan pencerede %@ uygulamasına izin verin, böylece macOS onun oturum açılışında başlamasına izin verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте %@ у щойно відкритому вікні, щоб macOS дозволив запускати його під час входу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép %@ trong cửa sổ vừa mở, để macOS cho nó mở khi đăng nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在刚打开的窗口中允许 %@，这样 macOS 才会让它在登录时打开。"
          }
        }
      }
    },
