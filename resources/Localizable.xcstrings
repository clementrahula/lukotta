    "No reason was reported. The details below may say more.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde kein Grund gemeldet. Die Details unten sagen möglicherweise mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha indicado ningún motivo. Los detalles de abajo pueden decir más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Põhjust ei teatatud. Allolevad üksikasjad võivad rohkem öelda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syytä ei ilmoitettu. Alla olevat tiedot voivat kertoa enemmän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune raison n’a été signalée. Les détails ci-dessous en disent peut-être davantage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato indicato alcun motivo. I dettagli qui sotto potrebbero dire di più."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iemesls netika norādīts. Tālāk redzamā informācija var pastāstīt vairāk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen reden gemeld. De details hieronder zeggen mogelijk meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie podano przyczyny. Szczegóły poniżej mogą powiedzieć więcej."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi indicado qualquer motivo. Os detalhes abaixo poderão dizer mais."
          }
        }
      }
    },
    "Not found in this build.": {
