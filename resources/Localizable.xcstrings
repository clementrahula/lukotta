          }
        }
      }
    },
    "Show what each permission is for": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigen, wofür jede Berechtigung dient"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar para qué sirve cada permiso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher à quoi sert chaque autorisation"
          }
        }
      }
    },
    "Some permissions are still needed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es fehlen noch Berechtigungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún faltan algunos permisos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
