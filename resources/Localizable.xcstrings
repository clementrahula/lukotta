    "It is in the Bin. Nothing else of it is left on this Mac.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنه في المهملات. ولم يبق منه شيء آخر على هذا الـ Mac."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Намира се в кошчето. Нищо друго от него не е останало на този Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je v Koši. Nic dalšího z něj na tomto Macu nezůstalo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den ligger i papirkurven. Der er ikke andet tilbage af den på denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es liegt im Papierkorb. Sonst ist nichts davon auf diesem Mac verblieben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρίσκεται στον Κάδο. Τίποτα άλλο από αυτό δεν έμεινε σε αυτό το Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está en la papelera. No queda nada más de ello en este Mac."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See on prügikastis. Muud sellest siia Maci ei jäänud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on roskakorissa. Muuta siitä ei jäänyt tähän Maciin."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasa Basurahan ito. Wala nang ibang natira nito sa Mac na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est dans la corbeille. Rien d’autre n’en subsiste sur ce Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוא באשפה. לא נשאר ממנו דבר נוסף על ה‑Mac הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह ट्रैश में है। इस Mac पर उसका और कुछ नहीं बचा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nalazi se u Smeću. Ništa drugo od njega nije ostalo na ovom Macu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kukában van. Semmi más nem maradt belőle ezen a Macen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada di Tong Sampah. Tidak ada lagi bagiannya yang tertinggal di Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È nel Cestino. Non ne resta altro su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱に入っています。この Mac にはほかに何も残っていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통에 있습니다. 이 Mac에 다른 것은 남아 있지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ji yra šiukšlinėje. Daugiau nieko iš jos šiame „Mac“ neliko."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tā ir atkritnē. Nekas cits no tās šajā Mac datorā nav palicis."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia berada dalam Tong Sampah. Tiada apa-apa lagi daripadanya tertinggal pada Mac ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den ligger i papirkurven. Ingenting annet av den er igjen på denne Mac-en."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het staat in de prullenmand. Er is verder niets van achtergebleven op deze Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest w Koszu. Nic więcej po nim nie zostało na tym Macu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está no lixo. Não resta mais nada dele neste Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se află în Coș. Nu a mai rămas nimic altceva din el pe acest Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он в Корзине. Больше ничего от него на этом Mac не осталось."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je v Košu. Ničesar drugega od njega ni ostalo na tem Macu."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Është në Bin. Asgjë tjetër prej tij nuk ka mbetur në këtë Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den ligger i papperskorgen. Inget annat av den finns kvar på den här datorn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยู่ในถังขยะแล้ว ไม่มีสิ่งอื่นของมันเหลืออยู่บน Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp Kutusu'nda. Bu Mac'te ondan başka bir şey kalmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він у Кошику. Більше нічого від нього на цьому Mac не залишилося."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó đang ở Thùng rác. Không còn gì khác của nó trên máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它在“废纸篓”里。这台 Mac 上没有留下它的其他内容。"
          }
        }
      }
    },
    "LUKS drives from Linux, both LUKS1 and LUKS2": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محرّكات LUKS من Linux، بنوعيها LUKS1 وLUKS2"
          }
        },
        "bg": {
          "stringUnit": {
