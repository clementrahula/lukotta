    "System follows your Mac's language.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„Системен“ следва езика на вашия Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“System” følger sproget på din Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„System“ folgt der Sprache deines Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επιλογή «Συστήματος» ακολουθεί τη γλώσσα του Mac σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema» sigue el idioma de tu Mac."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„Süsteemne“ järgib sinu Maci keelt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”Järjestelmä” noudattaa Macisi kieltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Système » suit la langue de votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema» segue la lingua del tuo Mac."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Sistemos“ seka jūsų „Mac“ kalbą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sistēmas” seko jūsu Mac datora valodai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Systeem’ volgt de taal van je Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Systemowy” podąża za językiem Twojego Maca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema» segue o idioma do seu Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”System” följer språket på din Mac."
          }
        }
      }
    },
    "System follows your Mac's setting, including when it changes.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„Системен“ следва настройката на вашия Mac, включително когато тя се променя."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“System” følger indstillingen på din Mac, også når den ændres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„System“ folgt der Einstellung deines Mac, auch wenn sie sich ändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επιλογή «Συστήματος» ακολουθεί τη ρύθμιση του Mac σας, ακόμη και όταν αλλάζει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema» sigue el ajuste de tu Mac, también cuando cambia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„Süsteemne“ järgib sinu Maci seadet, ka siis, kui see muutub."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”Järjestelmä” noudattaa Macisi asetusta, myös kun se muuttuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Système » suit le réglage de votre Mac, y compris lorsqu’il change."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema» segue l’impostazione del tuo Mac, anche quando cambia."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Sistemos“ seka jūsų „Mac“ nuostatą, taip pat ir tada, kai ji pasikeičia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sistēmas” seko jūsu Mac datora iestatījumam, arī tad, kad tas mainās."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Systeem’ volgt de instelling van je Mac, ook wanneer die verandert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Systemowy” podąża za ustawieniem Twojego Maca, także gdy się ono zmieni."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema» segue a definição do seu Mac, incluindo quando esta muda."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”System” följer inställningen på din Mac, även när den ändras."
          }
        }
      }
    },
    "That password or recovery key did not unlock this drive.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази парола или ключ за възстановяване не отключи този диск."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den adgangskode eller genoprettelsesnøgle låste ikke denne enhed op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Passwort bzw. dieser Wiederherstellungsschlüssel hat das Laufwerk nicht entsperrt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το συνθηματικό ή κλειδί ανάκτησης δεν ξεκλείδωσε αυτόν τον δίσκο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa contraseña o clave de recuperación no ha desbloqueado este disco."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See parool või taastevõti ei avanud seda ketast."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuo salasana tai palautusavain ei avannut tätä asemaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce mot de passe ou cette clé de récupération n’a pas déverrouillé ce disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella password o chiave di recupero non ha sbloccato questo disco."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis slaptažodis ar atkūrimo raktas šio disko neatrakino."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī parole vai atkopšanas atslēga neatbloķēja šo disku."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat wachtwoord of die herstelsleutel heeft deze schijf niet ontgrendeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To hasło ani klucz odzyskiwania nie odblokowały tego dysku."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa palavra-passe ou chave de recuperação não desbloqueou este disco."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det lösenordet eller den återställningsnyckeln låste inte upp enheten."
          }
        }
      }
    },
    "The Linux environment is unpacked once, on first use.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Средата на Linux се разопакова веднъж, при първото използване."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux-miljøet pakkes ud én gang, første gang det bruges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Linux-Umgebung wird einmalig beim ersten Verwenden entpackt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το περιβάλλον Linux αποσυμπιέζεται μία φορά, κατά την πρώτη χρήση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno Linux se descomprime una sola vez, la primera vez que se usa."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Linuxi keskkond pakitakse lahti ühe korra, esimesel kasutamisel."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux-ympäristö puretaan kerran, ensimmäisellä käyttökerralla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’environnement Linux n’est décompressé qu’une seule fois, à la première utilisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ambiente Linux viene estratto una sola volta, al primo utilizzo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Linux“ aplinka išpakuojama vieną kartą, pirmojo naudojimo metu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux vide tiek izpakota vienu reizi, pirmajā lietošanas reizē."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Linux-omgeving wordt eenmalig uitgepakt, bij het eerste gebruik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Środowisko Linuksa jest rozpakowywane raz, przy pierwszym użyciu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente Linux é descompactado uma única vez, na primeira utilização."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux-miljön packas upp en gång, vid första användningen."
          }
        }
      }
    },
    "The Linux environment will be deleted, freeing about %lld MB.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Средата на Linux ще бъде изтрита, освобождавайки около %lld MB."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux-miljøet slettes, hvilket frigør omkring %lld MB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Linux-Umgebung wird gelöscht und gibt etwa %lld MB frei."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το περιβάλλον Linux θα διαγραφεί, ελευθερώνοντας περίπου %lld MB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará el entorno Linux, liberando unos %lld MB."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Linuxi keskkond kustutatakse, vabastades umbes %lld MB."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux-ympäristö poistetaan, mikä vapauttaa noin %lld Mt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’environnement Linux sera supprimé, libérant environ %lld Mo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ambiente Linux verrà eliminato, liberando circa %lld MB."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Linux“ aplinka bus ištrinta, atlaisvinant apie %lld MB."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux vide tiks izdzēsta, atbrīvojot aptuveni %lld MB."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Linux-omgeving wordt verwijderd, waarmee ongeveer %lld MB vrijkomt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Środowisko Linuksa zostanie usunięte, zwalniając około %lld MB."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente Linux será eliminado, libertando cerca de %lld MB."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux-miljön raderas, vilket frigör omkring %lld MB."
          }
        }
      }
    },
    "The background helper is not set up, so %@ is holding the drive open itself. Quitting now disconnects it, and anything still being written would not finish.\n\nOnce the helper is set up, drives stay open on their own.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоновият помощник не е настроен, затова %@ сама държи диска отворен. Изходът сега го изключва и това, което още се записва, няма да завърши.\n\nСлед като помощникът бъде настроен, дисковете остават отворени сами."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baggrundshjælperen er ikke sat op, så %@ holder selv enheden åben. At slutte nu frakobler den, og det, der stadig skrives, ville ikke blive færdigt.\n\nNår hjælperen er sat op, forbliver enheder åbne af sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrund-Helfer ist nicht eingerichtet, daher hält %@ das Laufwerk selbst offen. Beenden trennt es jetzt, und alles, was noch geschrieben wird, würde nicht abgeschlossen.\n\nSobald der Helfer eingerichtet ist, bleiben Laufwerke von selbst geöffnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο βοηθός παρασκηνίου δεν έχει ρυθμιστεί, επομένως το ίδιο το %@ κρατά τον δίσκο ανοιχτό. Ο τερματισμός τώρα τον αποσυνδέει και ό,τι γράφεται ακόμη δεν θα ολοκληρωθεί.\n\nΜόλις ρυθμιστεί ο βοηθός, οι δίσκοι παραμένουν ανοιχτοί από μόνοι τους."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El asistente en segundo plano no está configurado, así que es %@ quien mantiene el disco abierto. Salir ahora lo desconecta y lo que quede por escribir no se completaría.\n\nUna vez configurado el asistente, los discos permanecen abiertos por sí solos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustaabiline ei ole seadistatud, seega hoiab %@ ketast ise avatuna. Praegu väljumine ühendab selle lahti ja pooleli kirjutamine ei lõpeks.\n\nKui abiline on seadistatud, jäävad kettad iseenesest avatuks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustaohjelmaa ei ole otettu käyttöön, joten %@ pitää asemaa auki itse. Lopettaminen nyt irrottaa sen, eikä kesken oleva kirjoitus valmistuisi.\n\nKun taustaohjelma on otettu käyttöön, asemat pysyvät auki itsestään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistant en arrière-plan n’est pas configuré : %@ maintient donc le disque ouvert lui-même. Quitter maintenant le déconnecte, et tout ce qui reste à écrire ne serait pas terminé.\n\nUne fois l’assistant configuré, les disques restent ouverts d’eux-mêmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’helper in background non è configurato, quindi è %@ stesso a tenere aperto il disco. Uscire ora lo scollega e ciò che resta da scrivere non verrebbe completato.\n\nUna volta configurato l’helper, i dischi restano aperti da soli."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foninis pagalbininkas nenustatytas, todėl %@ pati laiko diską atvertą. Baigus dabar jis bus atjungtas, o tai, kas dar rašoma, nebūtų užbaigta.\n\nKai pagalbininkas nustatytas, diskai lieka atverti savaime."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fona palīgs nav iestatīts, tāpēc %@ pati tur disku atvērtu. Iziešana tagad to atvienos, un tas, kas vēl tiek rakstīts, netiks pabeigts.\n\nKad palīgs ir iestatīts, diski paliek atvērti paši."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De achtergrondhelper is niet ingesteld, dus %@ houdt de schijf zelf open. Nu stoppen koppelt die los, en wat nog geschreven wordt, zou niet worden voltooid.\n\nZodra de helper is ingesteld, blijven schijven vanzelf open."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocnik działający w tle nie jest skonfigurowany, więc %@ sam utrzymuje dysk otwarty. Zakończenie teraz odłączy go, a to, co jest jeszcze zapisywane, nie zostanie dokończone.\n\nPo skonfigurowaniu pomocnika dyski pozostają otwarte same."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O assistente em segundo plano não está configurado, pelo que é o próprio %@ que mantém o disco aberto. Sair agora desliga-o, e o que estiver ainda a ser escrito não seria concluído.\n\nAssim que o assistente estiver configurado, os discos permanecem abertos por si."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrundshjälpen är inte konfigurerad, så %@ håller själv enheten öppen. Att avsluta nu kopplar bort den, och det som fortfarande skrivs skulle inte bli klart.\n\nNär hjälpen är konfigurerad förblir enheter öppna av sig själva."
          }
        }
      }
    },
    "The background helper is not set up, so %@ is holding them open itself. Quitting now disconnects them, and anything still being written would not finish.\n\nOnce the helper is set up, drives stay open on their own.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоновият помощник не е настроен, затова %@ сама ги държи отворени. Изходът сега ги изключва и това, което още се записва, няма да завърши.\n\nСлед като помощникът бъде настроен, дисковете остават отворени сами."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baggrundshjælperen er ikke sat op, så %@ holder dem selv åbne. At slutte nu frakobler dem, og det, der stadig skrives, ville ikke blive færdigt.\n\nNår hjælperen er sat op, forbliver enheder åbne af sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrund-Helfer ist nicht eingerichtet, daher hält %@ sie selbst offen. Beenden trennt sie jetzt, und alles, was noch geschrieben wird, würde nicht abgeschlossen.\n\nSobald der Helfer eingerichtet ist, bleiben Laufwerke von selbst geöffnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο βοηθός παρασκηνίου δεν έχει ρυθμιστεί, επομένως το ίδιο το %@ τους κρατά ανοιχτούς. Ο τερματισμός τώρα τους αποσυνδέει και ό,τι γράφεται ακόμη δεν θα ολοκληρωθεί.\n\nΜόλις ρυθμιστεί ο βοηθός, οι δίσκοι παραμένουν ανοιχτοί από μόνοι τους."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El asistente en segundo plano no está configurado, así que es %@ quien los mantiene abiertos. Salir ahora los desconecta y lo que quede por escribir no se completaría.\n\nUna vez configurado el asistente, los discos permanecen abiertos por sí solos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustaabiline ei ole seadistatud, seega hoiab %@ neid ise avatuna. Praegu väljumine ühendab nad lahti ja pooleli kirjutamine ei lõpeks.\n\nKui abiline on seadistatud, jäävad kettad iseenesest avatuks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustaohjelmaa ei ole otettu käyttöön, joten %@ pitää niitä auki itse. Lopettaminen nyt irrottaa ne, eikä kesken oleva kirjoitus valmistuisi.\n\nKun taustaohjelma on otettu käyttöön, asemat pysyvät auki itsestään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistant en arrière-plan n’est pas configuré : %@ les maintient donc ouverts lui-même. Quitter maintenant les déconnecte, et tout ce qui reste à écrire ne serait pas terminé.\n\nUne fois l’assistant configuré, les disques restent ouverts d’eux-mêmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’helper in background non è configurato, quindi è %@ stesso a tenerli aperti. Uscire ora li scollega e ciò che resta da scrivere non verrebbe completato.\n\nUna volta configurato l’helper, i dischi restano aperti da soli."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foninis pagalbininkas nenustatytas, todėl %@ pati laiko juos atvertus. Baigus dabar jie bus atjungti, o tai, kas dar rašoma, nebūtų užbaigta.\n\nKai pagalbininkas nustatytas, diskai lieka atverti savaime."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fona palīgs nav iestatīts, tāpēc %@ pati tur tos atvērtus. Iziešana tagad tos atvienos, un tas, kas vēl tiek rakstīts, netiks pabeigts.\n\nKad palīgs ir iestatīts, diski paliek atvērti paši."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De achtergrondhelper is niet ingesteld, dus %@ houdt ze zelf open. Nu stoppen koppelt ze los, en wat nog geschreven wordt, zou niet worden voltooid.\n\nZodra de helper is ingesteld, blijven schijven vanzelf open."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocnik działający w tle nie jest skonfigurowany, więc %@ sam utrzymuje je otwarte. Zakończenie teraz odłączy je, a to, co jest jeszcze zapisywane, nie zostanie dokończone.\n\nPo skonfigurowaniu pomocnika dyski pozostają otwarte same."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O assistente em segundo plano não está configurado, pelo que é o próprio %@ que os mantém abertos. Sair agora desliga-os, e o que estiver ainda a ser escrito não seria concluído.\n\nAssim que o assistente estiver configurado, os discos permanecem abertos por si."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrundshjälpen är inte konfigurerad, så %@ håller dem själv öppna. Att avsluta nu kopplar bort dem, och det som fortfarande skrivs skulle inte bli klart.\n\nNär hjälpen är konfigurerad förblir enheter öppna av sig själva."
          }
        }
      }
    },
    "The background helper will be unregistered.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрацията на фоновия помощник ще бъде отменена."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baggrundshjælperens registrering fjernes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Registrierung des Hintergrund-Helfers wird aufgehoben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η καταχώριση του βοηθού παρασκηνίου θα ακυρωθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se anulará el registro del asistente en segundo plano."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustaabilise registreering tühistatakse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustaohjelman rekisteröinti perutaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistant en arrière-plan sera désenregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’helper in background verrà deregistrato."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foninio pagalbininko registracija bus atšaukta."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fona palīga reģistrācija tiks atcelta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De registratie van de achtergrondhelper wordt ongedaan gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejestracja pomocnika działającego w tle zostanie cofnięta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O registo do assistente em segundo plano será anulado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrundshjälpens registrering tas bort."
          }
        }
      }
    },
    "The drive appears in the Finder sidebar under Locations.\nEject it here or in Finder before unplugging it.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дискът се появява в страничната лента на Finder в раздела „Locations“.\nИзвадете го тук или във Finder, преди да го изключите."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheden vises i Finders indholdsoversigt under “Placeringer”.\nSkub den ud her eller i Finder, før du frakobler den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laufwerk erscheint in der Finder-Seitenleiste unter „Orte“.\nWirf es hier oder im Finder aus, bevor du es abziehst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο δίσκος εμφανίζεται στην πλαϊνή στήλη του Finder, στην ενότητα «Τοποθεσίες».\nΚάντε εξαγωγή εδώ ή στο Finder πριν τον αποσυνδέσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco aparece en la barra lateral del Finder, en «Ubicaciones».\nExpúlsalo aquí o en el Finder antes de desconectarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketas ilmub Finderi külgribale jaotisse „Locations“.\nVäljuta see siin või Finderis, enne kui selle lahti ühendad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asema näkyy Finderin sivupalkissa kohdassa ”Sijainnit”.\nPoista se käytöstä täällä tai Finderissa ennen irrottamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque apparaît dans la barre latérale du Finder, sous « Emplacements ».\nÉjectez-le ici ou dans le Finder avant de le débrancher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco appare nella barra laterale del Finder, sotto «Posizioni».\nEspellilo qui o nel Finder prima di scollegarlo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskas rodomas „Finder“ šoninėje juostoje skiltyje „Locations“.\nIšstumkite jį čia arba „Finder“ programoje prieš atjungdami."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Disks parādās programmas Finder sānjoslā sadaļā “Locations”.\nIzstumiet to šeit vai programmā Finder, pirms to atvienojat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schijf verschijnt in de navigatiekolom van de Finder onder ‘Locaties’.\nVerwijder die hier of in de Finder voordat je de schijf loskoppelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dysk pojawia się na pasku bocznym Findera w sekcji „Miejsca”.\nWysuń go tutaj albo w Finderze, zanim go odłączysz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco aparece na barra lateral do Finder, em «Locais».\nEjete-o aqui ou no Finder antes de o desligar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten visas i Finders sidofält under ”Platser”.\nMata ut den här eller i Finder innan du kopplar bort den."
          }
        }
      }
    },
    "The drive is busy. Close anything using it, then try again.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дискът е зает. Затворете всичко, което го използва, и опитайте отново."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheden er optaget. Luk alt, der bruger den, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laufwerk ist belegt. Schließe alles, was es verwendet, und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο δίσκος είναι απασχολημένος. Κλείστε ό,τι τον χρησιμοποιεί και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco está ocupado. Cierra todo lo que lo esté usando y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketas on hõivatud. Sulge kõik, mis seda kasutab, ja proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asema on varattu. Sulje kaikki sitä käyttävä ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque est occupé. Fermez tout ce qui l’utilise, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco è occupato. Chiudi tutto ciò che lo sta usando, quindi riprova."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskas užimtas. Uždarykite viską, kas jį naudoja, ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Disks ir aizņemts. Aizveriet visu, kas to izmanto, un mēģiniet vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schijf is bezig. Sluit alles wat die gebruikt en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dysk jest zajęty. Zamknij wszystko, co go używa, i spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco está ocupado. Feche tudo o que o esteja a usar e tente de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten är upptagen. Stäng allt som använder den och försök igen."
          }
        }
      }
    },
    "The drive is handed to Finder over a local network connection, so it appears under Locations with a network icon. It reads, writes and ejects like any other drive. macOS offers no way to present it as a local disk.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дискът се предава на Finder през локална мрежова връзка, затова се появява в „Locations“ с мрежова икона. Чете се, записва се и се изважда като всеки друг диск. macOS не предлага начин да бъде показан като локален диск."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheden gives videre til Finder via en lokal netværksforbindelse og vises derfor under “Placeringer” med et netværkssymbol. Den læses, skrives og skubbes ud som enhver anden enhed. macOS giver ingen mulighed for at vise den som en lokal disk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laufwerk wird dem Finder über eine lokale Netzwerkverbindung übergeben und erscheint deshalb unter „Orte“ mit einem Netzwerksymbol. Es liest, schreibt und wird ausgeworfen wie jedes andere Laufwerk. macOS bietet keine Möglichkeit, es als lokales Volume darzustellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο δίσκος παραδίδεται στο Finder μέσω τοπικής σύνδεσης δικτύου, γι’ αυτό εμφανίζεται στις «Τοποθεσίες» με εικονίδιο δικτύου. Διαβάζεται, γράφεται και εξάγεται όπως κάθε άλλος δίσκος. Το macOS δεν προσφέρει τρόπο να παρουσιαστεί ως τοπικός δίσκος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco se entrega al Finder mediante una conexión de red local, por lo que aparece en «Ubicaciones» con un icono de red. Se lee, se escribe y se expulsa como cualquier otro disco. macOS no ofrece ninguna forma de presentarlo como un disco local."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketas antakse Finderile üle kohtvõrguühenduse kaudu, seega ilmub see jaotisse „Locations“ võrguikooniga. Seda loetakse, sellele kirjutatakse ja see väljutatakse nagu iga teine ketas. macOS ei võimalda seda kohaliku kettana esitada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asema välitetään Finderille paikallisen verkkoyhteyden kautta, joten se näkyy kohdassa ”Sijainnit” verkkokuvakkeella. Sitä luetaan, siihen kirjoitetaan ja se poistetaan käytöstä kuten mikä tahansa muu asema. macOS ei tarjoa tapaa esittää sitä paikallisena levynä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque est transmis au Finder via une connexion réseau locale : il apparaît donc sous « Emplacements » avec une icône de réseau. Il se lit, s’écrit et s’éjecte comme n’importe quel autre disque. macOS n’offre aucun moyen de le présenter comme un disque local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco viene consegnato al Finder tramite una connessione di rete locale, quindi appare sotto «Posizioni» con un’icona di rete. Si legge, si scrive e si espelle come qualsiasi altro disco. macOS non offre alcun modo di presentarlo come disco locale."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskas perduodamas „Finder“ programai vietinio tinklo ryšiu, todėl rodomas skiltyje „Locations“ su tinklo piktograma. Jis skaitomas, į jį rašoma ir jis išstumiamas kaip bet kuris kitas diskas. „macOS“ nesiūlo būdo pateikti jį kaip vietinį diską."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Disks tiek nodots programmai Finder pa lokālā tīkla savienojumu, tāpēc tas parādās sadaļā “Locations” ar tīkla ikonu. To lasa, tajā raksta un izstumj tāpat kā jebkuru citu disku. macOS nepiedāvā veidu, kā to parādīt kā lokālu disku."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schijf wordt via een lokale netwerkverbinding aan de Finder doorgegeven en verschijnt daarom onder ‘Locaties’ met een netwerksymbool. Je leest, schrijft en verwijdert die net als elke andere schijf. macOS biedt geen manier om die als lokale schijf te tonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dysk jest przekazywany Finderowi przez lokalne połączenie sieciowe, dlatego pojawia się w sekcji „Miejsca” z ikoną sieci. Odczytuje się go, zapisuje i wysuwa jak każdy inny dysk. macOS nie daje możliwości pokazania go jako dysku lokalnego."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco é entregue ao Finder através de uma ligação de rede local, pelo que aparece em «Locais» com um ícone de rede. Lê-se, escreve-se e ejeta-se como qualquer outro disco. O macOS não oferece forma de o apresentar como um disco local."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten lämnas över till Finder via en lokal nätverksanslutning och visas därför under ”Platser” med en nätverkssymbol. Den läses, skrivs och matas ut som vilken annan enhet som helst. macOS erbjuder inget sätt att visa den som en lokal disk."
          }
        }
      }
    },
    "The drive stays in Finder after %@ quits. Eject it there whenever you are finished.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дискът остава във Finder, след като %@ приключи. Извадете го оттам, когато сте готови."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheden bliver i Finder, efter at %@ er sluttet. Skub den ud derfra, når du er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laufwerk bleibt nach dem Beenden von %@ im Finder. Wirf es dort aus, wenn du fertig bist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο δίσκος παραμένει στο Finder αφού τερματιστεί το %@. Κάντε εξαγωγή από εκεί όταν τελειώσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco permanece en el Finder después de salir de %@. Expúlsalo allí cuando termines."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketas jääb Finderisse pärast seda, kui %@ väljub. Väljuta see sealt, kui oled lõpetanud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asema jää Finderiin sen jälkeen, kun %@ lopetetaan. Poista se sieltä käytöstä, kun olet valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque reste dans le Finder après la fermeture de %@. Éjectez-le depuis le Finder lorsque vous avez terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco resta nel Finder dopo la chiusura di %@. Espellilo da lì quando hai finito."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskas lieka „Finder“ programoje, kai %@ baigia darbą. Išstumkite jį ten, kai baigsite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Disks paliek programmā Finder pēc tam, kad %@ ir aizvērta. Izstumiet to tur, kad esat pabeidzis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schijf blijft in de Finder staan nadat %@ is gestopt. Verwijder die daar wanneer je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dysk pozostaje w Finderze po zakończeniu programu %@. Wysuń go stamtąd, gdy skończysz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco permanece no Finder depois de o %@ sair. Ejete-o aí quando terminar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten finns kvar i Finder efter att %@ avslutats. Mata ut den där när du är klar."
          }
        }
      }
    },
    "The drive was not opened": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дискът не беше отворен"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheden blev ikke åbnet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laufwerk wurde nicht geöffnet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο δίσκος δεν άνοιξε"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco no se abrió"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketast ei avatud"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asemaa ei avattu"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque n’a pas été ouvert"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco non è stato aperto"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskas nebuvo atvertas"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Disks netika atvērts"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schijf is niet geopend"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dysk nie został otwarty"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco não foi aberto"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten öppnades inte"
          }
        }
      }
    },
    "The drive was not opened. %@": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дискът не беше отворен. %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheden blev ikke åbnet. %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Laufwerk wurde nicht geöffnet. %@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο δίσκος δεν άνοιξε. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco no se abrió. %@"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketast ei avatud. %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asemaa ei avattu. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque n’a pas été ouvert. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco non è stato aperto. %@"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskas nebuvo atvertas. %@"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Disks netika atvērts. %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schijf is niet geopend. %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dysk nie został otwarty. %@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco não foi aberto. %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten öppnades inte. %@"
          }
        }
      }
    },
    "The drive was not shut down cleanly by Windows. Turn off Fast Startup in Windows, or shut Windows down fully rather than hibernating, then try again.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows не е изключил диска правилно. Изключете бързото стартиране в Windows или изключете Windows напълно, вместо да го приспивате, и опитайте отново."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows lukkede ikke enheden korrekt ned. Slå hurtig opstart fra i Windows, eller luk Windows helt ned i stedet for at sætte den i dvale, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows hat das Laufwerk nicht sauber heruntergefahren. Deaktiviere den Schnellstart in Windows oder fahre Windows vollständig herunter, statt in den Ruhezustand zu wechseln, und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα Windows δεν τερμάτισαν σωστά τον δίσκο. Απενεργοποιήστε τη γρήγορη εκκίνηση στα Windows ή τερματίστε τα πλήρως αντί για αδρανοποίηση, και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows no apagó el disco correctamente. Desactiva el inicio rápido en Windows, o apaga Windows por completo en vez de hibernarlo, y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows ei sulgenud ketast korralikult. Lülita Windowsis välja kiirkäivitus või sulge Windows täielikult, selle asemel et see talveunne panna, ja proovi siis uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows ei sammuttanut asemaa siististi. Poista nopea käynnistys käytöstä Windowsissa tai sammuta Windows kokonaan lepotilan sijaan, ja yritä sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows n’a pas arrêté le disque proprement. Désactivez le démarrage rapide dans Windows, ou arrêtez complètement Windows au lieu de le mettre en veille prolongée, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows non ha spento il disco correttamente. Disattiva l’avvio rapido in Windows, oppure spegni Windows completamente invece di ibernarlo, quindi riprova."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Windows“ neišjungė disko tvarkingai. Išjunkite spartųjį paleidimą „Windows“ sistemoje arba išjunkite „Windows“ visiškai, o ne užmigdykite, ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows neizslēdza disku korekti. Izslēdziet Windows ātro startēšanu vai izslēdziet Windows pilnībā, nevis pārejiet hibernācijā, un tad mēģiniet vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows heeft de schijf niet netjes afgesloten. Schakel snel opstarten uit in Windows, of sluit Windows volledig af in plaats van in slaapstand te zetten, en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "System Windows nie zamknął dysku poprawnie. Wyłącz szybkie uruchamianie w Windows albo zamknij Windows całkowicie zamiast hibernować, a potem spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Windows não encerrou o disco corretamente. Desative o arranque rápido no Windows, ou encerre o Windows por completo em vez de o hibernar, e tente de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows stängde inte av enheten korrekt. Stäng av snabbstart i Windows, eller stäng av Windows helt i stället för viloläge, och försök igen."
          }
        }
      }
    },
    "The engine did not recognise a filesystem on this volume. If it is encrypted, the password or recovery key may be wrong.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Двигателят не разпозна файлова система на този том. Ако е шифрована, паролата или ключът за възстановяване може да са грешни."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Motoren genkendte ikke noget filsystem på denne enhed. Hvis den er krypteret, er adgangskoden eller genoprettelsesnøglen måske forkert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Engine hat auf diesem Volume kein Dateisystem erkannt. Falls es verschlüsselt ist, ist möglicherweise das Passwort oder der Wiederherstellungsschlüssel falsch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μηχανή δεν αναγνώρισε σύστημα αρχείων σε αυτόν τον τόμο. Αν είναι κρυπτογραφημένος, το συνθηματικό ή το κλειδί ανάκτησης ίσως είναι λάθος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor no ha reconocido ningún sistema de archivos en este volumen. Si está cifrado, puede que la contraseña o la clave de recuperación sean incorrectas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mootor ei tuvastanud sellel köitel failisüsteemi. Kui see on krüpteeritud, võib parool või taastevõti olla vale."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moottori ei tunnistanut tästä taltiosta tiedostojärjestelmää. Jos se on salattu, salasana tai palautusavain voi olla väärä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur n’a reconnu aucun système de fichiers sur ce volume. S’il est chiffré, le mot de passe ou la clé de récupération est peut-être incorrect."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore non ha riconosciuto alcun file system su questo volume. Se è cifrato, la password o la chiave di recupero potrebbero essere errate."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Variklis šiame tome neatpažino failų sistemos. Jei ji užšifruota, slaptažodis arba atkūrimo raktas gali būti neteisingi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzinējs šajā sējumā neatpazina failu sistēmu. Ja tas ir šifrēts, parole vai atkopšanas atslēga var būt nepareiza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De engine heeft op dit volume geen bestandssysteem herkend. Als het versleuteld is, klopt het wachtwoord of de herstelsleutel mogelijk niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Silnik nie rozpoznał systemu plików na tym woluminie. Jeśli jest zaszyfrowany, hasło lub klucz odzyskiwania mogą być błędne."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor não reconheceu qualquer sistema de ficheiros neste volume. Se estiver encriptado, a palavra-passe ou a chave de recuperação poderão estar erradas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Motorn kände inte igen något filsystem på volymen. Om den är krypterad kan lösenordet eller återställningsnyckeln vara fel."
          }
        }
      }
    },
    "The engine reported nothing at all. The drive may have been unplugged.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Двигателят не съобщи нищо. Възможно е дискът да е бил изключен."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Motoren meldte ingenting. Enheden er måske blevet frakoblet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Engine hat überhaupt nichts gemeldet. Möglicherweise wurde das Laufwerk abgezogen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μηχανή δεν ανέφερε τίποτα. Ο δίσκος ίσως αποσυνδέθηκε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor no ha indicado nada en absoluto. Puede que el disco se haya desconectado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mootor ei teatanud üldse midagi. Ketas võis olla lahti ühendatud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moottori ei ilmoittanut mitään. Asema on saatettu irrottaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur n’a rien signalé du tout. Le disque a peut-être été débranché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore non ha segnalato nulla. Il disco potrebbe essere stato scollegato."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Variklis nepranešė nieko. Diskas galėjo būti atjungtas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzinējs neziņoja neko. Disks, iespējams, tika atvienots."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De engine heeft helemaal niets gemeld. Mogelijk is de schijf losgekoppeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Silnik nie zgłosił niczego. Dysk mógł zostać odłączony."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor não comunicou absolutamente nada. O disco pode ter sido desligado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Motorn rapporterade ingenting alls. Enheten kan ha kopplats bort."
          }
        }
      }
    },
    "The language changes when %@ starts again.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Езикът се променя, когато %@ стартира отново."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sproget ændres, når %@ starter igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache ändert sich, wenn %@ neu gestartet wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γλώσσα αλλάζει όταν το %@ ξεκινήσει ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma cambia la próxima vez que se inicie %@."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Keel muutub, kui %@ uuesti käivitub."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kieli vaihtuu, kun %@ käynnistyy uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue change au prochain démarrage de %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingua cambia al prossimo avvio di %@."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalba pasikeis, kai %@ bus paleista iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valoda mainīsies, kad %@ tiks palaista no jauna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De taal verandert wanneer %@ opnieuw start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Język zmieni się przy następnym uruchomieniu programu %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma muda quando o %@ voltar a iniciar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Språket ändras när %@ startar igen."
          }
        }
      }
    },
    "The name": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Името"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όνομα"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimi"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimi"
