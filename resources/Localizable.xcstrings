    "Windows NTFS drives, including ones Windows left hibernated or not shut down properly": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محرّكات Windows بنظام NTFS، بما فيها ما تركه Windows في وضع الإسبات أو لم يُغلق بشكل سليم"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "NTFS дискове на Windows, включително оставените от Windows в хибернация или неизключени правилно"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Disky NTFS z Windows, včetně těch, které Windows nechal v režimu spánku nebo řádně nevypnul"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "NTFS-enheder fra Windows, også dem Windows efterlod i dvale eller ikke lukkede korrekt ned"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows-NTFS-Laufwerke, auch solche, die Windows im Ruhezustand oder nicht ordnungsgemäß heruntergefahren hinterlassen hat"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δίσκοι NTFS των Windows, ακόμη και όσοι έμειναν σε αδρανοποίηση ή δεν τερματίστηκαν σωστά"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Discos NTFS de Windows, incluidos los que Windows dejó hibernados o mal apagados"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Windowsi NTFS-kettad, sealhulgas need, mille Windows jättis talveunne või korralikult sulgemata"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Windowsin NTFS-asemat, myös ne jotka Windows jätti lepotilaan tai sammutti huonosti"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga Windows NTFS drive, kasama ang mga iniwan ng Windows na naka-hibernate o hindi maayos na isinara"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les disques NTFS Windows, y compris ceux que Windows a laissés en veille prolongée ou mal arrêtés"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כונני NTFS של Windows, כולל כאלה ש‑Windows השאיר בתרדמת או לא סגר כראוי"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows NTFS ड्राइव, जिनमें वे भी शामिल हैं जिन्हें Windows ने हाइबरनेट छोड़ा या ठीक से बंद नहीं किया"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows NTFS diskovi, uključujući one koje je Windows ostavio u hibernaciji ili nije uredno isključio"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows NTFS-meghajtók, azokat is beleértve, amelyeket a Windows hibernálva vagy szabálytalanul leállítva hagyott"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive Windows NTFS, termasuk yang ditinggalkan Windows dalam hibernasi atau tidak dimatikan dengan benar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dischi NTFS di Windows, compresi quelli lasciati da Windows in ibernazione o spenti male"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows の NTFS ドライブ（Windows が休止状態のまま残したものや、正常に終了しなかったものを含む）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows가 최대 절전으로 남겨 두었거나 정상적으로 종료하지 않은 것을 포함한 Windows NTFS 드라이브"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Windows“ NTFS diskai, įskaitant tuos, kuriuos „Windows“ paliko užmigdytus arba netinkamai išjungė"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows NTFS diski, tostarp tie, ko Windows atstāja hibernācijā vai neizslēdza pareizi"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemacu Windows NTFS, termasuk yang ditinggalkan Windows dalam hibernasi atau tidak ditutup dengan betul"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "NTFS-enheter fra Windows, også de Windows forlot i dvale eller ikke slo ordentlig av"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NTFS-schijven van Windows, ook die Windows in slaapstand of niet correct afgesloten heeft achtergelaten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyski NTFS systemu Windows, także te pozostawione w hibernacji lub niepoprawnie zamknięte"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Discos NTFS do Windows, incluindo os que o Windows deixou hibernados ou mal encerrados"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Discuri NTFS Windows, inclusiv cele lăsate de Windows în hibernare sau oprite necorespunzător"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диски Windows NTFS, в том числе оставленные Windows в гибернации или завершённые некорректно"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogoni NTFS iz Windows, tudi tisti, ki jih je Windows pustil v mirovanju ali jih ni pravilno zaustavil"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Disqe Windows NTFS, përfshirë ata që Windows i la në gjumë ose nuk i fiku si duhet"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "NTFS-enheter från Windows, även sådana som Windows lämnat i viloläge eller inte stängt av ordentligt"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไดรฟ์ NTFS ของ Windows รวมถึงไดรฟ์ที่ Windows ทิ้งไว้ในสถานะไฮเบอร์เนตหรือปิดไม่เรียบร้อย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows NTFS sürücüleri, Windows'un uykuda bıraktığı ya da düzgün kapatmadığı sürücüler dahil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Диски Windows NTFS, зокрема залишені Windows у режимі глибокого сну або завершені некоректно"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ Windows NTFS, kể cả những ổ Windows để ở chế độ ngủ đông hoặc tắt không đúng cách"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows NTFS 驱动器，包括被 Windows 置于休眠或未正常关闭的驱动器"
          }
        }
      }
    },
    "Windows is part-way through encrypting or decrypting this drive. Open it in Windows and let BitLocker finish, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Windows في منتصف تشفير هذا المحرّك أو فك تشفيره. افتحه في Windows ودع BitLocker ينتهي، ثم حاول مرة أخرى."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows е по средата на шифроването или дешифроването на този диск. Отворете го в Windows и оставете BitLocker да завърши, след което опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows je uprostřed šifrování nebo dešifrování tohoto disku. Otevřete jej ve Windows a nechte BitLocker dokončit práci, pak to zkuste znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows er midt i at kryptere eller dekryptere denne disk. Åbn den i Windows, og lad BitLocker gøre færdig, og prøv så igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows ist mitten dabei, dieses Laufwerk zu verschlüsseln oder zu entschlüsseln. Öffne es in Windows und lass BitLocker fertig werden, dann versuch es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα Windows βρίσκονται στη μέση της κρυπτογράφησης ή της αποκρυπτογράφησης αυτού του δίσκου. Ανοίξτε τον στα Windows και αφήστε το BitLocker να τελειώσει, και μετά δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows está a medias cifrando o descifrando este disco. Ábrelo en Windows y deja que BitLocker termine; después inténtalo de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows on selle ketta krüptimise või dekrüptimise poole peal. Ava see Windowsis ja lase BitLockeril lõpetada, seejärel proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows on kesken tämän levyn salaamisen tai salauksen purkamisen. Avaa levy Windowsissa ja anna BitLockerin tehdä työ loppuun, yritä sitten uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasa kalagitnaan ang Windows ng pag-encrypt o pag-decrypt sa drive na ito. Buksan ito sa Windows at hayaang tapusin ng BitLocker, pagkatapos ay subukan muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows est en train de chiffrer ou de déchiffrer ce disque. Ouvrez-le dans Windows et laissez BitLocker terminer, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏Windows נמצא באמצע הצפנה או פענוח של הכונן הזה. פתחו אותו ב‑Windows ותנו ל‑BitLocker לסיים, ואז נסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows इस ड्राइव को एन्क्रिप्ट या डिक्रिप्ट करने के बीच में है। इसे Windows में खोलें और BitLocker को पूरा करने दें, फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows je usred šifriranja ili dešifriranja ovog diska. Otvorite ga u Windowsima i pustite BitLocker da dovrši, pa pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Windows épp titkosítja vagy visszafejti ezt a lemezt. Nyissa meg Windowsban, hagyja, hogy a BitLocker befejezze, azután próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows sedang di tengah proses mengenkripsi atau mendekripsi drive ini. Buka di Windows dan biarkan BitLocker selesai, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows sta cifrando o decifrando questo disco e non ha finito. Aprilo in Windows e lascia che BitLocker completi il lavoro, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows がこのドライブの暗号化または復号の途中です。Windows で開いて BitLocker を完了させてから、もう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows가 이 드라이브를 암호화하거나 해독하는 중입니다. Windows에서 열어 BitLocker가 끝나도록 한 뒤 다시 시도하십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Windows“ šiuo metu šifruoja arba iššifruoja šį diską. Atverkite jį „Windows“ sistemoje ir leiskite „BitLocker“ baigti, tada bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows pašlaik šifrē vai atšifrē šo disku. Atveriet to Windows vidē un ļaujiet BitLocker pabeigt, pēc tam mēģiniet vēlreiz."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows sedang di tengah-tengah menyulitkan atau menyahsulitkan pemacu ini. Bukanya dalam Windows dan biarkan BitLocker selesai, kemudian cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows er midt i å kryptere eller dekryptere denne disken. Åpne den i Windows og la BitLocker bli ferdig, og prøv så igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows is halverwege het versleutelen of ontsleutelen van deze schijf. Open die in Windows en laat BitLocker afmaken, probeer het daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows jest w trakcie szyfrowania lub odszyfrowywania tego dysku. Otwórz go w systemie Windows i pozwól funkcji BitLocker dokończyć, a potem spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Windows está a meio de cifrar ou decifrar este disco. Abra-o no Windows e deixe o BitLocker terminar, e depois tente de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows este la jumătatea criptării sau decriptării acestui disc. Deschideți-l în Windows și lăsați BitLocker să termine, apoi încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows наполовину зашифровал или расшифровал этот диск. Откройте его в Windows и дайте BitLocker закончить, затем попробуйте снова."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows je sredi šifriranja ali dešifriranja tega diska. Odprite ga v Windowsih in pustite BitLockerju, da konča, nato poskusite znova."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows është në mes të enkriptimit ose deshifrimit të këtij disku. Hape në Windows dhe lëre BitLocker ta përfundojë, pastaj provo sërish."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows håller på att kryptera eller dekryptera den här disken. Öppna den i Windows och låt BitLocker bli klart, försök sedan igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows กำลังเข้ารหัสหรือถอดรหัสไดรฟ์นี้อยู่กลางคัน เปิดมันใน Windows แล้วปล่อยให้ BitLocker ทำจนเสร็จ จากนั้นลองใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows bu sürücüyü şifrelemenin ya da şifresini çözmenin ortasında. Onu Windows'ta açın ve BitLocker'ın bitirmesine izin verin, sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows наполовину зашифрував або розшифрував цей диск. Відкрийте його у Windows і дайте BitLocker завершити, потім спробуйте знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows đang dở dang việc mã hóa hoặc giải mã ổ đĩa này. Hãy mở nó trong Windows và để BitLocker hoàn tất, rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 正在对这个驱动器进行加密或解密。请在 Windows 中打开它并让 BitLocker 完成，然后重试。"
          }
        }
      }
    },
    "Writing to this image format is untested": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكتابة إلى صيغة الصورة هذه غير مُختبرة"
