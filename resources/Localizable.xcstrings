    "Granted permission will only apply once the app is restarted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يسري الإذن الممنوح إلا بعد إعادة تشغيل التطبيق."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дадено разрешение влиза в сила едва след рестартиране на приложението."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udělené oprávnění se projeví až po restartu aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En given tilladelse træder først i kraft, når programmet er startet igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine erteilte Berechtigung gilt erst, wenn das Programm neu gestartet wurde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια άδεια που παραχωρήθηκε ισχύει μόνο μετά την επανεκκίνηση της εφαρμογής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un permiso concedido solo se aplica cuando se reinicia la app."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Antud luba hakkab kehtima alles pärast rakenduse taaskäivitamist."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Myönnetty oikeus tulee voimaan vasta, kun ohjelma käynnistetään uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang ipinagkaloob na pahintulot ay magkakabisa lamang kapag muling inilunsad ang app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autorisation accordée ne prend effet qu’après le redémarrage de l’app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרשאה שניתנה תיכנס לתוקף רק לאחר הפעלה מחדש של היישום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दी गई अनुमति ऐप के दोबारा शुरू होने पर ही लागू होगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodijeljeno dopuštenje vrijedi tek nakon ponovnog pokretanja aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megadott engedély csak az alkalmazás újraindítása után lép életbe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin yang diberikan baru berlaku setelah aplikasi dijalankan ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un permesso concesso vale solo dopo il riavvio dell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "付与した権限は、アプリを再起動してから有効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부여한 권한은 앱을 다시 실행해야 적용됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
