        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” är mindre än vad dess egen sidfot anger och kan vara skadad eller ofullständig."
          }
        }
      }
    },
    "“%@” is unlocked": {
      "localizations": {
