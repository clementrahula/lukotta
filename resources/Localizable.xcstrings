            "value": "Järjestelmä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Système"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistēmas"
          }
        },
        "nl": {
          "stringUnit": {
