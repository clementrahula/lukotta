    "BitLocker drives, unlocked with the volume password or a 48-digit recovery key": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дискове с BitLocker, отключени с паролата на тома или 48-цифрен ключ за възстановяване"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "BitLocker-enheder, låst op med enhedens adgangskode eller en 48-cifret genoprettelsesnøgle"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BitLocker-Laufwerke, entsperrt mit dem Volume-Passwort oder einem 48-stelligen Wiederherstellungsschlüssel"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δίσκοι BitLocker, ξεκλειδωμένοι με το συνθηματικό του τόμου ή ένα 48ψήφιο κλειδί ανάκτησης"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Discos BitLocker, desbloqueados con la contraseña del volumen o una clave de recuperación de 48 dígitos"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "BitLockeri kettad, avatuna köite parooli või 48-kohalise taastevõtmega"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
