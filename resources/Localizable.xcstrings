            "state": "translated",
            "value": "No hay nada en «%1$@» que %2$@ pueda abrir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ sees ei ole midagi, mida %2$@ avada oskaks."
          }
        },
        "fi": {
          "stringUnit": {
