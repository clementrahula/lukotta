    "What a drive contains is only known once it is unlocked.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съдържанието на диска се разбира едва след като бъде отключен."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad en enhed indeholder, ved man først, når den er låst op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ein Laufwerk enthält, ist erst nach dem Entsperren bekannt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το περιεχόμενο ενός δίσκου γίνεται γνωστό μόνο αφού ξεκλειδωθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido de un disco solo se conoce una vez desbloqueado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketta sisu selgub alles siis, kui see on avatud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseman sisältö selviää vasta, kun se on avattu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu d’un disque n’est connu qu’une fois celui-ci déverrouillé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto di un disco si conosce solo dopo averlo sbloccato."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Disko turinys paaiškėja tik jį atrakinus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diska saturs kļūst zināms tikai pēc tā atbloķēšanas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat een schijf bevat, is pas bekend nadat die is ontgrendeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawartość dysku jest znana dopiero po jego odblokowaniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo de um disco só é conhecido depois de este ser desbloqueado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad en enhet innehåller vet man först när den är upplåst."
          }
        }
      }
    },
