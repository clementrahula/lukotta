    "It is in the Bin. Nothing else of it is left on this Mac.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Намира се в кошчето. Нищо друго от него не е останало на този Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den ligger i papirkurven. Der er ikke andet tilbage af den på denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es liegt im Papierkorb. Sonst ist nichts davon auf diesem Mac verblieben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρίσκεται στον Κάδο. Τίποτα άλλο από αυτό δεν έμεινε σε αυτό το Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está en la papelera. No queda nada más de ello en este Mac."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See on prügikastis. Muud sellest siia Maci ei jäänud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on roskakorissa. Muuta siitä ei jäänyt tähän Maciin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est dans la corbeille. Rien d’autre n’en subsiste sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È nel Cestino. Non ne resta altro su questo Mac."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ji yra šiukšlinėje. Daugiau nieko iš jos šiame „Mac“ neliko."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tā ir atkritnē. Nekas cits no tās šajā Mac datorā nav palicis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het staat in de prullenmand. Er is verder niets van achtergebleven op deze Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest w Koszu. Nic więcej po nim nie zostało na tym Macu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está no lixo. Não resta mais nada dele neste Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den ligger i papperskorgen. Inget annat av den finns kvar på den här datorn."
          }
        }
      }
    },
    "LUKS drives from Linux, both LUKS1 and LUKS2": {
      "localizations": {
        "bg": {
