  "strings": {
    "%@ could not open your drives": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على %@ فتح محرّكاتك"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не можа да отвори дисковете ви"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nemohl otevřít vaše disky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kunne ikke åbne dine diske"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte deine Laufwerke nicht öffnen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ δεν μπόρεσε να ανοίξει τους δίσκους σας"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no ha podido abrir tus discos"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei saanud su kettaid avada"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei voinut avata levyjäsi"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi nabuksan ng %@ ang iyong mga drive"
