      }
    },
    "macOS would not add %@ to your login items. Open System Settings, then General, then Login Items, and add it there.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يضف macOS %@ إلى عناصر تسجيل الدخول لديك. افتح إعدادات النظام، ثم عام، ثم عناصر تسجيل الدخول، وأضفه هناك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS не добави %@ към елементите за влизане. Отворете System Settings, после General, после Login Items и го добавете там."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS nepřidal %@ mezi položky přihlášení. Otevřete Nastavení systému, pak Obecné, pak Položky přihlášení a přidejte ji tam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ville ikke føje %@ til dine loginemner. Åbn Systemindstillinger, derefter Generelt, derefter Loginemner, og tilføj programmet der."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat %@ nicht zu deinen Anmeldeobjekten hinzugefügt. Öffne die Systemeinstellungen, dann Allgemein, dann Anmeldeobjekte, und füge die App dort hinzu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το macOS δεν πρόσθεσε το %@ στα αντικείμενα σύνδεσης. Ανοίξτε τις Ρυθμίσεις συστήματος, μετά Γενικά, μετά Αντικείμενα σύνδεσης, και προσθέστε το εκεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no añadió %@ a tus ítems de inicio. Abre Ajustes del Sistema, luego General, luego Ítems de inicio, y añádelo ahí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ei lisanud rakendust %@ sisselogimisüksuste hulka. Ava Süsteemiseaded, siis Üldine, siis Sisselogimisüksused, ja lisa see sinna."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ei lisännyt ohjelmaa %@ kirjautumiskohteisiin. Avaa Järjestelmäasetukset, sitten Yleiset, sitten Kirjautumiskohteet, ja lisää se sinne."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi idinagdag ng macOS ang %@ sa iyong mga login item. Buksan ang System Settings, pagkatapos ay General, pagkatapos ay Login Items, at idagdag ito roon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’a pas ajouté %@ à vos ouvertures de session. Ouvrez Réglages Système, puis Général, puis Ouverture, et ajoutez-la là."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏macOS לא הוסיף את %@ לפריטי הכניסה שלך. פתחו את הגדרות המערכת, אחר כך כללי, אחר כך פריטי כניסה, והוסיפו אותו שם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ने %@ को आपके लॉगिन आइटम में नहीं जोड़ा। सिस्टम सेटिंग्ज़, फिर सामान्य, फिर लॉगिन आइटम खोलें और उसे वहाँ जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS nije dodao %@ u stavke prijave. Otvorite Postavke sustava, zatim Općenito, zatim Stavke prijave, i dodajte ga ondje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A macOS nem adta hozzá a(z) %@ alkalmazást a bejelentkezési elemekhez. Nyissa meg a Rendszerbeállításokat, majd az Általános, majd a Bejelentkezési elemek részt, és adja hozzá ott."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS tidak menambahkan %@ ke item masuk Anda. Buka Pengaturan Sistem, lalu Umum, lalu Item Masuk, dan tambahkan di sana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS non ha aggiunto %@ agli elementi di login. Apri Impostazioni di Sistema, poi Generali, poi Elementi login, e aggiungila lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS は %@ をログイン項目に追加しませんでした。「システム設定」を開き、「一般」、「ログイン項目」と進んで、そこで追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 %@을(를) 로그인 항목에 추가하지 않았습니다. 시스템 설정을 열고 일반, 로그인 항목으로 이동해 그곳에서 추가하십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„macOS“ nepridėjo %@ prie prisijungimo elementų. Atverkite Sistemos nuostatas, tada Bendra, tada Prisijungimo elementai, ir pridėkite ją ten."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS nepievienoja %@ pieteikšanās vienumiem. Atveriet Sistēmas iestatījumus, tad Vispārīgi, tad Pieteikšanās vienumi, un pievienojiet to tur."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS tidak menambah %@ pada item log masuk anda. Buka Seting Sistem, kemudian Umum, kemudian Item Log Masuk, dan tambahkannya di sana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS la ikke %@ til i påloggingsobjektene. Åpne Systeminnstillinger, så Generelt, så Påloggingsobjekter, og legg den til der."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS heeft %@ niet aan je inlogitems toegevoegd. Open Systeeminstellingen, dan Algemeen, dan Inlogonderdelen, en voeg de app daar toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS nie dodał programu %@ do elementów logowania. Otwórz Ustawienia systemowe, potem Ogólne, potem Elementy logowania, i dodaj go tam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não adicionou o %@ aos itens de início de sessão. Abra as Definições do Sistema, depois Geral, depois Itens de início de sessão, e adicione-o aí."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS nu a adăugat %@ la elementele de conectare. Deschideți Configurări sistem, apoi General, apoi Elemente de conectare, și adăugați-l acolo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS не добавил %@ в объекты входа. Откройте Системные настройки, затем Основные, затем Объекты входа, и добавьте его там."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ni dodal %@ med prijavne elemente. Odprite System Settings, nato Splošno, nato Prijavni elementi, in ga dodajte tam."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS nuk pranoi ta shtojë %@ te elementet e hyrjes. Hap System Settings, pastaj General, pastaj Login Items, dhe shtoje atje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lade inte till %@ bland dina inloggningsobjekt. Öppna Systeminställningar, sedan Allmänt, sedan Inloggningsobjekt, och lägg till det där."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ไม่ได้เพิ่ม %@ ลงในรายการล็อกอินของคุณ เปิด การตั้งค่าระบบ แล้วไปที่ ทั่วไป จากนั้น รายการเข้าสู่ระบบ และเพิ่มที่นั่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS, %@ uygulamasını oturum açma ögelerinize eklemedi. Sistem Ayarları, sonra Genel, sonra Giriş Öğeleri açın ve oradan ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS не додав %@ до об’єктів входу. Відкрийте Системні параметри, потім Загальні, потім Об’єкти входу, і додайте його там."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS không thêm %@ vào các mục đăng nhập của bạn. Hãy mở Cài đặt hệ thống, rồi Cài đặt chung, rồi Mục đăng nhập, và thêm ở đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 未把 %@ 添加到你的登录项。请打开“系统设置”，然后是“通用”，再到“登录项”，在那里添加。"
          }
        }
      }
    },
    "macOS wrote %@. It is not sent anywhere automatically. Attach it to your message if you can.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كتب macOS الملف %@. ولا يُرسل تلقائيًا إلى أي جهة. أرفقه برسالتك إن استطعت."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS записа %@. Той не се изпраща никъде автоматично. Прикачете го към съобщението си, ако можете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
