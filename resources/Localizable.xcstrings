          "stringUnit": {
            "state": "translated",
            "value": "Öppna krypterade enheter i macOS"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดไดรฟ์ที่เข้ารหัสบน macOS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS'te şifreli sürücüleri açın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкривайте зашифровані диски в macOS"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở ổ đĩa được mã hóa trên macOS"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 macOS 上打开加密驱动器"
          }
        }
      }
    },
    "Open it read-only to copy files out, or back it up first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتحه للقراءة فقط لنسخ الملفات منه، أو خذ نسخة احتياطية أولًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворете го само за четене, за да копирате файлове навън, или първо направете резервно копие."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete jej pouze pro čtení a zkopírujte soubory ven, nebo si jej nejprve zazálohujte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn det skrivebeskyttet for at kopiere filer ud, eller tag en sikkerhedskopi først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne es schreibgeschützt, um Dateien herauszukopieren, oder sichere es vorher."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε το μόνο για ανάγνωση για να αντιγράψετε αρχεία έξω, ή κρατήστε πρώτα αντίγραφο ασφαλείας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ábrela en modo de solo lectura para copiar archivos, o haz antes una copia de seguridad."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava see kirjutuskaitstuna, et failid välja kopeerida, või tee enne varukoopia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa se vain luettavaksi kopioidaksesi tiedostot ulos, tai tee ensin varmuuskopio."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ito nang read-only para makopya palabas ang mga file, o mag-backup muna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez-la en lecture seule pour en copier les fichiers, ou sauvegardez-la d’abord."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתחו אותה לקריאה בלבד כדי להעתיק קבצים החוצה, או גבו אותה תחילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलें बाहर कॉपी करने के लिए इसे केवल पढ़ने के लिए खोलें, या पहले इसका बैकअप लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite je samo za čitanje da biste iskopirali datoteke ili je prije toga sigurnosno kopirajte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyissa meg írásvédetten a fájlok kimásolásához, vagy előbb készítsen róla biztonsági másolatot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka baca-saja untuk menyalin berkas keluar, atau cadangkan dulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprila in sola lettura per copiarne i file, oppure falla prima un backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを取り出すには読み出し専用で開くか、先にバックアップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 밖으로 복사하려면 읽기 전용으로 열거나, 먼저 백업하십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atverkite jį tik skaitymui, kad nukopijuotumėte failus, arba pirma pasidarykite atsarginę kopiją."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atveriet to tikai lasīšanai, lai izkopētu failus, vai vispirms izveidojiet dublējumu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bukanya baca-sahaja untuk menyalin fail keluar, atau sandarkannya dahulu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne det skrivebeskyttet for å kopiere ut filer, eller ta en sikkerhetskopi først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open die als alleen-lezen om bestanden eruit te kopiëren, of maak er eerst een reservekopie van."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz go tylko do odczytu, aby skopiować pliki na zewnątrz, albo najpierw wykonaj kopię zapasową."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra-a apenas para leitura para copiar os ficheiros, ou faça primeiro uma cópia de segurança."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți-o în regim de doar-citire pentru a copia fișierele sau faceți întâi o copie de siguranță."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте его только для чтения, чтобы скопировать файлы наружу, или сначала сделайте резервную копию."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odprite jo samo za branje in prekopirajte datoteke ven ali pa jo najprej varnostno kopirajte."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Hape si vetëm-lexim për të kopjuar skedarët jashtë, ose bëj fillimisht një kopje rezervë."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna den skrivskyddad för att kopiera ut filer, eller säkerhetskopiera den först."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดแบบอ่านอย่างเดียวเพื่อคัดลอกไฟล์ออกมา หรือสำรองข้อมูลไว้ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyaları dışarı kopyalamak için salt okunur açın ya da önce yedekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте його лише для читання, щоб скопіювати файли назовні, або спершу зробіть резервну копію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy mở ở chế độ chỉ đọc để chép tệp ra, hoặc sao lưu trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以只读方式打开它来拷出文件，或先做个备份。"
          }
        }
      }
    },
