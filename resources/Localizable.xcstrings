            "value": "Pavadinimas"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosaukums"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naam"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namnet"
          }
        }
      }
    },
    "The passphrase this drive was encrypted with.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Паролата-фраза, с която този диск е шифрован."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgangssætningen, som denne enhed blev krypteret med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Passphrase, mit der dieses Laufwerk verschlüsselt wurde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φράση πρόσβασης με την οποία κρυπτογραφήθηκε αυτός ο δίσκος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La frase de contraseña con la que se cifró este disco."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paroolifraas, millega see ketas krüpteeriti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salauslause, jolla tämä asema salattiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La phrase secrète avec laquelle ce disque a été chiffré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La passphrase con cui è stato cifrato questo disco."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaptafrazė, kuria šis diskas buvo užšifruotas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paroles frāze, ar kuru šis disks tika šifrēts."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wachtwoordzin waarmee deze schijf is versleuteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasło dostępu, którym zaszyfrowano ten dysk."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A frase-passe com que este disco foi encriptado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösenfrasen som den här enheten krypterades med."
          }
        }
      }
    },
    "The password the drive was locked with, or a 48-digit BitLocker recovery key. Spaces and hyphens in a recovery key are ignored.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Паролата, с която дискът е заключен, или 48-цифрен ключ за възстановяване на BitLocker. Интервалите и тиретата в ключа се пренебрегват."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgangskoden, som enheden blev låst med, eller en 48-cifret BitLocker-genoprettelsesnøgle. Mellemrum og bindestreger i en genoprettelsesnøgle ignoreres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort, mit dem das Laufwerk gesperrt wurde, oder ein 48-stelliger BitLocker-Wiederherstellungsschlüssel. Leerzeichen und Bindestriche im Wiederherstellungsschlüssel werden ignoriert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το συνθηματικό με το οποίο κλειδώθηκε ο δίσκος ή ένα 48ψήφιο κλειδί ανάκτησης BitLocker. Τα κενά και οι παύλες στο κλειδί ανάκτησης αγνοούνται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña con la que se bloqueó el disco, o una clave de recuperación de BitLocker de 48 dígitos. Los espacios y guiones de una clave de recuperación se ignoran."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Parool, millega ketas lukustati, või 48-kohaline BitLockeri taastevõti. Taastevõtme tühikuid ja sidekriipse eiratakse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salasana, jolla asema lukittiin, tai 48-numeroinen BitLocker-palautusavain. Palautusavaimen välilyönnit ja väliviivat jätetään huomiotta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe avec lequel le disque a été verrouillé, ou une clé de récupération BitLocker à 48 chiffres. Les espaces et les traits d’union d’une clé de récupération sont ignorés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La password con cui il disco è stato bloccato, oppure una chiave di recupero BitLocker di 48 cifre. Gli spazi e i trattini nella chiave di recupero vengono ignorati."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaptažodis, kuriuo diskas buvo užrakintas, arba 48 skaitmenų „BitLocker“ atkūrimo raktas. Tarpai ir brūkšneliai atkūrimo rakte nepaisomi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parole, ar kuru disks tika bloķēts, vai 48 ciparu BitLocker atkopšanas atslēga. Atstarpes un defises atkopšanas atslēgā tiek ignorētas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wachtwoord waarmee de schijf is vergrendeld, of een BitLocker-herstelsleutel van 48 cijfers. Spaties en streepjes in een herstelsleutel worden genegeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasło, którym zablokowano dysk, albo 48-cyfrowy klucz odzyskiwania BitLocker. Spacje i myślniki w kluczu odzyskiwania są pomijane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A palavra-passe com que o disco foi bloqueado, ou uma chave de recuperação do BitLocker de 48 dígitos. Os espaços e hífenes de uma chave de recuperação são ignorados."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösenordet som enheten låstes med, eller en 48-siffrig BitLocker-återställningsnyckel. Mellanslag och bindestreck i en återställningsnyckel ignoreras."
          }
        }
      }
    },
    "The virtualisation engine could not start. A restart usually clears this.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Двигателят за виртуализация не можа да стартира. Рестартирането обикновено решава това."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualiseringsmotoren kunne ikke starte. En genstart løser det som regel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Virtualisierungs-Engine konnte nicht starten. Ein Neustart behebt das meistens."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μηχανή εικονικοποίησης δεν μπόρεσε να ξεκινήσει. Μια επανεκκίνηση συνήθως το λύνει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor de virtualización no ha podido arrancar. Reiniciar suele solucionarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualiseerimismootor ei saanud käivituda. Taaskäivitus lahendab selle tavaliselt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualisointimoottori ei käynnistynyt. Uudelleenkäynnistys yleensä korjaa tämän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur de virtualisation n’a pas pu démarrer. Un redémarrage suffit généralement à corriger cela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore di virtualizzazione non è riuscito ad avviarsi. Di solito basta un riavvio."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualizavimo variklis negalėjo pasileisti. Paprastai tai išsprendžia paleidimas iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualizācijas dzinējs nevarēja startēt. Parasti palīdz pārstartēšana."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De virtualisatie-engine kon niet starten. Opnieuw opstarten lost dit meestal op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Silnik wirtualizacji nie mógł się uruchomić. Zwykle pomaga ponowne uruchomienie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor de virtualização não conseguiu arrancar. Reiniciar costuma resolver."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualiseringsmotorn kunde inte starta. En omstart brukar lösa det."
          }
        }
      }
    },
    "They stay in Finder after %@ quits. Eject them there whenever you are finished.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Те остават във Finder, след като %@ приключи. Извадете ги оттам, когато сте готови."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De bliver i Finder, efter at %@ er sluttet. Skub dem ud derfra, når du er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie bleiben nach dem Beenden von %@ im Finder. Wirf sie dort aus, wenn du fertig bist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παραμένουν στο Finder αφού τερματιστεί το %@. Κάντε εξαγωγή από εκεί όταν τελειώσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanecen en el Finder después de salir de %@. Expúlsalos allí cuando termines."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Nad jäävad Finderisse pärast seda, kui %@ väljub. Väljuta nad sealt, kui oled lõpetanud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne jäävät Finderiin sen jälkeen, kun %@ lopetetaan. Poista ne sieltä käytöstä, kun olet valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils restent dans le Finder après la fermeture de %@. Éjectez-les depuis le Finder lorsque vous avez terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restano nel Finder dopo la chiusura di %@. Espellili da lì quando hai finito."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jie lieka „Finder“ programoje, kai %@ baigia darbą. Išstumkite juos ten, kai baigsite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tie paliek programmā Finder pēc tam, kad %@ ir aizvērta. Izstumiet tos tur, kad esat pabeidzis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze blijven in de Finder staan nadat %@ is gestopt. Verwijder ze daar wanneer je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostają w Finderze po zakończeniu programu %@. Wysuń je stamtąd, gdy skończysz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanecem no Finder depois de o %@ sair. Ejete-os aí quando terminar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De finns kvar i Finder efter att %@ avslutats. Mata ut dem där när du är klar."
          }
        }
      }
    },
    "Third-Party Notices": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Известия за софтуер на трети страни"
          }
        },
        "da": {
