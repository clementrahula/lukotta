    "No reason was reported. The details below may say more.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не беше посочена причина. Подробностите по-долу може да кажат повече."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke oplyst nogen årsag. Oplysningerne nedenfor siger måske mere."
