        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede haber unos diez discos desbloqueados a la vez"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une dizaine de disques peuvent rester déverrouillés en même temps"
          }
        }
      }
    },
    "Administrator password": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Administratorpasswort"
          }
