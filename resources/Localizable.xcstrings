    "macOS blocked access to the drive. %@ needs Full Disk Access before it can read an encrypted disk.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منع macOS الوصول إلى المحرّك. يحتاج %@ إلى الوصول الكامل إلى القرص قبل أن يستطيع قراءة قرص مشفّر."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS блокира достъпа до диска. %@ се нуждае от „Full Disk Access“, за да може да чете шифрован диск."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS zablokoval přístup k disku. %@ potřebuje plný přístup k disku, aby mohl číst šifrovaný disk."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS blokerede adgangen til enheden. %@ har brug for fuld adgang til disk for at kunne læse en krypteret disk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat den Zugriff auf das Laufwerk blockiert. %@ benötigt Festplattenvollzugriff, um eine verschlüsselte Festplatte lesen zu können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το macOS απέκλεισε την πρόσβαση στον δίσκο. Το %@ χρειάζεται «Πλήρης πρόσβαση στον δίσκο» για να μπορεί να διαβάσει κρυπτογραφημένο δίσκο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha bloqueado el acceso al disco. %@ necesita Acceso total al disco para poder leer un disco cifrado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS blokeeris ligipääsu kettale. %@ vajab õigust „Full Disk Access“, et krüpteeritud ketast lugeda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS esti pääsyn asemaan. %@ tarvitsee koko levyn käyttöoikeuden, jotta se voi lukea salattua levyä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinarangan ng macOS ang pag-access sa drive. Kailangan ng %@ ng Full Disk Access bago nito mabasa ang naka-encrypt na disk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a bloqué l’accès au disque. %@ a besoin de l’accès complet au disque pour pouvoir lire un disque chiffré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏macOS חסם את הגישה לכונן. ‏%@ זקוק לגישה מלאה לדיסק כדי לקרוא דיסק מוצפן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ने ड्राइव तक पहुँच रोक दी। एन्क्रिप्टेड डिस्क पढ़ने के लिए %@ को पूर्ण डिस्क ऐक्सेस चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS je blokirao pristup disku. %@ treba puni pristup disku kako bi mogao čitati šifrirani disk."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A macOS letiltotta a meghajtóhoz való hozzáférést. A(z) %@ programnak teljes hozzáférés kell a lemezhez, hogy titkosított lemezt olvashasson."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS memblokir akses ke drive. %@ memerlukan Akses Disk Penuh sebelum dapat membaca disk terenkripsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha bloccato l’accesso al disco. %@ necessita dell’accesso completo al disco per poter leggere un disco cifrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS がドライブへのアクセスを拒否しました。暗号化されたディスクを読むには、%@ に「フルディスクアクセス」が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 드라이브 접근을 차단했습니다. 암호화된 디스크를 읽으려면 %@에 전체 디스크 접근 권한이 필요합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„macOS“ užblokavo prieigą prie disko. %@ reikia leidimo „Full Disk Access“, kad galėtų skaityti užšifruotą diską."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bloķēja piekļuvi diskam. %@ ir nepieciešama atļauja “Full Disk Access”, lai varētu lasīt šifrētu disku."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS menyekat akses kepada pemacu. %@ memerlukan Akses Cakera Penuh sebelum ia boleh membaca cakera bersulit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS blokkerte tilgangen til enheten. %@ trenger full disktilgang for å kunne lese en kryptert disk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS heeft de toegang tot de schijf geblokkeerd. %@ heeft volledige schijftoegang nodig om een versleutelde schijf te kunnen lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS zablokował dostęp do dysku. %@ potrzebuje pełnego dostępu do dysku, aby móc odczytać zaszyfrowany dysk."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS bloqueou o acesso ao disco. O %@ precisa de acesso completo ao disco para poder ler um disco encriptado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a blocat accesul la disc. %@ are nevoie de acces complet la disc pentru a putea citi un disc criptat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS заблокировал доступ к диску. %@ нужен Полный доступ к диску, чтобы читать зашифрованный диск."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS je zavrnil dostop do pogona. %@ potrebuje poln dostop do diska, da lahko prebere šifriran disk."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bllokoi hyrjen te disku. %@ ka nevojë për Full Disk Access përpara se të lexojë një disk të enkriptuar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS blockerade åtkomsten till enheten. %@ behöver full skivtillgång för att kunna läsa en krypterad disk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ปิดกั้นการเข้าถึงไดรฟ์ %@ ต้องมี การเข้าถึงดิสก์เต็มรูปแบบ ก่อนจึงจะอ่านดิสก์ที่เข้ารหัสได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS sürücüye erişimi engelledi. %@ şifreli bir diski okuyabilmek için Tam Disk Erişimi iznine ihtiyaç duyar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS заблокував доступ до диска. %@ потрібен Повний доступ до диска, щоб читати зашифрований диск."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS đã chặn truy cập vào ổ đĩa. %@ cần Toàn quyền truy cập đĩa mới đọc được đĩa mã hóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 阻止了对驱动器的访问。%@ 需要“完全磁盘访问权限”才能读取加密磁盘。"
