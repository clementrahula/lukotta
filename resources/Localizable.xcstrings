    "Unlock uses it directly. Forget it to type a different one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wird direkt zum Entsperren verwendet. Vergiss ihn, um einen anderen einzugeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le déverrouillage l’utilise directement. Oubliez-la pour en saisir une autre."
          }
        }
      }
    },
    "Unlock “%@”": {
