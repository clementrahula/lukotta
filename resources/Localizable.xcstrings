    "“%@” could not be read.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ не можа да бъде прочетен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ se nepodařilo přečíst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” kunne ikke læses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ konnte nicht gelesen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η ανάγνωση του «%@»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer «%@»."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ei õnnestunud lugeda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” ei voitu lukea."
          }
        },
        "fr": {
