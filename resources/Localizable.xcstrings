          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "FileVault i šifrirane slike diskova, koje macOS otvara sam"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A FileVault és a titkosított lemezképek, amelyeket a macOS maga nyit meg"
