        }
      }
    },
    "Windows NTFS drives, including ones Windows left hibernated or not shut down properly": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "NTFS дискове на Windows, включително оставените от Windows в хибернация или неизключени правилно"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Disky NTFS z Windows, včetně těch, které Windows nechal v režimu spánku nebo řádně nevypnul"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "NTFS-enheder fra Windows, også dem Windows efterlod i dvale eller ikke lukkede korrekt ned"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows-NTFS-Laufwerke, auch solche, die Windows im Ruhezustand oder nicht ordnungsgemäß heruntergefahren hinterlassen hat"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δίσκοι NTFS των Windows, ακόμη και όσοι έμειναν σε αδρανοποίηση ή δεν τερματίστηκαν σωστά"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Discos NTFS de Windows, incluidos los que Windows dejó hibernados o mal apagados"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Windowsi NTFS-kettad, sealhulgas need, mille Windows jättis talveunne või korralikult sulgemata"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Windowsin NTFS-asemat, myös ne jotka Windows jätti lepotilaan tai sammutti huonosti"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les disques NTFS Windows, y compris ceux que Windows a laissés en veille prolongée ou mal arrêtés"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows NTFS diskovi, uključujući one koje je Windows ostavio u hibernaciji ili nije uredno isključio"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows NTFS-meghajtók, azokat is beleértve, amelyeket a Windows hibernálva vagy szabálytalanul leállítva hagyott"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dischi NTFS di Windows, compresi quelli lasciati da Windows in ibernazione o spenti male"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Windows“ NTFS diskai, įskaitant tuos, kuriuos „Windows“ paliko užmigdytus arba netinkamai išjungė"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows NTFS diski, tostarp tie, ko Windows atstāja hibernācijā vai neizslēdza pareizi"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "NTFS-enheter fra Windows, også de Windows forlot i dvale eller ikke slo ordentlig av"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NTFS-schijven van Windows, ook die Windows in slaapstand of niet correct afgesloten heeft achtergelaten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyski NTFS systemu Windows, także te pozostawione w hibernacji lub niepoprawnie zamknięte"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Discos NTFS do Windows, incluindo os que o Windows deixou hibernados ou mal encerrados"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Discuri NTFS Windows, inclusiv cele lăsate de Windows în hibernare sau oprite necorespunzător"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogoni NTFS iz Windows, tudi tisti, ki jih je Windows pustil v mirovanju ali jih ni pravilno zaustavil"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "NTFS-enheter från Windows, även sådana som Windows lämnat i viloläge eller inte stängt av ordentligt"
          }
        }
      }
    },
    "Windows is part-way through encrypting or decrypting this drive. Open it in Windows and let BitLocker finish, then try again.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows е по средата на шифроването или дешифроването на този диск. Отворете го в Windows и оставете BitLocker да завърши, след което опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows je uprostřed šifrování nebo dešifrování tohoto disku. Otevřete jej ve Windows a nechte BitLocker dokončit práci, pak to zkuste znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows er midt i at kryptere eller dekryptere denne disk. Åbn den i Windows, og lad BitLocker gøre færdig, og prøv så igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows ist mitten dabei, dieses Laufwerk zu verschlüsseln oder zu entschlüsseln. Öffne es in Windows und lass BitLocker fertig werden, dann versuch es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα Windows βρίσκονται στη μέση της κρυπτογράφησης ή της αποκρυπτογράφησης αυτού του δίσκου. Ανοίξτε τον στα Windows και αφήστε το BitLocker να τελειώσει, και μετά δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows está a medias cifrando o descifrando este disco. Ábrelo en Windows y deja que BitLocker termine; después inténtalo de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows on selle ketta krüptimise või dekrüptimise poole peal. Ava see Windowsis ja lase BitLockeril lõpetada, seejärel proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows on kesken tämän levyn salaamisen tai salauksen purkamisen. Avaa levy Windowsissa ja anna BitLockerin tehdä työ loppuun, yritä sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows est en train de chiffrer ou de déchiffrer ce disque. Ouvrez-le dans Windows et laissez BitLocker terminer, puis réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows je usred šifriranja ili dešifriranja ovog diska. Otvorite ga u Windowsima i pustite BitLocker da dovrši, pa pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Windows épp titkosítja vagy visszafejti ezt a lemezt. Nyissa meg Windowsban, hagyja, hogy a BitLocker befejezze, azután próbálja újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows sta cifrando o decifrando questo disco e non ha finito. Aprilo in Windows e lascia che BitLocker completi il lavoro, poi riprova."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Windows“ šiuo metu šifruoja arba iššifruoja šį diską. Atverkite jį „Windows“ sistemoje ir leiskite „BitLocker“ baigti, tada bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows pašlaik šifrē vai atšifrē šo disku. Atveriet to Windows vidē un ļaujiet BitLocker pabeigt, pēc tam mēģiniet vēlreiz."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows er midt i å kryptere eller dekryptere denne disken. Åpne den i Windows og la BitLocker bli ferdig, og prøv så igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows is halverwege het versleutelen of ontsleutelen van deze schijf. Open die in Windows en laat BitLocker afmaken, probeer het daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows jest w trakcie szyfrowania lub odszyfrowywania tego dysku. Otwórz go w systemie Windows i pozwól funkcji BitLocker dokończyć, a potem spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Windows está a meio de cifrar ou decifrar este disco. Abra-o no Windows e deixe o BitLocker terminar, e depois tente de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows este la jumătatea criptării sau decriptării acestui disc. Deschideți-l în Windows și lăsați BitLocker să termine, apoi încercați din nou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows je sredi šifriranja ali dešifriranja tega diska. Odprite ga v Windowsih in pustite BitLockerju, da konča, nato poskusite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows håller på att kryptera eller dekryptera den här disken. Öppna den i Windows och låt BitLocker bli klart, försök sedan igen."
          }
        }
      }
    },
    "Writing to this format is untested and may still have faults, so writing to it is at your own risk. Open it read-only to copy files out safely, or make a backup first.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Записът в този формат не е тестван и може да съдържа грешки, затова записвате на свой риск. Отворете файла само за четене, за да копирате от него безопасно, или първо направете резервно копие."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zápis do tohoto formátu není otestovaný a může mít chyby, takže píšete na vlastní riziko. Otevřete soubor jen ke čtení, abyste z něj bezpečně kopírovali, nebo si nejdřív udělejte zálohu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At skrive til dette format er utestet og kan have fejl, så du skriver på eget ansvar. Åbn filen kun til læsning for at kopiere sikkert fra den, eller tag en sikkerhedskopi først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Schreiben in dieses Format ist ungetestet und kann Fehler haben, du schreibst also auf eigenes Risiko. Öffne die Datei nur lesend, um sicher daraus zu kopieren, oder lege zuerst eine Sicherungskopie an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εγγραφή σε αυτή τη μορφή δεν έχει δοκιμαστεί και μπορεί να έχει σφάλματα, οπότε γράφετε με δική σας ευθύνη. Ανοίξτε το αρχείο μόνο για ανάγνωση για να αντιγράψετε με ασφάλεια, ή κρατήστε πρώτα αντίγραφο ασφαλείας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura en este formato no está probada y puede tener fallos, así que escribes bajo tu propia responsabilidad. Ábrelo en solo lectura para copiar archivos con seguridad, o haz antes una copia de seguridad."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sellesse vormingusse kirjutamine on testimata ja võib vigu sisaldada, seega kirjutad omal vastutusel. Ava fail ainult lugemiseks, et sellest turvaliselt kopeerida, või tee enne varukoopia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähän muotoon kirjoittamista ei ole testattu ja siinä voi olla vikoja, joten kirjoitat omalla vastuullasi. Avaa tiedosto vain luettavaksi kopioidaksesi siitä turvallisesti, tai ota ensin varmuuskopio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écriture dans ce format n’est pas testée et peut comporter des défauts : vous écrivez à vos propres risques. Ouvrez le fichier en lecture seule pour en copier le contenu sans risque, ou faites d’abord une sauvegarde."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisanje u ovaj format nije testirano i može imati greške, pa pišete na vlastitu odgovornost. Otvorite datoteku samo za čitanje kako biste iz nje sigurno kopirali, ili prvo napravite sigurnosnu kopiju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ebbe a formátumba írás nincs tesztelve, és hibái lehetnek, tehát saját felelősségre ír. Nyissa meg a fájlt csak olvasásra a biztonságos másoláshoz, vagy készítsen előbb biztonsági másolatot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scrittura in questo formato non è collaudata e può avere difetti, quindi scrivi a tuo rischio. Apri il file in sola lettura per copiarne il contenuto in sicurezza, o fai prima una copia di riserva."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rašymas šiuo formatu neišbandytas ir gali turėti klaidų, todėl rašote savo rizika. Atverkite failą tik skaitymui, kad saugiai iš jo nukopijuotumėte, arba pirma pasidarykite atsarginę kopiją."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakstīšana šajā formātā nav pārbaudīta un var saturēt kļūdas, tāpēc rakstāt uz savu atbildību. Atveriet failu tikai lasīšanai, lai no tā droši kopētu, vai vispirms izveidojiet rezerves kopiju."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriving til dette formatet er utestet og kan ha feil, så du skriver på eget ansvar. Åpne filen kun for lesing for å kopiere trygt fra den, eller ta en sikkerhetskopi først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijven naar dit formaat is ongetest en kan fouten bevatten, dus je schrijft op eigen risico. Open het bestand alleen-lezen om er veilig uit te kopiëren, of maak eerst een reservekopie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapis w tym formacie nie jest przetestowany i może mieć błędy, więc zapisujesz na własne ryzyko. Otwórz plik tylko do odczytu, aby bezpiecznie skopiować z niego dane, albo najpierw zrób kopię zapasową."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A escrita neste formato não está testada e pode ter falhas, pelo que escreve por sua conta e risco. Abra o ficheiro apenas para leitura para copiar com segurança, ou faça primeiro uma cópia de segurança."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrierea în acest format nu este testată și poate avea defecte, așa că scrieți pe propriul risc. Deschideți fișierul doar pentru citire pentru a copia în siguranță, sau faceți mai întâi o copie de siguranță."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisanje v ta zapis ni preizkušeno in ima lahko napake, zato pišete na lastno odgovornost. Datoteko odprite samo za branje, da iz nje varno kopirate, ali pa najprej naredite varnostno kopijo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivning till det här formatet är otestad och kan ha fel, så du skriver på egen risk. Öppna filen skrivskyddad för att kopiera ur den säkert, eller ta en säkerhetskopia först."
          }
        }
      }
    },
    "You can read and write files on it.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете да четете и записвате файлове на него."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete na něm číst a zapisovat soubory."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan læse og skrive arkiver på den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst Dateien darauf lesen und schreiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να διαβάζετε και να γράφετε αρχεία σε αυτόν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes leer y escribir archivos en él."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa saad sellele faile lugeda ja kirjutada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit lukea ja kirjoittaa siihen tiedostoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez y lire et y écrire des fichiers."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na njemu možete čitati i zapisivati datoteke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvashat és írhat rajta fájlokat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi leggere e scrivere file al suo interno."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jame galite skaityti ir rašyti failus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūs varat tajā lasīt un rakstīt failus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan lese og skrive filer på den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt er bestanden op lezen en schrijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz na nim odczytywać i zapisywać pliki."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ler e escrever ficheiros nele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți citi și scrie fișiere pe el."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na njem lahko berete in zapisujete datoteke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan läsa och skriva filer på den."
          }
        }
      }
    },
    "You can read files on it. It was opened read-only, so nothing can be written to it.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете да четете файловете на него. Беше отворен само за четене, така че нищо не може да бъде записано."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete číst soubory na tomto disku. Byl otevřen jen ke čtení, takže na něj nelze nic zapsat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan læse filer på den. Den blev åbnet kun til læsning, så der kan ikke skrives noget til den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst Dateien darauf lesen. Es wurde nur lesend geöffnet, sodass nichts darauf geschrieben werden kann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να διαβάσετε τα αρχεία του. Άνοιξε μόνο για ανάγνωση, οπότε δεν μπορεί να γραφτεί τίποτα σε αυτό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes leer los archivos que contiene. Se abrió en solo lectura, así que no se puede escribir nada en él."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saad selle faile lugeda. See avati ainult lugemiseks, seega sinna kirjutada ei saa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit lukea sen tiedostoja. Se avattiin vain luettavaksi, joten siihen ei voi kirjoittaa mitään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez lire les fichiers qu’il contient. Il a été ouvert en lecture seule, rien ne peut donc y être écrit."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete čitati datoteke na njemu. Otvoren je samo za čitanje, pa se na njega ništa ne može zapisati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvashatja a rajta lévő fájlokat. Csak olvasásra nyílt meg, így semmi nem írható rá."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi leggere i file che contiene. È stato aperto in sola lettura, quindi non vi si può scrivere nulla."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Galite skaityti jame esančius failus. Jis atvertas tik skaitymui, todėl į jį nieko įrašyti negalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varat lasīt tajā esošos failus. Tas tika atvērts tikai lasīšanai, tāpēc tajā neko nevar ierakstīt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan lese filene på den. Den ble åpnet kun for lesing, så ingenting kan skrives til den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt de bestanden erop lezen. De schijf is alleen-lezen geopend, dus er kan niets naar worden geschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz czytać znajdujące się na nim pliki. Został otwarty tylko do odczytu, więc nic nie da się na nim zapisać."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ler os ficheiros que contém. Foi aberto apenas para leitura, pelo que nada lhe pode ser escrito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți citi fișierele de pe el. A fost deschis doar pentru citire, așa că nu se poate scrie nimic pe el."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteke na njem lahko berete. Odprt je bil samo za branje, zato nanj ni mogoče ničesar zapisati."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan läsa filerna på den. Den öppnades skrivskyddad, så ingenting kan skrivas till den."
          }
        }
      }
    },
    "You can still check whenever you like.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пак можете да проверявате, когато пожелаете."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhledávat můžete i nadále kdykoli sami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan stadig selv søge, når du vil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst weiterhin jederzeit selbst suchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε πάντα να ελέγχετε όποτε θέλετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes buscarlas manualmente cuando quieras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa saad ikka ise kontrollida, millal soovid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit silti tarkistaa milloin haluat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez toujours vérifier quand vous le souhaitez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "I dalje možete provjeriti kad god želite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bármikor kereshet frissítést saját maga is."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi comunque cercarli quando vuoi."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis tiek galite tikrinti kada panorėję."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūs joprojām varat meklēt, kad vien vēlaties."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fortsatt søke selv når du vil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt nog steeds zelf zoeken wanneer je wilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadal możesz sprawdzać samodzielnie, kiedy zechcesz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode continuar a procurar quando quiser."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți căuta oricând și singur."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Še vedno lahko preverite, kadar želite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fortfarande söka själv när du vill."
          }
        }
      }
    },
