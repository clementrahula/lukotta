    "Unlock uses it directly. Forget it to type a different one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wird direkt zum Entsperren verwendet. Vergiss ihn, um einen anderen einzugeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El desbloqueo la usa directamente. Olvídala para escribir otra."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Avamine kasutab seda otse. Unusta see, kui soovid sisestada teise."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaaminen käyttää sitä suoraan. Unohda se, jos haluat kirjoittaa toisen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le déverrouillage l’utilise directement. Oubliez-la pour en saisir une autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo sblocco la usa direttamente. Dimenticala per inserirne un’altra."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atbloķēšana to izmanto tieši. Aizmirstiet to, lai ievadītu citu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendelen gebruikt die direct. Vergeet die om een andere in te voeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokowanie używa go bezpośrednio. Zapomnij go, aby wpisać inny."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O desbloqueio usa-a diretamente. Esqueça-a para introduzir outra."
          }
        }
      }
    },
