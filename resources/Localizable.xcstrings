    "Unlock uses it directly. Forget it to type a different one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدمه إلغاء القفل مباشرةً. انسه لكتابة مفتاح آخر."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключването го използва директно. Забравете го, за да въведете друг."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odemknutí jej použije přímo. Zapomeňte jej, chcete‑li zadat jiný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oplåsningen bruger den direkte. Glem den for at skrive en anden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wird direkt zum Entsperren verwendet. Vergiss ihn, um einen anderen einzugeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ξεκλείδωμα το χρησιμοποιεί απευθείας. Διαγράψτε το για να πληκτρολογήσετε άλλο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El desbloqueo la usa directamente. Olvídala para escribir otra."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Avamine kasutab seda otse. Unusta see, kui soovid sisestada teise."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaaminen käyttää sitä suoraan. Unohda se, jos haluat kirjoittaa toisen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginagamit ito nang tuwiran ng I-unlock. Kalimutan ito para makapaglagay ng iba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le déverrouillage l’utilise directement. Oubliez-la pour en saisir une autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול נעילה משתמש בו ישירות. שכחו אותו כדי להקליד אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनलॉक करें उसे सीधे इस्तेमाल करता है। कोई और डालने के लिए उसे भुला दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otključavanje ga koristi izravno. Zaboravite ga kako biste unijeli drugi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A feloldás közvetlenül ezt használja. Felejtse el, ha másikat szeretne megadni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Kunci memakainya langsung. Lupakan untuk mengetik yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo sblocco la usa direttamente. Dimenticala per inserirne un’altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ロック解除」はそれをそのまま使います。別のものを入力するには忘れさせてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 해제는 그것을 그대로 사용합니다. 다른 것을 입력하려면 잊게 하십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrakinimas naudoja jį tiesiogiai. Pamirškite jį, kad įvestumėte kitą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atbloķēšana to izmanto tieši. Aizmirstiet to, lai ievadītu citu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Kunci menggunakannya terus. Lupakannya untuk menaip yang lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opplåsingen bruker den direkte. Glem den for å skrive inn en annen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendelen gebruikt die direct. Vergeet die om een andere in te voeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokowanie używa go bezpośrednio. Zapomnij go, aby wpisać inny."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O desbloqueio usa-a diretamente. Esqueça-a para introduzir outra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deblocarea o folosește direct. Uitați-o pentru a introduce alta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Разблокировать» использует его напрямую. Забудьте его, чтобы ввести другой."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odklep ga uporabi neposredno. Pozabite ga, če želite vnesti drugega."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shkyçja e përdor drejtpërdrejt. Harroje për të shkruar një tjetër."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upplåsningen använder den direkt. Glöm den om du vill skriva in en annan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลดล็อก จะใช้คีย์นั้นโดยตรง ลืมมันเพื่อพิมพ์คีย์อื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilidi Aç onu doğrudan kullanır. Başka bir tane yazmak için unutturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Розблокувати» використовує його напряму. Забудьте його, щоб ввести інший."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
