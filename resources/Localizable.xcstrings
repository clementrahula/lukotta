    "“%@” had stopped responding and was disconnected. You can open it again.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ спря да отговаря и беше изключен. Можете да го отворите отново."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” svarede ikke længere og blev frakoblet. Du kan åbne den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ hat nicht mehr reagiert und wurde getrennt. Du kannst es erneut öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» σταμάτησε να αποκρίνεται και αποσυνδέθηκε. Μπορείτε να το ανοίξετε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» había dejado de responder y se desconectó. Puedes volver a abrirlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ei vastanud enam ja ühendati lahti. Sa saad selle uuesti avada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” lakkasi vastaamasta ja irrotettiin. Voit avata sen uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne répondait plus et a été déconnecté. Vous pouvez l’ouvrir à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» non rispondeva più ed è stato scollegato. Puoi aprirlo di nuovo."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ nustojo atsakyti ir buvo atjungtas. Galite jį atverti dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” pārstāja atbildēt un tika atvienots. Jūs varat to atvērt vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ reageerde niet meer en is losgekoppeld. Je kunt die opnieuw openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” przestał odpowiadać i został odłączony. Możesz otworzyć go ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» deixou de responder e foi desligado. Pode abri-lo novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” slutade svara och kopplades bort. Du kan öppna den igen."
          }
        }
      }
    },
