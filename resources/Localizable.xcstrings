    "“%@” was not shut down cleanly, and its most recent contents have not been written back into the file. Open it once in the virtual machine it belongs to, then try again.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ не беше изключен правилно и последното му съдържание не е записано обратно във файла. Отворете го веднъж във виртуалната машина, на която принадлежи, и опитайте отново."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ nebyl řádně vypnut a jeho poslední obsah nebyl zapsán zpět do souboru. Otevřete jej jednou ve virtuálním počítači, kterému patří, a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” blev ikke lukket ned korrekt, og dens seneste indhold er ikke skrevet tilbage til filen. Åbn den én gang i den virtuelle maskine, den hører til, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wurde nicht sauber heruntergefahren, und der zuletzt enthaltene Stand wurde nicht in die Datei zurückgeschrieben. Öffne sie einmal in der virtuellen Maschine, zu der sie gehört, und versuche es dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» δεν τερματίστηκε ομαλά και το πιο πρόσφατο περιεχόμενό του δεν γράφτηκε πίσω στο αρχείο. Ανοίξτε το μία φορά στην εικονική μηχανή στην οποία ανήκει και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no se apagó correctamente y su contenido más reciente no se ha escrito de vuelta en el archivo. Ábrelo una vez en la máquina virtual a la que pertenece y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ei suletud korralikult ja tema viimane sisu on faili tagasi kirjutamata. Ava see korra virtuaalmasinas, kuhu see kuulub, ja proovi siis uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” ei sammunut siististi, eikä sen viimeisintä sisältöä ole kirjoitettu takaisin tiedostoon. Avaa se kerran siinä virtuaalikoneessa, johon se kuuluu, ja yritä sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’a pas été arrêté proprement, et son contenu le plus récent n’a pas été réécrit dans le fichier. Ouvrez-le une fois dans la machine virtuelle à laquelle il appartient, puis réessayez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nije uredno isključen i njegov najnoviji sadržaj nije zapisan natrag u datoteku. Otvorite ga jednom u virtualnom stroju kojem pripada pa pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” nem állt le rendesen, és a legutóbbi tartalma nem került vissza a fájlba. Nyissa meg egyszer abban a virtuális gépben, amelyhez tartozik, majd próbálja újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» non è stato arrestato correttamente e il suo contenuto più recente non è stato riscritto nel file. Aprilo una volta nella macchina virtuale a cui appartiene, poi riprova."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ nebuvo tinkamai išjungtas ir naujausias jo turinys neįrašytas atgal į failą. Atverkite jį kartą virtualioje mašinoje, kuriai jis priklauso, ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” netika korekti izslēgts, un tā jaunākais saturs nav ierakstīts atpakaļ failā. Atveriet to vienreiz virtuālajā mašīnā, kurai tas pieder, un mēģiniet vēlreiz."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ble ikke avsluttet ordentlig, og det siste innholdet er ikke skrevet tilbake til filen. Åpne den én gang i den virtuelle maskinen den hører til, og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ is niet netjes afgesloten en de meest recente inhoud is niet teruggeschreven naar het bestand. Open het één keer in de virtuele machine waar het bij hoort en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nie został poprawnie zamknięty, a jego najnowsza zawartość nie została zapisana z powrotem do pliku. Otwórz go raz w maszynie wirtualnej, do której należy, i spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» não foi encerrado corretamente e o seu conteúdo mais recente não foi escrito de volta no ficheiro. Abra-o uma vez na máquina virtual a que pertence e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nu a fost închis corect, iar conținutul său cel mai recent nu a fost scris înapoi în fișier. Deschideți-l o dată în mașina virtuală căreia îi aparține, apoi încercați din nou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« ni bil pravilno zaustavljen in njegova najnovejša vsebina ni bila zapisana nazaj v datoteko. Odprite ga enkrat v navideznem računalniku, ki mu pripada, in poskusite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” stängdes inte av ordentligt, och dess senaste innehåll har inte skrivits tillbaka till filen. Öppna den en gång i den virtuella maskin den hör till och försök igen."
          }
        }
      }
    }
  },
  "version": "1.0"
}
