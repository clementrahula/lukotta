          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có lý do nào được báo. Chi tiết bên dưới có thể nói rõ hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未报告任何原因。下方的详细信息也许能说明更多。"
