    "Drives sealed to a TPM rather than a password, including Ubuntu's newer hardware-backed encryption": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дискове, обвързани с TPM вместо с парола, включително по-новото хардуерно шифроване на Ubuntu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheder bundet til en TPM i stedet for en adgangskode, herunder Ubuntus nyere hardwarekryptering"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufwerke, die an ein TPM statt an ein Passwort gebunden sind, einschließlich der neueren hardwaregestützten Verschlüsselung von Ubuntu"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δίσκοι δεμένοι με TPM αντί για συνθηματικό, όπως η νεότερη κρυπτογράφηση υλικού του Ubuntu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Discos sellados a un TPM en vez de a una contraseña, incluido el cifrado por hardware más reciente de Ubuntu"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kettad, mis on seotud TPM-iga parooli asemel, sealhulgas Ubuntu uuem riistvarapõhine krüpteering"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asemat, jotka on sidottu TPM-piiriin salasanan sijaan, mukaan lukien Ubuntun uudempi laitepohjainen salaus"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les disques scellés à un TPM plutôt qu’à un mot de passe, y compris le chiffrement matériel plus récent d’Ubuntu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dischi legati a un TPM anziché a una password, compresa la più recente cifratura basata su hardware di Ubuntu"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskai, susieti su TPM, o ne su slaptažodžiu, įskaitant naujesnį „Ubuntu“ aparatinį šifravimą"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diski, kas piesaistīti TPM, nevis parolei, tostarp Ubuntu jaunākā aparatūras šifrēšana"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schijven die aan een TPM zijn gekoppeld in plaats van aan een wachtwoord, waaronder de nieuwere hardwareversleuteling van Ubuntu"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyski powiązane z modułem TPM zamiast z hasłem, w tym nowsze szyfrowanie sprzętowe w Ubuntu"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Discos selados a um TPM em vez de a uma palavra-passe, incluindo a encriptação por hardware mais recente do Ubuntu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheter bundna till en TPM i stället för ett lösenord, inklusive Ubuntus nyare hårdvarukryptering"
          }
        }
      }
    },
