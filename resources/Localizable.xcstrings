            "value": "Site web"
          }
        }
      }
    },
    "Welcome to %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen bei %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue dans %@"
          }
        }
      }
    },
    "What a drive contains is only known once it is unlocked.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ein Laufwerk enthält, ist erst nach dem Entsperren bekannt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu d’un disque n’est connu qu’une fois celui-ci déverrouillé."
          }
        }
      }
    },
    "What happened": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist passiert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que s’est-il passé"
          }
        }
      }
    },
    "What happened?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist passiert?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que s’est-il passé ?"
          }
        }
      }
    },
    "What it can open": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was geöffnet werden kann"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu’il peut ouvrir"
          }
        }
      }
    },
    "What it cannot open": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was nicht geöffnet werden kann"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu’il ne peut pas ouvrir"
          }
