{
  "sourceLanguage": "en",
  "strings": {
    "%@ has been removed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde entfernt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ha eliminado"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on eemaldatud"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on poistettu"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été supprimé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stato rimosso"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ir noņemta"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is verwijderd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ został usunięty"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ foi removido"
          }
        }
      }
    },
    "%@ is free software under the GPL, version 3 or later. The mounting is done by anylinuxfs. Complete source for every component is published with each release. The name and the logo are trademarks, and are not covered by that licence.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist freie Software unter der GPL, Version 3 oder höher. Das Aktivieren übernimmt anylinuxfs. Der vollständige Quelltext jeder Komponente wird mit jeder Version veröffentlicht. Der Name und das Logo sind Marken und fallen nicht unter diese Lizenz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es software libre bajo la GPL, versión 3 o posterior. Del montaje se encarga anylinuxfs. El código fuente completo de cada componente se publica con cada versión. El nombre y el logotipo son marcas registradas y no están cubiertos por esa licencia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on vaba tarkvara GPL-litsentsi versiooni 3 või uuema alusel. Haakimise teeb anylinuxfs. Iga komponendi täielik lähtekood avaldatakse koos iga väljalaskega. Nimi ja logo on kaubamärgid ning need litsents ei hõlma."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on vapaa ohjelmisto GPL-lisenssin version 3 tai uudemman alaisuudessa. Käyttöönotosta huolehtii anylinuxfs. Jokaisen osan täydellinen lähdekoodi julkaistaan jokaisen version mukana. Nimi ja logo ovat tavaramerkkejä, eikä kyseinen lisenssi kata niitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est un logiciel libre sous licence GPL, version 3 ou ultérieure. Le montage est assuré par anylinuxfs. Le code source complet de chaque composant est publié à chaque version. Le nom et le logo sont des marques et ne sont pas couverts par cette licence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è software libero sotto licenza GPL, versione 3 o successiva. Il montaggio è svolto da anylinuxfs. Il codice sorgente completo di ogni componente viene pubblicato a ogni versione. Il nome e il logo sono marchi e non sono coperti da quella licenza."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ir brīvā programmatūra ar GPL licenci, versiju 3 vai jaunāku. Montēšanu veic anylinuxfs. Katra komponenta pilns pirmkods tiek publicēts ar katru laidienu. Nosaukums un logotips ir preču zīmes, un šī licence uz tiem neattiecas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is vrije software onder de GPL, versie 3 of later. Het activeren gebeurt door anylinuxfs. De volledige broncode van elk onderdeel wordt bij elke versie gepubliceerd. De naam en het logo zijn handelsmerken en vallen niet onder die licentie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest wolnym oprogramowaniem na licencji GPL w wersji 3 lub nowszej. Montowaniem zajmuje się anylinuxfs. Pełny kod źródłowy każdego składnika jest publikowany wraz z każdym wydaniem. Nazwa i logo są znakami towarowymi i nie są objęte tą licencją."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ é software livre sob a GPL, versão 3 ou posterior. A montagem é feita pelo anylinuxfs. O código-fonte completo de cada componente é publicado com cada versão. O nome e o logótipo são marcas registadas e não estão abrangidos por essa licença."
          }
        }
      }
    },
    "%@ opens BitLocker and Linux drives that macOS cannot read on its own. One setting is needed first.\n\nReading a drive at the raw device level needs Full Disk Access — an administrator password is not enough, and the removable-volumes permission covers files on a drive, not the raw device. macOS has no way for an app to request this one, so it has to be switched on by hand.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ öffnet BitLocker- und Linux-Laufwerke, die macOS von sich aus nicht lesen kann. Dafür ist zunächst eine Einstellung nötig.\n\nUm ein Laufwerk auf Geräteebene zu lesen, wird Festplattenvollzugriff benötigt — ein Administratorpasswort genügt nicht, und die Berechtigung für entfernbare Volumes umfasst Dateien auf einem Laufwerk, nicht das Gerät selbst. macOS bietet Apps keine Möglichkeit, diese Berechtigung anzufordern, daher muss sie von Hand aktiviert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ abre discos BitLocker y Linux que macOS no puede leer por sí solo. Antes hace falta un ajuste.\n\nLeer un disco a nivel de dispositivo requiere Acceso total al disco: una contraseña de administrador no basta, y el permiso de volúmenes extraíbles cubre los archivos de un disco, no el dispositivo en sí. macOS no ofrece a ninguna app forma de solicitarlo, así que debe activarse a mano."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ avab BitLockeri ja Linuxi kettaid, mida macOS ise lugeda ei oska. Enne seda on vaja üht seadet.\n\nKetta lugemine seadme tasemel nõuab õigust „Full Disk Access“ — administraatori paroolist ei piisa ja eemaldatavate köidete õigus katab ketta faile, mitte seadet ennast. macOS ei võimalda rakendusel seda küsida, seega tuleb see käsitsi sisse lülitada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ avaa BitLocker- ja Linux-asemia, joita macOS ei osaa itse lukea. Sitä ennen tarvitaan yksi asetus.\n\nAseman lukeminen laitetasolla vaatii koko levyn käyttöoikeuden — pääkäyttäjän salasana ei riitä, ja siirrettävien taltioiden oikeus koskee aseman tiedostoja, ei itse laitetta. macOS ei anna ohjelman pyytää tätä, joten se on otettava käyttöön käsin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ouvre les disques BitLocker et Linux que macOS ne sait pas lire seul. Un réglage est nécessaire au préalable.\n\nLire un disque au niveau du périphérique brut exige l’accès complet au disque — un mot de passe administrateur ne suffit pas, et l’autorisation relative aux volumes amovibles couvre les fichiers d’un disque, pas le périphérique lui-même. macOS ne permet à aucune app de demander celle-ci : elle doit être activée à la main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ apre dischi BitLocker e Linux che macOS da solo non riesce a leggere. Prima serve un’impostazione.\n\nLeggere un disco a livello di dispositivo richiede l’accesso completo al disco: una password di amministratore non basta, e il permesso per i volumi rimovibili riguarda i file su un disco, non il dispositivo stesso. macOS non permette a nessuna app di richiederlo, quindi va attivato a mano."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ atver BitLocker un Linux diskus, ko macOS pati nespēj nolasīt. Vispirms ir nepieciešams viens iestatījums.\n\nDiska lasīšanai ierīces līmenī ir vajadzīga atļauja “Full Disk Access” — administratora parole nav pietiekama, un noņemamo sējumu atļauja attiecas uz failiem diskā, nevis uz pašu ierīci. macOS neļauj lietotnei to pieprasīt, tāpēc tā jāieslēdz manuāli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opent BitLocker- en Linux-schijven die macOS zelf niet kan lezen. Daarvoor is eerst één instelling nodig.\n\nEen schijf op apparaatniveau lezen vereist volledige schijftoegang — een beheerderswachtwoord is niet genoeg, en het recht voor verwijderbare volumes geldt voor bestanden op een schijf, niet voor het apparaat zelf. macOS biedt apps geen manier om dit aan te vragen, dus moet het met de hand worden ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ otwiera dyski BitLocker i Linuksa, których macOS sam nie odczyta. Najpierw potrzebne jest jedno ustawienie.\n\nOdczyt dysku na poziomie urządzenia wymaga pełnego dostępu do dysku — hasło administratora nie wystarcza, a uprawnienie do woluminów wymiennych obejmuje pliki na dysku, a nie samo urządzenie. macOS nie pozwala aplikacji o nie poprosić, więc trzeba je włączyć ręcznie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ abre discos BitLocker e Linux que o macOS não consegue ler sozinho. Antes disso, é necessária uma definição.\n\nLer um disco ao nível do dispositivo exige acesso completo ao disco — uma palavra-passe de administrador não basta, e a permissão para volumes amovíveis abrange os ficheiros de um disco, não o dispositivo em si. O macOS não permite que uma app a solicite, pelo que tem de ser ativada manualmente."
          }
        }
      }
    },
    "%@ starts a small Linux virtual machine, unlocks the drive inside it, and hands the drive back to Finder. macOS cannot read BitLocker or Linux filesystems. Linux can.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ startet eine kleine virtuelle Linux-Maschine, entsperrt das Laufwerk darin und übergibt es zurück an den Finder. macOS kann BitLocker- und Linux-Dateisysteme nicht lesen. Linux schon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ arranca una pequeña máquina virtual Linux, desbloquea el disco dentro de ella y se lo entrega al Finder. macOS no puede leer sistemas de archivos BitLocker ni de Linux. Linux sí."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ käivitab väikese Linuxi virtuaalmasina, avab ketta selle sees ja annab ketta Finderile tagasi. macOS ei oska lugeda BitLockeri ega Linuxi failisüsteeme. Linux oskab."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ käynnistää pienen Linux-virtuaalikoneen, avaa aseman sen sisällä ja luovuttaa aseman takaisin Finderille. macOS ei osaa lukea BitLocker- eikä Linux-tiedostojärjestelmiä. Linux osaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ démarre une petite machine virtuelle Linux, y déverrouille le disque, puis le transmet au Finder. macOS ne sait pas lire les systèmes de fichiers BitLocker ou Linux. Linux, si."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ avvia una piccola macchina virtuale Linux, vi sblocca il disco e lo consegna al Finder. macOS non sa leggere i file system BitLocker o Linux. Linux sì."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ palaiž nelielu Linux virtuālo mašīnu, atbloķē disku tajā un nodod disku atpakaļ programmai Finder. macOS nespēj lasīt BitLocker vai Linux failu sistēmas. Linux spēj."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ start een kleine virtuele Linux-machine, ontgrendelt de schijf daarbinnen en geeft die terug aan de Finder. macOS kan BitLocker- of Linux-bestandssystemen niet lezen. Linux wel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uruchamia małą maszynę wirtualną z Linuksem, odblokowuje w niej dysk i przekazuje go z powrotem Finderowi. macOS nie odczyta systemów plików BitLocker ani Linuksa. Linux tak."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ inicia uma pequena máquina virtual Linux, desbloqueia o disco dentro dela e devolve-o ao Finder. O macOS não consegue ler sistemas de ficheiros BitLocker ou Linux. O Linux consegue."
          }
        }
      }
    },
    "%@ will be moved to the Bin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird in den Papierkorb bewegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se moverá a la papelera."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ teisaldatakse prügikasti (Trash)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ siirretään roskakoriin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sera placé dans la corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verrà spostato nel Cestino."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiks pārvietota uz atkritni (Trash)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wordt naar de prullenmand verplaatst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zostanie przeniesiony do Kosza."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ será movido para o lixo."
          }
        }
      }
    },
    "%lld drives had stopped responding and were disconnected. You can open them again.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Laufwerk hat nicht mehr reagiert und wurde getrennt. Du kannst es erneut öffnen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Laufwerke haben nicht mehr reagiert und wurden getrennt. Du kannst sie erneut öffnen."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld drive had stopped responding and was disconnected. You can open it again."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld drives had stopped responding and were disconnected. You can open them again."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld disco había dejado de responder y se desconectó. Puedes volver a abrirlo."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld discos habían dejado de responder y se desconectaron. Puedes volver a abrirlos."
                }
              }
            }
          }
        },
        "et": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ketas ei vastanud enam ja ühendati lahti. Sa saad selle uuesti avada."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ketast ei vastanud enam ja ühendati lahti. Sa saad need uuesti avada."
                }
              }
            }
          }
        },
        "fi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld asema lakkasi vastaamasta ja irrotettiin. Voit avata sen uudelleen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld asemaa lakkasi vastaamasta ja irrotettiin. Voit avata ne uudelleen."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld disque ne répondait plus et a été déconnecté. Vous pouvez l’ouvrir à nouveau."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld disques ne répondaient plus et ont été déconnectés. Vous pouvez les ouvrir à nouveau."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld disco non rispondeva più ed è stato scollegato. Puoi aprirlo di nuovo."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld dischi non rispondevano più e sono stati scollegati. Puoi aprirli di nuovo."
                }
              }
            }
          }
        },
        "lv": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld disks pārstāja atbildēt un tika atvienots. Jūs varat to atvērt vēlreiz."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld diski pārstāja atbildēt un tika atvienoti. Jūs varat tos atvērt vēlreiz."
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld disku pārstāja atbildēt un tika atvienoti. Jūs varat tos atvērt vēlreiz."
                }
              }
            }
          }
        },
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld schijf reageerde niet meer en is losgekoppeld. Je kunt die opnieuw openen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld schijven reageerden niet meer en zijn losgekoppeld. Je kunt ze opnieuw openen."
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld dyski przestały odpowiadać i zostały odłączone. Możesz otworzyć je ponownie."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld dysków przestało odpowiadać i zostało odłączonych. Możesz otworzyć je ponownie."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld dysk przestał odpowiadać i został odłączony. Możesz otworzyć go ponownie."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld dysku przestało odpowiadać i zostało odłączone. Możesz otworzyć je ponownie."
                }
              }
            }
          }
        },
        "pt-PT": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld disco deixou de responder e foi desligado. Pode abri-lo novamente."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld discos deixaram de responder e foram desligados. Pode abri-los novamente."
                }
              }
            }
          }
        }
      }
    },
    "%lld open drives will be ejected.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Das geöffnete Laufwerk wird ausgeworfen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld geöffnete Laufwerke werden ausgeworfen."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The open drive will be ejected."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld open drives will be ejected."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Se expulsará el disco abierto."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Se expulsarán %lld discos abiertos."
                }
              }
            }
          }
        },
        "et": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Avatud ketas väljutatakse."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld avatud ketast väljutatakse."
                }
              }
            }
          }
        },
        "fi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Avattu asema poistetaan käytöstä."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld avattua asemaa poistetaan käytöstä."
                }
              }
            }
          }
