    "Done": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        }
      }
    },
    "Download and install them": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates laden und installieren"
          }
        }
      }
    },
    "Drives sealed to a TPM rather than a password, including Ubuntu's newer hardware-backed encryption": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufwerke, die an ein TPM statt an ein Passwort gebunden sind, einschließlich der neueren hardwaregestützten Verschlüsselung von Ubuntu"
          }
        }
      }
    },
    "Eject": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auswerfen"
          }
        }
      }
    },
    "Eject %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ auswerfen"
          }
        }
      }
    },
    "Eject and Quit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auswerfen und beenden"
          }
        }
      }
    },
    "Ejecting %lld open drives": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Geöffnetes Laufwerk wird ausgeworfen"
                }
