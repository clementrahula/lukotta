              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "يحتوي هذا المحرّك على %lld وحدات تخزين ولم تُفتح كلها."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "يحتوي هذا المحرّك على %lld وحدة تخزين ولم تُفتح كلها."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "يحتوي هذا المحرّك على وحدة تخزين واحدة ولم تُفتح."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
