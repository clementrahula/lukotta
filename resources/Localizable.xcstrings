        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%@” pillanatképek láncának része. Nyissa meg azt a meghajtót, amelyből készült."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
