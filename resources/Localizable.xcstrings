    "No reason was reported. The details below may say more.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُذكر أي سبب. قد تقول التفاصيل أدناه المزيد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не беше посочена причина. Подробностите по-долу може да кажат повече."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyl uveden žádný důvod. Podrobnosti níže mohou říct více."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke oplyst nogen årsag. Oplysningerne nedenfor siger måske mere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde kein Grund gemeldet. Die Details unten sagen möglicherweise mehr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν αναφέρθηκε αιτία. Οι λεπτομέρειες παρακάτω ίσως πουν περισσότερα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha indicado ningún motivo. Los detalles de abajo pueden decir más."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Põhjust ei teatatud. Allolevad üksikasjad võivad rohkem öelda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syytä ei ilmoitettu. Alla olevat tiedot voivat kertoa enemmän."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang iniulat na dahilan. Maaaring may mas masasabi ang mga detalye sa ibaba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune raison n’a été signalée. Les détails ci-dessous en disent peut-être davantage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא דווחה סיבה. ייתכן שהפרטים למטה יאמרו יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई कारण नहीं बताया गया। नीचे दिए विवरण अधिक बता सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije naveden razlog. Pojedinosti u nastavku možda kažu više."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem érkezett indoklás. Az alábbi részletek többet elárulhatnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada alasan yang dilaporkan. Rincian di bawah mungkin menjelaskan lebih banyak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato indicato alcun motivo. I dettagli qui sotto potrebbero dire di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "理由は報告されませんでした。下の詳細に手がかりがあるかもしれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보고된 이유가 없습니다. 아래 세부 정보에 더 많은 단서가 있을 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
