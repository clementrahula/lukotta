          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez à cette fenêtre et cliquez sur Relancer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזרו לחלון הזה ולחצו על הפעלה מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस विंडो में लौटें और पुनः लॉन्च पर क्लिक करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vratite se u ovaj prozor i kliknite Pokreni ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Térjen vissza ehhez az ablakhoz, és kattintson az Újraindítás gombra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembali ke jendela ini dan klik Jalankan Ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a questa finestra e fai clic su Riavvia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウインドウに戻り、「再起動」をクリックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 창으로 돌아와 다시 실행을 클릭하십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grįžkite į šį langą ir spustelėkite „Paleisti iš naujo“."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atgriezieties šajā logā un noklikšķiniet uz Palaist no jauna."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembali ke tetingkap ini dan klik Lancar Semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom tilbake til dette vinduet og klikk Start på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom terug naar dit venster en klik op Herstart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wróć do tego okna i kliknij Uruchom ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte a esta janela e clique em Reiniciar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reveniți la această fereastră și faceți clic pe Relansați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернитесь в это окно и нажмите «Перезапустить»."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrnite se v to okno in kliknite Znova zaženi."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Kthehu te kjo dritare dhe kliko Rinis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom tillbaka till det här fönstret och klicka på Starta om."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลับมาที่หน้าต่างนี้แล้วคลิก เปิดใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu pencereye dönün ve Yeniden Başlat'a tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поверніться до цього вікна й натисніть «Перезапустити»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quay lại cửa sổ này và bấm Khởi động lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到这个窗口并点按“重新启动”。"
          }
        }
      }
    },
    "Connect the drive and choose Rescan. If it is already connected, macOS may have it mounted, in which case eject it in Finder first. To open a disk image instead, choose File → Open Disk Image.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصّل المحرّك واختر إعادة الفحص. إن كان موصولًا بالفعل فقد يكون macOS قد ركّبه، وعندها أخرجه في الباحث أولًا. ولفتح صورة قرص بدلًا من ذلك، اختر ملف ← فتح صورة قرص."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Свържете диска и изберете Търсене отново. Ако вече е свързан, macOS може да го е монтирал — тогава първо го извадете във Finder. За да отворите дисков образ вместо това, изберете Файл → Отвори дисков образ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojte disk a zvolte Hledat znovu. Pokud už připojený je, může ho mít připojený macOS — pak ho nejprve vysuňte ve Finderu. Chcete-li místo toho otevřít obraz disku, zvolte Soubor → Otevřít obraz disku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilslut disken og vælg Søg igen. Er den allerede tilsluttet, har macOS den måske monteret — skub den så først ud i Finder. Vil du i stedet åbne et diskbillede, så vælg Arkiv → Åbn diskbillede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe das Laufwerk an und wähle Erneut suchen. Ist es bereits angeschlossen, hat macOS es womöglich eingehängt — wirf es dann zuerst im Finder aus. Um stattdessen ein Image zu öffnen, wähle „Ablage → Image öffnen“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδέστε τον δίσκο και επιλέξτε Νέα αναζήτηση. Αν είναι ήδη συνδεδεμένος, μπορεί να τον έχει προσαρτήσει το macOS — τότε κάντε πρώτα εξαγωγή από το Finder. Για να ανοίξετε είδωλο δίσκου αντ’ αυτού, επιλέξτε Αρχείο → Άνοιγμα ειδώλου δίσκου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta el disco y elige Volver a buscar. Si ya está conectado, puede que macOS lo tenga montado: en ese caso, expúlsalo primero en el Finder. Para abrir una imagen de disco, elige Archivo → Abrir imagen de disco."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühendage ketas ja valige Otsi uuesti. Kui see on juba ühendatud, võib macOS olla selle haakinud — siis väljutage see kõigepealt Finderis. Kettatõmmise avamiseks valige hoopis Fail → Ava kettatõmmis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä levy ja valitse Etsi uudelleen. Jos se on jo liitetty, macOS on ehkä liittänyt sen — poista se silloin ensin Finderissa. Jos haluat sen sijaan avata levytiedoston, valitse Arkisto → Avaa levytiedosto."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikabit ang drive at piliin ang I-scan Muli. Kung nakakabit na ito, maaaring na-mount na ito ng macOS; sa ganoong kaso, i-eject muna ito sa Finder. Para magbukas ng disk image, piliin ang File → Open Disk Image."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchez le disque et choisissez Rechercher à nouveau. S’il est déjà branché, macOS l’a peut-être monté : éjectez-le d’abord dans le Finder. Pour ouvrir une image disque à la place, choisissez Fichier → Ouvrir une image disque."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חברו את הכונן ובחרו סריקה מחדש. אם הוא כבר מחובר, ייתכן ש‑macOS עיגן אותו, ואז הוציאו אותו קודם ב‑Finder. כדי לפתוח תמונת דיסק במקום זאת, בחרו קובץ ← פתיחת תמונת דיסק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ड्राइव जोड़ें और फिर से स्कैन करें चुनें। यदि वह पहले से जुड़ी है, तो शायद macOS ने उसे माउंट कर रखा हो; उस स्थिति में पहले उसे Finder में निकालें। इसके बजाय कोई डिस्क इमेज खोलने के लिए File → Open Disk Image चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Priključite disk i odaberite Pretraži ponovno. Ako je već priključen, možda ga je macOS montirao — tada ga najprije izbacite u Finderu. Želite li umjesto toga otvoriti sliku diska, odaberite Datoteka → Otvori sliku diska."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakoztassa a lemezt, és válassza a Keresés újra lehetőséget. Ha már csatlakoztatva van, lehet, hogy a macOS csatolta — ez esetben előbb adja ki a Finderben. Ha inkább lemezképet nyitna meg, válassza a Fájl → Lemezkép megnyitása menüpontot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan drive lalu pilih Pindai Ulang. Jika sudah tersambung, macOS mungkin telah memasangnya; dalam hal itu keluarkan dulu di Finder. Untuk membuka image disk, pilih File → Open Disk Image."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega il disco e scegli Cerca di nuovo. Se è già collegato, macOS potrebbe averlo montato: in tal caso espellilo prima dal Finder. Per aprire invece un’immagine disco, scegli Archivio → Apri immagine disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライブを接続して「再スキャン」を選んでください。すでに接続されている場合は macOS がマウントしている可能性があるので、まず Finder で取り出してください。代わりにディスクイメージを開くには、「ファイル」→「ディスクイメージを開く」を選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드라이브를 연결하고 다시 검색을 선택하십시오. 이미 연결되어 있다면 macOS가 마운트했을 수 있으니 먼저 Finder에서 추출하십시오. 대신 디스크 이미지를 열려면 파일 → 디스크 이미지 열기를 선택하십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijunkite diską ir pasirinkite Ieškoti iš naujo. Jei jis jau prijungtas, „macOS“ gali būti jį prijungusi — tada pirmiausia išstumkite jį per „Finder“. Jei norite atverti disko atvaizdį, pasirinkite Failas → Atverti disko atvaizdį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievienojiet disku un izvēlieties Meklēt vēlreiz. Ja tas jau ir pievienots, macOS to var būt pievienojis sistēmai — tad vispirms izstumiet to programmā Finder. Lai tā vietā atvērtu diska attēlu, izvēlieties Fails → Atvērt diska attēlu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan pemacu dan pilih Imbas Semula. Jika ia sudah disambungkan, macOS mungkin telah melekapkannya; jika begitu, keluarkannya dalam Finder dahulu. Untuk membuka imej cakera pula, pilih File → Open Disk Image."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til disken og velg Søk på nytt. Er den allerede tilkoblet, kan macOS ha montert den — mat den da ut i Finder først. Vil du åpne et diskbilde i stedet, velg Arkiv → Åpne diskbilde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit de schijf aan en kies Opnieuw zoeken. Is die al aangesloten, dan heeft macOS die mogelijk gekoppeld — verwijder die dan eerst in de Finder. Wil je in plaats daarvan een schijfkopie openen, kies dan Archief → Open schijfkopie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podłącz dysk i wybierz Szukaj ponownie. Jeśli jest już podłączony, macOS mógł go zamontować — wtedy najpierw wysuń go w Finderze. Aby zamiast tego otworzyć obraz dysku, wybierz Plik → Otwórz obraz dysku."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue o disco e escolha Procurar de novo. Se já estiver ligado, o macOS pode tê-lo montado — nesse caso, ejete-o primeiro no Finder. Para abrir uma imagem de disco em vez disso, escolha Ficheiro → Abrir imagem de disco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectați discul și alegeți Căutați din nou. Dacă este deja conectat, macOS îl poate avea montat — atunci ejectați-l mai întâi în Finder. Pentru a deschide în schimb o imagine de disc, alegeți Fișier → Deschide imagine de disc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите диск и выберите «Искать снова». Если он уже подключён, macOS мог смонтировать его — в этом случае сначала извлеките его в Finder. Чтобы открыть образ диска, выберите File → Open Disk Image."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Priključite disk in izberite Ponovno poišči. Če je že priključen, ga je morda priklopil macOS — tedaj ga najprej izvrzite v Finderju. Če želite namesto tega odpreti sliko diska, izberite Datoteka → Odpri sliko diska."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidh diskun dhe zgjidh Kërko sërish. Nëse është tashmë i lidhur, macOS mund ta ketë të montuar, dhe në atë rast nxirre fillimisht në Finder. Për të hapur një imazh disku, zgjidh File → Open Disk Image."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut disken och välj Sök igen. Är den redan ansluten kan macOS ha monterat den — mata i så fall ut den i Finder först. Vill du i stället öppna en skivavbild, välj Arkiv → Öppna skivavbild."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต่อไดรฟ์แล้วเลือก สแกนใหม่ ถ้าต่ออยู่แล้ว macOS อาจเมานต์ไว้ ในกรณีนั้นให้ดันออกใน Finder ก่อน หากต้องการเปิดอิมเมจดิสก์แทน ให้เลือก File → Open Disk Image"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürücüyü bağlayın ve Yeniden Tara'yı seçin. Zaten bağlıysa macOS onu bağlamış olabilir; o durumda önce Finder'da çıkarın. Bunun yerine bir disk imajı açmak için File → Open Disk Image seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіть диск і виберіть «Шукати знову». Якщо він уже підключений, macOS міг змонтувати його — тоді спершу вилучіть його у Finder. Щоб відкрити образ диска, виберіть File → Open Disk Image."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cắm ổ đĩa và chọn Quét lại. Nếu nó đã được cắm, macOS có thể đã gắn kết nó; khi đó hãy tháo nó trong Finder trước. Để mở một ảnh đĩa, hãy chọn File → Open Disk Image."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请连接驱动器并选取“重新扫描”。如果它已经连接，可能已被 macOS 挂载，那就先在“访达”中推出它。若想改为打开磁盘映像，请选取“文件”→“打开磁盘映像”。"
          }
        }
      }
    },
