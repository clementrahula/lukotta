    "Leave Open": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Остави отворен"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad være åben"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geöffnet lassen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατήρηση ανοιχτού"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar abierto"
          }
        },
        "et": {
