    "What a drive contains is only known once it is unlocked.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съдържанието на диска се разбира едва след като бъде отключен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsah disku je znám až po jeho odemknutí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad en enhed indeholder, ved man først, når den er låst op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ein Laufwerk enthält, ist erst nach dem Entsperren bekannt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το περιεχόμενο ενός δίσκου γίνεται γνωστό μόνο αφού ξεκλειδωθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido de un disco solo se conoce una vez desbloqueado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketta sisu selgub alles siis, kui see on avatud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseman sisältö selviää vasta, kun se on avattu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu d’un disque n’est connu qu’une fois celui-ci déverrouillé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadržaj diska poznat je tek nakon što se otključa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy meghajtó tartalma csak a feloldás után derül ki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto di un disco si conosce solo dopo averlo sbloccato."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Disko turinys paaiškėja tik jį atrakinus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diska saturs kļūst zināms tikai pēc tā atbloķēšanas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva en enhet inneholder, vet man først når den er låst opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat een schijf bevat, is pas bekend nadat die is ontgrendeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawartość dysku jest znana dopiero po jego odblokowaniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo de um disco só é conhecido depois de este ser desbloqueado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conținutul unui disc se află abia după ce este deblocat."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsebina pogona je znana šele, ko je ta odklenjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad en enhet innehåller vet man först när den är upplåst."
          }
        }
      }
    },
    "What happened": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Какво се случи"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co se stalo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad skete der"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist passiert"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι συνέβη"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué ha pasado"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis juhtus"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä tapahtui"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que s’est-il passé"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Što se dogodilo"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi történt"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cos’è successo"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas nutiko"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas notika"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva skjedde"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat is er gebeurd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co się stało"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que aconteceu"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce s-a întâmplat"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaj se je zgodilo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad hände"
          }
        }
      }
    },
