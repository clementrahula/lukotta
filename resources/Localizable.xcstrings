    "Enter the drive's password, or its 48-digit recovery key.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل كلمة سر المحرّك، أو مفتاح الاسترداد المكوّن من 48 رقمًا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Въведете паролата на диска или неговия 48-цифрен ключ за възстановяване."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte heslo disku nebo jeho 48místný obnovovací klíč."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv enhedens adgangskode eller dens 48-cifrede genoprettelsesnøgle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib das Passwort des Laufwerks ein oder seinen 48-stelligen Wiederherstellungsschlüssel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε το συνθηματικό του δίσκου ή το 48ψήφιο κλειδί ανάκτησής του."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la contraseña del disco o su clave de recuperación de 48 dígitos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisesta ketta parool või selle 48-kohaline taastevõti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita aseman salasana tai sen 48-numeroinen palautusavain."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilagay ang password ng drive, o ang 48-digit nitong recovery key."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le mot de passe du disque ou sa clé de récupération à 48 chiffres."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזינו את סיסמת הכונן, או את מפתח השחזור בן 48 הספרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ड्राइव का पासवर्ड, या उसकी 48 अंकों की रिकवरी कुंजी दर्ज करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite lozinku diska ili njegov 48-znamenkasti ključ za oporavak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adja meg a meghajtó jelszavát vagy a 48 jegyű helyreállítási kulcsát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kata sandi drive, atau kunci pemulihan 48 digitnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la password del disco o la sua chiave di recupero di 48 cifre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライブのパスワード、または 48 桁の回復キーを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드라이브의 암호 또는 48자리 복구 키를 입력하십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įveskite disko slaptažodį arba jo 48 skaitmenų atkūrimo raktą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ievadiet diska paroli vai tā 48 ciparu atkopšanas atslēgu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kata laluan pemacu, atau kunci pemulihan 48 digitnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn passordet til enheten eller den 48-sifrede gjenopprettingsnøkkelen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer het wachtwoord van de schijf in, of de herstelsleutel van 48 cijfers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz hasło dysku albo jego 48-cyfrowy klucz odzyskiwania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza a palavra-passe do disco ou a respetiva chave de recuperação de 48 dígitos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți parola discului sau cheia sa de recuperare din 48 de cifre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите пароль диска или его 48-значный ключ восстановления."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnesite geslo pogona ali njegov 48-mestni obnovitveni ključ."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shkruaj fjalëkalimin e diskut, ose çelësin e tij të rikuperimit me 48 shifra."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange enhetens lösenord eller dess 48-siffriga återställningsnyckel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนรหัสผ่านของไดรฟ์ หรือคีย์กู้คืน 48 หลัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürücünün parolasını veya 48 haneli kurtarma anahtarını girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть пароль диска або його 48-значний ключ відновлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy nhập mật khẩu của ổ đĩa, hoặc khóa khôi phục 48 chữ số."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入驱动器的密码，或其 48 位恢复密钥。"
          }
        }
      }
    },
    "Every drive and image can be opened read-only, from the button beside Open or Unlock. Nothing is written to it, not even by macOS": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن فتح كل محرّك وكل صورة للقراءة فقط، من الزر المجاور لـ فتح أو إلغاء القفل. ولا يُكتب عليها شيء، ولا حتى من macOS"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всеки диск и образ може да бъде отворен само за четене, от бутона до „Отвори“ или „Отключи“. Върху него не се записва нищо, дори от macOS"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý disk i obraz lze otevřít jen ke čtení, tlačítkem vedle Otevřít nebo Odemknout. Nic se na něj nezapíše, ani ze strany macOS"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert drev og hvert diskbillede kan åbnes kun til læsning, med knappen ved siden af Åbn eller Lås op. Der skrives intet til det, heller ikke af macOS"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Laufwerk und jedes Abbild lässt sich nur lesend öffnen, über die Taste neben Öffnen oder Entsperren. Darauf wird nichts geschrieben, auch nicht von macOS"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε δίσκος και κάθε εικόνα μπορεί να ανοίξει μόνο για ανάγνωση, από το κουμπί δίπλα στο Άνοιγμα ή στο Ξεκλείδωμα. Δεν γράφεται τίποτα σε αυτόν, ούτε από το macOS"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier disco o imagen puede abrirse en solo lectura, desde el botón junto a Abrir o Desbloquear. No se escribe nada en él, ni siquiera macOS"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga ketta ja tõmmise saab avada ainult lugemiseks, nupust Ava või Ava lukust kõrval. Sellele ei kirjutata midagi, ka macOS ise mitte"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaisen levyn ja levykuvan voi avata vain luettavaksi painikkeesta Avaa- tai Avaa lukitus -painikkeen vierestä. Siihen ei kirjoiteta mitään, ei edes macOS"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawat drive at image ay mabubuksan nang read-only, mula sa pindutan katabi ng Buksan o I-unlock. Walang isinusulat dito, kahit ng macOS"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque disque et chaque image peut être ouvert en lecture seule, par le bouton voisin d’Ouvrir ou de Déverrouiller. Rien n’y est écrit, pas même par macOS"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לפתוח כל כונן וכל תמונה לקריאה בלבד, מהכפתור שליד פתיחה או ביטול נעילה. שום דבר לא נכתב אליהם, גם לא על ידי macOS"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर ड्राइव और इमेज को खोलें या अनलॉक करें के पास वाले बटन से केवल पढ़ने के लिए खोला जा सकता है। उस पर कुछ नहीं लिखा जाता, macOS भी नहीं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki se disk i svaka slika mogu otvoriti samo za čitanje, tipkom uz Otvori ili Otključaj. Na njih se ništa ne zapisuje, ni sam macOS"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden lemez és lemezkép megnyitható csak olvasásra, a Megnyitás vagy a Feloldás melletti gombbal. Semmi nem íródik rá, még a macOS sem ír rá"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap drive dan image dapat dibuka baca-saja, lewat tombol di samping Buka atau Buka Kunci. Tidak ada yang ditulis padanya, bahkan oleh macOS"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni disco e ogni immagine si può aprire in sola lettura, dal pulsante accanto ad Apri o Sblocca. Non vi si scrive nulla, nemmeno macOS"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのドライブもイメージも、「開く」または「ロック解除」の隣のボタンから読み出し専用で開けます。macOS でさえ、何も書き込みません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 드라이브와 이미지는 열기 또는 잠금 해제 옆의 버튼으로 읽기 전용으로 열 수 있습니다. macOS조차 아무것도 기록하지 않습니다"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekvieną diską ir atvaizdį galima atverti tik skaitymui – mygtuku šalia „Atverti“ arba „Atrakinti“. Į jį nieko neįrašoma, net „macOS“"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikvienu disku un attēlu var atvērt tikai lasīšanai — ar pogu blakus Atvērt vai Atbloķēt. Tajā netiek ierakstīts nekas, arī macOS neko neieraksta"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap pemacu dan imej boleh dibuka baca-sahaja, melalui butang di sebelah Buka atau Buka Kunci. Tiada apa-apa ditulis padanya, malah oleh macOS"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle disker og diskbilder kan åpnes kun for lesing, med knappen ved siden av Åpne eller Lås opp. Ingenting skrives til dem, heller ikke av macOS"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke schijf en elk schijfkopiebestand kan alleen-lezen worden geopend, met de knop naast Open of Ontgrendel. Er wordt niets naar geschreven, ook niet door macOS"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy dysk i każdy obraz można otworzyć tylko do odczytu, przyciskiem obok Otwórz lub Odblokuj. Nic nie jest na nim zapisywane, nawet przez macOS"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer disco ou imagem pode ser aberto apenas para leitura, no botão ao lado de Abrir ou Desbloquear. Nada lhe é escrito, nem sequer pelo macOS"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Orice disc și orice imagine pot fi deschise doar pentru citire, cu butonul de lângă Deschideți sau Deblocați. Nu se scrie nimic pe el, nici măcar de către macOS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой диск и образ можно открыть только для чтения — кнопкой рядом с «Открыть» или «Разблокировать». На него ничего не записывается, даже macOS"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsak disk in vsako sliko je mogoče odpreti samo za branje, z gumbom ob Odpri ali Odkleni. Nanj se ne zapiše nič, niti macOS ne"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çdo disk dhe imazh mund të hapet si vetëm-lexim, nga butoni pranë Hap ose Shkyç. Asgjë nuk shkruhet në të, as edhe nga macOS"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje disk och skivavbild kan öppnas skrivskyddad, med knappen bredvid Öppna eller Lås upp. Ingenting skrivs till den, inte ens av macOS"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกไดรฟ์และทุกอิมเมจเปิดแบบอ่านอย่างเดียวได้ จากปุ่มข้าง เปิด หรือ ปลดล็อก ไม่มีอะไรถูกเขียนลงไป แม้แต่ macOS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sürücü ve imaj, Aç ya da Kilidi Aç düğmesinin yanındaki düğmeyle salt okunur açılabilir. Üzerine hiçbir şey yazılmaz, macOS bile yazmaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь-який диск і образ можна відкрити лише для читання — кнопкою поруч із «Відкрити» або «Розблокувати». На нього нічого не записується, навіть macOS"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi ổ đĩa và ảnh đĩa đều có thể mở ở chế độ chỉ đọc, bằng nút bên cạnh Mở hoặc Mở khóa. Không có gì được ghi lên nó, kể cả macOS"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个驱动器和映像都可以通过“打开”或“解锁”旁边的按钮以只读方式打开。不会向其写入任何内容，连 macOS 也不会"
          }
        }
      }
    },
    "Everything attached to this Mac, whether or not %@ can open it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما هو متصل بهذا الـ Mac، سواء استطاع %@ فتحه أم لا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всичко, свързано с този Mac, независимо дали %@ може да го отвори."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše připojené k tomuto Macu, ať už to %@ umí otevřít, nebo ne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt, der er tilsluttet denne Mac, uanset om %@ kan åbne det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was an diesem Mac hängt, ob %@ es öffnen kann oder nicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ό,τι είναι συνδεδεμένο σε αυτόν τον Mac, είτε μπορεί να το ανοίξει το %@ είτε όχι."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo conectado a este Mac, pueda %@ abrirlo o no."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik, mis on selle Maciga ühendatud, olenemata sellest, kas %@ suudab seda avada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tähän Maciin liitetty, avaapa %@ sen tai ei."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lahat ng nakakabit sa Mac na ito, mabuksan man ito ng %@ o hindi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui est connecté à ce Mac, que %@ sache l’ouvrir ou non."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מה שמחובר ל‑Mac הזה, בין אם %@ יכול לפתוח אותו ובין אם לא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac से जुड़ी हर चीज़, चाहे %@ उसे खोल सके या नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve što je spojeno na ovaj Mac, bez obzira može li ga %@ otvoriti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden, ami ehhez a Machez csatlakozik, akár meg tudja nyitni a(z) %@, akár nem."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Segala yang terpasang pada Mac ini, baik %@ dapat membukanya maupun tidak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che è collegato a questo Mac, che %@ possa aprirlo o meno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が開けるかどうかにかかわらず、この Mac に接続されているすべて。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 열 수 있든 없든, 이 Mac에 연결된 모든 것."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Viskas, kas prijungta prie šio „Mac“, nesvarbu, ar %@ gali tai atverti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Viss, kas pievienots šim Mac, neatkarīgi no tā, vai %@ to var atvērt."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Segala yang disambungkan pada Mac ini, sama ada %@ dapat membukanya atau tidak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt som er koblet til denne Macen, enten %@ kan åpne det eller ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat op deze Mac is aangesloten, of %@ het nu kan openen of niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko podłączone do tego Maca, niezależnie od tego, czy %@ potrafi to otworzyć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que está ligado a este Mac, quer o %@ o consiga abrir ou não."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot ce este conectat la acest Mac, indiferent dacă %@ îl poate deschide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что подключено к этому Mac, независимо от того, может ли %@ это открыть."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse, kar je priključeno na ta Mac, ne glede na to, ali zna %@ to odpreti."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjithçka e lidhur me këtë Mac, pavarësisht nëse %@ mund ta hapë."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt som är anslutet till den här datorn, oavsett om %@ kan öppna det."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างที่ต่ออยู่กับ Mac เครื่องนี้ ไม่ว่า %@ จะเปิดได้หรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'e bağlı olan her şey, %@ açabilsin veya açamasın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе, що підключено до цього Mac, незалежно від того, чи може %@ це відкрити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ gắn với máy Mac này, dù %@ có mở được hay không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接到这台 Mac 的一切，无论 %@ 能否打开。"
          }
        }
      }
    },
    "Everything else was removed. %@ itself could not be moved to the Bin: %@. Drag it there yourself to finish.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُزيل كل شيء آخر. أما %@ نفسه فتعذّر نقله إلى المهملات: %@. اسحبه إلى هناك بنفسك لإتمام الأمر."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всичко останало беше премахнато. Самото %@ не можа да бъде преместено в Кошчето: %@. Преместете го там сами, за да завършите."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše ostatní bylo odstraněno. Samotnou aplikaci %@ se nepodařilo přesunout do Koše: %@. Přetáhněte ji tam sami, tím to bude hotové."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt andet blev fjernet. Selve %@ kunne ikke flyttes til Papirkurven: %@. Træk programmet derover selv for at gøre det færdigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles andere wurde entfernt. %@ selbst ließ sich nicht in den Papierkorb bewegen: %@. Zieh die App selbst dorthin, dann ist es erledigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα τα υπόλοιπα αφαιρέθηκαν. Το ίδιο το %@ δεν μπόρεσε να μετακινηθεί στον Κάδο απορριμμάτων: %@. Σύρετέ το εκεί εσείς για να ολοκληρωθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo demás se eliminó. La propia app %@ no se pudo mover a la Papelera: %@. Arrástrala allí tú mismo para terminar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik muu eemaldati. %@ ennast ei õnnestunud prügikasti liigutada: %@. Lohistage see ise sinna, siis on kõik tehtud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki muu poistettiin. %@ itseään ei saatu siirrettyä roskakoriin: %@. Vedä se sinne itse, niin homma on valmis."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naalis na ang lahat ng iba pa. Ang %@ mismo ay hindi mailipat sa Basurahan: %@. I-drag ito roon nang mag-isa para matapos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le reste a été supprimé. %@ lui-même n’a pas pu être placé dans la Corbeille : %@. Faites-l’y glisser vous-même pour terminer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל השאר הוסר. את %@ עצמו לא ניתן היה להעביר לאשפה: %@. גררו אותו לשם בעצמכם כדי לסיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाकी सब हटा दिया गया। %@ को ही ट्रैश में नहीं ले जाया जा सका: %@। पूरा करने के लिए उसे स्वयं वहाँ खींचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve ostalo je uklonjeno. Sam %@ nije se mogao premjestiti u Smeće: %@. Povucite ga tamo sami kako biste dovršili."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden más el lett távolítva. Magát a(z) %@ alkalmazást nem sikerült a Kukába helyezni: %@. Húzza oda maga, ezzel készen is van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selebihnya telah dihapus. %@ sendiri tidak dapat dipindahkan ke Tong Sampah: %@. Seret sendiri ke sana untuk menyelesaikannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto il resto è stato rimosso. %@ stesso non è stato spostato nel Cestino: %@. Trascinalo lì tu per finire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかはすべて削除しました。%@ 自体はゴミ箱に移動できませんでした：%@。仕上げにご自身でそこへドラッグしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나머지는 모두 제거되었습니다. %@ 자체는 휴지통으로 옮기지 못했습니다: %@. 마무리하려면 직접 그곳으로 끌어다 놓으십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa kita pašalinta. Pačios %@ nepavyko perkelti į šiukšlinę: %@. Nutempkite ją ten patys ir tuo viskas baigsis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Viss pārējais tika noņemts. Pašu %@ neizdevās pārvietot uz miskasti: %@. Ievelciet to tur pats, un viss būs pabeigts."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selebihnya telah dibuang. %@ sendiri tidak dapat dipindahkan ke Tong Sampah: %@. Seret sendiri ke sana untuk menyelesaikannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt annet ble fjernet. %@ selv kunne ikke flyttes til papirkurven: %@. Dra programmet dit selv for å gjøre det ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al het andere is verwijderd. %@ zelf kon niet naar de prullenmand worden verplaatst: %@. Sleep de app er zelf naartoe om het af te ronden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko inne zostało usunięte. Samego programu %@ nie udało się przenieść do Kosza: %@. Przeciągnij go tam sam, aby dokończyć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o resto foi removido. O próprio %@ não pôde ser movido para o Lixo: %@. Arraste-o para lá para terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restul a fost eliminat. Aplicația %@ nu a putut fi mutată la Coșul de gunoi: %@. Trageți-o acolo dumneavoastră pentru a încheia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё остальное удалено. Сам %@ не удалось переместить в Корзину: %@. Перетащите его туда сами, чтобы завершить."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse drugo je bilo odstranjeno. Programa %@ ni bilo mogoče premakniti v Koš: %@. Povlecite ga tja sami in s tem bo opravljeno."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjithçka tjetër u hoq. Vetë %@ nuk mund të zhvendosej në Bin: %@. Zvarrite atje vetë për ta përfunduar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt annat togs bort. Själva %@ gick inte att flytta till papperskorgen: %@. Dra dit programmet själv för att bli klar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่วนอื่นถูกลบไปแล้ว แต่ตัว %@ เองย้ายไปถังขยะไม่ได้: %@ กรุณาลากไปเองเพื่อให้เสร็จสมบูรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer her şey kaldırıldı. %@ uygulamasının kendisi Çöp Kutusu'na taşınamadı: %@. Bitirmek için onu oraya kendiniz sürükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе інше видалено. Сам %@ не вдалося перемістити в Кошик: %@. Перетягніть його туди самі, щоб завершити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ khác đã được gỡ. Riêng %@ không chuyển được vào Thùng rác: %@. Hãy tự kéo nó vào đó để hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其余部分均已移除。%@ 本身无法移到“废纸篓”：%@。请自行将它拖到那里以完成。"
          }
        }
      }
    },
    "Examining its contents.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجري فحص محتواه."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съдържанието се проверява."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zjišťuje se jeho obsah."
          }
