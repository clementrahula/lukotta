            "value": "Aún faltan algunos permisos"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mõned õigused on veel vajalikud"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osa käyttöoikeuksista puuttuu yhä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines autorisations manquent encore"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mancano ancora alcuni permessi"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dažas atļaujas joprojām ir nepieciešamas"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn nog rechten nodig"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadal brakuje niektórych uprawnień"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltam ainda algumas permissões"
          }
        }
      }
    },
