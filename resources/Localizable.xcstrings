          "stringUnit": {
            "state": "translated",
            "value": "Si punon %@ dhe çfarë mbështet"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur %@ fungerar och vad det stöder"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ทำงานอย่างไร และรองรับอะไรบ้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nasıl çalışır ve neleri destekler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як працює %@ і що підтримує"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hoạt động thế nào và hỗ trợ những gì"
          }
