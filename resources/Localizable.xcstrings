                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا يحتوي هذا المحرّك على وحدات تخزين."
                }
              }
            }
          }
        },
        "bg": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Този диск съдържа %lld том и той не можа да бъде отворен."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Този диск съдържа %lld тома и не всички можаха да бъдат отворени."
                }
              }
            }
          }
        },
        "cs": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Tento disk obsahuje %lld svazky a ne všechny se podařilo otevřít."
                }
              },
              "many": {
