    "What a drive contains is only known once it is unlocked.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ein Laufwerk enthält, ist erst nach dem Entsperren bekannt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido de un disco solo se conoce una vez desbloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu d’un disque n’est connu qu’une fois celui-ci déverrouillé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto di un disco si conosce solo dopo averlo sbloccato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat een schijf bevat, is pas bekend nadat die is ontgrendeld."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo de um disco só é conhecido depois de este ser desbloqueado."
          }
        }
      }
    },
