    "About ten drives can stay unlocked at once": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن أن يبقى نحو عشرة محرّكات مفتوحة في آن واحد"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Около десет диска могат да останат отключени едновременно"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odemčených současně může zůstat asi deset disků"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Omkring ti enheder kan være låst op samtidig"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa zehn Laufwerke können gleichzeitig entsperrt bleiben"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περίπου δέκα δίσκοι μπορούν να μείνουν ξεκλείδωτοι ταυτόχρονα"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede haber unos diez discos desbloqueados a la vez"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Umbes kümme ketast võib korraga avatuks jääda"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Noin kymmenen asemaa voi olla avattuna yhtä aikaa"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga sampung drive ang maaaring manatiling nakabukas nang sabay"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une dizaine de disques peuvent rester déverrouillés en même temps"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להשאיר כעשרה כוננים פתוחים בו־זמנית"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक साथ लगभग दस ड्राइव अनलॉक रह सकती हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otključano istodobno može ostati oko deset diskova"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Körülbelül tíz meghajtó maradhat egyszerre feloldva"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekitar sepuluh drive dapat tetap terbuka sekaligus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa dieci dischi possono restare sbloccati contemporaneamente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同時にロック解除しておけるドライブは 10 台ほどです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동시에 약 열 개의 드라이브를 잠금 해제 상태로 둘 수 있습니다"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apie dešimt diskų gali likti atrakinti vienu metu"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptuveni desmit diski var vienlaikus palikt atbloķēti"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kira-kira sepuluh pemacu boleh kekal dibuka serentak"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Omtrent ti enheter kan være låst opp samtidig"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeveer tien schijven kunnen tegelijk ontgrendeld blijven"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Około dziesięciu dysków może być odblokowanych jednocześnie"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de dez discos podem permanecer desbloqueados em simultâneo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproximativ zece discuri pot rămâne deblocate simultan"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одновременно могут оставаться разблокированными около десяти дисков"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hkrati lahko ostane odklenjenih približno deset pogonov"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Rreth dhjetë disqe mund të qëndrojnë të shkyçur njëherësh"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungefär tio enheter kan vara upplåsta samtidigt"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดค้างไว้พร้อมกันได้ราวสิบไดรฟ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı anda yaklaşık on sürücü açık kalabilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одночасно розблокованими можуть залишатися близько десяти дисків"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng mười ổ đĩa có thể cùng ở trạng thái đã mở khóa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大约可同时保持十个驱动器处于解锁状态"
          }
        }
      }
    },
