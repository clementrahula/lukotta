    "What a drive contains is only known once it is unlocked.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُعرف ما يحتويه المحرّك إلا بعد فتحه."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съдържанието на диска се разбира едва след като бъде отключен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsah disku je znám až po jeho odemknutí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad en enhed indeholder, ved man først, når den er låst op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ein Laufwerk enthält, ist erst nach dem Entsperren bekannt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το περιεχόμενο ενός δίσκου γίνεται γνωστό μόνο αφού ξεκλειδωθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido de un disco solo se conoce una vez desbloqueado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketta sisu selgub alles siis, kui see on avatud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseman sisältö selviää vasta, kun se on avattu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang laman ng isang drive ay nalalaman lamang kapag ito ay nabuksan na."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu d’un disque n’est connu qu’une fois celui-ci déverrouillé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה שכונן מכיל נודע רק לאחר שנפתח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ड्राइव में क्या है, यह अनलॉक होने पर ही पता चलता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadržaj diska poznat je tek nakon što se otključa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy meghajtó tartalma csak a feloldás után derül ki."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Isi sebuah drive baru diketahui setelah dibuka kuncinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto di un disco si conosce solo dopo averlo sbloccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライブの中身は、ロック解除して初めて分かります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드라이브에 무엇이 들어 있는지는 잠금 해제한 뒤에야 알 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Disko turinys paaiškėja tik jį atrakinus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diska saturs kļūst zināms tikai pēc tā atbloķēšanas."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kandungan sesebuah pemacu hanya diketahui setelah ia dibuka kunci."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva en enhet inneholder, vet man først når den er låst opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat een schijf bevat, is pas bekend nadat die is ontgrendeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawartość dysku jest znana dopiero po jego odblokowaniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo de um disco só é conhecido depois de este ser desbloqueado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conținutul unui disc se află abia după ce este deblocat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что содержит диск, становится известно только после разблокировки."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsebina pogona je znana šele, ko je ta odklenjen."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çfarë përmban një disk dihet vetëm pasi të shkyçet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad en enhet innehåller vet man först när den är upplåst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะรู้ว่าไดรฟ์มีอะไรอยู่ก็ต่อเมื่อปลดล็อกแล้วเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sürücünün içinde ne olduğu ancak kilidi açıldığında bilinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що містить диск, стає відомо лише після розблокування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ khi mở khóa mới biết một ổ đĩa chứa gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "驱动器里有什么，只有解锁之后才知道。"
          }
        }
      }
    },
    "What happened": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
