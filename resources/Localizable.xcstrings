        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "exFAT इमेज macOS को सौंप दी जाती है, जो इस फ़ॉर्मैट को खुद ही पढ़ता और लिखता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "exFAT slika predaje se macOS-u, koji taj format sam čita i zapisuje"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az exFAT lemezképet a macOS kapja meg, amely ezt a formátumot maga olvassa és írja"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Image exFAT diserahkan ke macOS, yang membaca dan menulis format itu sendiri"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’immagine exFAT viene affidata a macOS, che legge e scrive quel formato da sé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "exFAT のイメージは macOS に引き渡されます。この形式は macOS 自身が読み書きできます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "exFAT 이미지는 macOS로 넘겨집니다. 이 형식은 macOS가 직접 읽고 씁니다"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "exFAT atvaizdis perduodamas „macOS“, kuri šį formatą skaito ir rašo pati"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "exFAT attēls tiek nodots macOS, kas šo formātu lasa un raksta pats"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imej exFAT diserahkan kepada macOS, yang membaca dan menulis format itu sendiri"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et exFAT-diskbilde overlates til macOS, som leser og skriver det formatet selv"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een exFAT-schijfkopie wordt aan macOS overgelaten, dat die structuur zelf leest en schrijft"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obraz exFAT trafia do macOS, który sam odczytuje i zapisuje ten format"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma imagem exFAT é entregue ao macOS, que lê e escreve esse formato por si"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O imagine exFAT este predată macOS, care citește și scrie singur acest format"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Образ exFAT передаётся macOS, который читает и записывает этот формат сам"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slika exFAT je predana macOS, ki to obliko bere in zapisuje sam"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një imazh exFAT i dorëzohet macOS, i cili e lexon dhe e shkruan vetë atë format"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En exFAT-avbild lämnas över till macOS, som läser och skriver det formatet självt"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อิมเมจ exFAT จะถูกส่งต่อให้ macOS ซึ่งอ่านและเขียนรูปแบบนี้ได้เอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir exFAT imajı macOS'e devredilir; bu biçimi macOS zaten kendisi okuyup yazar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Образ exFAT передається macOS, який читає та записує цей формат сам"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh đĩa exFAT được giao cho macOS, vốn tự đọc và ghi định dạng này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "exFAT 映像会交给 macOS，这种格式 macOS 自己就能读写"
          }
        }
      }
    },
    "An image opens without an administrator password, and the volume appears in your home folder": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفتح الصورة دون كلمة سر المسؤول، وتظهر وحدة التخزين في مجلد المستخدم الخاص بك"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Образът се отваря без администраторска парола, а томът се появява в личната ви папка"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obraz se otevře bez hesla správce a svazek se objeví ve vaší domovské složce"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et diskbillede åbnes uden administratoradgangskode, og enheden vises i din hjemmemappe"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Image wird ohne Administratorkennwort geöffnet, und das Volume erscheint in deinem Benutzerordner"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα είδωλο ανοίγει χωρίς κωδικό διαχειριστή και ο τόμος εμφανίζεται στον προσωπικό σας φάκελο"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una imagen se abre sin contraseña de administrador, y el volumen aparece en tu carpeta de inicio"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõmmis avaneb administraatori paroolita ja köide ilmub sinu kodukausta"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Levytiedosto avautuu ilman ylläpitäjän salasanaa, ja taltio ilmestyy kotikansioosi"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bumubukas ang isang image nang walang password ng administrator, at lumalabas ang volume sa iyong home folder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une image s’ouvre sans mot de passe administrateur, et le volume apparaît dans votre dossier de départ"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונה נפתחת ללא סיסמת מנהל, ואמצעי האחסון מופיע בתיקיית הבית שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इमेज व्यवस्थापक पासवर्ड के बिना खुलती है, और वॉल्यूम आपके होम फ़ोल्डर में दिखता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slika se otvara bez administratorske lozinke, a jedinica se pojavljuje u vašoj korisničkoj mapi"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lemezkép rendszergazdai jelszó nélkül nyílik meg, a kötet pedig a saját mappájában jelenik meg"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah image terbuka tanpa kata sandi administrator, dan volumenya muncul di folder rumah Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’immagine si apre senza password di amministratore e il volume compare nella tua cartella Inizio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イメージは管理者パスワードなしで開き、ボリュームはホームフォルダに表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지는 관리자 암호 없이 열리며, 볼륨은 홈 폴더에 나타납니다"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atvaizdis atveriamas be administratoriaus slaptažodžio, o tomas atsiranda jūsų namų aplanke"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Attēls atveras bez administratora paroles, un sējums parādās jūsu mājas mapē"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesebuah imej dibuka tanpa kata laluan pentadbir, dan volumnya muncul dalam folder rumah anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et diskbilde åpnes uten administratorpassord, og volumet vises i hjemmemappen din"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een schijfkopie wordt geopend zonder beheerderswachtwoord, en het volume verschijnt in je thuismap"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obraz otwiera się bez hasła administratora, a wolumin pojawia się w twoim katalogu domowym"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma imagem abre sem palavra-passe de administrador, e o volume aparece na sua pasta pessoal"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O imagine se deschide fără parolă de administrator, iar volumul apare în dosarul dumneavoastră personal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Образ открывается без пароля администратора, и том появляется в вашей домашней папке"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slika se odpre brez skrbniškega gesla, nosilec pa se pojavi v vaši domači mapi"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një imazh hapet pa fjalëkalim administratori, dhe volumi shfaqet në dosjen tënde bazë"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En avbild öppnas utan administratörslösenord, och volymen visas i din hemmapp"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อิมเมจเปิดได้โดยไม่ต้องใช้รหัสผ่านผู้ดูแลระบบ และโวลุ่มจะปรากฏในโฟลเดอร์บ้านของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir imaj yönetici parolası olmadan açılır ve birim ana klasörünüzde görünür"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Образ відкривається без пароля адміністратора, і том з’являється у вашій домашній теці"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh đĩa mở ra mà không cần mật khẩu quản trị, và ổ xuất hiện trong thư mục nhà của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "映像无需管理员密码即可打开，宗卷会出现在你的个人文件夹中"
          }
        }
      }
    },
    "An issue on GitHub is answered sooner. Send it by email instead if it carries anything you would rather not publish.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُجاب على المشكلة المطروحة في GitHub أسرع. أرسلها بالبريد الإلكتروني بدلًا من ذلك إن كانت تحمل ما لا ترغب في نشره."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигналите в GitHub получават отговор по-бързо. Изпратете го по имейл, ако съдържа нещо, което предпочитате да не публикувате."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na issue na GitHubu přijde odpověď dříve. Pokud obsahuje něco, co byste raději nezveřejňovali, pošlete jej e-mailem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En sag på GitHub bliver besvaret hurtigere. Send den med e-mail i stedet, hvis den indeholder noget, du helst ikke vil offentliggøre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Issue auf GitHub wird schneller beantwortet. Schick es per E-Mail, wenn es etwas enthält, das du lieber nicht veröffentlichst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ζητήματα στο GitHub απαντώνται πιο γρήγορα. Στείλτε το με email αν περιέχει κάτι που προτιμάτε να μη δημοσιευτεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las incidencias en GitHub se responden antes. Envíala por correo si contiene algo que prefieras no publicar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubi teated saavad vastuse kiiremini. Saada see e-postiga, kui selles on midagi, mida sa pigem ei avaldaks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHubiin tehtyihin ilmoituksiin vastataan nopeammin. Lähetä se sähköpostilla, jos siinä on jotain, jota et halua julkaista."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas mabilis masagot ang isyu sa GitHub. Ipadala ito sa email kung may lamang ayaw mong ilathala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ticket sur GitHub reçoit une réponse plus rapidement. Envoyez-le par e-mail s’il contient quelque chose que vous préférez ne pas publier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשאלה ב‑GitHub עונים מהר יותר. שלחו אותה בדוא״ל אם היא כוללת משהו שלא הייתם רוצים לפרסם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub पर दर्ज समस्या का उत्तर जल्दी मिलता है। यदि उसमें ऐसा कुछ है जिसे आप सार्वजनिक नहीं करना चाहते, तो उसे ईमेल से भेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na prijave na GitHubu odgovor stiže brže. Pošaljite je e-poštom ako sadrži nešto što radije ne biste objavili."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A GitHubon nyitott hibajegyekre hamarabb érkezik válasz. Küldje inkább e-mailben, ha olyasmit tartalmaz, amit inkább nem hozna nyilvánosságra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Isu di GitHub dijawab lebih cepat. Kirim lewat surel jika berisi hal yang tidak ingin Anda terbitkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le segnalazioni su GitHub ricevono risposta prima. Inviala per email se contiene qualcosa che preferisci non pubblicare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub の issue のほうが早く回答が得られます。公開したくない内容を含む場合は、代わりにメールで送ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub의 이슈가 더 빨리 답을 받습니다. 공개하고 싶지 않은 내용이 있다면 이메일로 보내 주십시오."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Į pranešimus „GitHub“ atsakoma greičiau. Siųskite jį el. paštu, jei jame yra kas nors, ko nenorėtumėte skelbti viešai."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uz ziņojumiem GitHub atbild ātrāk. Sūtiet to pa e-pastu, ja tajā ir kaut kas, ko labāk nepubliskot."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Isu di GitHub dijawab lebih cepat. Hantar melalui e-mel jika ia mengandungi sesuatu yang anda tidak mahu terbitkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En sak på GitHub blir besvart raskere. Send den på e-post i stedet hvis den inneholder noe du helst ikke vil offentliggjøre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een melding op GitHub wordt sneller beantwoord. Stuur die per e-mail als er iets in staat dat je liever niet publiceert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zgłoszenia w serwisie GitHub odpowiedź przychodzi szybciej. Wyślij je e-mailem, jeśli zawiera coś, czego wolisz nie publikować."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os problemas no GitHub têm resposta mais depressa. Envie-o por e-mail se contiver algo que prefira não publicar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesizările de pe GitHub primesc răspuns mai repede. Trimiteți-o pe e-mail dacă include ceva ce preferați să nu publicați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На вопрос в GitHub ответят быстрее. Отправьте его по электронной почте, если он содержит то, что вы не хотели бы публиковать."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na prijave na GitHubu odgovor pride prej. Pošljite jo po e-pošti, če vsebuje kaj, česar raje ne objavite."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një çështje në GitHub merr përgjigje më shpejt. Dërgoje me email nëse përmban diçka që nuk do ta bësh publike."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett ärende på GitHub besvaras snabbare. Skicka det med e-post i stället om det innehåller något du helst inte vill publicera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัญหาที่แจ้งบน GitHub ได้รับคำตอบเร็วกว่า หากมีสิ่งที่คุณไม่อยากเผยแพร่ ให้ส่งทางอีเมลแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub'daki bir konu daha çabuk yanıtlanır. Yayımlamak istemediğiniz bir şey içeriyorsa bunun yerine e-posta ile gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На питання в GitHub відповідають швидше. Надішліть його електронною поштою, якщо воно містить те, що ви не хотіли б оприлюднювати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một vấn đề trên GitHub được trả lời sớm hơn. Hãy gửi qua email nếu nó chứa điều bạn không muốn công khai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 GitHub 上提交的问题会更快得到回复。若其中含有你不愿公开的内容，请改用电子邮件发送。"
          }
        }
      }
    },
    "Another drive is open, and the drive engine has to run on its own the first time after it changes. Eject the other drives, open this one, then they can all be open together again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك محرّك آخر مفتوح، ويجب أن يعمل محرّك الأقراص وحده في المرة الأولى بعد تغيّره. أخرج المحرّكات الأخرى، وافتح هذا، وبعدها يمكن فتحها كلها معًا من جديد."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворен е друг диск, а двигателят трябва да работи сам първия път след промяна. Извадете другите дискове, отворете този и след това всички отново могат да бъдат отворени заедно."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je otevřen jiný disk a jádro musí po změně poprvé běžet samo. Vysuňte ostatní disky, otevřete tento a poté mohou být všechny znovu otevřené současně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden enhed er åben, og motoren skal køre alene første gang efter en ændring. Skub de andre enheder ud, åbn denne, og derefter kan de alle være åbne sammen igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Laufwerk ist geöffnet, und die Laufwerks-Engine muss nach einer Änderung beim ersten Mal allein laufen. Wirf die anderen Laufwerke aus, öffne dieses, danach können wieder alle gleichzeitig geöffnet sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας άλλος δίσκος είναι ανοιχτός και η μηχανή πρέπει να τρέξει μόνη της την πρώτη φορά μετά από αλλαγή. Κάντε εξαγωγή των άλλων δίσκων, ανοίξτε αυτόν, και έπειτα μπορούν όλοι να είναι ξανά ανοιχτοί μαζί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay otro disco abierto y el motor debe ejecutarse solo la primera vez tras cambiar. Expulsa los demás discos, abre este y después podrán estar todos abiertos a la vez de nuevo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teine ketas on avatud ja mootor peab pärast muutumist esimesel korral üksi töötama. Väljuta teised kettad, ava see, seejärel saavad nad taas koos avatud olla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toinen asema on auki, ja moottorin on toimittava yksin ensimmäisellä kerralla muutoksen jälkeen. Poista muut asemat käytöstä, avaa tämä, minkä jälkeen ne voivat taas olla auki yhtä aikaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May ibang drive na nakabukas, at kailangang tumakbong mag-isa ang drive engine sa unang pagkakataon pagkatapos itong magbago. I-eject ang ibang mga drive, buksan ito, pagkatapos ay maaari na silang lahat na magkasabay muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre disque est ouvert, et le moteur doit s’exécuter seul la première fois après une modification. Éjectez les autres disques, ouvrez celui-ci, puis ils pourront de nouveau être ouverts ensemble."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כונן אחר פתוח, ומנוע הכוננים חייב לפעול לבדו בפעם הראשונה לאחר שהשתנה. הוציאו את הכוננים האחרים, פתחו את זה, ואחר כך כולם יוכלו להיות פתוחים יחד שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक और ड्राइव खुली है, और ड्राइव इंजन बदलने के बाद पहली बार अकेले ही चलना चाहिए। बाकी ड्राइव निकालें, इसे खोलें, फिर सभी दोबारा साथ खुली रह सकती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvoren je drugi disk, a pogon nakon promjene prvi put mora raditi sam. Izbacite ostale diskove, otvorite ovaj, a zatim opet svi mogu biti otvoreni zajedno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy másik meghajtó nyitva van, a motornak pedig változás után először egyedül kell futnia. Adja ki a többi meghajtót, nyissa meg ezt, utána újra mind egyszerre lehetnek nyitva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive lain sedang terbuka, dan mesin drive harus berjalan sendirian pada kali pertama setelah berubah. Keluarkan drive lain, buka yang ini, setelah itu semuanya dapat terbuka bersama lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro disco è aperto e il motore deve funzionare da solo la prima volta dopo una modifica. Espelli gli altri dischi, apri questo, poi potranno essere di nuovo tutti aperti insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のドライブが開いています。ドライブエンジンは更新後の最初の 1 回だけ単独で動作する必要があります。ほかのドライブを取り出し、これを開いてください。その後はまたすべて同時に開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 드라이브가 열려 있고, 드라이브 엔진은 바뀐 뒤 처음 한 번은 단독으로 실행되어야 합니다. 다른 드라이브를 추출하고 이것을 연 다음에는 모두 다시 함께 열 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atvertas kitas diskas, o variklis po pakeitimo pirmą kartą turi veikti vienas. Išstumkite kitus diskus, atverkite šį, ir tada jie visi vėl galės būti atverti kartu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir atvērts cits disks, un dzinējam pēc izmaiņām pirmajā reizē jādarbojas vienam pašam. Izstumiet pārējos diskus, atveriet šo, un pēc tam tie visi atkal varēs būt atvērti kopā."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemacu lain sedang terbuka, dan enjin pemacu perlu berjalan bersendirian pada kali pertama selepas ia berubah. Keluarkan pemacu lain, buka yang ini, kemudian semuanya boleh terbuka bersama semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En annen enhet er åpen, og motoren må kjøre alene første gang etter en endring. Mat ut de andre enhetene, åpne denne, så kan alle være åpne sammen igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een andere schijf geopend, en de engine moet de eerste keer na een wijziging alleen draaien. Verwijder de andere schijven, open deze, daarna kunnen ze weer allemaal tegelijk open zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwarty jest inny dysk, a silnik musi działać samodzielnie przy pierwszym uruchomieniu po zmianie. Wysuń pozostałe dyski, otwórz ten, a potem znów będą mogły być otwarte razem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Existe outro disco aberto, e o motor tem de funcionar sozinho na primeira vez após ser alterado. Ejete os outros discos, abra este e depois poderão estar todos abertos em simultâneo novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un alt disc este deschis, iar motorul trebuie să ruleze singur prima dată după o modificare. Ejectați celelalte discuri, deschideți-l pe acesta, iar apoi vor putea fi din nou toate deschise împreună."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыт другой диск, а после обновления движок дисков должен первый раз работать в одиночку. Извлеките остальные диски, откройте этот, после чего все снова смогут быть открыты вместе."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odprt je drug pogon, mehanizem pa mora po spremembi prvič teči sam. Izvrzite druge pogone, odprite tega, nato so lahko spet vsi odprti hkrati."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Një disk tjetër është i hapur, dhe motori i disqeve duhet të punojë vetëm herën e parë pasi ndryshon. Nxirr disqet e tjera, hap këtë, pastaj mund të jenë sërish të gjithë të hapur bashkë."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En annan enhet är öppen, och motorn måste köra ensam första gången efter en ändring. Mata ut de andra enheterna, öppna den här, sedan kan alla vara öppna samtidigt igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีไดรฟ์อื่นเปิดอยู่ และเอนจินไดรฟ์ต้องทำงานลำพังในครั้งแรกหลังจากมีการเปลี่ยนแปลง ให้ดันไดรฟ์อื่นออก เปิดไดรฟ์นี้ จากนั้นทั้งหมดจะเปิดพร้อมกันได้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir sürücü açık ve sürücü motoru değiştikten sonraki ilk seferde tek başına çalışmalı. Diğer sürücüleri çıkarın, bunu açın; ardından hepsi yine birlikte açık olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрито інший диск, а після оновлення рушій дисків має першого разу працювати сам. Вилучіть інші диски, відкрийте цей, і потім усі знову зможуть бути відкриті разом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ổ đĩa khác đang mở, và bộ máy ổ đĩa phải chạy một mình trong lần đầu sau khi nó thay đổi. Hãy tháo các ổ khác, mở ổ này, sau đó tất cả lại có thể mở cùng nhau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个驱动器已打开，而驱动引擎在更新后的第一次必须单独运行。请先推出其他驱动器，打开这一个，之后它们就可以再次同时打开。"
          }
        }
      }
    },
