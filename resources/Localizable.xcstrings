    "System follows your Mac's language.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع النظام لغة الـ Mac لديك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„Системен“ следва езика на вашия Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„Systémový“ se řídí jazykem vašeho Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“System” følger sproget på din Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„System“ folgt der Sprache deines Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επιλογή «Συστήματος» ακολουθεί τη γλώσσα του Mac σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema» sigue el idioma de tu Mac."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„Süsteemne“ järgib sinu Maci keelt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”Järjestelmä” noudattaa Macisi kieltä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinusunod ng Sistema ang wika ng iyong Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Système » suit la langue de votre Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏מערכת עוקבת אחר שפת ה‑Mac שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम आपके Mac की भाषा का अनुसरण करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„Sustav” prati jezik vašeg Maca."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A „Rendszer” a Mac nyelvét követi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem mengikuti bahasa Mac Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema» segue la lingua del tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム」は Mac の言語に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘시스템’은 Mac의 언어를 따릅니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Sistemos“ seka jūsų „Mac“ kalbą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sistēmas” seko jūsu Mac datora valodai."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem mengikut bahasa Mac anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«System» følger språket på Mac-en din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Systeem’ volgt de taal van je Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Systemowy” podąża za językiem Twojego Maca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema» segue o idioma do seu Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„Sistem” urmează limba Mac-ului dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системное — язык вашего Mac."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»Sistemski« sledi jeziku vašega Maca."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistemi ndjek gjuhën e Mac-ut tënd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”System” följer språket på din Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบ จะตามภาษาของ Mac ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem, Mac'inizin dilini izler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Системне — мова вашого Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ thống theo ngôn ngữ của máy Mac của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“系统”跟随你的 Mac 语言。"
          }
        }
      }
    },
    "System follows your Mac's setting, including when it changes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع النظام إعداد الـ Mac لديك، بما في ذلك عند تغيّره."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "„Системен“ следва настройката на вашия Mac, включително когато тя се променя."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„Systémový“ se řídí nastavením vašeho Macu, i když se změní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“System” følger indstillingen på din Mac, også når den ændres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„System“ folgt der Einstellung deines Mac, auch wenn sie sich ändert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επιλογή «Συστήματος» ακολουθεί τη ρύθμιση του Mac σας, ακόμη και όταν αλλάζει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema» sigue el ajuste de tu Mac, también cuando cambia."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "„Süsteemne“ järgib sinu Maci seadet, ka siis, kui see muutub."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”Järjestelmä” noudattaa Macisi asetusta, myös kun se muuttuu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinusunod ng Sistema ang setting ng iyong Mac, pati kapag nagbago ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Système » suit le réglage de votre Mac, y compris lorsqu’il change."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏מערכת עוקבת אחר ההגדרה של ה‑Mac שלך, גם כשהיא משתנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम आपके Mac की सेटिंग का अनुसरण करता है, बदलने पर भी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„Sustav” prati postavku vašeg Maca, i onda kad se promijeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A „Rendszer” a Mac beállítását követi, akkor is, ha az megváltozik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem mengikuti pengaturan Mac Anda, termasuk ketika berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema» segue l’impostazione del tuo Mac, anche quando cambia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム」は Mac の設定に従い、設定が変わったときも同じです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘시스템’은 Mac의 설정을 따르며, 설정이 바뀔 때도 그렇습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Sistemos“ seka jūsų „Mac“ nuostatą, taip pat ir tada, kai ji pasikeičia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sistēmas” seko jūsu Mac datora iestatījumam, arī tad, kad tas mainās."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem mengikut tetapan Mac anda, termasuk apabila ia berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«System» følger innstillingen på Mac-en din, også når den endres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Systeem’ volgt de instelling van je Mac, ook wanneer die verandert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Systemowy” podąża za ustawieniem Twojego Maca, także gdy się ono zmieni."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema» segue a definição do seu Mac, incluindo quando esta muda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„Sistem” urmează configurarea Mac-ului dvs., inclusiv când aceasta se schimbă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системное следует настройке вашего Mac, в том числе когда она меняется."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»Sistemski« sledi nastavitvi vašega Maca, tudi ko se ta spremeni."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistemi ndjek rregullimin e Mac-ut tënd, edhe kur ai ndryshon."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”System” följer inställningen på din Mac, även när den ändras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบ จะตามการตั้งค่าของ Mac ของคุณ รวมถึงเมื่อมีการเปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem, değiştiğinde de dahil olmak üzere Mac'inizin ayarını izler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Системне відповідає налаштуванню вашого Mac, зокрема коли воно змінюється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ thống theo cài đặt của máy Mac của bạn, kể cả khi cài đặt thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“系统”跟随你的 Mac 设置，包括设置发生变化时。"
          }
        }
      }
    },
    "That password or recovery key did not unlock this drive.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تفتح كلمة السر أو مفتاح الاسترداد هذا المحرّك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази парола или ключ за възстановяване не отключи този диск."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto heslo ani obnovovací klíč tento disk neodemkly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den adgangskode eller genoprettelsesnøgle låste ikke denne enhed op."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Passwort bzw. dieser Wiederherstellungsschlüssel hat das Laufwerk nicht entsperrt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το συνθηματικό ή κλειδί ανάκτησης δεν ξεκλείδωσε αυτόν τον δίσκο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa contraseña o clave de recuperación no ha desbloqueado este disco."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See parool või taastevõti ei avanud seda ketast."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuo salasana tai palautusavain ei avannut tätä asemaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi nabuksan ng password o recovery key na iyon ang drive na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce mot de passe ou cette clé de récupération n’a pas déverrouillé ce disque."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסיסמה או מפתח השחזור לא פתחו את הכונן הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस पासवर्ड या रिकवरी कुंजी से यह ड्राइव अनलॉक नहीं हुई।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta lozinka ili ključ za oporavak nisu otključali ovaj disk."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a jelszó vagy helyreállítási kulcs nem oldotta fel a meghajtót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata sandi atau kunci pemulihan itu tidak membuka drive ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella password o chiave di recupero non ha sbloccato questo disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのパスワードまたは回復キーでは、このドライブをロック解除できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 암호 또는 복구 키로는 이 드라이브를 잠금 해제하지 못했습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis slaptažodis ar atkūrimo raktas šio disko neatrakino."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šī parole vai atkopšanas atslēga neatbloķēja šo disku."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata laluan atau kunci pemulihan itu tidak membuka kunci pemacu ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det passordet eller den gjenopprettingsnøkkelen låste ikke opp denne enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat wachtwoord of die herstelsleutel heeft deze schijf niet ontgrendeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To hasło ani klucz odzyskiwania nie odblokowały tego dysku."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa palavra-passe ou chave de recuperação não desbloqueou este disco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acea parolă sau cheie de recuperare nu a deblocat acest disc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот пароль или ключ восстановления не разблокировал этот диск."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To geslo ali obnovitveni ključ ni odklenil tega pogona."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai fjalëkalim ose çelës rikuperimi nuk e shkyçi këtë disk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det lösenordet eller den återställningsnyckeln låste inte upp enheten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสผ่านหรือคีย์กู้คืนนั้นปลดล็อกไดรฟ์นี้ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu parola veya kurtarma anahtarı bu sürücünün kilidini açmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей пароль або ключ відновлення не розблокував цей диск."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mật khẩu hoặc khóa khôi phục đó không mở khóa được ổ đĩa này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该密码或恢复密钥未能解锁这个驱动器。"
          }
        }
      }
    },
    "The Full Disk Access list, with an app's switch marked.": {
