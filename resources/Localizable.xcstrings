    "Raw disk images, and a BitLocker or LUKS volume inside any image, which unlocks like one on a drive": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صور الأقراص الخام، ووحدة تخزين BitLocker أو LUKS داخل أي صورة، وتُفتح كما تُفتح على محرّك"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сурови дискови образи, както и том с BitLocker или LUKS във всеки образ, който се отключва като том на диск"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Surové obrazy disků a svazek s BitLockerem nebo LUKS uvnitř libovolného obrazu, který se odemkne jako svazek na disku"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rå diskbilleder, og en BitLocker- eller LUKS-enhed inde i et hvilket som helst diskbillede, som låses op ligesom en på en disk"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rohimages sowie ein BitLocker- oder LUKS-Volume in einem beliebigen Image, das sich wie eines auf einem Laufwerk entsperren lässt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακατέργαστα είδωλα δίσκων, καθώς και τόμος BitLocker ή LUKS μέσα σε οποιοδήποτε είδωλο, που ξεκλειδώνει όπως ένας τόμος σε δίσκο"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imágenes de disco sin formato, y un volumen BitLocker o LUKS dentro de cualquier imagen, que se desbloquea como uno de un disco"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Töötlemata kettatõmmised ning BitLockeri või LUKS-i köide mis tahes tõmmise sees, mis avaneb nagu kettal olev köide"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Raakalevytiedostot sekä BitLocker- tai LUKS-taltio minkä tahansa levytiedoston sisällä, joka avautuu kuten aseman taltio"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga raw na disk image, at isang BitLocker o LUKS volume sa loob ng anumang image, na bumubukas gaya ng nasa isang drive"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Images disque brutes, ainsi qu’un volume BitLocker ou LUKS à l’intérieur d’une image, qui se déverrouille comme celui d’un disque"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונות דיסק גולמיות, ואמצעי אחסון BitLocker או LUKS בתוך כל תמונה, שנפתח כמו על כונן"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रॉ डिस्क इमेज, और किसी भी इमेज के भीतर का BitLocker या LUKS वॉल्यूम, जो ड्राइव पर मौजूद वॉल्यूम की तरह ही अनलॉक होता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirove slike diskova te BitLocker ili LUKS jedinica unutar bilo koje slike, koja se otključava kao ona na disku"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyers lemezképek, valamint bármely lemezképen belüli BitLocker- vagy LUKS-kötet, amely úgy nyílik meg, mint egy meghajtón lévő"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Image disk mentah, dan volume BitLocker atau LUKS di dalam image mana pun, yang terbuka seperti pada sebuah drive"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immagini disco grezze e un volume BitLocker o LUKS all’interno di qualsiasi immagine, che si sblocca come quello di un disco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "raw ディスクイメージと、任意のイメージ内の BitLocker または LUKS ボリューム。ドライブ上のものと同じようにロック解除されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원시 디스크 이미지, 그리고 어떤 이미지 안에 있든 드라이브의 것과 똑같이 잠금 해제되는 BitLocker 또는 LUKS 볼륨"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neapdoroti diskų atvaizdžiai ir BitLocker arba LUKS tomas bet kuriame atvaizdyje, kuris atrakinamas kaip esantis diske"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neapstrādāti disku attēli, kā arī BitLocker vai LUKS sējums jebkurā attēlā, kas atveras tāpat kā sējums diskā"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imej cakera mentah, dan volum BitLocker atau LUKS di dalam mana-mana imej, yang dibuka sama seperti pada sesebuah pemacu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rå diskbilder, og et BitLocker- eller LUKS-volum inne i et hvilket som helst diskbilde, som låses opp som ett på en disk"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onbewerkte schijfkopieën, en een BitLocker- of LUKS-volume in een schijfkopie, dat net zo wordt ontgrendeld als een volume op een schijf"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Surowe obrazy dysków oraz wolumin BitLocker lub LUKS wewnątrz dowolnego obrazu, który odblokowuje się tak samo jak na dysku"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagens de disco em bruto, e um volume BitLocker ou LUKS dentro de qualquer imagem, que se desbloqueia como um de um disco"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagini de disc brute și un volum BitLocker sau LUKS în interiorul oricărei imagini, care se deblochează ca unul de pe un disc"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необработанные образы дисков, а также том BitLocker или LUKS внутри любого образа, который разблокируется так же, как на диске"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Surove slike diskov ter nosilec BitLocker ali LUKS znotraj katere koli slike, ki se odklene enako kot tisti na disku"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Imazhe disqesh të papërpunuara, dhe një volum BitLocker ose LUKS brenda çdo imazhi, që shkyçet si ai në një disk"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Råa skivavbilder, och en BitLocker- eller LUKS-volym inuti valfri avbild, som låses upp som en på en disk"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อิมเมจดิสก์ดิบ และโวลุ่ม BitLocker หรือ LUKS ภายในอิมเมจใดก็ตาม ซึ่งปลดล็อกเหมือนที่อยู่บนไดรฟ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ham disk imajları ve herhangi bir imajın içindeki BitLocker veya LUKS birimi; bir sürücüdeki gibi açılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необроблені образи дисків, а також том BitLocker або LUKS усередині будь-якого образу, який розблоковується так само, як на диску"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh đĩa thô, và ổ BitLocker hay LUKS bên trong bất kỳ ảnh đĩa nào, mở khóa giống như trên một ổ đĩa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始磁盘映像，以及任何映像内部的 BitLocker 或 LUKS 宗卷，其解锁方式与驱动器上的一样"
          }
        }
      }
    },
