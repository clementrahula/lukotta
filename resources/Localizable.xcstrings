    "Updating does not eject your drives. Anything unlocked stays unlocked and keeps working.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Актуализирането не изважда вашите дискове. Всичко отключено остава отключено и продължава да работи."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizace vaše disky nevysune. Vše odemčené zůstane odemčené a funguje dál."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En opdatering skubber ikke dine enheder ud. Alt, der er låst op, forbliver låst op og fungerer videre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Update wirft deine Laufwerke nicht aus. Alles Entsperrte bleibt entsperrt und funktioniert weiter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ενημέρωση δεν κάνει εξαγωγή των δίσκων σας. Ό,τι είναι ξεκλείδωτο παραμένει ξεκλείδωτο και συνεχίζει να λειτουργεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizar no expulsa tus discos. Todo lo que esté desbloqueado sigue desbloqueado y funcionando."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Uuendamine ei väljuta sinu kettaid. Kõik avatu jääb avatuks ja töötab edasi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivittäminen ei poista asemiasi käytöstä. Kaikki avattu pysyy avattuna ja toimii edelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mise à jour n’éjecte pas vos disques. Tout ce qui est déverrouillé le reste et continue de fonctionner."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažuriranje ne izbacuje vaše diskove. Sve što je otključano ostaje otključano i nastavlja raditi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A frissítés nem adja ki a meghajtóit. Ami fel van oldva, az feloldva marad és tovább működik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aggiornamento non espelle i tuoi dischi. Ciò che è sbloccato resta sbloccato e continua a funzionare."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Naujinimas neišstumia jūsų diskų. Viskas, kas atrakinta, lieka atrakinta ir veikia toliau."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atjaunināšana neizstumj jūsu diskus. Viss atbloķētais paliek atbloķēts un turpina darboties."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En oppdatering mater ikke ut enhetene dine. Alt som er låst opp, forblir låst opp og fungerer videre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijwerken verwijdert je schijven niet. Alles wat ontgrendeld is, blijft ontgrendeld en blijft werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uaktualnianie nie wysuwa Twoich dysków. Wszystko, co odblokowane, pozostaje odblokowane i działa dalej."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizar não ejeta os seus discos. Tudo o que estiver desbloqueado assim permanece e continua a funcionar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizarea nu vă ejectează discurile. Tot ce este deblocat rămâne deblocat și continuă să funcționeze."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Posodabljanje ne izvrže vaših pogonov. Vse, kar je odklenjeno, ostane odklenjeno in deluje naprej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En uppdatering matar inte ut dina enheter. Allt som är upplåst förblir upplåst och fungerar vidare."
          }
        }
      }
    },
    "Using the key saved in your Keychain": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
