    "macOS already has this drive mounted. Eject it in Finder and try again.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS вече е монтирала този диск. Извадете го във Finder и опитайте отново."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS har allerede aktiveret denne enhed. Skub den ud i Finder, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat dieses Laufwerk bereits aktiviert. Wirf es im Finder aus und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το macOS έχει ήδη προσαρτήσει αυτόν τον δίσκο. Κάντε εξαγωγή στο Finder και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ya tiene este disco montado. Expúlsalo en el Finder y vuelve a intentarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS on selle ketta juba haakinud. Väljuta see Finderis ja proovi uuesti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS on jo ottanut tämän aseman käyttöön. Poista se käytöstä Finderissa ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a déjà monté ce disque. Éjectez-le dans le Finder, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha già montato questo disco. Espellilo nel Finder e riprova."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„macOS“ šį diską jau prijungė. Išstumkite jį „Finder“ programoje ir bandykite dar kartą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS šo disku jau ir piemontējis. Izstumiet to programmā Finder un mēģiniet vēlreiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS heeft deze schijf al geactiveerd. Verwijder die in de Finder en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ma już ten dysk zamontowany. Wysuń go w Finderze i spróbuj ponownie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS já tem este disco montado. Ejete-o no Finder e tente de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS har redan monterat enheten. Mata ut den i Finder och försök igen."
          }
        }
      }
    },
    "macOS blocked access to the drive. %@ needs Full Disk Access before it can read an encrypted disk.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS блокира достъпа до диска. %@ се нуждае от „Full Disk Access“, за да може да чете шифрован диск."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS blokerede adgangen til enheden. %@ har brug for fuld adgang til disk for at kunne læse en krypteret disk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat den Zugriff auf das Laufwerk blockiert. %@ benötigt Festplattenvollzugriff, um eine verschlüsselte Festplatte lesen zu können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το macOS απέκλεισε την πρόσβαση στον δίσκο. Το %@ χρειάζεται «Πλήρης πρόσβαση στον δίσκο» για να μπορεί να διαβάσει κρυπτογραφημένο δίσκο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha bloqueado el acceso al disco. %@ necesita Acceso total al disco para poder leer un disco cifrado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS blokeeris ligipääsu kettale. %@ vajab õigust „Full Disk Access“, et krüpteeritud ketast lugeda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS esti pääsyn asemaan. %@ tarvitsee koko levyn käyttöoikeuden, jotta se voi lukea salattua levyä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a bloqué l’accès au disque. %@ a besoin de l’accès complet au disque pour pouvoir lire un disque chiffré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha bloccato l’accesso al disco. %@ necessita dell’accesso completo al disco per poter leggere un disco cifrato."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„macOS“ užblokavo prieigą prie disko. %@ reikia leidimo „Full Disk Access“, kad galėtų skaityti užšifruotą diską."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bloķēja piekļuvi diskam. %@ ir nepieciešama atļauja “Full Disk Access”, lai varētu lasīt šifrētu disku."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS heeft de toegang tot de schijf geblokkeerd. %@ heeft volledige schijftoegang nodig om een versleutelde schijf te kunnen lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS zablokował dostęp do dysku. %@ potrzebuje pełnego dostępu do dysku, aby móc odczytać zaszyfrowany dysk."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS bloqueou o acesso ao disco. O %@ precisa de acesso completo ao disco para poder ler um disco encriptado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS blockerade åtkomsten till enheten. %@ behöver full skivtillgång för att kunna läsa en krypterad disk."
          }
        }
      }
    },
    "macOS wrote %@. It is not sent anywhere automatically — attach it to your message if you can.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS записа %@. Не се изпраща никъде автоматично — прикачете го към съобщението си, ако можете."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS skrev %@. Den sendes ikke automatisk nogen steder — vedhæft den til din besked, hvis du kan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat %@ geschrieben. Er wird nirgendwohin automatisch gesendet — hänge ihn deiner Nachricht an, wenn du kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το macOS έγραψε το %@. Δεν αποστέλλεται πουθενά αυτόματα — επισυνάψτε το στο μήνυμά σας αν μπορείτε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha escrito %@. No se envía a ningún sitio automáticamente: adjúntalo a tu mensaje si puedes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS kirjutas faili %@. Seda ei saadeta kuhugi automaatselt — lisa see oma sõnumile, kui saad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS kirjoitti tiedoston %@. Sitä ei lähetetä minnekään automaattisesti — liitä se viestiisi, jos voit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a écrit %@. Il n’est envoyé nulle part automatiquement — joignez-le à votre message si vous le pouvez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha scritto %@. Non viene inviato automaticamente da nessuna parte: allegalo al tuo messaggio se puoi."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„macOS“ sukūrė %@. Ji niekur automatiškai nesiunčiama — pridėkite ją prie savo žinutės, jei galite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS izveidoja %@. Tas netiek automātiski nekur nosūtīts — pievienojiet to savai ziņai, ja varat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS heeft %@ geschreven. Dat wordt nergens automatisch naartoe gestuurd — voeg het bij je bericht als dat kan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS zapisał %@. Nie jest nigdzie wysyłany automatycznie — dołącz go do wiadomości, jeśli możesz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS escreveu %@. Não é enviado automaticamente para lado nenhum — anexe-o à sua mensagem, se puder."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS skrev %@. Den skickas inte någonstans automatiskt — bifoga den till ditt meddelande om du kan."
          }
        }
      }
    },
