    "The passphrase this drive was encrypted with.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Паролата-фраза, с която този диск е шифрован."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístupová fráze, kterou byl tento disk zašifrován."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgangssætningen, som denne enhed blev krypteret med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Passphrase, mit der dieses Laufwerk verschlüsselt wurde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η φράση πρόσβασης με την οποία κρυπτογραφήθηκε αυτός ο δίσκος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La frase de contraseña con la que se cifró este disco."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Paroolifraas, millega see ketas krüpteeriti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salauslause, jolla tämä asema salattiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La phrase secrète avec laquelle ce disque a été chiffré."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaporka kojom je ovaj disk šifriran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelmondat, amellyel ezt a meghajtót titkosították."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La passphrase con cui è stato cifrato questo disco."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaptafrazė, kuria šis diskas buvo užšifruotas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paroles frāze, ar kuru šis disks tika šifrēts."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Passordfrasen denne enheten ble kryptert med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wachtwoordzin waarmee deze schijf is versleuteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasło dostępu, którym zaszyfrowano ten dysk."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A frase-passe com que este disco foi encriptado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraza de acces cu care a fost criptat acest disc."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geslo, s katerim je bil ta pogon šifriran."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösenfrasen som den här enheten krypterades med."
          }
        }
      }
    },
    "The password the drive was locked with, or a 48-digit BitLocker recovery key. Spaces and hyphens in a recovery key are ignored.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Паролата, с която дискът е заключен, или 48-цифрен ключ за възстановяване на BitLocker. Интервалите и тиретата в ключа се пренебрегват."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Heslo, kterým byl disk zamčen, nebo 48místný obnovovací klíč BitLocker. Mezery a spojovníky v obnovovacím klíči se ignorují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgangskoden, som enheden blev låst med, eller en 48-cifret BitLocker-genoprettelsesnøgle. Mellemrum og bindestreger i en genoprettelsesnøgle ignoreres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort, mit dem das Laufwerk gesperrt wurde, oder ein 48-stelliger BitLocker-Wiederherstellungsschlüssel. Leerzeichen und Bindestriche im Wiederherstellungsschlüssel werden ignoriert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το συνθηματικό με το οποίο κλειδώθηκε ο δίσκος ή ένα 48ψήφιο κλειδί ανάκτησης BitLocker. Τα κενά και οι παύλες στο κλειδί ανάκτησης αγνοούνται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña con la que se bloqueó el disco, o una clave de recuperación de BitLocker de 48 dígitos. Los espacios y guiones de una clave de recuperación se ignoran."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Parool, millega ketas lukustati, või 48-kohaline BitLockeri taastevõti. Taastevõtme tühikuid ja sidekriipse eiratakse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salasana, jolla asema lukittiin, tai 48-numeroinen BitLocker-palautusavain. Palautusavaimen välilyönnit ja väliviivat jätetään huomiotta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe avec lequel le disque a été verrouillé, ou une clé de récupération BitLocker à 48 chiffres. Les espaces et les traits d’union d’une clé de récupération sont ignorés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lozinka kojom je disk zaključan ili 48-znamenkasti BitLocker ključ za oporavak. Razmaci i crtice u ključu za oporavak se zanemaruju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelszó, amellyel a meghajtót zárolták, vagy egy 48 jegyű BitLocker helyreállítási kulcs. A helyreállítási kulcsban lévő szóközöket és kötőjeleket a program figyelmen kívül hagyja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La password con cui il disco è stato bloccato, oppure una chiave di recupero BitLocker di 48 cifre. Gli spazi e i trattini nella chiave di recupero vengono ignorati."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaptažodis, kuriuo diskas buvo užrakintas, arba 48 skaitmenų „BitLocker“ atkūrimo raktas. Tarpai ir brūkšneliai atkūrimo rakte nepaisomi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parole, ar kuru disks tika bloķēts, vai 48 ciparu BitLocker atkopšanas atslēga. Atstarpes un defises atkopšanas atslēgā tiek ignorētas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Passordet enheten ble låst med, eller en 48-sifret BitLocker-gjenopprettingsnøkkel. Mellomrom og bindestreker i en gjenopprettingsnøkkel ignoreres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wachtwoord waarmee de schijf is vergrendeld, of een BitLocker-herstelsleutel van 48 cijfers. Spaties en streepjes in een herstelsleutel worden genegeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasło, którym zablokowano dysk, albo 48-cyfrowy klucz odzyskiwania BitLocker. Spacje i myślniki w kluczu odzyskiwania są pomijane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A palavra-passe com que o disco foi bloqueado, ou uma chave de recuperação do BitLocker de 48 dígitos. Os espaços e hífenes de uma chave de recuperação são ignorados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola cu care a fost blocat discul sau o cheie de recuperare BitLocker din 48 de cifre. Spațiile și cratimele dintr-o cheie de recuperare sunt ignorate."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geslo, s katerim je bil pogon zaklenjen, ali 48-mestni obnovitveni ključ BitLocker. Presledki in vezaji v obnovitvenem ključu se prezrejo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösenordet som enheten låstes med, eller en 48-siffrig BitLocker-återställningsnyckel. Mellanslag och bindestreck i en återställningsnyckel ignoreras."
          }
        }
      }
    },
    "The virtualisation engine could not start. A restart usually clears this.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Двигателят за виртуализация не можа да стартира. Рестартирането обикновено решава това."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualizační jádro se nepodařilo spustit. Obvykle to vyřeší restart."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualiseringsmotoren kunne ikke starte. En genstart løser det som regel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Virtualisierungs-Engine konnte nicht starten. Ein Neustart behebt das meistens."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μηχανή εικονικοποίησης δεν μπόρεσε να ξεκινήσει. Μια επανεκκίνηση συνήθως το λύνει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor de virtualización no ha podido arrancar. Reiniciar suele solucionarlo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualiseerimismootor ei saanud käivituda. Taaskäivitus lahendab selle tavaliselt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualisointimoottori ei käynnistynyt. Uudelleenkäynnistys yleensä korjaa tämän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur de virtualisation n’a pas pu démarrer. Un redémarrage suffit généralement à corriger cela."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogon za virtualizaciju nije se mogao pokrenuti. Ponovno pokretanje obično to rješava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A virtualizációs motor nem indult el. Ezt általában egy újraindítás megoldja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore di virtualizzazione non è riuscito ad avviarsi. Di solito basta un riavvio."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualizavimo variklis negalėjo pasileisti. Paprastai tai išsprendžia paleidimas iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualizācijas dzinējs nevarēja startēt. Parasti palīdz pārstartēšana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualiseringsmotoren kunne ikke starte. En omstart løser vanligvis dette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De virtualisatie-engine kon niet starten. Opnieuw opstarten lost dit meestal op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Silnik wirtualizacji nie mógł się uruchomić. Zwykle pomaga ponowne uruchomienie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor de virtualização não conseguiu arrancar. Reiniciar costuma resolver."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Motorul de virtualizare nu a putut porni. De obicei o repornire rezolvă problema."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehanizem za virtualizacijo se ni mogel zagnati. Ponovni zagon to običajno odpravi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Virtualiseringsmotorn kunde inte starta. En omstart brukar lösa det."
          }
        }
      }
    },
    "There is no password to enter.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма парола за въвеждане."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není co zadávat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen adgangskode at indtaste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt kein Passwort einzugeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει κωδικός για εισαγωγή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay contraseña que introducir."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Parooli pole vaja sisestada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salasanaa ei tarvita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas de mot de passe à saisir."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema lozinke za unijeti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs beírandó jelszó."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è alcuna password da inserire."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaptažodžio įvesti nereikia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nav jāievada parole."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ingen adgangskode å skrive inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen wachtwoord in te voeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma hasła do wpisania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há palavra-passe a introduzir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există nicio parolă de introdus."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni gesla za vnos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inget lösenord att ange."
          }
        }
      }
    },
    "There is no password to enter. Open it to read and write to it, which macOS on its own cannot do, or open it read-only to leave it untouched.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма парола за въвеждане. Отворете го, за да четете и записвате, което macOS сам не може, или го отворете само за четене, за да остане непроменен."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není co zadávat. Otevřete jej pro čtení i zápis, což macOS sám neumí, nebo jen ke čtení, aby zůstal nedotčený."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen adgangskode at indtaste. Åbn den for at læse og skrive til den, hvilket macOS ikke selv kan, eller åbn den kun til læsning, så den forbliver urørt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt kein Passwort einzugeben. Öffne es zum Lesen und Schreiben, was macOS allein nicht kann, oder öffne es nur lesend, damit es unverändert bleibt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει κωδικός για εισαγωγή. Ανοίξτε τον για ανάγνωση και εγγραφή, κάτι που το macOS από μόνο του δεν μπορεί, ή ανοίξτε τον μόνο για ανάγνωση ώστε να μείνει ανέπαφος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay contraseña que introducir. Ábrelo para leer y escribir en él, algo que macOS por sí solo no puede hacer, o ábrelo en solo lectura para dejarlo intacto."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Parooli pole vaja sisestada. Ava see lugemiseks ja kirjutamiseks, mida macOS ise ei suuda, või ava ainult lugemiseks, et see puutumata jääks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salasanaa ei tarvita. Avaa se luettavaksi ja kirjoitettavaksi, mihin macOS ei yksin pysty, tai avaa se vain luettavaksi, jolloin se säilyy koskemattomana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas de mot de passe à saisir. Ouvrez-le en lecture et écriture, ce que macOS seul ne sait pas faire, ou en lecture seule pour le laisser intact."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema lozinke za unijeti. Otvorite ga za čitanje i pisanje, što macOS sam ne može, ili ga otvorite samo za čitanje kako bi ostao netaknut."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs beírandó jelszó. Nyissa meg olvasásra és írásra, amire a macOS önmagában nem képes, vagy nyissa meg csak olvasásra, hogy érintetlen maradjon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è alcuna password da inserire. Aprilo per leggerlo e scriverlo, cosa che macOS da solo non sa fare, oppure aprilo in sola lettura per lasciarlo intatto."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaptažodžio įvesti nereikia. Atverkite jį skaitymui ir rašymui, ko „macOS“ pati negali, arba atverkite tik skaitymui, kad liktų nepakeistas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nav jāievada parole. Atveriet to lasīšanai un rakstīšanai, ko macOS pats nespēj, vai atveriet tikai lasīšanai, lai tas paliktu neskarts."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ingen adgangskode å skrive inn. Åpne den for å lese og skrive til den, noe macOS ikke kan alene, eller åpne den kun for lesing så den forblir urørt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen wachtwoord in te voeren. Open de schijf om te lezen en schrijven, wat macOS zelf niet kan, of open die alleen-lezen zodat er niets aan verandert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma hasła do wpisania. Otwórz go do odczytu i zapisu, czego macOS sam nie potrafi, albo otwórz tylko do odczytu, aby pozostał nienaruszony."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há palavra-passe a introduzir. Abra-o para ler e escrever, o que o macOS por si só não consegue, ou abra-o apenas para leitura para o deixar intacto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există nicio parolă de introdus. Deschideți-l pentru citire și scriere, lucru pe care macOS singur nu îl poate face, sau deschideți-l doar pentru citire pentru a-l lăsa neatins."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni gesla za vnos. Odprite ga za branje in pisanje, česar macOS sam ne zmore, ali pa samo za branje, da ostane nedotaknjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inget lösenord att ange. Öppna den för att läsa och skriva till den, vilket macOS inte klarar på egen hand, eller öppna den skrivskyddad så att den lämnas orörd."
          }
        }
      }
    },
    "There is nothing in “%@” that %@ can open. It holds no BitLocker, LUKS, NTFS or Linux volume.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В „%1$@“ няма нищо, което %2$@ да може да отвори. Той не съдържа том с BitLocker, LUKS, NTFS или Linux."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V „%1$@“ není nic, co by %2$@ dokázal otevřít. Neobsahuje žádný svazek BitLocker, LUKS, NTFS ani Linux."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er intet i “%1$@”, som %2$@ kan åbne. Den indeholder ingen BitLocker-, LUKS-, NTFS- eller Linux-enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In „%1$@“ ist nichts, was %2$@ öffnen kann. Es enthält kein BitLocker-, LUKS-, NTFS- oder Linux-Volume."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει τίποτα στο «%1$@» που να μπορεί να ανοίξει το %2$@. Δεν περιέχει τόμο BitLocker, LUKS, NTFS ή Linux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada en «%1$@» que %2$@ pueda abrir. No contiene ningún volumen BitLocker, LUKS, NTFS ni Linux."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Failis „%1$@“ pole midagi, mida %2$@ avada saaks. See ei sisalda BitLockeri, LUKS-i, NTFS-i ega Linuxi köidet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostossa ”%1$@” ei ole mitään, minkä %2$@ voisi avata. Se ei sisällä BitLocker-, LUKS-, NTFS- eikä Linux-taltiota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » ne contient rien que %2$@ puisse ouvrir. Il ne contient aucun volume BitLocker, LUKS, NTFS ou Linux."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U „%1$@” nema ničega što %2$@ može otvoriti. Ne sadrži BitLocker, LUKS, NTFS ni Linux jedinicu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) „%1$@” nem tartalmaz semmit, amit a(z) %2$@ meg tudna nyitni. Nincs benne BitLocker-, LUKS-, NTFS- vagy Linux-kötet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In «%1$@» non c’è nulla che %2$@ possa aprire. Non contiene volumi BitLocker, LUKS, NTFS o Linux."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faile „%1$@“ nėra nieko, ką %2$@ galėtų atverti. Jame nėra BitLocker, LUKS, NTFS ar Linux tomo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Failā “%1$@” nav nekā, ko %2$@ varētu atvērt. Tajā nav BitLocker, LUKS, NTFS vai Linux sējuma."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ingenting i «%1$@» som %2$@ kan åpne. Den inneholder ingen BitLocker-, LUKS-, NTFS- eller Linux-enhet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zit niets in ‘%1$@’ dat %2$@ kan openen. Het bevat geen BitLocker-, LUKS-, NTFS- of Linux-volume."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W „%1$@” nie ma niczego, co %2$@ mógłby otworzyć. Nie zawiera woluminu BitLocker, LUKS, NTFS ani Linux."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nada em «%1$@» que o %2$@ consiga abrir. Não contém qualquer volume BitLocker, LUKS, NTFS ou Linux."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există nimic în „%1$@” pe care %2$@ să îl poată deschide. Nu conține niciun volum BitLocker, LUKS, NTFS sau Linux."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V »%1$@« ni ničesar, kar bi %2$@ lahko odprl. Ne vsebuje nosilca BitLocker, LUKS, NTFS ali Linux."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inget i ”%1$@” som %2$@ kan öppna. Den innehåller ingen BitLocker-, LUKS-, NTFS- eller Linux-volym."
          }
        }
      }
    },
    "They stay in Finder after %@ quits. Eject them there whenever you are finished.": {
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Те остават във Finder, след като %@ приключи. Извадете ги оттам, когато сте готови."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstanou ve Finderu i po ukončení aplikace %@. Až budete hotovi, vysuňte je odtud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De bliver i Finder, efter at %@ er sluttet. Skub dem ud derfra, når du er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie bleiben nach dem Beenden von %@ im Finder. Wirf sie dort aus, wenn du fertig bist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παραμένουν στο Finder αφού τερματιστεί το %@. Κάντε εξαγωγή από εκεί όταν τελειώσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanecen en el Finder después de salir de %@. Expúlsalos allí cuando termines."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Nad jäävad Finderisse pärast seda, kui %@ väljub. Väljuta nad sealt, kui oled lõpetanud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne jäävät Finderiin sen jälkeen, kun %@ lopetetaan. Poista ne sieltä käytöstä, kun olet valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils restent dans le Finder après la fermeture de %@. Éjectez-les depuis le Finder lorsque vous avez terminé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostaju u Finderu nakon što %@ završi. Izbacite ih ondje kad završite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Finderben maradnak, miután a(z) %@ kilép. Ha végzett, onnan adja ki őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restano nel Finder dopo la chiusura di %@. Espellili da lì quando hai finito."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jie lieka „Finder“ programoje, kai %@ baigia darbą. Išstumkite juos ten, kai baigsite."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tie paliek programmā Finder pēc tam, kad %@ ir aizvērta. Izstumiet tos tur, kad esat pabeidzis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De blir værende i Finder etter at %@ avsluttes. Mat dem ut derfra når du er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze blijven in de Finder staan nadat %@ is gestopt. Verwijder ze daar wanneer je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostają w Finderze po zakończeniu programu %@. Wysuń je stamtąd, gdy skończysz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanecem no Finder depois de o %@ sair. Ejete-os aí quando terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rămân în Finder după ce %@ se închide. Ejectați-le de acolo când terminați."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostanejo v Finderju, potem ko se %@ konča. Izvrzite jih tam, ko končate."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De finns kvar i Finder efter att %@ avslutats. Mata ut dem där när du är klar."
          }
        }
      }
    },
    "Third-Party Notices": {
