            "value": "Proč se zobrazuje jako síťový disk"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvorfor den vises som en netværksenhed"
          }
        },
        "de": {
          "stringUnit": {
