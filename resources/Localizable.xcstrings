            "state": "translated",
            "value": "Mostra a cosa serve ogni permesso"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon waarvoor elk recht dient"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar para que serve cada permissão"
          }
        }
      }
    },
    "Some permissions are still needed": {
      "localizations": {
        "de": {
          "stringUnit": {
